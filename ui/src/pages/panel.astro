              <span class="panel-nav-group-toggle-label">Çalışma</span>
              <span class="panel-nav-chevron" aria-hidden="true"></span>
            </button>
            <div class="panel-nav-group-items" id="panel-nav-items-calisma">
              <button type="button" data-module="sohbet" aria-current="true">
                <span class="panel-nav-label">Sohbet</span>
              </button>
              <button type="button" data-module="gorevler">
                <span class="panel-nav-label">Görevler</span>
              </button>
              <button type="button" data-module="ses">
                <span class="panel-nav-label">Ses</span>
              </button>
              <button type="button" data-module="medya">
                <span class="panel-nav-label">Medya</span>
              </button>
              <button type="button" data-module="sosyal">
                <span class="panel-nav-label">Sosyal</span>
              </button>
              <button type="button" data-module="posta">
                <span class="panel-nav-label">Posta</span>
              </button>
              <button type="button" data-module="dosyalar">
                <span class="panel-nav-label">Dosyalar</span>
              </button>
            </div>
          </div>
          <div class="panel-nav-collapsible" data-nav-group="lumos-cekirdegi">
            <button
              type="button"
              class="panel-nav-group-toggle"
              id="panel-nav-toggle-lumos"
              aria-expanded="false"
              aria-controls="panel-nav-items-lumos"
            >
              <span class="panel-nav-group-toggle-label">Lumos çekirdeği</span>
              <span class="panel-nav-chevron" aria-hidden="true"></span>
            </button>
            <div class="panel-nav-group-items" id="panel-nav-items-lumos" hidden>
              <button type="button" data-module="yayincilik">
                <span class="panel-nav-label">Yayıncılık</span>
              </button>
              <button type="button" data-module="yapayzeka">
                <span class="panel-nav-label">Yapay Zekâ</span>
              </button>
              <button type="button" data-module="kuantum">
                <span class="panel-nav-label">Kuantum</span>
                <span class="lumos-soon-badge">Yakında</span>
              </button>
              <button type="button" data-module="entegrasyon">
                <span class="panel-nav-label">Entegrasyon</span>
              </button>
              <button type="button" data-module="kimlik">
                <span class="panel-nav-label">Kimlik</span>
              </button>
              <button type="button" data-module="guvenlik">
                <span class="panel-nav-label">Güvenlik</span>
                <span class="lumos-soon-badge">Yakında</span>
              </button>
              <button type="button" data-module="dunya">
                <span class="panel-nav-label">Dünya</span>
                <span class="lumos-soon-badge">Yakında</span>
              </button>
              <button type="button" data-module="ayarlar">
                <span class="panel-nav-label">Ayarlar</span>
                <span class="lumos-soon-badge">Yakında</span>
              </button>
            </div>
          </div>
        </nav>
        <main class="panel-main">
          <section
            id="panel-sohbet"
            class="module-panel"
            data-module-panel="sohbet"
            data-active="true"
            aria-labelledby="panel-sohbet-title"
          >
            <div class="chat-panel-top">
              <h2 id="panel-sohbet-title">Sohbet</h2>
              <p class="chat-panel-status">Aşağıdaki alanda yalnızca konuşma geçmişi kayar; mesajını en alttan gönder.</p>
              <p class="chat-panel-arch" role="note">Lumos, göreve göre doğru çalışma alanını açar; cihaz yerel merkez, dış servisler güvenli köprüdür.</p>
            </div>
            <div class="chat-workspace">
              <div class="chat-history-shell" aria-label="Mesaj geçmişi">
                <div
                  id="chat-thread"
                  class="chat-thread"
                  role="log"
                  aria-live="polite"
                  aria-relevant="additions"
                >
                  <div class="chat-empty-hint" aria-hidden="true">
                    <span class="chat-empty-hint__line">Lumos hazır</span>
                    <span class="chat-empty-hint__sub">Dinliyor</span>
                  </div>
                </div>
              </div>
              <div class="chat-compose-stack">
                <div class="chat-compose-bar">
                  <div class="chat-compose">
                    <textarea
                      id="panel-msg"
                      rows="2"
                      placeholder="Mesajını yaz…"
                      aria-label="Mesajını yaz…"
                      autocomplete="off"
                    ></textarea>
                    <button type="button" id="panel-send">Gönder</button>
                  </div>
                </div>
                <p class="lumos-security-note">Kalıcı ve yıkıcı işlemler açık onay gerektirir.</p>
              </div>
            </div>
          </section>

          <section
            id="panel-gorevler"
            class="module-panel"
            data-module-panel="gorevler"
            data-active="false"
            aria-labelledby="panel-gorevler-title"
          >
            <h2 id="panel-gorevler-title">Görevler</h2>
            <p class="gorevler-intro">
              Lumos’un takip ettiği işler ve onay bekleyen adımlar burada görünür olacak.
            </p>
            <ul class="gorevler-task-list">
              <li class="gorevler-task-card">
                <span class="gorevler-task-title">Panel ilk iskeleti tamamlandı</span>
                <span class="task-status-badge task-status-badge--done">Tamamlandı</span>
              </li>
              <li class="gorevler-task-card">
                <span class="gorevler-task-title">Ses katmanı planlanacak</span>
                <span class="task-status-badge task-status-badge--waiting">Bekliyor</span>
              </li>
              <li class="gorevler-task-card">
                <span class="gorevler-task-title">Posta bağlantıları tasarlanacak</span>
                <span class="task-status-badge task-status-badge--waiting">Bekliyor</span>
              </li>
              <li class="gorevler-task-card">
                <span class="gorevler-task-title">Kalıcı işlem güvenlik akışı korunacak</span>
                <span class="task-status-badge task-status-badge--approval">Onay gerekli</span>
              </li>
            </ul>
          </section>

          <section
            id="panel-ses"
            class="module-panel"
            data-module-panel="ses"
            data-active="false"
            aria-labelledby="panel-ses-title"
          >
            <h2 id="panel-ses-title">Ses</h2>
            <p class="gorevler-intro">
              Ses temel yapı hazır. Oturum ve adım durumları bu alanda görünür.
            </p>
            <ul class="gorevler-task-list">
              <li class="gorevler-task-card">
                <span class="gorevler-task-title">Dinleme oturumu</span>
                <span class="task-status-badge task-status-badge--done">Hazır</span>
              </li>
              <li class="gorevler-task-card">
                <span class="gorevler-task-title">Konuşma akışı</span>
                <span class="task-status-badge task-status-badge--waiting">Taslak</span>
              </li>
              <li class="gorevler-task-card">
                <span class="gorevler-task-title">Onay bekleyen ses adımı</span>
                <span class="task-status-badge task-status-badge--approval">Onay bekliyor</span>
              </li>
            </ul>
          </section>

          <section
            id="panel-medya"
            class="module-panel"
            data-module-panel="medya"
            data-active="false"
            aria-labelledby="panel-medya-title"
          >
            <h2 id="panel-medya-title">Medya</h2>
            <p class="medya-intro">
              Medya alanı, kullanıcının görsel içeriklerle çalışırken düzeni, mahremiyeti ve kontrolü koruması için ayrılmıştır.
            </p>
            <ul class="medya-card-list">
              <li class="medya-card">
                <h3>Görsel Düzeni</h3>
                <p>
                  Görseller, kullanıcının medya materyallerini dağınıklığa düşmeden takip edebilmesi için ayrı bir alanda
                  konumlanır.
                </p>
              </li>
              <li class="medya-card">
                <h3>Kullanıcı Kontrolü</h3>
                <p>Görsel içerikle ilgili tercih, kullanım sınırı ve son karar kullanıcıda kalır.</p>
              </li>
              <li class="medya-card">
                <h3>Mahremiyet Sınırı</h3>
                <p>
                  Görsel içerikler, paket ya da kullanım türünden bağımsız olarak çekirdek mahremiyet ilkesiyle ele alınır.
                </p>
              </li>
              <li class="medya-card">
                <h3>Çalışma Bağlamı</h3>
                <p>
                  Bu alan, görsellerle ilgili notların, kararların ve sonraki adımların bağlam içinde tutulması için
                  tasarlanır.
                </p>
              </li>
            </ul>
          </section>

          <section
            id="panel-sosyal"
            class="module-panel"
            data-module-panel="sosyal"
            data-active="false"
            aria-labelledby="panel-sosyal-title"
          >
            <h2 id="panel-sosyal-title">Sosyal</h2>
            <p class="medya-intro">
              Sosyal alan, kullanıcının dışarıya açılan içeriklerinde sesini, tonunu ve kararını koruması için ayrılmıştır.
            </p>
            <ul class="medya-card-list">
              <li class="medya-card">
                <h3>İçerik Düzeni</h3>
                <p>
                  Taslaklar ve gönderiler, kullanıcının içerik sürecini dağınıklığa düşmeden takip edebilmesi için ayrı bir
                  alanda konumlanır.
                </p>
              </li>
              <li class="medya-card">
                <h3>Kullanıcı Sesi</h3>
                <p>İçeriğin tonu, biçimi ve son kararı kullanıcıda kalır.</p>
              </li>
              <li class="medya-card">
                <h3>Mahremiyet Sınırı</h3>
                <p>
                  Sosyal içerikler ve taslaklar, paket ya da kullanım türünden bağımsız olarak çekirdek mahremiyet ilkesiyle
                  ele alınır.
                </p>
              </li>
              <li class="medya-card">
                <h3>Çalışma Bağlamı</h3>
                <p>
                  Bu alan, içeriklere bağlı notların, kararların ve sonraki adımların bağlam içinde tutulması için
                  tasarlanır.
                </p>
              </li>
            </ul>
          </section>

          <section
            id="panel-posta"
            class="module-panel"
            data-module-panel="posta"
            data-active="false"
            aria-labelledby="panel-posta-title"
