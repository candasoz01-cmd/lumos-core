---
interface Props {
  id: string;
  name: string;
  compact?: boolean;
  chip?: boolean;
  monochrome?: boolean;
  linked?: boolean;
}

const { id, name, compact = false, chip = false, monochrome = false, linked = true } = Astro.props;

/**
 * Presentation-only lockup. Official local SVGs only.
 * Missing or unofficial marks render as the clean brand name — no CDN,
 * Simple Icons, letter tiles, or invented icons.
 */
const LOCAL_LOGOS: Record<string, string> = {
  gemini: "/brands/gemini.svg",
  deepseek: "/brands/deepseek.svg",
  matter: "/brands/matter.svg",
  homeAssistant: "/brands/home-assistant.svg",
  smartThings: "/brands/smartthings.svg",
  sonos: "/brands/sonos.svg",
};

const BRAND_HREFS: Record<string, string> = {
  github: "https://github.com/",
  gmail: "https://workspace.google.com/products/gmail/",
  googleCalendar: "https://workspace.google.com/products/calendar/",
  googleDrive: "https://workspace.google.com/products/drive/",
  google: "https://about.google/",
  slack: "https://slack.com/",
  zoom: "https://www.zoom.com/",
  whatsapp: "https://www.whatsapp.com/",
  telegram: "https://telegram.org/",
  line: "https://line.me/",
  kakaoTalk: "https://www.kakaocorp.com/page/service/service/KakaoTalk",
  microsoftTeams: "https://www.microsoft.com/microsoft-teams/",
  notion: "https://www.notion.com/",
  jira: "https://www.atlassian.com/software/jira",
  linear: "https://linear.app/",
  chrome: "https://www.google.com/chrome/",
  safari: "https://www.apple.com/safari/",
  apple: "https://www.apple.com/",
  openai: "https://openai.com/",
  gemini: "https://gemini.google.com/",
  deepseek: "https://www.deepseek.com/",
  bluetoothAudio: "https://www.bluetooth.com/",
  matter: "https://csa-iot.org/all-solutions/matter/",
  homeAssistant: "https://www.home-assistant.io/",
  smartThings: "https://www.samsung.com/us/smartthings/",
  sonos: "https://www.sonos.com/",
  facebook: "https://www.facebook.com/",
  instagram: "https://www.instagram.com/",
  x: "https://x.com/",
  tiktok: "https://www.tiktok.com/",
  linkedin: "https://www.linkedin.com/",
  youtube: "https://www.youtube.com/",
  wechat: "https://www.wechat.com/",
  vk: "https://vk.com/",
  bilibili: "https://www.bilibili.com/",
  xiaohongshu: "https://www.xiaohongshu.com/",
  weibo: "https://weibo.com/",
  okru: "https://ok.ru/",
};

const logo = LOCAL_LOGOS[id];
const href = BRAND_HREFS[id];
const useLink = Boolean(linked && href);
const lockupClass = [
  "brand-lockup",
  compact && "brand-lockup--compact",
  chip && "brand-lockup--chip",
  monochrome && "brand-lockup--mono",
  !logo && "brand-lockup--text",
];
---

{
  useLink ? (
    <a
      class:list={lockupClass}
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={name}
    >
      {logo && (
        <span class="brand-lockup__mark" aria-hidden="true">
          <img src={logo} alt="" decoding="async" />
        </span>
      )}
      <span class="brand-lockup__name">{name}</span>
    </a>
  ) : (
    <span class:list={lockupClass}>
      {logo && (
        <span class="brand-lockup__mark" aria-hidden="true">
          <img src={logo} alt="" decoding="async" />
        </span>
      )}
      <span class="brand-lockup__name">{name}</span>
    </span>
  )
}

<script>
  function hideBrokenBrandMarks() {
    document.querySelectorAll(".brand-lockup__mark img").forEach((node) => {
      const img = node as HTMLImageElement;
      const hide = () => {
        const mark = img.closest(".brand-lockup__mark");
        const lockup = img.closest(".brand-lockup");
        mark?.remove();
        lockup?.classList.add("brand-lockup--text");
      };
      img.addEventListener("error", hide);
      if (img.complete && img.naturalWidth === 0) hide();
    });
  }

  hideBrokenBrandMarks();
  document.addEventListener("astro:page-load", hideBrokenBrandMarks);
</script>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    max-width: 100%;
    min-height: 2.5rem;
    color: var(--lumos-land-title);
    text-decoration: none;
  }

  a.brand-lockup:hover .brand-lockup__name,
  a.brand-lockup:focus-visible .brand-lockup__name {
    color: var(--lumos-accent-blue-bright);
  }

  a.brand-lockup:focus-visible {
    outline: 2px solid rgb(var(--lumos-land-warm) / 0.5);
    outline-offset: 4px;
    border-radius: var(--lumos-radius-sm);
  }

  .brand-lockup__mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.36rem;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid rgb(var(--lumos-land-warm) / 0.28);
    border-radius: 0.7rem;
    background: #f8fafc;
  }

  .brand-lockup__mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .brand-lockup__name {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .brand-lockup--text {
    gap: 0;
  }

  .brand-lockup--compact {
    gap: 0.5rem;
    min-height: 2rem;
  }

  .brand-lockup--compact.brand-lockup--text {
    gap: 0;
  }

  .brand-lockup--compact .brand-lockup__mark {
    flex-basis: 2rem;
    width: 2rem;
    height: 2rem;
    padding: 0.3rem;
    border-radius: 0.55rem;
  }

  .brand-lockup--compact .brand-lockup__name {
    font-size: 0.92rem;
  }

  .brand-lockup--chip {
    gap: 0.4rem;
    min-height: 1.15rem;
  }

  .brand-lockup--chip.brand-lockup--text {
    gap: 0;
  }

  .brand-lockup--chip .brand-lockup__mark {
    flex-basis: 1.15rem;
    width: 1.15rem;
    height: 1.15rem;
    padding: 0.14rem;
    border-radius: 0.4rem;
    border-width: 1px;
  }

  .brand-lockup--chip .brand-lockup__name {
    font-size: inherit;
    font-weight: 600;
  }

  .brand-lockup--mono .brand-lockup__mark img {
    filter: grayscale(1) opacity(0.7);
    transition: filter 0.2s ease;
  }

  .brand-lockup--mono .brand-lockup__name {
    color: var(--lumos-text-muted);
    transition: color 0.2s ease;
  }

  a.brand-lockup--mono:hover .brand-lockup__mark img,
  a.brand-lockup--mono:focus-visible .brand-lockup__mark img,
  .brand-lockup--mono:hover .brand-lockup__mark img,
  .brand-lockup--mono:focus-within .brand-lockup__mark img {
    filter: grayscale(0) opacity(1);
  }

  a.brand-lockup--mono:hover .brand-lockup__name,
  a.brand-lockup--mono:focus-visible .brand-lockup__name,
  .brand-lockup--mono:hover .brand-lockup__name,
  .brand-lockup--mono:focus-within .brand-lockup__name {
    color: var(--lumos-land-title);
  }
</style>
