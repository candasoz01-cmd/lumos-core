          if (typeof refreshPanelVoiceHintsI18n === "function") refreshPanelVoiceHintsI18n();
        });

        if (speechRecognitionSupported) {
          voiceBtn?.addEventListener("click", () => {
          const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
          if (!SR) return;

          if (voiceListening || voiceStartPending) {
            if (voiceRec) {
              voiceStopRequested = true;
              try {
                voiceRec.stop();
              } catch {
                /* ignore */
              }
            }
            return;
          }

          voiceRec = new SR();
          voiceRec.lang = panelSpeechRecognitionLang();
          voiceRec.interimResults = false;
          voiceRec.continuous = false;
          voiceRec.maxAlternatives = 1;

          voiceStartPending = true;
          voiceStopRequested = false;
          voiceGotResult = false;
          voiceHadError = false;
          voiceSessionStarted = false;
          setVoiceHintKey("");

          voiceRec.onstart = () => {
            beginVoiceListeningUi();
          };

          voiceRec.onaudiostart = () => {
            if (!voiceListening) beginVoiceListeningUi();
          };

          voiceRec.onresult = (ev) => {
            let spoken = "";
            for (let i = ev.resultIndex; i < ev.results.length; i++) {
              spoken += ev.results[i][0].transcript;
            }
            const trimmed = String(spoken || "").trim();
            if (!trimmed) return;
            voiceGotResult = true;
            appendVoiceTranscript(spoken);
            if (voiceHint) voiceHint.hidden = true;
          };

          voiceRec.onerror = (ev) => {
            const code = ev.error || "";
            if (code !== "aborted" || !voiceStopRequested) {
              setVoiceHintKey(voiceErrorHintKey(code));
              voiceHadError = true;
            }
            stopVoiceListeningUi();
          };

          voiceRec.onend = () => {
            const userStopped = voiceStopRequested;
            const gotResult = voiceGotResult;
            const hadError = voiceHadError;
            const sessionStarted = voiceSessionStarted;
            const startPendingButNeverStarted =
              voiceStartPending && !voiceSessionStarted;
            stopVoiceListeningUi();
            voiceStopRequested = false;
            voiceGotResult = false;
            voiceHadError = false;
            voiceSessionStarted = false;
            if (gotResult || userStopped || hadError) return;
            if (startPendingButNeverStarted) {
              setVoiceHintKey("panel.modules.chat.compose.voiceHints.startFailed");
              return;
            }
            if (sessionStarted) {
              setVoiceHintKey("panel.modules.chat.compose.voiceHints.noResult");
            }
          };

          try {
            voiceRec.start();
          } catch {
            stopVoiceListeningUi();
            setVoiceHintKey("panel.modules.chat.compose.voiceHints.startFailed");
          }
        });
        }

