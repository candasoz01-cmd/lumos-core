      }

      function gorevlerStatusLabel(key) {
        const k = key != null ? String(key).trim() : "";
        const map = {
          bekliyor: panelT("panel.modules.tasks.status.bekliyor"),
          onay_bekliyor: panelT("panel.modules.tasks.status.onay_bekliyor"),
