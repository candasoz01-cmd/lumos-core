<div class="lumos-platform-hero-layout">
  <div class="lumos-platform-hero-copy">
    <p class="lumos-hero-eyebrow" data-i18n="hero.eyebrow">WE LOCK AI · LUMOS</p>
    <div class="lumos-hero-title-lockup">
      <img
        class="lumos-logo-mark lumos-hero-title-mark"
        src="/chat-lumos-mark.svg"
        alt=""
        width="64"
        height="64"
        decoding="async"
      />
      <h1 id="lumos-platform-baslik" class="lumos-hero-title-page" data-i18n="landing.platform.heroTitle">
        Bir panel. Her akış. Senin kararın.
      </h1>
    </div>
    <p class="lumos-hero-subtitle" data-i18n="landing.platform.heroSubtitle">
      Kimlik, yapay zekâ ve otomasyon için kontrol katmanı.
    </p>
    <p class="lumos-hero-lead" data-i18n="landing.platform.heroBody">
      Lumos; kimliği, yapay zekâ sağlayıcılarını, entegrasyonları ve cihazları aynı güven sınırı içinde yöneten insan merkezli platformdur.
    </p>
    <p class="lumos-hero-pillar" data-i18n="hero.pillar">Tek panel · Çoklu akış · Kullanıcı kontrolü</p>
    <div class="lumos-hero-actions">
      <a class="lumos-hero-btn lumos-hero-btn--primary" href="/panel" data-i18n="landing.platform.openLumos">Lumos’u aç</a>
      <!-- Devreye alma bağımlılığı: bu CTA `id="canli-durum"` taşıyan canlı
           durum bölümünü gerektirir. O bölüm bu kurtarma PR'ının kapsamı
           dışındaki index.astro'da yaşar; bileşen bağlanırken eklenmelidir. -->
      <a class="lumos-hero-btn lumos-hero-btn--ghost" href="#canli-durum" data-i18n="landing.platform.viewStatus">Canlı durumu gör</a>
    </div>
  </div>
  <div class="lumos-hero-scene" aria-label="Lumos platform katmanları" data-i18n-aria-label="landing.platform.mapAria">
    <div class="lumos-control-map">
      <article class="lumos-control-node lumos-control-node--core">
        <span class="lumos-control-node__index">01 · CORE</span>
        <h2 data-i18n="landing.platform.coreTitle">Lumos kontrol katmanı</h2>
        <p data-i18n="landing.platform.coreBody">Kimlik · politika · orkestrasyon · görev akışı</p>
        <span class="lumos-control-node__state" data-i18n="landing.platform.coreState">Çekirdek hazır</span>
      </article>
      <article class="lumos-control-node">
        <span class="lumos-control-node__index">02 · ID</span>
        <h3 data-i18n="landing.platform.identityTitle">Lumos ID</h3>
        <p data-i18n="landing.platform.identityBody">Oturum, profil ve güven bağlamı</p>
        <span class="lumos-control-node__state" data-i18n="landing.platform.identityState">Google bağlantısı canlı</span>
      </article>
      <article class="lumos-control-node">
        <span class="lumos-control-node__index">03 · AI</span>
        <h3 data-i18n="landing.platform.aiTitle">AI sağlayıcı ağı</h3>
        <p data-i18n="landing.platform.aiBody">Yapılandırılabilir sağlayıcı ve model seçimi</p>
        <span class="lumos-control-node__state lumos-control-node__state--roadmap" data-i18n="landing.platform.aiState">Orkestrasyon hazırlanıyor</span>
      </article>
      <article class="lumos-control-node">
        <span class="lumos-control-node__index">04 · CONNECT</span>
        <h3 data-i18n="landing.platform.integrationTitle">Entegrasyonlar</h3>
        <p data-i18n="landing.platform.integrationBody">Google · GitHub · Slack · dosya akışları</p>
        <span class="lumos-control-node__state lumos-control-node__state--roadmap" data-i18n="landing.platform.integrationState">Kademeli bağlantı</span>
      </article>
      <article class="lumos-control-node">
        <span class="lumos-control-node__index">05 · DEVICE</span>
        <h3 data-i18n="landing.platform.deviceTitle">Cihaz ekosistemi</h3>
        <p data-i18n="landing.platform.deviceBody">Mac · mobil · ev · yerel çalışma</p>
        <span class="lumos-control-node__state lumos-control-node__state--roadmap" data-i18n="landing.platform.deviceState">Yol haritası</span>
      </article>
    </div>
  </div>
</div>
