---
/** Canlı köprü testi: istek adresi sabit (deploy ortamı yanlış env ile kırılmasın). */
const CHAT_URL = "https://lumos-core-1.onrender.com/chat";
const kandoToken = import.meta.env.PUBLIC_KANDO_TOKEN || "test123";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lumos — Açık mektup</title>
    <style>
      .lumos-hero-row {
        display: flex;
        align-items: stretch;
        width: 100%;
        min-height: 0;
      }
      .lumos-hero-dna {
        flex: 0 0 13px;
        width: 13px;
        min-width: 13px;
        position: relative;
        pointer-events: none;
        opacity: 1;
      }
      .lumos-hero-dna svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      .lumos-hero-imgwrap {
        flex: 1 1 auto;
        min-width: 0;
      }
      @media (max-width: 559.98px) {
        .lumos-hero-dna {
          display: none;
        }
      }
      .lumos-cap {
        box-sizing: border-box;
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 clamp(0.65rem, 2vw, 1.25rem) clamp(1.1rem, 2.8vw, 1.85rem);
      }
      .lumos-cap-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem 1.15rem;
      }
      @media (min-width: 640px) {
        .lumos-cap-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (min-width: 1024px) {
        .lumos-cap-grid {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }
      .lumos-cap-card {
        box-sizing: border-box;
        margin: 0;
        padding: 0.85rem 0.95rem;
        border-radius: 10px;
        border: 1px solid rgba(148, 112, 68, 0.38);
        background: linear-gradient(165deg, rgba(12, 14, 22, 0.92) 0%, rgba(14, 12, 10, 0.88) 100%);
        box-shadow: inset 0 1px 0 rgba(188, 148, 92, 0.08), 0 6px 20px rgba(0, 0, 0, 0.35);
      }
      .lumos-cap-card h3 {
        margin: 0 0 0.45rem;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: #e0c49a;
        line-height: 1.25;
      }
      .lumos-cap-card p {
        margin: 0;
        font-size: 0.88rem;
        line-height: 1.55;
        color: #c5cad6;
      }
      .lumos-cap-sronly {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </head>
  <body
    style="margin:0;background:#0b1020;color:#f2f2f2;font-family:ui-sans-serif,system-ui,Segoe UI,Roboto,sans-serif;line-height:1.6;"
  >
    <section
      aria-label="Lumos görseli"
      style="box-sizing:border-box;width:100%;max-width:100%;padding:clamp(0.4rem, 1.4vw, 0.75rem) clamp(0.65rem, 2vw, 1.25rem) clamp(0.8rem, 2.4vw, 1.35rem);display:flex;justify-content:center;"
    >
      <div
        style="box-sizing:border-box;width:100%;max-width:1240px;margin:0 auto;min-width:0;"
      >
        <div
          style="box-sizing:border-box;width:100%;margin:0;border-radius:12px;padding:0;overflow:hidden;background:linear-gradient(165deg,#0a0c12 0%,#141118 42%,#120f0a 100%);border:1px solid rgba(148, 112, 68, 0.52);box-shadow:inset 0 1px 0 rgba(188, 148, 92, 0.14),0 0 0 1px rgba(98, 72, 44, 0.38),0 10px 36px rgba(0,0,0,0.55),0 0 22px rgba(32, 88, 86, 0.04),0 0 40px rgba(130, 96, 56, 0.07);display:block;min-height:0;"
        >
          <div class="lumos-hero-row">
            <aside class="lumos-hero-dna" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 320" preserveAspectRatio="none" focusable="false">
                <path
                  fill="none"
                  stroke="rgba(72, 188, 184, 0.16)"
                  stroke-width="0.55"
                  stroke-linecap="round"
                  d="M5.2 0c-2.8 28 5.2 56 2.2 84s-4.8 56-1.8 84 5.8 56 2.8 84-4.8 56-1.8 84"
                ></path>
                <path
                  fill="none"
                  stroke="rgba(72, 188, 184, 0.11)"
                  stroke-width="0.5"
                  stroke-linecap="round"
                  d="M10.8 0c2.8 28-5.2 56-2.2 84s4.8 56 1.8 84-5.8 56-2.8 84 4.8 56 1.8 84"
                ></path>
              </svg>
            </aside>
            <div class="lumos-hero-imgwrap">
              <img
                src="/assets/lumos/lumos-last.png"
                alt="Lumos"
                width="1536"
                height="1024"
                loading="eager"
                decoding="async"
                style="display:block;margin:0 auto;width:100%;max-width:100%;height:auto;object-fit:contain;"
              />
            </div>
            <aside class="lumos-hero-dna" aria-hidden="true" style="transform:scaleX(-1);">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 320" preserveAspectRatio="none" focusable="false">
                <path
                  fill="none"
                  stroke="rgba(72, 188, 184, 0.16)"
                  stroke-width="0.55"
                  stroke-linecap="round"
                  d="M5.2 0c-2.8 28 5.2 56 2.2 84s-4.8 56-1.8 84 5.8 56 2.8 84-4.8 56-1.8 84"
                ></path>
                <path
                  fill="none"
                  stroke="rgba(72, 188, 184, 0.11)"
                  stroke-width="0.5"
                  stroke-linecap="round"
                  d="M10.8 0c2.8 28-5.2 56-2.2 84s4.8 56 1.8 84-5.8 56-2.8 84 4.8 56 1.8 84"
                ></path>
              </svg>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section class="lumos-cap" aria-labelledby="lumos-cap-sr-title">
      <h2 id="lumos-cap-sr-title" class="lumos-cap-sronly">Modül açıklamaları</h2>
      <div class="lumos-cap-grid">
        <article class="lumos-cap-card">
          <h3>Yayıncılık</h3>
          <p>
            Canlı ve kayıtlı yayın akışlarını tek çatıda toplar; hangi kaynağın nereye gittiği ve hangi adımda
            onay gerektiği sayfa üzerinde net görünür.
          </p>
        </article>
        <article class="lumos-cap-card">
          <h3>Medya</h3>
          <p>
            Ses, görüntü ve dosya işlerini cihazda düzenli tutar; önizleme ve dönüşümlerde küçük, kontrollü
            adımlarla dağınıklığı azaltır.
          </p>
        </article>
        <article class="lumos-cap-card">
          <h3>Yapay Zekâ</h3>
          <p>
            Metin ve görevlerde yardımcı öneriler sunar; nihai karar ve onay kullanıcıda kalır, süreç izlenebilir
            olur.
          </p>
        </article>
        <article class="lumos-cap-card">
          <h3>Kuantum</h3>
          <p>
            İleri güvenlik ve kriptografi yollarına uzun vadeli hazırlık düşüncesi taşır; bugünkü iş akışlarını
            süslemeden köprü rolünü vurgular.
          </p>
        </article>
        <article class="lumos-cap-card">
          <h3>Entegrasyon</h3>
          <p>
            Dış servislerle bağlantıları güvenli köprüler üzerinden kurar; sınırlar ve veri akışı gizlenmez,
            gerektiğinde durdurulabilir.
          </p>
        </article>
        <article class="lumos-cap-card">
          <h3>Kimlik</h3>
          <p>
            Oturum ve kimlik bilgilerini anlaşılır bir merkezde toplar; paylaşım ve yetki her zaman kullanıcı
            kontrolüyle başlar.
          </p>
        </article>
        <article class="lumos-cap-card">
          <h3>Güvenlik</h3>
          <p>
            Riskli veya kalıcı işlemlerde ek doğrulama ister; varsayılanı gizlilik ve minimum yüzey olarak
            ele alır.
          </p>
        </article>
        <article class="lumos-cap-card">
          <h3>Dünya</h3>
          <p>
            Dil, zaman dilimi ve küresel uç noktalarla uyumlu çalışır; tek cihazdan farklı bağlamlara erişimi
            düzenli tutmayı hedefler.
          </p>
        </article>
      </div>
    </section>

    <main style="max-width:40rem;margin:0 auto;padding:0 clamp(1rem, 4vw, 1.5rem) 3rem;">
      <article style="text-align:left;color:#e4e7ef;">
        <p style="margin:0 0 1rem;font-size:1.05rem;line-height:1.65;">
          Kıbrıs’tan dünyaya uzanan bu çağrı, sesi, medyayı, yapay zekâyı ve yönlendirilmiş görevleri tek akışta
          toplama niyetidir. Lumos; kullanıcı ile dijital dünya arasında bilinçli bir kontrol katmanı olarak
          tasarlanır: abartılı vaatlerin değil, daha görünür, daha sakin ve daha insani bir düzenin yolunu
          açmak için.
        </p>
        <p style="margin:0 0 1.75rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Bu açık mektup, ne kurduğumuzu olduğu kadar neyi reddettiğimizi de anlatır: belirsizliği,
          kontrolsüzlüğü ve insanı kendi aracının gerisine düşüren teknoloji anlayışını.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Lumos nedir?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Lumos; ses, metin, medya, kimlik, güvenlik ve yapay zekâ destekli görevleri tek bir akışta
          buluşturmayı hedefleyen bir kontrol katmanıdır. Kullanıcının yerine sahiplik iddia etmez; cihazın,
          verinin ve dış bağlantıların kullanıcı tarafından daha anlaşılır yönetilmesini sağlar. Amaç, çok
          özellik göstermek değil; karmaşık dijital işlemleri daha görünür, daha kontrollü ve daha insani bir
          düzene taşımaktır.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Kurulu olduğu cihazda ne sağlar?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Kurulu olduğu cihazda Lumos, yerel arayüz ve görev akışlarını toparlayan bir merkez gibi davranır.
          Gerektiğinde medya işleme, sohbet, yönlendirme, kimlik ve servis bağlantılarını güvenli köprülerle
          dış dünyaya açar. Silme, değiştirme, paylaşma veya dış servise gönderme gibi etkili işlemlerde
          kontrolün kullanıcıda kalmasını esas alır.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Kullanıcı Lumos ile ne kazanır?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Kullanıcı, dağınık araçlar arasında kaybolmak yerine tek bir sakin çalışma alanı kazanır. Ne yaptığını,
          neyin cihazda kaldığını, neyin dış servise gittiğini ve hangi adımda onay gerektiğini daha açık görür.
          Lumos’un değeri, insanı hızın peşinde ezmek değil; hızı, kontrol ve sorumlulukla birlikte kullanılabilir
          hale getirmektir.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Temel ilkeler
        </h2>
        <ul style="margin:0;padding-left:1.15rem;color:#c5cad6;font-size:0.98rem;line-height:1.55;">
          <li style="margin-bottom:0.5rem">Karar kullanıcıdadır.</li>
          <li style="margin-bottom:0.5rem">Güven görünür davranışla kurulur.</li>
          <li style="margin-bottom:0.5rem">Hız, kontrolün önüne geçmez.</li>
          <li style="margin-bottom:0.5rem">Dış bağlantılar gizlenmez; kullanıcı neyin nereye gittiğini bilmelidir.</li>
          <li style="margin-bottom:0.5rem">Yıkıcı veya kalıcı işlemler açık onay gerektirir.</li>
          <li style="margin-bottom:0.5rem">Teknoloji insanı küçültmek için değil, insanın alanını genişletmek için kullanılır.</li>
        </ul>
      </article>

      <section
        style="margin-top:2.75rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,0.1);font-size:0.8rem;color:#9aa4b5;text-align:left;line-height:1.55;"
        aria-label="API bağlantı testi"
      >
        <p style="margin:0 0 0.6rem;font-weight:600;color:#aeb6c8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;">
          API bağlantı testi
        </p>
        <p style="margin:0 0 0.7rem;">
          Canlı sunucuya tek bir mesaj gönderip yanıtı burada görebilirsiniz. Adres:
          <code style="color:#c8d0e0;font-size:0.78rem;">https://lumos-core-1.onrender.com/chat</code>
          — özel token kullanacaksanız build sırasında
          <code style="color:#c8d0e0;font-size:0.78rem;">PUBLIC_KANDO_TOKEN</code> tanımlayın.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
          <input
            id="msg"
            type="text"
            placeholder="Kısa bir test mesajı"
            style="flex:1;min-width:12rem;max-width:100%;padding:0.45rem 0.55rem;border-radius:8px;border:1px solid rgba(255,255,255,0.15);background:#12182a;color:#f2f2f2;font-size:0.8rem;"
          />
          <button
            type="button"
            id="api-test-send"
            style="padding:0.45rem 0.85rem;border-radius:8px;border:none;background:#2a3f6d;color:#fff;font-size:0.8rem;cursor:pointer;"
          >
            Gönder
          </button>
        </div>
        <pre
          id="out"
          role="status"
          aria-live="polite"
          aria-relevant="additions text"
          style="margin:0.65rem 0 0;padding:0.65rem 0.75rem;border-radius:10px;border:1px solid rgba(255,255,255,0.12);background:rgba(0,0,0,0.25);min-height:2.75rem;white-space:pre-wrap;word-break:break-word;font-size:0.8rem;color:#dce3f0;"
        ></pre>
      </section>
    </main>
    <script define:vars={{ CHAT_URL, kandoToken }}>
      function apiTestWire() {
        const btn = document.getElementById("api-test-send");
        const input = document.getElementById("msg");
        const out = document.getElementById("out");
        if (!btn || !input || !out) return;

        async function runApiTest() {
          const message = input.value.trim();
          if (!message) return;

          const label = btn.textContent;
          btn.disabled = true;
          btn.textContent = "Gönderiliyor...";
          out.textContent = "";
          try {
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify({ message }),
            });
            const text = await r.text();
            let data = null;
            try {
              data = text ? JSON.parse(text) : null;
            } catch {
              data = null;
            }
            if (r.ok) {
              const body =
                data && typeof data === "object"
                  ? JSON.stringify(data, null, 2)
                  : text || "(boş yanıt)";
              out.textContent = "Backend cevabı: " + body;
            } else {
              const detail =
                data && typeof data === "object"
                  ? JSON.stringify(data, null, 2)
                  : text || r.statusText;
              out.textContent = "Bağlantı hatası: HTTP " + r.status + " — " + detail;
            }
          } catch (e) {
            const msg = e instanceof Error ? e.message : String(e);
            out.textContent = "Bağlantı hatası: " + msg;
          } finally {
            btn.disabled = false;
            btn.textContent = label;
          }
        }

        btn.addEventListener("click", () => {
          void runApiTest();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter") return;
          e.preventDefault();
          void runApiTest();
        });
      }
      apiTestWire();
    </script>
  </body>
</html>
