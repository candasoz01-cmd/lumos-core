---
import "../styles/lumos-tokens.css";
import "../styles/umbrella-chrome.css";
import WeLockSiteNav from "../components/WeLockSiteNav.astro";
import WeLockSiteFooter from "../components/WeLockSiteFooter.astro";
import I18nInit from "../components/I18nInit.astro";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Lumos Lab — We Lock AI</title>
    <meta name="description" content="Lumos Lab: deneysel fikirlerin açık sınırlar ve kullanıcı kontrolüyle incelendiği alan." />
    <link rel="canonical" href="https://welockai.com/lab" />
    <link rel="icon" href="/lumos-tree-logo.svg" type="image/svg+xml" sizes="any" />
  </head>
  <body class="umbrella-page">
    <WeLockSiteNav active="lab" />
    <main class="umbrella-main">
      <p class="umbrella-eyebrow" data-i18n="umbrella.lab.eyebrow">LUMOS · LAB</p>
      <h1 data-i18n="umbrella.lab.title">Merakın güvenli çalışma alanı</h1>
      <p class="umbrella-lead" data-i18n="umbrella.lab.lead">Lab; kuantum hazırlığı, yapay zekâ değerlendirmeleri ve yeni etkileşim fikirlerinin ürün vaadine dönüşmeden önce ölçüldüğü deneysel alandır.</p>
      <div class="umbrella-visual"><img src="/lumos-world-map.jpg" alt="Lumos dünya vizyonunu temsil eden insan ve teknoloji sahnesi" /><p data-i18n="umbrella.lab.visual">Deneyler ayrı etiketlenir; sonuç, kaynak ve sınırlar görünür kalır.</p></div>
      <div class="umbrella-feature-grid">
        <article class="umbrella-feature-card"><h2 data-i18n="umbrella.lab.quantumTitle">Kuantum</h2><p data-i18n="umbrella.lab.quantumBody">Hazırlık ölçümü ve güvenli deneyler; abartılı gelecek vaadi yok.</p></article>
        <article class="umbrella-feature-card"><h2 data-i18n="umbrella.lab.aiTitle">AI karşılaştırma</h2><p data-i18n="umbrella.lab.aiBody">Kalite, maliyet, hız ve mahremiyet dengesi; sağlayıcı üstünlüğü dayatılmaz.</p></article>
        <article class="umbrella-feature-card"><h2 data-i18n="umbrella.lab.humanTitle">İnsan denetimi</h2><p data-i18n="umbrella.lab.humanBody">Deney sonucu öneridir; kritik karar kullanıcıda kalır.</p></article>
      </div>
      <div class="umbrella-actions"><a class="umbrella-btn umbrella-btn--primary" href="/panel" data-i18n="umbrella.lab.panelCta">Panelde incele</a><a class="umbrella-btn" href="/education" data-i18n="umbrella.lab.educationCta">Nasıl çalıştığını öğren</a></div>
    </main>
    <WeLockSiteFooter />
    <I18nInit />
  </body>
</html>
