{
  // TASLAK — henüz deploy edilmedi. Deploy ve secret kurucu işidir:
  //   wrangler secret put LUMOS_USAGE_GUARD_SECRET   (en az 32 karakter)
  //   wrangler deploy
  "$schema": "../cloudflare/node_modules/wrangler/config-schema.json",
  "name": "lumos-usage-guard",
  "account_id": "629f2cad718a754d9e96175641afd4a0",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageCounter" }]
  },
  // Ücretsiz plan yalnız SQLite tabanlı Durable Object'e izin verir.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageCounter"] }],
  "vars": {
    "LUMOS_USAGE_USER_PER_MINUTE": "10",
    "LUMOS_USAGE_USER_PER_DAY": "100",
    "LUMOS_USAGE_GLOBAL_PER_DAY": "2000"
  }
}
