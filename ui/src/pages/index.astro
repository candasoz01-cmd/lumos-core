---
import GlobalMay19Corner from "../components/GlobalMay19Corner.astro";

const GITHUB_REPO_URL = "https://github.com/candasoz01-cmd/lumos-core";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Lumos by We Lock AI</title>
    <meta
      name="description"
      content="Lumos, We Lock AI çatısı altında geliştirilen insan merkezli yapay zekâ kontrol katmanıdır."
    />
    <link rel="canonical" href="https://welockai.com/" />
    <meta property="og:title" content="Lumos by We Lock AI" />
    <meta
      property="og:description"
      content="Lumos, We Lock AI çatısı altında geliştirilen insan merkezli yapay zekâ kontrol katmanıdır."
    />
    <meta property="og:url" content="https://welockai.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content="https://welockai.com/lumos-world-map.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <link rel="icon" href="/lumos-logo-mark.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/lumos-logo-mark.svg" />
    <link rel="stylesheet" href="/styles/lumos-tokens.css" />
    <style>
      /**
       * Landing yüzeyi: çok koyu lacivert, elektrik mavisi çizgiler, altın vurgu.
       * `--lumos-land-teal` adı panel uyumu için kaldı; değerler mavi kanalıdır.
       */
      :root {
        --lumos-land-teal: 56 189 248;
        --lumos-land-teal-deep: 22 108 168;
        --lumos-land-warm: 218 188 124;
        --lumos-land-warm-deep: 176 142 88;
        /** Harita (lumos-world-map) ile aynı zemin — logo pad / kutu rengi */
        --lumos-map-canvas: #03060d;
        --lumos-land-page: #05070d;
        --lumos-land-title: #e8edf5;
      }
      html {
        scroll-behavior: smooth;
      }
      body.lumos-landing {
        margin: 0;
        min-height: 100vh;
        background-color: var(--lumos-land-page);
        background-image:
          radial-gradient(ellipse 130% 88% at 50% -6%, rgb(24 48 92 / 0.4), transparent 54%),
          radial-gradient(ellipse 88% 52% at 94% 38%, rgb(var(--lumos-land-teal) / 0.055), transparent 46%),
          radial-gradient(ellipse 72% 48% at 10% 72%, rgb(var(--lumos-land-warm) / 0.04), transparent 50%),
          linear-gradient(178deg, #02040a 0%, #070f1c 44%, #05070d 100%);
        background-attachment: fixed;
        color: #f0f4fa;
        font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, sans-serif;
        line-height: 1.6;
      }
      .lumos-site-nav {
        margin: 0 0 clamp(0.65rem, 1.8vw, 1rem);
        padding-bottom: clamp(0.5rem, 1.3vw, 0.72rem);
        border-bottom: 1px solid rgb(var(--lumos-land-teal) / 0.38);
        box-shadow: 0 1px 0 rgb(var(--lumos-land-warm-deep) / 0.14);
      }
      .lumos-site-nav__bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.45rem 0.65rem;
        flex-wrap: wrap;
      }
      .lumos-site-nav__corner {
        flex: 0 0 auto;
        padding-left: 0.35rem;
        padding-right: max(0.15rem, env(safe-area-inset-right, 0px));
      }
      .lumos-site-nav__list {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        flex: 1 1 auto;
        min-width: 0;
        gap: 0.25rem 0.65rem;
        margin: 0;
        padding: 0 0 2px;
        list-style: none;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: rgb(var(--lumos-land-teal) / 0.38) transparent;
      }
      .lumos-site-nav__list::-webkit-scrollbar {
        height: 4px;
      }
      .lumos-site-nav__list::-webkit-scrollbar-thumb {
        background: rgb(var(--lumos-land-teal) / 0.4);
        border-radius: 4px;
      }
      .lumos-site-nav__link {
        display: inline-block;
        flex-shrink: 0;
        padding: 0.32rem 0.48rem;
        font-size: clamp(0.7rem, 2.35vw, 0.85rem);
        font-weight: 600;
        letter-spacing: 0.02em;
        color: rgb(var(--lumos-land-teal) / 0.88);
        text-decoration: none;
        white-space: nowrap;
        border-radius: 8px;
        border: 1px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }
      .lumos-site-nav__link:hover,
      .lumos-site-nav__link:focus-visible {
        color: #a8dcff;
        border-color: rgb(var(--lumos-land-teal) / 0.38);
        background: rgba(14, 22, 32, 0.55);
      }
      .lumos-site-nav__link:focus-visible {
        outline: 2px solid rgb(var(--lumos-land-teal) / 0.45);
        outline-offset: 2px;
      }
      .lumos-site-nav__link--accent {
        color: rgba(236, 207, 147, 0.92);
      }
      .lumos-site-nav__link--accent:hover,
      .lumos-site-nav__link--accent:focus-visible {
        color: #f0dcb8;
        border-color: rgba(184, 148, 96, 0.42);
        background: rgba(24, 18, 12, 0.45);
      }
      .lumos-site-nav__brand {
        flex-shrink: 0;
        margin-right: 0.15rem;
      }
      .lumos-site-nav__logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        padding: 0.35rem;
        border-radius: 10px;
        border: 1px solid transparent;
        text-decoration: none;
        transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
      }
      .lumos-site-nav__logo:hover,
      .lumos-site-nav__logo:focus-visible {
        border-color: rgb(var(--lumos-land-teal) / 0.35);
        background: rgba(14, 22, 32, 0.45);
        box-shadow: 0 0 0 1px rgb(var(--lumos-land-warm-deep) / 0.12);
      }
      .lumos-site-nav__logo:focus-visible {
        outline: 2px solid rgb(var(--lumos-land-teal) / 0.45);
        outline-offset: 2px;
      }
      /** Lumos site logosu: özgün SVG marka (lumos-logo-mark.svg); hafif derinlik */
      .lumos-logo-mark {
        display: block;
        box-sizing: border-box;
        flex-shrink: 0;
        object-fit: contain;
        filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.45));
      }
      .lumos-site-nav__logo .lumos-logo-mark {
        width: 1.65rem;
        height: 1.65rem;
      }
      .lumos-hero-logo-box .lumos-logo-mark {
        width: clamp(3rem, 7vw, 3.45rem);
        height: clamp(3rem, 7vw, 3.45rem);
      }
      #modules,
      #dunya-hero,
      #dunya-vizyon {
        scroll-margin-top: 1.25rem;
      }
      /** Giriş: geniş Lumos kartı — sol metin, sağda düşük baskınlıkta dekoratif görsel */
      #giris.lumos-section {
        position: relative;
        isolation: isolate;
        padding-bottom: clamp(1.5rem, 3.5vw, 2.25rem);
      }
      #giris.lumos-section::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.5;
        background:
          repeating-linear-gradient(90deg, rgb(var(--lumos-land-teal) / 0.028) 0 1px, transparent 1px 72px),
          repeating-linear-gradient(0deg, rgb(var(--lumos-land-teal) / 0.022) 0 1px, transparent 1px 72px),
          radial-gradient(ellipse 52% 44% at 59% 32%, rgb(var(--lumos-land-teal-deep) / 0.16), transparent 62%),
          radial-gradient(ellipse 95% 55% at 48% 38%, rgb(var(--lumos-land-teal-deep) / 0.09), transparent 58%),
          radial-gradient(ellipse 70% 45% at 82% 72%, rgb(var(--lumos-land-warm) / 0.05), transparent 52%),
          radial-gradient(circle at 18% 62%, rgb(var(--lumos-land-teal) / 0.045), transparent 42%);
      }
      #giris.lumos-section > * {
        position: relative;
        z-index: 1;
      }
      #giris.lumos-section--tight-top {
        padding-top: clamp(0.8rem, 2vw, 1.15rem);
      }
      .lumos-hero-row {
        display: flex;
        align-items: stretch;
        flex: 1 1 auto;
        width: 100%;
        min-height: 0;
      }
      .lumos-hero-dna {
        flex: 0 0 13px;
        width: 13px;
        min-width: 13px;
        position: relative;
        pointer-events: none;
        opacity: 1;
      }
      .lumos-hero-dna svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      .lumos-hero-imgwrap {
        flex: 1 1 auto;
        min-width: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.1rem, 2.8vw, 1.75rem);
        align-items: start;
      }
      .lumos-hero-brand {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0;
        border-radius: 12px;
        padding: clamp(1.5rem, 3.6vw, 2.65rem) clamp(1rem, 3vw, 2.1rem);
        min-height: clamp(360px, 50vh, 620px);
        min-height: clamp(360px, 50svh, 620px);
        overflow: hidden;
        background:
          radial-gradient(ellipse 55% 48% at 58% 36%, rgb(var(--lumos-land-teal-deep) / 0.14), transparent 58%),
          radial-gradient(circle at 12% 18%, rgb(var(--lumos-land-teal-deep) / 0.18), transparent 42%),
          radial-gradient(circle at 85% 78%, rgb(var(--lumos-land-warm) / 0.14), transparent 44%),
          linear-gradient(165deg, #050810 0%, #0a1020 38%, #07060c 100%);
        border: 1px solid rgb(var(--lumos-land-teal) / 0.32);
        box-shadow:
          inset 0 1px 0 rgb(var(--lumos-land-warm) / 0.12),
          0 0 0 1px rgb(var(--lumos-land-warm-deep) / 0.22),
          0 10px 36px rgba(0, 0, 0, 0.58),
          0 0 28px rgb(var(--lumos-land-teal-deep) / 0.12),
          0 0 44px rgb(var(--lumos-land-warm) / 0.07);
      }
      .lumos-hero-copy {
        max-width: min(56rem, 100%);
        flex: 1 1 auto;
        min-width: 0;
      }
      .lumos-hero-title-stack {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: clamp(0.58rem, 1.6vw, 0.72rem);
        margin: 0 0 0.45rem;
      }
      @media (min-width: 480px) {
        .lumos-hero-title-stack {
          flex-direction: row;
          align-items: center;
          gap: clamp(1.1rem, 2.6vw, 1.45rem);
        }
      }
      .lumos-hero-title-stack .lumos-hero-title-page {
        margin-bottom: 0;
      }
      /** Başlık yanı: harita ile aynı zemin + hafif altın/camgöbeği hale */
      .lumos-hero-logo-box {
        box-sizing: border-box;
        width: clamp(72px, 8.5vw, 96px);
        height: clamp(72px, 8.5vw, 96px);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        padding: 0.12rem;
        border-radius: 50%;
        border: 1px solid rgb(var(--lumos-land-teal) / 0.22);
        background:
          radial-gradient(
            circle at 50% 42%,
            rgb(var(--lumos-land-teal) / 0.14) 0%,
            rgb(var(--lumos-land-teal-deep) / 0.06) 52%,
            var(--lumos-map-canvas) 100%
          );
        box-shadow:
          inset 0 0 0 1px rgb(var(--lumos-land-warm-deep) / 0.12),
          0 0 14px rgb(var(--lumos-land-teal) / 0.12),
          0 0 22px rgb(var(--lumos-land-warm) / 0.06);
      }
      .lumos-hero-title-page {
        margin: 0 0 0.45rem;
        font-size: clamp(2.35rem, 7vw, 3.85rem);
        line-height: 1.04;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--lumos-land-title);
        text-shadow:
          0 0 26px rgb(var(--lumos-land-teal) / 0.14),
          0 1px 0 rgb(255 255 255 / 0.14);
      }
      @supports ((-webkit-background-clip: text) or (background-clip: text)) {
        .lumos-hero-title-page {
          color: transparent;
          background-image: linear-gradient(
            168deg,
            #ffffff 0%,
            #e8eef8 32%,
            #a8b8d4 68%,
            #d4dce8 100%
          );
          -webkit-background-clip: text;
          background-clip: text;
          text-shadow: none;
        }
      }
      .lumos-hero-subtitle {
        margin: 0 0 1.05rem;
        max-width: 42ch;
        font-size: clamp(1.05rem, 2.65vw, 1.42rem);
        line-height: 1.42;
        font-weight: 600;
        color: #d9deea;
      }
      .lumos-hero-lead {
        margin: 0 0 1.35rem;
        max-width: 52ch;
        font-size: clamp(0.95rem, 2vw, 1.08rem);
        line-height: 1.62;
        color: #c9ced9;
      }
      /** Sağ: Project Lumos harita infografiği (lumos-world-map.jpg) — tam görünüm, kırpma yok */
      @media (min-width: 768px) {
        .lumos-hero-imgwrap {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(220px, 40vw);
          align-items: center;
          gap: clamp(1.35rem, 3vw, 2.5rem);
        }
      }
      @media (min-width: 1024px) {
        .lumos-hero-imgwrap {
          grid-template-columns: minmax(0, 1.02fr) minmax(260px, min(42vw, 460px));
          gap: clamp(1.5rem, 3.2vw, 2.75rem);
        }
      }
      @media (min-width: 1200px) {
        .lumos-hero-imgwrap {
          grid-template-columns: minmax(0, 1fr) minmax(300px, min(44vw, 480px));
        }
      }
      .lumos-hero-visual {
        position: relative;
        width: 100%;
        max-width: min(100%, 28rem);
        margin-left: auto;
        margin-right: auto;
        overflow: visible;
        pointer-events: none;
      }
      .lumos-hero-visual::before {
        content: "";
        position: absolute;
        inset: -5% -3% -3% -3%;
        border-radius: 50%;
        border: 1px solid rgb(var(--lumos-land-teal) / 0.18);
        box-shadow:
          0 0 0 1px rgb(var(--lumos-land-teal-deep) / 0.08),
          0 0 24px rgb(var(--lumos-land-teal-deep) / 0.06);
        opacity: 0.65;
        transform: rotate(-10deg);
        pointer-events: none;
        z-index: 0;
      }
      .lumos-hero-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 18px;
        background:
          radial-gradient(ellipse 70% 58% at 52% 38%, rgb(var(--lumos-land-teal) / 0.06), transparent 62%),
          radial-gradient(ellipse 55% 48% at 70% 72%, rgb(var(--lumos-land-warm) / 0.05), transparent 58%);
        mix-blend-mode: screen;
        opacity: 0.28;
        pointer-events: none;
        z-index: 2;
      }
      .lumos-hero-visual picture {
        display: block;
        position: relative;
        z-index: 1;
        width: 100%;
        aspect-ratio: 3 / 2;
        max-height: min(52vh, 520px);
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgb(var(--lumos-land-teal) / 0.28);
        box-shadow:
          inset 0 0 0 1px rgb(var(--lumos-land-warm-deep) / 0.12),
          0 12px 40px rgba(0, 0, 0, 0.45),
          0 0 32px rgb(var(--lumos-land-teal-deep) / 0.1);
        background: var(--lumos-map-canvas);
      }
      .lumos-hero-visual__img {
        display: block;
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center center;
        opacity: 1;
        border-radius: 0;
        filter: saturate(1.05) contrast(1.04);
        -webkit-mask-image: none;
        mask-image: none;
      }
      @media (min-width: 768px) {
        .lumos-hero-visual {
          max-width: none;
          width: 100%;
          margin: 0;
          justify-self: end;
        }
        .lumos-hero-visual picture {
          aspect-ratio: 3 / 2;
          max-height: min(58vh, 560px);
        }
      }
      @media (max-width: 767.98px) {
        .lumos-hero-visual {
          order: 2;
          width: 100%;
          max-width: min(26rem, 100%);
          margin-left: auto;
          margin-right: auto;
          overflow: hidden;
        }
        .lumos-hero-visual picture {
          max-height: min(72vw, 22rem);
        }
      }
      @media (max-width: 479.98px) {
        .lumos-hero-visual {
          max-width: min(100%, 24rem);
        }
      }
      @media (max-width: 559.98px) {
        .lumos-hero-dna {
          display: none;
        }
        #giris.lumos-section {
          padding-bottom: clamp(1.15rem, 3.2vw, 1.85rem);
        }
      }
      .lumos-dunya-hero {
        position: relative;
        isolation: isolate;
        padding-top: clamp(0.5rem, 1.5vw, 0.85rem);
        padding-bottom: clamp(1.15rem, 2.8vw, 1.85rem);
      }
      .lumos-dunya-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.4;
        background:
          radial-gradient(ellipse 72% 58% at 58% 36%, rgb(var(--lumos-land-teal-deep) / 0.12), transparent 58%),
          repeating-linear-gradient(90deg, rgb(var(--lumos-land-teal) / 0.022) 0 1px, transparent 1px 56px),
          repeating-linear-gradient(0deg, rgb(var(--lumos-land-teal) / 0.018) 0 1px, transparent 1px 56px);
      }
      .lumos-dunya-hero > * {
        position: relative;
        z-index: 1;
      }
      .lumos-dunya-hero__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.15rem, 2.8vw, 1.85rem);
        align-items: center;
      }
      @media (min-width: 880px) {
        .lumos-dunya-hero__grid {
          grid-template-columns: minmax(0, 1.05fr) minmax(220px, 0.95fr);
          gap: clamp(1.35rem, 3.2vw, 2.5rem);
        }
      }
      .lumos-dunya-hero h2 {
        margin: 0 0 0.6rem;
        font-size: clamp(1.75rem, 3.8vw, 2.25rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--lumos-accent-gold);
        line-height: 1.15;
        padding-bottom: 0.45rem;
        border-bottom: 1px solid rgb(var(--lumos-land-teal) / 0.26);
        box-shadow: 0 1px 0 rgb(var(--lumos-land-warm-deep) / 0.18);
      }
      .lumos-dunya-hero__copy > p {
        margin: 0 0 0.75rem;
        font-size: 0.98rem;
        line-height: 1.62;
        color: var(--lumos-text-muted, #c9ced9);
        max-width: 54ch;
      }
      .lumos-dunya-hero__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem 0.5rem;
        margin: 0.25rem 0 0;
        font-size: 0.88rem;
      }
      .lumos-dunya-hero__sep {
        color: rgba(158, 168, 184, 0.45);
        user-select: none;
      }
      .lumos-dunya-hero__link {
        color: var(--lumos-accent-blue);
        font-weight: 600;
        text-decoration: none;
        border-bottom: 1px solid var(--lumos-accent-blue-soft);
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .lumos-dunya-hero__link:hover,
      .lumos-dunya-hero__link:focus-visible {
        color: var(--lumos-accent-blue-bright);
        border-bottom-color: rgb(var(--lumos-land-warm) / 0.55);
      }
      .lumos-dunya-hero__link:focus-visible {
        outline: 2px solid var(--lumos-accent-blue-soft);
        outline-offset: 2px;
        border-radius: 2px;
      }
      .lumos-dunya-hero__link--subtle {
        color: rgb(var(--lumos-land-teal) / 0.95);
        border-bottom-color: rgb(var(--lumos-land-teal) / 0.35);
      }
      .lumos-dunya-hero__link--subtle:hover,
      .lumos-dunya-hero__link--subtle:focus-visible {
        color: #b8e7ff;
        border-bottom-color: rgb(var(--lumos-land-warm) / 0.42);
      }
      .lumos-dunya-hero__figure {
        margin: 0;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid transparent;
        background: var(--lumos-map-canvas);
        background-image:
          linear-gradient(145deg, var(--lumos-accent-blue-soft), rgb(var(--lumos-land-warm) / 0.28));
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.06),
          inset 0 0 60px rgba(0, 0, 0, 0.28),
          0 12px 40px rgba(0, 0, 0, 0.48),
          0 0 0 1px rgb(var(--lumos-land-teal-deep) / 0.2);
      }
      .lumos-dunya-hero__figure img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 3 / 2;
        object-fit: contain;
        object-position: center center;
      }
      .lumos-shell {
        box-sizing: border-box;
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 clamp(0.65rem, 2vw, 1.25rem);
      }
      .lumos-section {
        scroll-margin-top: 1.25rem;
        padding: clamp(1rem, 2.5vw, 1.55rem) 0;
      }
      .lumos-section--tight-top {
        padding-top: clamp(0.45rem, 1.2vw, 0.75rem);
      }
      .lumos-section h2 {
        margin: 0 0 0.75rem;
