    </div>
    <script define:vars={{ CHAT_URL, kandoToken, UPLOAD_URL, HEALTH_URL, BRIDGE_BASE_URL, STATUS_URL }}>
      /** Görevler sekmesi ile sohbet görev komutları tek diziyi paylaşır (wireGorevlerPrototype). Kalıcılık: tarayıcı localStorage. */
      const PANEL_GOREVLER_LS_KEY = "lumos_panel_gorevler_list_v1";
      const GOREVLER_FIELD_MAX_LEN = 2048;

      function truncateGorevlerField(s) {
        const t = String(s || "").trim();
        if (!t) return "";
        return t.length > GOREVLER_FIELD_MAX_LEN
          ? t.slice(0, GOREVLER_FIELD_MAX_LEN) + "…"
          : t;
      }

      const defaultGorevlerSeed = [
        { title: "Panel API durumunu kontrol et", priority: "orta", status: "onay_bekliyor" },
        { title: "Güvenlik sekmesini gözden geçir", priority: "dusuk", status: "tamamlandi" },
      ];

      function sanitizeBridgeLast(bl) {
        if (!bl || typeof bl !== "object") return null;
        const src = /** @type {Record<string, unknown>} */ (bl);
        const isoRaw = String(
          src.lastBridgeAt != null ? src.lastBridgeAt : src.last_bridge_at != null ? src.last_bridge_at : "",
        ).trim();
        const isoOk = isoRaw && !Number.isNaN(Date.parse(isoRaw));
        const out = {};
        if (isoOk) out.lastBridgeAt = isoRaw;
        for (const k of ["route", "source"]) {
          const raw = src[k];
          const v = truncateGorevlerField(raw != null ? String(raw) : "");
          if (v) out[k] = v;
        }
        for (const [outKey, aliases] of [
          ["result_file", ["result_file", "resultFile"]],
          ["execution_file", ["execution_file", "executionFile"]],
        ]) {
          let raw = null;
          for (const a of aliases) {
            if (src[a] != null && String(src[a]).trim()) {
              raw = src[a];
              break;
            }
          }
          const v = truncateGorevlerField(raw != null ? String(raw) : "");
          if (v) out[outKey] = v;
        }
        if (src.accepted === true || src.accepted === false) out.accepted = src.accepted;
        const has =
          !!out.lastBridgeAt ||
          !!out.route ||
          !!out.source ||
          !!out.result_file ||
          !!out.execution_file ||
          out.accepted !== undefined;
        return has ? out : null;
      }

      function sanitizeGorevlerRow(x) {
        if (!x || typeof x !== "object") return null;
        const title = String(x.title || "").trim();
        if (!title) return null;
        const pr = ["dusuk", "orta", "yuksek"].includes(x.priority) ? x.priority : "orta";
        const st = ["bekliyor", "onay_bekliyor", "tamamlandi"].includes(x.status) ? x.status : "bekliyor";
        const row = { title, priority: pr, status: st };
        const w = x.when != null ? String(x.when).trim() : "";
        if (w) row.when = w;
        const bridge = sanitizeBridgeLast(x.bridgeLast);
        if (bridge) row.bridgeLast = bridge;
        return row;
      }

      function loadPanelGorevlerTasksFromStorage() {
        try {
          if (typeof localStorage === "undefined") return undefined;
          const raw = localStorage.getItem(PANEL_GOREVLER_LS_KEY);
          if (raw == null || raw === "") return undefined;
          const a = JSON.parse(raw);
          if (!Array.isArray(a)) return [];
          const out = [];
          for (let i = 0; i < a.length; i++) {
            const r = sanitizeGorevlerRow(a[i]);
            if (r) out.push(r);
          }
          return out;
        } catch {
          return [];
        }
      }

      function persistPanelGorevlerTasks() {
        try {
          if (typeof localStorage === "undefined") return;
          localStorage.setItem(PANEL_GOREVLER_LS_KEY, JSON.stringify(panelGorevlerTasks));
        } catch (_) {
          /* kota / gizli mod */
        }
      }

      const storedGorevler = loadPanelGorevlerTasksFromStorage();
      const panelGorevlerTasks =
        storedGorevler === undefined ? defaultGorevlerSeed.slice() : storedGorevler;

      if (storedGorevler === undefined) {
        persistPanelGorevlerTasks();
      }

      let panelGorevlerTasksRender = null;

      /** @typedef {{ title: string, whenSummary: string | null }} PanelGorevKomut */

      function pad2(n) {
        const x = String(Number(n));
        return x.length >= 2 ? x : "0" + x;
      }

      /** Kullanıcı yazımı: gorev/yarain/saar vb. — ayrıştırmadan önce tek satırda düzeltir. */
      function normalizeUserTaskMessage(s) {
        return String(s || "")
          .replace(/\bgorev\b/gi, "görev")
          .replace(/\bolustur\b/gi, "oluştur")
          .replace(/\byarain\b/gi, "yarın")
          .replace(/\byarin\b/gi, "yarın")
          .replace(/\bsaar\b/gi, "saat")
          .replace(/\bbugun\b/gi, "bugün");
      }

      /** Lumos metninden Görev:/Tarih:/Saat: satırları (ekleyemiyorum densene çalışır). */
      function parsePanelGorevFromAssistantReply(raw) {
        const t = String(raw || "")
          .replace(/\*\*/g, "")
          .replace(/\r\n/g, "\n")
          .trim();
        if (!t) return null;
        const g = /(?:^|\n)\s*Görev\s*:\s*([^\n]+)/i.exec(t);
        if (!g) return null;
        const title = g[1].trim().replace(/^>\s*/, "");
        if (!title) return null;
        const parts = [];
        const d = /(?:^|\n)\s*Tarih\s*:\s*([^\n]+)/i.exec(t);
        if (d) {
          const dl = d[1].trim().toLocaleLowerCase("tr-TR");
          if (/\byarın\b|\byarin\b|\byarain\b/.test(dl)) parts.push("Yarın");
          else if (/\bbugün\b|\bbugun\b/.test(dl)) parts.push("Bugün");
          else if (d[1].trim()) parts.push(d[1].trim());
        }
        const st = /(?:^|\n)\s*Saat\s*:\s*([^\n]+)/i.exec(t);
        if (st) {
          const sx = st[1].trim();
          const tm = /^(\d{1,2})(?:\s*[:.]\s*(\d{2}))?$/.exec(sx);
          if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
          else parts.push(sx);
        }
        const whenSummary = parts.length ? parts.join(" ") : null;
        return { title, whenSummary };
      }

      function panelGorevRowExists(title, whenSummary) {
        const w = whenSummary || null;
        return panelGorevlerTasks.some((x) => x.title === title && (x.when || null) === w);
      }

      /**
       * Onay sorusu / dış uygulama uyarısı içeren Lumos metninden mini görev başlığı.
       * Örn: Mini görev olarak 'tiss' eklemek istiyorsun, doğru mu?
       */
      function parsePanelGorevLooseFromAssistant(raw) {
        const t = String(raw || "").replace(/\*\*/g, "").replace(/\r\n/g, "\n");
        const m =
          /mini\s+görev\s+olarak\s+['"'‘’«\u201c](.+?)['"'‘’»\u201d]/i.exec(t);
        if (!m) return null;
        const title = m[1].trim();
        return title ? { title, whenSummary: null, replyKind: "mini" } : null;
      }

      /** Asistan cevabından yerel listeye aktarır; mini onay cümlelerinde sohbet metnini kısaltır. */
      function ingestAssistantPanelGorev(replyBody) {
        let cmd = parsePanelGorevFromAssistantReply(replyBody);
        if (cmd) {
          const w = cmd.whenSummary || null;
          if (!panelGorevRowExists(cmd.title, w)) applyPanelGorevKomutu(cmd);
          return { lumosText: String(replyBody || "").trim() };
        }
        const loose = parsePanelGorevLooseFromAssistant(replyBody);
        if (loose) {
          const w = loose.whenSummary || null;
          if (!panelGorevRowExists(loose.title, w)) {
            applyPanelGorevKomutu({ title: loose.title, whenSummary: loose.whenSummary || null });
          }
          if (loose.replyKind === "mini") {
            return { lumosText: `Mini görev eklendi: ${loose.title}` };
          }
        }
        return { lumosText: String(replyBody || "").trim() };
      }

      /**
       * "görev oluştur …" kuyruğundan başlık + Yarın 14:00 benzeri özet (yarain/saar toleranslı).
       */
      function parseOlusturRest(restRaw) {
        const rest = normalizeUserTaskMessage(String(restRaw || "").trim());
        if (!rest) return { title: "", whenSummary: null };
        const parts = [];
        if (/\byarın\b/i.test(rest)) parts.push("Yarın");
        else if (/\bbugün\b/i.test(rest)) parts.push("Bugün");
        const tm = /\bsaat\s*(\d{1,2})(?:\s*[:.]\s*(\d{2}))?\b/i.exec(rest);
        if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
        let titleWork = rest
          .replace(/\byarın\b/gi, " ")
          .replace(/\bbugün\b/gi, " ")
          .replace(/\bsaat\s*\d{1,2}(?:\s*[:.]\s*\d{2})?\b/gi, " ")
          .replace(/\s+/g, " ")
          .trim();
        if (!titleWork) titleWork = normalizeUserTaskMessage(String(restRaw || "").trim());
        const whenSummary = parts.length ? parts.join(" ") : null;
        return { title: titleWork, whenSummary };
      }

      /**
       * "yarın saat 14:00" / "bugün 09:30" vb. önekten görünen özet üretir (chat + liste).
       */
      function parseSchedulePrefix(prefixRaw) {
        const prefix = normalizeUserTaskMessage(String(prefixRaw || "").trim());
        if (!prefix) return { whenSummary: null };
        const pl = prefix.toLocaleLowerCase("tr-TR");
        const parts = [];
        if (/\byarın\b|\byarain\b|\byarin\b/i.test(prefix)) parts.push("Yarın");
        else if (/\bbugün\b|\bbugun\b/i.test(prefix)) parts.push("Bugün");
        const tm = /(?:saat\s*)?(\d{1,2})(?:\s*[:.]\s*(\d{2}))?\b/.exec(pl);
        if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
        const whenSummary = parts.length ? parts.join(" ") : prefix;
        return { whenSummary };
      }

      /** NBSP / büyük-küçük harf / birleşik Unicode — komut satırını tek forma çeker. */
      function canonicalizeTaskInput(raw) {
        let s = String(raw || "")
          .replace(/\u00a0/g, " ")
          .normalize("NFKC")
          .trim();
        s = normalizeUserTaskMessage(s);
        s = s.toLocaleLowerCase("tr-TR").replace(/\s+/g, " ").trim();
        return s;
      }

      /**
       * mini görev ekle … | görev oluştur … | … görev ekle … (isteğe bağlı tarih/saat öneki).
       * accepted / onay beklemez; yalnızca yerel liste ile bağlar.
       */
      function parsePanelGorevKomutu(raw) {
        const s0 = String(raw || "").trim();
        if (!s0) return null;
        const s = canonicalizeTaskInput(s0);

        let m = /^\s*mini\s+görev\s+ekle\s+(.+)$/i.exec(s);
        if (m) {
          const title = m[1].trim();
          return title ? { title, whenSummary: null, replyKind: "mini" } : null;
        }

        m = /^\s*görev\s+oluştur\s+(.+)$/i.exec(s);
        if (m) {
          const { title, whenSummary } = parseOlusturRest(m[1]);
          return title ? { title, whenSummary } : null;
        }

        m = /^\s*(?:([\s\S]*?)\s+)?görev\s+ekle\s+(.+)$/i.exec(s);
        if (!m) return null;
        const pre = (m[1] || "").trim();
        const title = (m[2] || "").trim();
        if (!title) return null;
        const { whenSummary } = parseSchedulePrefix(pre);
        return { title, whenSummary };
      }

      function buildPanelGorevConfirmation(cmd) {
        if (cmd.replyKind === "mini") return `Mini görev eklendi: ${cmd.title}`;
        return cmd.whenSummary
          ? `Görev eklendi: ${cmd.title} — ${cmd.whenSummary}`
          : `Görev eklendi: ${cmd.title}`;
      }

      function applyPanelGorevKomutu(cmd) {
        const row = {
          title: cmd.title,
          priority: "orta",
          status: "bekliyor",
        };
        if (cmd.whenSummary) row.when = cmd.whenSummary;
        panelGorevlerTasks.push(row);
        persistPanelGorevlerTasks();
        if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
      }

      function wirePanel() {
        const nav = document.querySelector(".panel-body");
        const panels = document.querySelectorAll("[data-module-panel]");
        const sendBtn = document.getElementById("panel-send");
        const sendLabelEl = sendBtn?.querySelector(".chat-compose-send__label");
        const input = document.getElementById("panel-msg");
        const thread = document.getElementById("chat-thread");
        if (!nav || !sendBtn || !input || !thread) return;

        function expandNavGroupIfActiveHidden() {
          const active = nav.querySelector('button[data-module][aria-current="true"]');
          if (!active) return;
          const items = active.closest(".panel-nav-group-items");
          if (!items || !items.hasAttribute("hidden")) return;
          items.removeAttribute("hidden");
          const collapsible = items.closest(".panel-nav-collapsible");
          const toggle = collapsible?.querySelector(".panel-nav-group-toggle");
          if (toggle) toggle.setAttribute("aria-expanded", "true");
        }
        expandNavGroupIfActiveHidden();

        const vv = window.visualViewport;
        if (vv) {
          let vvTimer = 0;
          const onVisualViewportMove = () => {
            if (vvTimer) return;
            vvTimer = window.setTimeout(() => {
              vvTimer = 0;
              const se = document.scrollingElement;
              const docSl = Math.max(
                document.documentElement.scrollLeft || 0,
                document.body.scrollLeft || 0,
                se ? se.scrollLeft || 0 : 0,
              );
              const offL = vv.offsetLeft;
              if ((offL !== 0 && Number.isFinite(offL)) || docSl > 0) {
                window.scrollTo(0, window.scrollY);
                if (se) se.scrollLeft = 0;
                document.documentElement.scrollLeft = 0;
                document.body.scrollLeft = 0;
              }
            }, 100);
          };
          vv.addEventListener("resize", onVisualViewportMove, { passive: true });
          vv.addEventListener("scroll", onVisualViewportMove, { passive: true });
        }

        nav.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLElement)) return;
          const groupToggle = t.closest(".panel-nav-group-toggle");
          if (groupToggle) {
            const expanded = groupToggle.getAttribute("aria-expanded") === "true";
            const next = !expanded;
            groupToggle.setAttribute("aria-expanded", next ? "true" : "false");
            const cid = groupToggle.getAttribute("aria-controls");
            const panel = cid ? document.getElementById(cid) : null;
            if (panel) {
              if (next) panel.removeAttribute("hidden");
              else panel.setAttribute("hidden", "");
            }
            return;
          }
          const btn = t.closest("button[data-module]");
          if (!btn) return;
          const id = btn.getAttribute("data-module");
          if (!id) return;
          nav.querySelectorAll("button[data-module]").forEach((b) => {
            b.setAttribute("aria-current", b === btn ? "true" : "false");
          });
          panels.forEach((p) => {
            p.setAttribute("data-active", p.getAttribute("data-module-panel") === id ? "true" : "false");
          });
        });

        const sendLabel = "Gönder";
        const loadingLabel = "Gönderiliyor…";
        const CHAT_HISTORY_LIMIT = 12;
        let sending = false;

        const cameraBtn = document.getElementById("panel-camera-input");
        const cameraHint = document.getElementById("panel-camera-hint");
        const sendHint = document.getElementById("panel-send-hint");
        const cameraPhotoInput = /** @type {HTMLInputElement | null} */ (document.getElementById("panel-camera-photo-input"));
        const cameraPhotoPreview = /** @type {HTMLImageElement | null} */ (document.getElementById("panel-camera-photo-preview"));
        const cameraPhotoStatus = document.getElementById("panel-camera-photo-status");
        const cameraPreviewWrap = document.getElementById("panel-camera-preview-wrap");
        const mqPanelCameraMobile = window.matchMedia("(max-width: 767.98px)");
        /** @type {string | null} */
        let cameraPhotoObjectUrl = null;

        function setCameraHint(msg) {
          if (!cameraHint) return;
          cameraHint.textContent = msg;
          cameraHint.hidden = !msg;
        }

        function setSendHint(msg) {
          if (!sendHint) return;
          sendHint.textContent = msg;
          sendHint.hidden = !msg;
        }

        function revokeCameraPhotoObjectUrl() {
          if (!cameraPhotoObjectUrl) return;
          try {
            URL.revokeObjectURL(cameraPhotoObjectUrl);
          } catch {
            /* ignore */
          }
          cameraPhotoObjectUrl = null;
        }

        function syncPanelCameraPhotoBarVisibility() {
          const has = !!cameraPhotoObjectUrl;
          if (!cameraPreviewWrap) return;
          cameraPreviewWrap.hidden = !has;
        }

        function clearPanelCameraPhotoSelection() {
          revokeCameraPhotoObjectUrl();
          if (cameraPhotoPreview) {
            cameraPhotoPreview.onload = null;
            cameraPhotoPreview.removeAttribute("src");
            cameraPhotoPreview.removeAttribute("title");
            cameraPhotoPreview.alt = "";
            cameraPhotoPreview.hidden = true;
          }
          if (cameraPhotoInput) cameraPhotoInput.value = "";
          if (cameraPhotoStatus) cameraPhotoStatus.textContent = "Fotoğraf bekleniyor";
          if (cameraBtn) {
            cameraBtn.classList.remove("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "false");
          }
          syncPanelCameraPhotoBarVisibility();
        }

        function bindCameraPhotoFromFile(file) {
          if (!file || !/^image\//.test(file.type)) {
            setCameraHint("Lütfen bir görsel dosyası seçin.");
            return;
          }
          setCameraHint("");
          revokeCameraPhotoObjectUrl();
          try {
            cameraPhotoObjectUrl = URL.createObjectURL(file);
          } catch {
            setCameraHint("Önizleme oluşturulamadı.");
            return;
          }
          const name = file.name && String(file.name).trim();
          if (cameraPhotoPreview) {
            cameraPhotoPreview.hidden = true;
            const label = name ? name : "Seçilen görsel";
            cameraPhotoPreview.alt = label;
            cameraPhotoPreview.title = label;
            cameraPhotoPreview.onload = () => {
              cameraPhotoPreview.hidden = false;
            };
            cameraPhotoPreview.src = cameraPhotoObjectUrl;
          }
          if (cameraPhotoStatus) {
            cameraPhotoStatus.textContent = name ? name : "Fotoğraf alındı";
          }
          if (cameraBtn) {
            cameraBtn.classList.add("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "true");
          }
          syncPanelCameraPhotoBarVisibility();
        }

        function escapeHtml(s) {
          return String(s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        function formatAssistantHtml(raw) {
          let s = escapeHtml(String(raw));
          s = s.replace(/\*\*([\s\S]+?)\*\*/g, "<strong>$1</strong>");
          s = s.replace(/\*\*/g, "");
          s = s.replace(/\n/g, "<br />");
          return s;
        }

        /** Lumos gövdesinden (strong, br) backend geçmişi için düz metin üretir. */
        function lumosBodyToPlainText(root) {
          const out = [];
          function walk(n) {
            if (n.nodeType === Node.TEXT_NODE) out.push(n.textContent);
            else if (n.nodeType === Node.ELEMENT_NODE) {
              const el = /** @type {Element} */ (n);
              if (el.tagName === "BR") out.push("\n");
              else el.childNodes.forEach(walk);
            }
          }
          walk(root);
          return out.join("").trim();
        }

        /** Mevcut iplikten (yeni kullanıcı mesajı eklenmeden önce) son N mesajı role/content olarak döner. */
        function collectThreadHistory(threadEl) {
          const nodes = threadEl.querySelectorAll(".chat-msg");
          const items = [];
          for (const wrap of nodes) {
            let role;
            if (wrap.classList.contains("chat-msg--user")) role = "user";
            else if (wrap.classList.contains("chat-msg--lumos")) role = "assistant";
            else continue;
            const body = wrap.querySelector(".chat-msg-body");
            let text = "";
            if (role === "assistant" && body) {
              text = lumosBodyToPlainText(body);
            } else if (body && body.textContent) {
              text = body.textContent.trim();
            }
            if (!text) continue;
            items.push({ role, content: text });
          }
          if (items.length <= CHAT_HISTORY_LIMIT) return items;
          return items.slice(-CHAT_HISTORY_LIMIT);
        }

        function appendBubble(kind, text) {
          const turn = document.createElement("div");
          turn.className =
            "chat-turn " +
            (kind === "user" ? "chat-turn--user" : kind === "error" ? "chat-turn--error" : "chat-turn--lumos");

          const wrap = document.createElement("div");
          wrap.className =
            "chat-msg " +
            (kind === "user" ? "chat-msg--user" : kind === "error" ? "chat-msg--error" : "chat-msg--lumos");
          const role = document.createElement("span");
          role.className = "chat-msg-role";
          role.textContent = kind === "user" ? "Sen" : kind === "error" ? "Uyarı" : "Lumos";
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          if (kind === "lumos") {
            body.innerHTML = formatAssistantHtml(text);
          } else {
            body.textContent = text;
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        /**
         * /chat: JSON gövdesi; isteğe bağlı küçük görsel base64 (tavan backend ile uyumlu).
         * Ham bayt tavanı 256 KiB — üzerinde yalnızca photo* metadata gider.
         */
        const PANEL_CHAT_IMAGE_INLINE_MAX_BYTES = 256 * 1024;

        /** Sunucunun `Buffer.from(b64, "base64")` uzunluğu ile aynı: ham bayt sayısı. */
        function decodedByteLengthFromBase64(b64) {
          if (!b64) return 0;
          let pad = 0;
          if (b64.endsWith("==")) pad = 2;
          else if (b64.endsWith("=")) pad = 1;
          return Math.floor((b64.length * 3) / 4) - pad;
        }

        /** Yerel önizleme (data URL); sunucuya ayrıca şartlara uygunsa imageData olarak gider. */
        function readFileAsDataUrl(file) {
          return new Promise((resolve, reject) => {
            const fr = new FileReader();
            fr.onload = () => resolve(String(fr.result || ""));
            fr.onerror = () => reject(new Error("read failed"));
            fr.readAsDataURL(file);
          });
        }

        /** data:image/...;base64, sonrası — tavan ve MIME image/ iken kullanılır. */
        function dataUrlToInlineBase64ForChat(dataUrl, file) {
          if (!dataUrl || !file || !/^image\//.test(file.type)) return null;
          if (file.size > PANEL_CHAT_IMAGE_INLINE_MAX_BYTES) return null;
          const marker = "base64,";
          const i = dataUrl.indexOf(marker);
          if (i < 0) return null;
          const b64 = dataUrl.slice(i + marker.length).replace(/\s/g, "");
          if (!b64) return null;
          if (decodedByteLengthFromBase64(b64) > PANEL_CHAT_IMAGE_INLINE_MAX_BYTES) return null;
          return b64;
        }

        /**
         * Orijinal dosyayı sıkıştırıp ham base64 (data: öneki yok) üretir; `PANEL_CHAT_IMAGE_INLINE_MAX_BYTES` altına indiremezse null.
         * null iken mevcut davranış: `photo*` metadata gider, `imageData` gönderilmez.
         */
        async function compressPhotoFileForChat(file) {
          if (!file || !/^image\//.test(file.type)) return null;
          const cap = PANEL_CHAT_IMAGE_INLINE_MAX_BYTES;
          const maxSide = 1024;

          let bmp;
          try {
            bmp = await createImageBitmap(file);
          } catch {
            return null;
          }

          const iw = bmp.width;
          const ih = bmp.height;
          if (!iw || !ih) {
            try {
              bmp.close();
            } catch {
              /* ignore */
            }
            return null;
          }

          const canvas = document.createElement("canvas");
          const ctx = canvas.getContext("2d");
          if (!ctx) {
            try {
              bmp.close();
            } catch {
              /* ignore */
            }
            return null;
          }

          let dimScale = Math.min(1, maxSide / Math.max(iw, ih));
          let quality = 0.7;
          const minQuality = 0.25;
          const maxAttempts = 28;

          for (let attempt = 0; attempt < maxAttempts; attempt++) {
            const w = Math.max(1, Math.round(iw * dimScale));
            const h = Math.max(1, Math.round(ih * dimScale));
            canvas.width = w;
            canvas.height = h;
            ctx.drawImage(bmp, 0, 0, w, h);

            const blob = await new Promise((resolve) => {
              canvas.toBlob((b) => resolve(b), "image/jpeg", quality);
            });
            if (blob && blob.size <= cap) {
              let b64 = "";
              try {
                b64 = await new Promise((resolve, reject) => {
                  const fr = new FileReader();
                  fr.onload = () => {
                    const s = String(fr.result || "");
                    const marker = "base64,";
                    const j = s.indexOf(marker);
                    resolve(j >= 0 ? s.slice(j + marker.length).replace(/\s/g, "") : "");
                  };
                  fr.onerror = () => reject(new Error("blob read"));
                  fr.readAsDataURL(blob);
                });
              } catch {
                b64 = "";
              }
              try {
                bmp.close();
              } catch {
                /* ignore */
              }
              /* blob.size = decode edilen JPEG baytı; backend tavanı ile aynı ölçü. */
              if (b64 && decodedByteLengthFromBase64(b64) <= cap) return b64;
              return null;
            }

            if (quality > minQuality) {
              quality = Math.max(minQuality, quality - 0.08);
            } else {
              dimScale *= 0.9;
              quality = 0.55;
            }
            if (Math.round(iw * dimScale) < 8 || Math.round(ih * dimScale) < 8) {
              try {
                bmp.close();
              } catch {
                /* ignore */
              }
              return null;
            }
          }

          try {
            bmp.close();
          } catch {
            /* ignore */
          }
          return null;
        }

        /** Kullanıcı balonu: düz metin ve isteğe bağlı yerel görsel (sunucu ikili almaz). */
        function appendUserComposeBubble(plainText, imageDataUrl) {
          const turn = document.createElement("div");
          turn.className = "chat-turn chat-turn--user";
          const wrap = document.createElement("div");
          wrap.className = "chat-msg chat-msg--user";
          const role = document.createElement("span");
          role.className = "chat-msg-role";
          role.textContent = "Sen";
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          const trimmed = plainText && String(plainText).trim();
          if (trimmed) {
            const textEl = document.createElement("div");
            textEl.textContent = trimmed;
            body.appendChild(textEl);
          }
          if (imageDataUrl) {
            if (!trimmed) {
              const cap = document.createElement("div");
              cap.textContent = "Fotoğraf eklendi";
              body.appendChild(cap);
            }
            const img = document.createElement("img");
            img.src = imageDataUrl;
            img.alt = "";
            img.decoding = "async";
            img.style.maxWidth = "100%";
            img.style.borderRadius = "8px";
            img.style.display = "block";
            img.style.marginTop = trimmed ? "8px" : "6px";
            body.appendChild(img);
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        function resetPanelHorizontalScrollAfterInputBlur() {
          const y = window.scrollY;
          try {
            window.scrollTo({ left: 0, top: y, behavior: "instant" });
          } catch {
            try {
              window.scrollTo({ left: 0, top: y, behavior: "auto" });
            } catch {
              window.scrollTo(0, y);
            }
          }
          const se = document.scrollingElement;
          if (se) se.scrollLeft = 0;
          document.documentElement.scrollLeft = 0;
          document.body.scrollLeft = 0;
        }

        function summarizeClientFetchError(err) {
          if (err == null) return "Bilinmeyen hata";
          if (typeof err === "object" && err !== null && typeof err.message === "string" && err.message) {
            return err.message;
          }
          return String(err);
        }

        async function runSend() {
          const message = input.value.trim();
          const photoFile =
            cameraPhotoInput && cameraPhotoInput.files && cameraPhotoInput.files[0]
              ? cameraPhotoInput.files[0]
              : null;
          const hasPhoto = !!(photoFile && /^image\//.test(photoFile.type));
          if ((!message && !hasPhoto) || sending) return;

          setSendHint("");
          if (!hasPhoto) {
            showPanelChatPhotoTech("");
          }

          let imageDataUrlForBubble = null;
          if (hasPhoto) {
            try {
              imageDataUrlForBubble = await readFileAsDataUrl(photoFile);
            } catch {
              setSendHint("Fotoğraf okunamadı.");
              return;
            }
          }

          const outgoingMessage = message;
          const panelGorevCmd = parsePanelGorevKomutu(message);

          sending = true;
          sendBtn.disabled = true;
          sendBtn.setAttribute("aria-busy", "true");
          sendBtn.setAttribute("aria-label", loadingLabel);
          sendBtn.setAttribute("title", loadingLabel);
          sendBtn.classList.add("chat-compose-send--busy");
          if (sendLabelEl) sendLabelEl.textContent = loadingLabel;
          const history = collectThreadHistory(thread);
          if (imageDataUrlForBubble) {
            appendUserComposeBubble(message, imageDataUrlForBubble);
          } else {
            appendBubble("user", message);
          }

          /** Liste + onay: fetch’ten önce; aksi halde uzayan / takılan istek zinciri burada kopar (runSend hiç ilerlemez). */
          if (panelGorevCmd) {
            applyPanelGorevKomutu(panelGorevCmd);
            appendBubble("lumos", buildPanelGorevConfirmation(panelGorevCmd));
            input.value = "";
            clearPanelCameraPhotoSelection();
            setSendHint("");
            input.blur();
            resetPanelHorizontalScrollAfterInputBlur();
          }

          /**
           * Sistem Durumu için fotoğraf gönderim özeti; backend'e gönderilmez, yalnızca
           * istemcide görsel analiz durumunu (aktif/fallback/hata) çıkarmak ve panele yazmak için tutulur.
           */
          const photoTelemetry = hasPhoto && photoFile
            ? {
                photoAttached: true,
                photoSize:
                  typeof photoFile.size === "number" && Number.isFinite(photoFile.size)
                    ? photoFile.size
                    : 0,
                inlineBytes: 0,
                hasInline: false,
              }
            : null;
          try {
            const chatBody = { message: outgoingMessage, history };
            if (hasPhoto && photoFile) {
              chatBody.photoAttached = true;
              chatBody.photoName = photoFile.name || "";
              chatBody.photoType = photoFile.type || "";
              chatBody.photoSize =
                typeof photoFile.size === "number" && Number.isFinite(photoFile.size)
                  ? photoFile.size
                  : 0;
              let inlineB64 =
                imageDataUrlForBubble && dataUrlToInlineBase64ForChat(imageDataUrlForBubble, photoFile);
              let sentCompressedJpeg = false;
              if (!inlineB64) {
                inlineB64 = await compressPhotoFileForChat(photoFile);
                sentCompressedJpeg = !!inlineB64;
              }
              if (inlineB64) chatBody.imageData = inlineB64;
              if (sentCompressedJpeg) {
                chatBody.photoType = "image/jpeg";
                const rawName = photoFile.name || "photo";
                chatBody.photoName = rawName.replace(/\.[^/.]+$/, "") + ".jpg";
              }
              if (photoTelemetry) {
                photoTelemetry.hasInline = !!inlineB64;
                photoTelemetry.inlineBytes = inlineB64
                  ? decodedByteLengthFromBase64(inlineB64)
                  : 0;
              }
            }
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify(chatBody),
            });
            const text = await r.text();

            if (!r.ok) {
              console.warn("[Lumos panel chat] HTTP error", r.status);
              setSendHint("Gönderilemedi (HTTP " + r.status + "). Tekrar dene.");
              appendBubble(
                "error",
                "Sunucu yanıtı başarısız (HTTP " +
                  r.status +
                  "). Biraz sonra tekrar deneyebilir veya CHAT_URL / token ayarlarını kontrol edebilirsin.",
              );
              if (photoTelemetry) {
                let reason = "HTTP " + r.status;
                let missingKey = "";
                if (text) {
                  try {
                    const errJson = JSON.parse(text);
                    if (errJson && typeof errJson === "object") {
                      if (typeof errJson.error === "string") {
                        if (/OPENAI_API_KEY/i.test(errJson.error)) {
                          missingKey = " · OPENAI_API_KEY eksik";
                        }
                        reason = "HTTP " + r.status + " · " + errJson.error.slice(0, 80);
                      }
                    }
                  } catch {
                    /* ham metin */
                  }
                }
                const visionGuess =
                  photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
                showPanelChatPhotoTech(
                  buildPhotoTechBlock({
                    httpStatus: r.status,
                    reachedBackend: true,
                    imageDataSent: photoTelemetry.hasInline,
                    visionTriedGuess: visionGuess,
                    replyPreview: text ? String(text).trim().slice(0, 120) : "",
                    fallbackExact: false,
                    fallbackRegex: false,
                    networkError: false,
                    extraReason: reason + missingKey,
                  }),
                );
                void loadPanelBackendStatus();
              }
            } else {
              const INVALID_FORMAT_MSG =
                "Sunucu yanıtı beklenen formatta değil (JSON veya reply/content/message alanı). Biraz sonra tekrar deneyebilirsin.";
              const EMPTY_REPLY_MSG =
                "Bu sefer boş bir yanıt geldi. Sorunu biraz açıp yeniden deneyebilirsin.";

              let data = null;
              let parsed = false;
              if (text && text.trim()) {
                try {
                  data = JSON.parse(text);
                  parsed = true;
                } catch {
                  setSendHint("Yanıt okunamadı.");
                  appendBubble("error", INVALID_FORMAT_MSG);
                }
              } else {
                setSendHint("Yanıt okunamadı.");
                appendBubble("error", INVALID_FORMAT_MSG);
              }

              if (parsed) {
                const isPlainObject =
                  data !== null && typeof data === "object" && !Array.isArray(data);
                const hasChatBodyKey =
                  isPlainObject &&
                  ("reply" in data || "content" in data || "message" in data);
                if (!isPlainObject || !hasChatBodyKey) {
                  setSendHint("Yanıt okunamadı.");
                  appendBubble("error", INVALID_FORMAT_MSG);
                } else {
                  const raw = data.reply ?? data.content ?? data.message;
                  const replyBody = raw == null ? "" : String(raw);
                  if (photoTelemetry) {
                    const trimmedReply = replyBody.trim();
                    const fallbackExact = trimmedReply === REPLY_PHOTO_NO_VISION_TR;
                    const fallbackRegex = PANEL_REPLY_PHOTO_NO_VISION_RE.test(trimmedReply);
                    const visionGuess =
                      photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
                    if (fallbackRegex || fallbackExact) {
                      const extra =
                        !photoTelemetry.hasInline
                          ? "Görsel veri gitmedi (tavan veya sıkıştırma) · dosya ≈ "
                            + formatBytesShort(photoTelemetry.photoSize)
                          : "";
                      showPanelChatPhotoTech(
                        buildPhotoTechBlock({
                          httpStatus: r.status,
                          reachedBackend: true,
                          imageDataSent: photoTelemetry.hasInline,
                          visionTriedGuess: visionGuess,
                          replyPreview: trimmedReply.slice(0, 140),
                          fallbackExact,
                          fallbackRegex: fallbackRegex && !fallbackExact,
                          networkError: false,
                          extraReason: extra,
                        }),
                      );
                    } else if (trimmedReply) {
                      showPanelChatPhotoTech(
                        buildPhotoTechBlock({
                          httpStatus: r.status,
                          reachedBackend: true,
                          imageDataSent: photoTelemetry.hasInline,
                          visionTriedGuess: visionGuess,
                          replyPreview: trimmedReply.slice(0, 140),
                          fallbackExact: false,
                          fallbackRegex: false,
                          networkError: false,
                          extraReason: "",
                        }),
                      );
                    } else {
                      showPanelChatPhotoTech(
                        buildPhotoTechBlock({
                          httpStatus: r.status,
                          reachedBackend: true,
                          imageDataSent: photoTelemetry.hasInline,
                          visionTriedGuess: visionGuess,
                          replyPreview: "",
                          fallbackExact: false,
                          fallbackRegex: false,
                          networkError: false,
                          extraReason: "Boş yanıt",
                        }),
                      );
                    }
                    void loadPanelBackendStatus();
                  }
                  if (replyBody.trim()) {
                    const { lumosText } = ingestAssistantPanelGorev(replyBody);
                    if (panelGorevCmd) {
                      appendBubble("lumos", "Sunucu yanıtı:\n" + lumosText);
                      setSendHint("");
                    } else {
                      appendBubble("lumos", lumosText);
                      input.value = "";
                      clearPanelCameraPhotoSelection();
                      setSendHint("");
                      input.blur();
                      resetPanelHorizontalScrollAfterInputBlur();
                    }
                  } else if (panelGorevCmd) {
                    appendBubble(
                      "lumos",
                      "Sunucu bu istek için ek metin dönmedi (görev zaten yerelde kayıtlı).",
                    );
                    setSendHint("");
                  } else {
                    appendBubble("lumos", EMPTY_REPLY_MSG);
                    setSendHint("");
                  }
                }
              }
            }
          } catch (err) {
            const netMsg = summarizeClientFetchError(err);
            setSendHint("İstek hatası: " + netMsg.slice(0, 140));
            appendBubble(
              "error",
              "Sunucuya ulaşılamadı (istemci tarafında istek tamamlanmadı).\n" +
                "URL: " +
                String(CHAT_URL) +
                "\nHata: " +
                netMsg +
                "\nHTTP kodu yok (ağ kesintisi, engel veya sunucunun CORS/413 yanıtı tarayıcıda buna benzer görünebilir).",
            );
            if (photoTelemetry) {
              const visionGuess =
                photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
              showPanelChatPhotoTech(
                buildPhotoTechBlock({
                  requestUrl: CHAT_URL,
                  httpStatus: "—",
                  reachedBackend: false,
                  imageDataSent: photoTelemetry.hasInline,
                  visionTriedGuess: visionGuess,
                  replyPreview: "",
                  fallbackExact: false,
                  fallbackRegex: false,
                  networkError: true,
                  extraReason: "Ağ veya istemci: " + netMsg,
                }),
              );
              void loadPanelBackendStatus();
            }
          } finally {
            sending = false;
            sendBtn.disabled = false;
            sendBtn.removeAttribute("aria-busy");
            sendBtn.setAttribute("aria-label", sendLabel);
            sendBtn.setAttribute("title", sendLabel);
            sendBtn.classList.remove("chat-compose-send--busy");
            if (sendLabelEl) sendLabelEl.textContent = sendLabel;
          }
        }

        sendBtn.addEventListener("click", () => {
          void runSend();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter" || e.shiftKey) return;
          e.preventDefault();
          void runSend();
        });

        const voiceBtn = document.getElementById("panel-voice-input");
        const voiceHint = document.getElementById("panel-voice-hint");
        let voiceRec = null;
        let voiceListening = false;

        function setVoiceHint(msg) {
          if (!voiceHint) return;
          voiceHint.textContent = msg;
          voiceHint.hidden = !msg;
        }

        function stopVoiceListeningUi() {
          voiceListening = false;
          if (voiceBtn) {
            voiceBtn.classList.remove("chat-compose-voice-btn--listening");
            voiceBtn.setAttribute("aria-pressed", "false");
          }
        }

        function appendVoiceTranscript(chunk) {
          const t = String(chunk || "").trim();
          if (!t) return;
          const cur = input.value;
          const sep = cur && !/\s$/.test(cur) ? " " : "";
          input.value = cur + sep + t;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }

        voiceBtn?.addEventListener("click", () => {
          const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
          if (!SR) {
            setVoiceHint("Bu tarayıcıda sesli giriş desteklenmiyor.");
            return;
          }

          if (voiceListening && voiceRec) {
            try {
              voiceRec.stop();
            } catch {
              /* ignore */
            }
            return;
          }

          voiceRec = new SR();
          voiceRec.lang = "tr-TR";
          voiceRec.interimResults = false;
          voiceRec.continuous = false;
          voiceRec.maxAlternatives = 1;

          voiceListening = true;
          voiceBtn.classList.add("chat-compose-voice-btn--listening");
          voiceBtn.setAttribute("aria-pressed", "true");
          setVoiceHint("");

          voiceRec.onresult = (ev) => {
            let spoken = "";
            for (let i = ev.resultIndex; i < ev.results.length; i++) {
              spoken += ev.results[i][0].transcript;
            }
            appendVoiceTranscript(spoken);
            if (voiceHint) voiceHint.hidden = true;
          };

          voiceRec.onerror = (ev) => {
            if (ev.error === "not-allowed" || ev.error === "service-not-allowed") {
              setVoiceHint("Mikrofon izni verilmedi.");
            }
            stopVoiceListeningUi();
          };

          voiceRec.onend = () => {
            stopVoiceListeningUi();
          };

          try {
            voiceRec.start();
          } catch {
            stopVoiceListeningUi();
            setVoiceHint("Bu tarayıcıda sesli giriş desteklenmiyor.");
          }
        });

        mqPanelCameraMobile.addEventListener("change", syncPanelCameraPhotoBarVisibility);
        syncPanelCameraPhotoBarVisibility();

        cameraBtn?.addEventListener("click", () => {
          if (!cameraPhotoInput) {
            setCameraHint("Bu tarayıcıda görsel seçimi desteklenmiyor.");
            return;
          }
          setCameraHint("");
          cameraPhotoInput.click();
        });

        cameraPhotoInput?.addEventListener("change", () => {
          const f = cameraPhotoInput.files && cameraPhotoInput.files[0];
          if (!f) return;
          bindCameraPhotoFromFile(f);
        });
      }

      function wireGorevlerPrototype() {
        const listEl = document.getElementById("gorevler-list");
        const titleInput = document.getElementById("gorevler-title-input");
        const prioritySel = document.getElementById("gorevler-priority");
        const statusSel = document.getElementById("gorevler-status");
        const addBtn = document.getElementById("gorevler-add");
        const hintEl = document.getElementById("gorevler-hint");
        const detailEl = document.getElementById("gorevler-detail");
        const detailTitleEl = document.getElementById("gorevler-detail-title");
        const detailTaskDl = document.getElementById("gorevler-detail-task-dl");
        const detailBridgeDl = document.getElementById("gorevler-detail-bridge-dl");
        const detailCloseBtn = document.getElementById("gorevler-detail-close");
        const clearTestBtn = document.getElementById("gorevler-clear-test");
        if (
          !listEl ||
          !titleInput ||
          !prioritySel ||
          !statusSel ||
          !addBtn ||
          !hintEl ||
          !detailEl ||
          !detailTitleEl ||
          !detailTaskDl ||
          !detailBridgeDl ||
          !detailCloseBtn ||
          !clearTestBtn
        ) {
          console.warn("[Lumos panel görev] wireGorevlerPrototype erken çıkış — görev listesi bağlanmadı.", {
            listEl: !!listEl,
            titleInput: !!titleInput,
            prioritySel: !!prioritySel,
            statusSel: !!statusSel,
            addBtn: !!addBtn,
            hintEl: !!hintEl,
            detailEl: !!detailEl,
            detailTitleEl: !!detailTitleEl,
            detailTaskDl: !!detailTaskDl,
            detailBridgeDl: !!detailBridgeDl,
            detailCloseBtn: !!detailCloseBtn,
            clearTestBtn: !!clearTestBtn,
          });
          return;
        }

        let gorevlerUseDialog =
          typeof detailEl.showModal === "function" && typeof detailEl.close === "function";
        if (!gorevlerUseDialog) {
          detailEl.classList.add("gorevler-detail--fallback");
          detailEl.hidden = true;
        } else {
          detailEl.addEventListener("close", () => {
            if (detailTaskDl.childElementCount > 0 || detailBridgeDl.childElementCount > 0) {
              syncGorevlerDetailUiClosed(false);
            }
          });
          detailEl.addEventListener("cancel", (ev) => {
            ev.preventDefault();
            closeGorevlerDetail(true);
          });
        }

        const priorityLabels = { dusuk: "Düşük", orta: "Orta", yuksek: "Yüksek" };
        const statusLabels = {
          bekliyor: "Bekliyor",
          onay_bekliyor: "Onay bekliyor",
          tamamlandi: "Tamamlandı",
        };

        let gorevlerEscapeHandler = null;
        let lastGorevlerOpenedIndex = -1;

        function syncGorevlerDetailUiClosed(restoreFocus) {
          detailTaskDl.replaceChildren();
          detailBridgeDl.replaceChildren();
          detailTitleEl.textContent = "Görev";
          listEl.querySelectorAll(".gorevler-task-card").forEach((node) => {
            node.setAttribute("aria-expanded", "false");
          });
          if (gorevlerEscapeHandler) {
            document.removeEventListener("keydown", gorevlerEscapeHandler);
            gorevlerEscapeHandler = null;
          }
          if (restoreFocus && lastGorevlerOpenedIndex >= 0) {
            const li = listEl.querySelector(
              '[data-task-index="' + String(lastGorevlerOpenedIndex) + '"]',
            );
            if (li && typeof li.focus === "function") li.focus({ preventScroll: true });
          }
          lastGorevlerOpenedIndex = -1;
        }

        function closeGorevlerDetail(restoreFocus) {
          syncGorevlerDetailUiClosed(restoreFocus);
          if (gorevlerUseDialog) {
            if (detailEl.open) detailEl.close();
          } else {
            detailEl.hidden = true;
          }
        }

        function formatTrDateTime(iso) {
          const s = String(iso || "").trim();
          if (!s) return "—";
          const d = new Date(s);
          if (Number.isNaN(d.getTime())) return "—";
          try {
            return d.toLocaleString("tr-TR", { dateStyle: "short", timeStyle: "medium" });
          } catch {
            return s;
          }
        }

        /** Köprü JSON alanları (detay + kalıcılık). */
        function bridgeFieldsFromJson(data) {
          const empty = {
            route: null,
            source: null,
            accepted: null,
            result_file: null,
            execution_file: null,
          };
          if (!data || typeof data !== "object") return empty;
          const d = /** @type {Record<string, unknown>} */ (data);
          const routeRaw = d.route != null ? String(d.route).trim() : "";
          const route = routeRaw ? routeRaw : null;
          const sourceRaw = d.source != null ? String(d.source).trim() : "";
          const source = sourceRaw ? sourceRaw : null;
          let accepted = null;
          if (d.accepted === true || d.accepted === false) accepted = d.accepted;
          const rfRaw =
            d.result_file != null
              ? String(d.result_file).trim()
              : d.resultFile != null
                ? String(d.resultFile).trim()
                : "";
          const result_file = rfRaw ? rfRaw : null;
          const efRaw =
            d.execution_file != null
              ? String(d.execution_file).trim()
              : d.executionFile != null
                ? String(d.executionFile).trim()
                : "";
          const execution_file = efRaw ? efRaw : null;
          return { route, source, accepted, result_file, execution_file };
        }

        function assignTaskBridgeLast(taskRef, data, acceptedOverride) {
          const ts = new Date().toISOString();
          const f = bridgeFieldsFromJson(data);
          const snap = { ...f, lastBridgeAt: ts };
          if (acceptedOverride === true || acceptedOverride === false) snap.accepted = acceptedOverride;
          const sane = sanitizeBridgeLast(snap) || { lastBridgeAt: ts };
          taskRef.bridgeLast = sane;
          persistPanelGorevlerTasks();
        }

        function lumosOutboxPathBasename(p) {
          const s = p != null ? String(p).trim() : "";
          if (!s) return "";
          const parts = s.replace(/\\/g, "/").split("/");
          return parts[parts.length - 1] || s;
        }

        function appendDetailRow(dl, label, value) {
          const dt = document.createElement("dt");
          dt.textContent = label;
          const dd = document.createElement("dd");
          dd.textContent = value != null && String(value).trim() ? String(value).trim() : "—";
          dl.appendChild(dt);
          dl.appendChild(dd);
        }

        function openGorevlerDetail(taskIndex) {
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          lastGorevlerOpenedIndex = taskIndex;
          const bl = t.bridgeLast && typeof t.bridgeLast === "object" ? t.bridgeLast : null;
          detailTitleEl.textContent = t.title != null ? String(t.title).trim() || "—" : "—";
          detailTaskDl.replaceChildren();
          detailBridgeDl.replaceChildren();

          const statusTxt =
            statusLabels[t.status] != null ? statusLabels[t.status] : t.status != null ? String(t.status) : "—";
          const priorityTxt =
            priorityLabels[t.priority] != null
              ? priorityLabels[t.priority]
              : t.priority != null
                ? String(t.priority)
                : "—";
          const whenRaw = t.when != null ? String(t.when).trim() : "";
          const whenTxt = whenRaw ? whenRaw : "—";

          appendDetailRow(detailTaskDl, "Durum", statusTxt);
          appendDetailRow(detailTaskDl, "Öncelik", priorityTxt);
          appendDetailRow(detailTaskDl, "Tarih", whenTxt);

          let route = "—";
          let source = "—";
          let acceptedTxt = "—";
          let resultFile = "—";
          let execFile = "—";
          let lastOp = "—";

          if (bl) {
            lastOp = formatTrDateTime(bl.lastBridgeAt);
            if (bl.route != null && String(bl.route).trim()) route = String(bl.route).trim();
            if (bl.source != null && String(bl.source).trim()) source = String(bl.source).trim();
            if (bl.accepted === true) acceptedTxt = "Evet";
            else if (bl.accepted === false) acceptedTxt = "Hayır";
            if (bl.result_file) {
              const raw = String(bl.result_file).trim();
              const bn = lumosOutboxPathBasename(raw);
              resultFile = bn || raw;
            }
            if (bl.execution_file) {
              const raw = String(bl.execution_file).trim();
              const bn = lumosOutboxPathBasename(raw);
              execFile = bn || raw;
            }
          }

          appendDetailRow(detailBridgeDl, "Route", route);
          appendDetailRow(detailBridgeDl, "Kaynak", source);
          appendDetailRow(detailBridgeDl, "Kabul", acceptedTxt);
          appendDetailRow(detailBridgeDl, "Sonuç dosyası", resultFile);
          appendDetailRow(detailBridgeDl, "Çalıştırma dosyası", execFile);
          appendDetailRow(detailBridgeDl, "Köprü zamanı", lastOp);

          if (gorevlerUseDialog) {
            try {
              if (!detailEl.open) detailEl.showModal();
            } catch (_) {
              gorevlerUseDialog = false;
              detailEl.classList.add("gorevler-detail--fallback");
            }
          }
          if (!gorevlerUseDialog) {
            detailEl.hidden = false;
            if (!gorevlerEscapeHandler) {
              gorevlerEscapeHandler = (ev) => {
                if (ev.key !== "Escape" || detailEl.hidden) return;
                ev.preventDefault();
                closeGorevlerDetail(true);
              };
              document.addEventListener("keydown", gorevlerEscapeHandler);
            }
          }
          if (typeof detailEl.focus === "function") detailEl.focus({ preventScroll: true });
        }

        /**
         * Görev kartı köprü özeti: geçerli zaman damgası varsa “Son köprü”, aksi halde sade “henüz yok”.
         * Detay paneli ham `bridgeLast` ile doldurulmaya devam eder.
         * @param {Record<string, unknown> | null} blRow
         */
        function formatGorevlerTaskBridgeLine(blRow) {
          const blSumm = sanitizeBridgeLast(blRow);
          const iso =
            blSumm && blSumm.lastBridgeAt != null ? String(blSumm.lastBridgeAt).trim() : "";
          const isoOk = iso && !Number.isNaN(Date.parse(iso));
          if (blSumm && isoOk) {
            const whenBridge = formatTrDateTime(blSumm.lastBridgeAt);
            const routeBit =
              blSumm.route != null && String(blSumm.route).trim()
                ? " · " + truncateGorevlerField(String(blSumm.route).trim()).slice(0, 56)
                : "";
            return "Son köprü: " + whenBridge + routeBit;
          }
          return "Köprü: henüz yok";
        }

        function gorevlerTaskBadgeSlug(v) {
          const s = v != null ? String(v).trim().toLowerCase() : "";
          const slug = s.replace(/_/g, "-").replace(/[^a-z0-9-]/g, "") || "unknown";
          return slug;
        }

        function render() {
          closeGorevlerDetail(false);
          listEl.replaceChildren();
          for (let i = 0; i < panelGorevlerTasks.length; i++) {
            const t = panelGorevlerTasks[i];
            const li = document.createElement("li");
            li.className = "gorevler-task-card";
            li.tabIndex = 0;
            li.setAttribute("role", "button");
            li.setAttribute("data-task-index", String(i));
            li.setAttribute("aria-expanded", "false");
            li.setAttribute("aria-controls", "gorevler-detail");
            li.setAttribute("aria-label", "Görev: " + t.title + "; ayrıntıları göster");

            const main = document.createElement("div");
            main.className = "gorevler-task-main";

            const titleEl = document.createElement("div");
            titleEl.className = "gorevler-task-title";
            titleEl.textContent = t.title != null ? String(t.title).trim() : "";
            main.appendChild(titleEl);

            const metaEl = document.createElement("div");
            metaEl.className = "gorevler-task-meta";
            const statusLabel =
              statusLabels[t.status] != null ? statusLabels[t.status] : String(t.status);
            const priorityLabel =
              priorityLabels[t.priority] != null ? priorityLabels[t.priority] : String(t.priority);
            metaEl.textContent = "Durum: " + statusLabel + " · Öncelik: " + priorityLabel;
            main.appendChild(metaEl);

            const whenEl = document.createElement("div");
            whenEl.className = "gorevler-task-when";
            const whenText = t.when != null ? String(t.when).trim() : "";
            whenEl.textContent = whenText || "\u00a0";
            if (!whenText) {
              whenEl.setAttribute("data-gorevler-when-empty", "");
              whenEl.setAttribute("aria-hidden", "true");
            }
            main.appendChild(whenEl);

            const blRow = t.bridgeLast && typeof t.bridgeLast === "object" ? t.bridgeLast : null;
            const bridgeEl = document.createElement("div");
            bridgeEl.className = "gorevler-task-bridge";
            bridgeEl.textContent = formatGorevlerTaskBridgeLine(blRow);
            main.appendChild(bridgeEl);

            if (sanitizeBridgeLast(blRow)) {
              li.classList.add("gorevler-task-card--has-bridge");
            }

            li.appendChild(main);
            listEl.appendChild(li);
          }
        }

        function showHint(msg) {
          const s = msg != null ? String(msg) : "";
          hintEl.textContent = s;
          hintEl.hidden = false;
          hintEl.style.whiteSpace = s.indexOf("\n") >= 0 ? "pre-line" : "";
        }

        function hideHint() {
          hintEl.hidden = true;
          hintEl.textContent = "";
          hintEl.style.whiteSpace = "";
        }

        /**
         * POST /task 200 ve accepted !== false: ham JSON yerine kısa özet (üst hint).
         * @param {Record<string, unknown>} data
         */
        function buildTaskBridgeSuccessReadableHint(data) {
          const route =
            data.route != null && String(data.route).trim() ? String(data.route).trim() : "—";
          const source =
            data.source != null && String(data.source).trim() ? String(data.source).trim() : "—";
          const head =
            data.accepted === true || data.ok === true ? "kabul edildi" : "yanıt alındı";
          const main = "Köprü: " + head + " · route: " + route + " · source: " + source;
          const rf = data.result_file != null ? String(data.result_file).trim() : "";
          const ef = data.execution_file != null ? String(data.execution_file).trim() : "";
          const extra = [];
          const rfBn = lumosOutboxPathBasename(rf);
          if (rfBn) extra.push("result_file: " + rfBn);
          const efBn = lumosOutboxPathBasename(ef);
          if (efBn) extra.push("execution_file: " + efBn);
          if (extra.length === 0) return main;
          return main + "\n" + extra.join(" · ");
        }

        /**
         * Görevler sekmesi: önce yerel liste (panelGorevlerTasks + localStorage),
         * sonra köprü POST /task. Köprü hatası listeyi geri almaz.
         * Köprü JSON: goal (metin), source panel_gorevler; token sohbet/yükleme ile aynı.
         */
        async function addTask() {
          const title = titleInput.value.trim();
          if (!title) {
            showHint("Görev adı boş olamaz.");
            titleInput.focus();
            return;
          }
          hideHint();

          const priority = prioritySel.value;
          const status = statusSel.value;

          panelGorevlerTasks.push({
            title,
            priority,
            status,
          });
          const taskRef = panelGorevlerTasks[panelGorevlerTasks.length - 1];
          titleInput.value = "";
          persistPanelGorevlerTasks();
          render();

          try {
            const r = await fetch(`${BRIDGE_BASE_URL}/task`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify({
                goal: title,
                source: "panel_gorevler",
                priority,
                status,
              }),
            });
            const text = await r.text();
            let data = null;
            try {
              data = text && String(text).trim() ? JSON.parse(text) : null;
            } catch {
              data = null;
            }

            if (!r.ok) {
              assignTaskBridgeLast(taskRef, data, null);
              const err =
                data && typeof data === "object" && data.error != null
                  ? String(data.error)
                  : "Köprü yanıtı başarısız (" + r.status + ").";
              showHint("Görev yerel listeye eklendi; " + err);
              return;
            }
            if (data && typeof data === "object" && data.accepted === false) {
              assignTaskBridgeLast(taskRef, data, false);
              const err =
                data.error != null ? String(data.error) : "Görev köprü tarafından kabul edilmedi.";
              showHint("Görev yerel listeye eklendi; " + err);
              return;
            }
            if (data && typeof data === "object") {
              assignTaskBridgeLast(taskRef, data, null);
              showHint(buildTaskBridgeSuccessReadableHint(data));
            } else {
              assignTaskBridgeLast(taskRef, null, null);
              hideHint();
            }
          } catch (_) {
            assignTaskBridgeLast(taskRef, null, null);
            showHint("Görev yerel listeye eklendi; bridge bağlantısı başarısız.");
          }
        }

        panelGorevlerTasksRender = render;

        addBtn.addEventListener("click", addTask);
        titleInput.addEventListener("keydown", (e) => {
          if (e.key !== "Enter") return;
          e.preventDefault();
          addTask();
        });

        listEl.addEventListener("click", (e) => {
          const raw = e.target;
          const el = raw instanceof Element ? raw : raw && raw.parentElement;
          const li = el && typeof el.closest === "function" ? el.closest("li.gorevler-task-card") : null;
          if (!li || !listEl.contains(li)) return;
          const idx = Number(li.getAttribute("data-task-index"));
          if (Number.isNaN(idx) || idx < 0) return;
          listEl.querySelectorAll(".gorevler-task-card").forEach((node) => {
            node.setAttribute("aria-expanded", "false");
          });
          li.setAttribute("aria-expanded", "true");
          openGorevlerDetail(idx);
        });

        listEl.addEventListener("keydown", (e) => {
          const raw = e.target;
          const el = raw instanceof Element ? raw : raw && raw.parentElement;
          const li = el && typeof el.closest === "function" ? el.closest("li.gorevler-task-card") : null;
          if (!li || !listEl.contains(li)) return;
          if (e.key !== "Enter" && e.key !== " ") return;
          e.preventDefault();
          const idx = Number(li.getAttribute("data-task-index"));
          if (Number.isNaN(idx) || idx < 0) return;
          listEl.querySelectorAll(".gorevler-task-card").forEach((node) => {
            node.setAttribute("aria-expanded", "false");
          });
          li.setAttribute("aria-expanded", "true");
          openGorevlerDetail(idx);
        });

        detailCloseBtn.addEventListener("click", () => closeGorevlerDetail(true));

        clearTestBtn.addEventListener("click", () => {
          if (
            !confirm(
              "Görev listesi test verileri sıfırlansın mı? Yerel görev kaydı silinir ve öntanımlı örnek görevlere dönülür.",
            )
          ) {
            return;
          }
          try {
            if (typeof localStorage !== "undefined") {
              localStorage.removeItem(PANEL_GOREVLER_LS_KEY);
            }
          } catch (_) {
            /* ignore */
          }
          panelGorevlerTasks.length = 0;
          for (let s = 0; s < defaultGorevlerSeed.length; s++) {
            const row = defaultGorevlerSeed[s];
            panelGorevlerTasks.push({
              title: row.title,
              priority: row.priority,
              status: row.status,
            });
          }
          persistPanelGorevlerTasks();
          render();
        });

        render();
      }

      wirePanel();
      wireGorevlerPrototype();
      wireDosyalarUpload();

      function wireDosyalarUpload() {
        const input = document.getElementById("dosyalar-file-input");
        const btn = document.getElementById("dosyalar-upload-btn");
        const hint = document.getElementById("dosyalar-hint");
        const result = document.getElementById("dosyalar-result");
        const historyWrap = document.getElementById("dosyalar-history-wrap");
        const historyList = document.getElementById("dosyalar-history-list");
        if (!input || !btn || !hint || !result) return;

        /** Bellek içi; sayfa yenilenince sıfırlanır. En fazla 5 kayıt, en yeni üstte. */
        const dosyalarUploadHistory = [];

        function dosyalarHistoryShortStatus(data) {
          const u = data.unsupported != null ? String(data.unsupported).trim() : "";
          if (u) return "Uyarı";
          const s = data.summary != null ? String(data.summary).trim() : "";
          if (s) return "Özet hazır";
          return "Tamamlandı";
        }

        function replayDosyalarSnapshot(snapshot) {
          if (!snapshot || typeof snapshot !== "object") return;
          renderResult(snapshot);
          result.hidden = false;
          try {
            result.scrollIntoView({ behavior: "smooth", block: "nearest" });
          } catch (_) {
            /* eski tarayıcı */
          }
        }

        function renderDosyalarHistory() {
          if (!historyWrap || !historyList) return;
          historyList.replaceChildren();
          if (dosyalarUploadHistory.length === 0) {
            historyWrap.hidden = true;
            return;
          }
          historyWrap.hidden = false;
          for (const row of dosyalarUploadHistory) {
            const snap = row.snapshot;
            if (!snap || typeof snap !== "object") continue;

            const li = document.createElement("li");
            li.className = "dosyalar-history-row";
            li.setAttribute("role", "button");
            li.setAttribute("tabindex", "0");
            const fn = String(snap.filename ?? "");
            li.setAttribute(
              "aria-label",
              fn ? `Sonuçları yeniden göster: ${fn}` : "Sonuçları yeniden göster",
            );

            const nameEl = document.createElement("span");
            nameEl.className = "dosyalar-history-name";
            nameEl.textContent = fn || "—";

            const sizeEl = document.createElement("span");
            sizeEl.className = "dosyalar-history-meta";
            sizeEl.textContent =
              snap.size != null && snap.size !== "" ? String(snap.size) + " bayt" : "—";

            const extEl = document.createElement("span");
            extEl.className = "dosyalar-history-meta";
            extEl.textContent =
              snap.extension != null && String(snap.extension).trim()
                ? String(snap.extension)
                : "—";

            const stEl = document.createElement("p");
            stEl.className = "dosyalar-history-status";
            stEl.textContent = dosyalarHistoryShortStatus(snap);

            li.appendChild(nameEl);
            li.appendChild(sizeEl);
            li.appendChild(extEl);
            li.appendChild(stEl);

            const open = () => replayDosyalarSnapshot(snap);
            li.addEventListener("click", open);
            li.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                open();
              }
            });

            historyList.appendChild(li);
          }
        }

        function pushDosyalarHistory(data) {
          if (!data || typeof data !== "object") return;
          const snapshot = { ...data };
          dosyalarUploadHistory.unshift({ snapshot });
          if (dosyalarUploadHistory.length > 5) dosyalarUploadHistory.length = 5;
          renderDosyalarHistory();
        }

        function showHint(msg) {
          hint.textContent = msg;
          hint.hidden = false;
        }

        function hideHint() {
          hint.hidden = true;
          hint.textContent = "";
        }

        function renderResult(data) {
          result.replaceChildren();
          result.className = "dosyalar-result-stack";

          const metaCard = document.createElement("section");
          metaCard.className = "dosyalar-result-card dosyalar-result-card--meta";
          metaCard.setAttribute("aria-labelledby", "dosyalar-result-meta-title");
          const metaTitle = document.createElement("h3");
          metaTitle.id = "dosyalar-result-meta-title";
          metaTitle.className = "dosyalar-result-card__title";
          metaTitle.textContent = "Dosya bilgisi";
          metaCard.appendChild(metaTitle);

          const ul = document.createElement("ul");
          ul.className = "dosyalar-result-meta";
          const rows = [
            ["Dosya adı", String(data.filename ?? "")],
            ["Boyut", String(data.size ?? "") + " bayt"],
            ["Tür", String(data.kind ?? "")],
            ["Uzantı", data.extension ? String(data.extension) : "—"],
          ];
          for (const [k, v] of rows) {
            const li = document.createElement("li");
            const a = document.createElement("span");
            a.textContent = k;
            const b = document.createElement("span");
            b.textContent = v;
            li.appendChild(a);
            li.appendChild(b);
            ul.appendChild(li);
          }
          metaCard.appendChild(ul);
          result.appendChild(metaCard);

          const unsup = data.unsupported != null ? String(data.unsupported).trim() : "";
          if (unsup) {
            const alertCard = document.createElement("section");
            alertCard.className = "dosyalar-result-card dosyalar-result-card--alert";
            alertCard.setAttribute("aria-labelledby", "dosyalar-result-alert-title");
            alertCard.setAttribute("role", "region");
            const alertTitle = document.createElement("h3");
            alertTitle.id = "dosyalar-result-alert-title";
            alertTitle.className = "dosyalar-result-card__title";
            alertTitle.textContent = "Uyarı";
            const alertBody = document.createElement("p");
            alertBody.className = "dosyalar-result-alert-body";
            alertBody.textContent = unsup;
            alertCard.appendChild(alertTitle);
            alertCard.appendChild(alertBody);
            result.appendChild(alertCard);
          }

          if (data.summary != null && String(data.summary).trim()) {
            const sumCard = document.createElement("section");
            sumCard.className = "dosyalar-result-card dosyalar-result-card--summary";
            sumCard.setAttribute("aria-labelledby", "dosyalar-result-summary-title");
            const sumTitle = document.createElement("h3");
            sumTitle.id = "dosyalar-result-summary-title";
            sumTitle.className = "dosyalar-result-card__title";
            sumTitle.textContent = "Kısa özet";
            const sumBody = document.createElement("p");
            sumBody.className = "dosyalar-result-summary-body";
            sumBody.textContent = String(data.summary);
            sumCard.appendChild(sumTitle);
            sumCard.appendChild(sumBody);
            result.appendChild(sumCard);
          }

          result.hidden = false;
        }

        btn.addEventListener("click", async () => {
          const file = input.files && input.files[0];
          if (!file) {
            showHint("Önce bir dosya seçin.");
            return;
          }
          hideHint();
          result.hidden = true;
          btn.disabled = true;
          btn.setAttribute("aria-busy", "true");
          const fd = new FormData();
          fd.append("file", file, file.name);
          try {
            const r = await fetch(UPLOAD_URL, {
              method: "POST",
              headers: { "X-Kando-Token": kandoToken },
              body: fd,
            });
            const text = await r.text();
            let data = null;
            try {
              data = text && text.trim() ? JSON.parse(text) : null;
            } catch {
              data = null;
            }
            if (!r.ok) {
              const err =
                data && typeof data === "object" && data.error != null
                  ? String(data.error)
                  : "Yükleme başarısız.";
              showHint("HTTP " + r.status + ": " + err);
              return;
            }
            if (!data || typeof data !== "object" || data.ok !== true) {
              showHint("Sunucu yanıtı beklenen formatta değil.");
              return;
            }
            renderResult(data);
            pushDosyalarHistory(data);
          } catch {
            showHint("Sunucuya ulaşılamadı. Köprü adresini veya bağlantıyı kontrol edin.");
          } finally {
            btn.disabled = false;
            btn.removeAttribute("aria-busy");
          }
        });
      }

      function setPanelConnBadge(state) {
        const badge = document.getElementById("panel-conn-badge");
        if (!badge) return;
        badge.setAttribute("data-state", state);
        if (state === "ok") {
          badge.textContent = "Bağlı";
        } else if (state === "bad") {
          badge.textContent = "Çevrimdışı";
        } else {
          badge.textContent = "Bağlanıyor";
        }
      }

      function setPanelHealthDetail(text) {
        const el = document.getElementById("panel-health-detail");
        if (!el) return;
        el.textContent = text != null ? String(text) : "";
      }

      function formatBytesShort(n) {
        const v = Number(n);
        if (!Number.isFinite(v) || v <= 0) return "—";
        if (v < 1024) return v + " B";
        if (v < 1024 * 1024) return (v / 1024).toFixed(1) + " KB";
        return (v / (1024 * 1024)).toFixed(2) + " MB";
      }

      const REPLY_PHOTO_NO_VISION_TR =
        "Fotoğraf eklendi; görsel analiz henüz aktif değil.";
      const PANEL_REPLY_PHOTO_NO_VISION_RE =
        /Fotoğraf eklendi;\s*görsel analiz henüz aktif değil\.?$/i;

      function showPanelChatPhotoTech(text) {
        const wrap = document.getElementById("panel-chat-photo-tech");
        const pre = document.getElementById("panel-chat-photo-tech-pre");
        if (!wrap || !pre) return;
        const t = text == null ? "" : String(text).trim();
        if (!t) {
          wrap.hidden = true;
          pre.textContent = "";
          return;
        }
        wrap.hidden = false;
        pre.textContent = t;
      }

      function buildPhotoTechBlock(o) {
        const lines = [];
        if (o.requestUrl != null && String(o.requestUrl).trim()) {
          lines.push("İstek URL: " + String(o.requestUrl).trim());
        }
        lines.push("HTTP: " + String(o.httpStatus != null ? o.httpStatus : "—"));
        lines.push("Fotoğraf backend'e ulaştı: " + (o.reachedBackend ? "evet" : "hayır"));
        lines.push("imageData gönderildi: " + (o.imageDataSent ? "evet" : "hayır"));
        lines.push("Vision (istemci tahmini): " + (o.visionTriedGuess ? "evet" : "hayır"));
        if (o.networkError) lines.push("Ağ/CORS (istemci): evet");
        let fb = "—";
        if (o.fallbackExact) fb = REPLY_PHOTO_NO_VISION_TR;
        else if (o.fallbackRegex) fb = "Türkçe fallback metni (regex eşleşmesi)";
        else if (o.extraReason) fb = o.extraReason;
        lines.push("Fallback nedeni: " + fb);
        if (o.extraReason && String(o.extraReason).trim() && (o.fallbackExact || o.fallbackRegex)) {
          lines.push("Ek not: " + String(o.extraReason).trim());
        }
        if (o.replyPreview) lines.push("Yanıt özeti: " + o.replyPreview);
        return lines.join("\n");
      }

      let bridgeHealthLine = "bekleniyor…";
      let lastStatusJson = /** @type {Record<string, unknown> | null} */ (null);
      let lastStatusCorsError = false;
      let lastChatOptionsPingLine = "—";

      function setSistemDurumuDd(id, t) {
        const el = document.getElementById(id);
        if (el) el.textContent = t == null ? "" : String(t);
      }

      function paintSistemDurumuPanel() {
        const corsEl = document.getElementById("panel-sistem-durumu-cors");
        const dl = document.getElementById("panel-sistem-durumu-dl");
        if (lastStatusCorsError) {
          if (corsEl) {
            corsEl.hidden = false;
            corsEl.textContent = "Bu bilgi panelden okunamıyor (CORS).";
          }
          if (dl) dl.hidden = false;
          setSistemDurumuDd("panel-sistem-durumu-baglanti", "Köprü: " + bridgeHealthLine);
          setSistemDurumuDd("panel-sistem-durumu-chat", "—");
          setSistemDurumuDd("panel-sistem-durumu-vision", "—");
          setSistemDurumuDd("panel-sistem-durumu-vision-last", "—");
          return;
        }
        if (corsEl) {
          corsEl.hidden = true;
          corsEl.textContent = "";
        }
        if (dl) dl.hidden = false;
        const j = lastStatusJson;
        if (!j) {
          setSistemDurumuDd("panel-sistem-durumu-baglanti", "Köprü: " + bridgeHealthLine);
          setSistemDurumuDd("panel-sistem-durumu-chat", "—");
          setSistemDurumuDd("panel-sistem-durumu-vision", "—");
          setSistemDurumuDd("panel-sistem-durumu-vision-last", "—");
          return;
        }
        const health = j.health != null ? String(j.health) : "—";
        const chatS = j.chat != null ? String(j.chat) : "—";
        const visionLast = j.visionLastStatus != null ? String(j.visionLastStatus) : "—";
        const visionCfg = j.visionConfigured === true;
        setSistemDurumuDd("panel-sistem-durumu-baglanti", health + " · köprü: " + bridgeHealthLine);
        setSistemDurumuDd("panel-sistem-durumu-chat", chatS + " · " + lastChatOptionsPingLine);
        setSistemDurumuDd("panel-sistem-durumu-vision", visionCfg ? "Evet (OpenAI anahtarı var)" : "Hayır");
        setSistemDurumuDd("panel-sistem-durumu-vision-last", visionLast);
      }

      async function probeChatOptionsPingLine() {
        try {
          const r = await fetch(CHAT_URL, {
            method: "OPTIONS",
            cache: "no-store",
            mode: "cors",
            credentials: "omit",
          });
          if (r.ok || r.status === 204) return "OPTIONS OK (" + r.status + ")";
          return "OPTIONS HTTP " + r.status;
        } catch {
          return "OPTIONS hata (ağ/CORS)";
        }
      }

      async function loadPanelBackendStatus() {
        if (typeof STATUS_URL !== "string" || !String(STATUS_URL).trim()) {
          lastStatusJson = null;
          lastStatusCorsError = false;
          lastChatOptionsPingLine = await probeChatOptionsPingLine();
          paintSistemDurumuPanel();
          setSistemDurumuDd("panel-sistem-durumu-chat", "STATUS_URL yok · " + lastChatOptionsPingLine);
          return;
        }
        try {
          const r = await fetch(STATUS_URL, {
            method: "GET",
            cache: "no-store",
            mode: "cors",
            credentials: "omit",
            headers: { Accept: "application/json" },
          });
          if (!r.ok) {
            lastStatusJson = null;
            lastStatusCorsError = false;
            lastChatOptionsPingLine = await probeChatOptionsPingLine();
            paintSistemDurumuPanel();
            setSistemDurumuDd(
              "panel-sistem-durumu-chat",
              "/status HTTP " + r.status + " · " + lastChatOptionsPingLine,
            );
            return;
          }
          const text = await r.text();
          let data = null;
          try {
            data = text && String(text).trim() ? JSON.parse(text) : null;
          } catch {
            data = null;
          }
          if (!data || typeof data !== "object") {
            lastStatusJson = null;
            lastStatusCorsError = false;
            lastChatOptionsPingLine = await probeChatOptionsPingLine();
            paintSistemDurumuPanel();
            setSistemDurumuDd("panel-sistem-durumu-chat", "JSON okunamadı · " + lastChatOptionsPingLine);
            return;
          }
          lastStatusJson = data;
          lastStatusCorsError = false;
          lastChatOptionsPingLine = await probeChatOptionsPingLine();
          paintSistemDurumuPanel();
        } catch {
          lastStatusJson = null;
          lastStatusCorsError = true;
          lastChatOptionsPingLine = "—";
          paintSistemDurumuPanel();
        }
      }

      void loadPanelBackendStatus();
      setInterval(() => {
        void loadPanelBackendStatus();
      }, 15000);

      async function probeBridgeHealthOnce(url) {
        try {
          const r = await fetch(url, {
            method: "GET",
            cache: "no-store",
            mode: "cors",
            credentials: "omit",
          });
          const text = await r.text();
          if (!r.ok) {
            return { ok: false, detail: "HTTP " + r.status, url };
          }
          if (!text || !String(text).trim()) {
            return { ok: false, detail: "Boş yanıt", url };
          }
          try {
            const data = JSON.parse(text);
            if (data === null || typeof data !== "object" || Array.isArray(data)) {
              return { ok: false, detail: "Geçersiz JSON gövdesi", url };
            }
            if (String(data.status || "").toLowerCase() === "ok") {
              return { ok: true, detail: "status=ok", url };
            }
            if (data.ok === true) {
              return { ok: true, detail: "ok=true", url };
            }
            return { ok: false, detail: "Health alanları tanınmadı", url };
          } catch {
            return { ok: false, detail: "JSON ayrıştırılamadı", url };
          }
        } catch {
          return { ok: false, detail: "Ağ veya CORS", url };
        }
      }

      void (async function checkBridgeHealth() {
        setPanelConnBadge("pending");
        setPanelHealthDetail("Köprü deneniyor…");
        bridgeHealthLine = "deneniyor…";
        paintSistemDurumuPanel();
        const candidates = [
          HEALTH_URL,
          BRIDGE_BASE_URL + "/health",
          BRIDGE_BASE_URL + "/",
        ];
        const seen = new Set();
        let last = /** @type {{ ok: boolean, detail: string, url: string } | null} */ (null);
        try {
          let ok = false;
          for (let i = 0; i < candidates.length; i++) {
            const u = candidates[i];
            if (!u || seen.has(u)) continue;
            seen.add(u);
            const res = await probeBridgeHealthOnce(u);
            last = res;
            if (res.ok) {
              ok = true;
              setPanelHealthDetail("Health: OK · " + res.url);
              bridgeHealthLine = "OK · " + res.url;
              break;
            }
          }
          setPanelConnBadge(ok ? "ok" : "bad");
          if (!ok && last) {
            setPanelHealthDetail("Health: erişilemedi (" + last.detail + ") · " + last.url);
            bridgeHealthLine = "erişilemedi (" + last.detail + ")";
          } else if (!ok) {
            setPanelHealthDetail("Health: uygun URL yok (PUBLIC_LUMOS_PANEL_HEALTH_URL ayarlayın).");
            bridgeHealthLine = "uygun URL yok";
          }
        } catch {
          setPanelConnBadge("bad");
          setPanelHealthDetail("Health: istisna (köprü kapalı olabilir).");
          bridgeHealthLine = "istisna (köprü kapalı olabilir)";
        }
        paintSistemDurumuPanel();
      })();

      function wireMedyaOutbox() {
        const btn = document.getElementById("medya-outbox-refresh");
        const hint = document.getElementById("medya-outbox-hint");
        const pre = document.getElementById("medya-outbox-pre");
        if (!btn || !hint || !pre) return;

        async function refresh() {
          hint.hidden = true;
          hint.textContent = "";
          btn.disabled = true;
          const url = BRIDGE_BASE_URL + "/last-result";
          try {
            const r = await fetch(url, {
              method: "GET",
              headers: { "X-Kando-Token": kandoToken },
              cache: "no-store",
              mode: "cors",
              credentials: "omit",
            });
            const text = await r.text();
            if (!r.ok) {
              const snippet = text && String(text).trim().length ? String(text).trim().slice(0, 280) : "";
              hint.textContent =
                "Köprü yanıtı " + r.status + (snippet ? ": " + snippet : " (last-result yok veya token hatalı).");
              hint.hidden = false;
              pre.hidden = true;
              return;
            }
            let pretty = String(text || "").trim();
            try {
              const j = JSON.parse(pretty);
              pretty = JSON.stringify(j, null, 2);
            } catch {
              /* ham metin */
            }
            if (pretty.length > 5000) pretty = pretty.slice(0, 5000) + "\n…";
            pre.textContent = pretty || "—";
            pre.hidden = false;
          } catch {
            hint.textContent =
              "İstek başarısız (ağ, CORS veya köprü kapalı). Yerelde `./scripts/bridge_start.sh` ile deneyin.";
            hint.hidden = false;
            pre.hidden = true;
          } finally {
            btn.disabled = false;
          }
        }

        btn.addEventListener("click", () => {
          void refresh();
        });
      }

      wireMedyaOutbox();
    </script>
  </body>
</html>
