        async function restoreLastGorevlerTask() {
          if (!lastGorevlerDeletedId) return;
          hideHint();
          if (shouldSkipGorevlerTasksApi() || lastGorevlerDeletedLocalRow) {
            if (lastGorevlerDeletedLocalRow) {
              const row = sanitizeGorevlerRow(lastGorevlerDeletedLocalRow);
              if (row) {
                panelGorevlerTasks.push(row);
                persistPanelGorevlerTasks();
                render();
                const rid = row.id ? String(row.id).trim() : "";
                if (rid) {
                  enqueueEvidencePendingOp("restore", rid, "id");
                } else if (row.title) {
                  enqueueEvidencePendingOp("create", String(row.title).trim(), "title");
                }
              }
            }
            lastGorevlerDeletedId = "";
            lastGorevlerDeletedLocalRow = null;
            if (restoreLastBtn) restoreLastBtn.hidden = true;
            hideHint();
            refreshPanelEvidenceStripIfReady();
            return;
          }
          let res;
          let apiUnreachable = false;
          try {
            res = await tasksApiPost("/tasks/restore", { id: lastGorevlerDeletedId });
          } catch {
            apiUnreachable = true;
          }
          if (apiUnreachable || !res || !res.ok || !res.data || !res.data.ok) {
            if (shouldFallbackGorevlerTasksLocal(apiUnreachable) && lastGorevlerDeletedLocalRow) {
              const row = sanitizeGorevlerRow(lastGorevlerDeletedLocalRow);
              if (row) {
                panelGorevlerTasks.push(row);
