---
import GlobalMay19Corner from "../components/GlobalMay19Corner.astro";

/**
 * POST /chat tam URL (örn. `https://host/chat`).
 * GET /status: aynı origin’de `.../status` — `PUBLIC_LUMOS_PANEL_STATUS_URL` ile ayrı host verilmezse CHAT_URL’den türetilir.
 */
const CHAT_URL = import.meta.env.PUBLIC_LUMOS_CHAT_URL || "https://lumos-core-1.onrender.com/chat";
/** PUBLIC token visible in browser — local/dev only; prod build omits test123 fallback */
const kandoToken = import.meta.env.DEV
  ? import.meta.env.PUBLIC_KANDO_TOKEN || "test123"
  : import.meta.env.PUBLIC_KANDO_TOKEN || "";
const UPLOAD_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_UPLOAD_URL ||
  String(CHAT_URL).replace(/\/chat\/?$/i, "") + "/panel/upload";
/** Köprü tabanı: upload ile aynı origin (CHAT farklı host olsa bile rozet yerel bridge’e baksın). */
const BRIDGE_BASE_URL = String(UPLOAD_URL).replace(/\/panel\/upload\/?$/i, "");
/** Rozet: önce açık health URL; yoksa BRIDGE_BASE + /health (PUBLIC_LUMOS_PANEL_HEALTH_URL ve BRIDGE_HEALTH_URL birlikte desteklenir). */
const HEALTH_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_HEALTH_URL ||
  import.meta.env.PUBLIC_LUMOS_BRIDGE_HEALTH_URL ||
  BRIDGE_BASE_URL + "/health";
/** Backend "Sistem Durumu" (GET): varsayılan olarak CHAT_URL’deki `/chat` → `/status` ile aynı host. */
const STATUS_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_STATUS_URL ||
  String(CHAT_URL).replace(/\/chat\/?$/i, "") + "/status";
/** Görev motoru: GET/POST /tasks → `.lumos/tasks.json` (`panel/scripts/panel_tasks_server.py`, varsayılan :8766). */
const TASKS_API_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_TASKS_URL || "http://127.0.0.1:8766";
// Prod builds ignore PUBLIC_LUMOS_PANEL_DEV; bundle token risk is separate.
const PANEL_DEBUG = import.meta.env.DEV;
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover, user-scalable=no"
    />
    <title>Lumos Panel — Çalışma alanı</title>
    <link rel="icon" href="/lumos-tree-logo.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/lumos-tree-logo.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#38CEFF" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Lumos" />
    <style>
      :root {
        /**
         * Landing ile aynı kanal (index.astro :root — salt okunur referans).
         * Panel: koyu lacivert zemin, elektrik cyan-mavi, kontrollü sıcak altın.
         */
        --lumos-land-teal: 56 206 255;
        --lumos-land-teal-deep: 8 52 108;
        --lumos-land-warm: 186 148 88;
        --lumos-land-warm-deep: 128 96 54;
        --lumos-teal-12: rgb(var(--lumos-land-teal) / 0.12);
        --lumos-teal-14: rgb(var(--lumos-land-teal) / 0.14);
        --lumos-teal-16: rgb(var(--lumos-land-teal) / 0.16);
        --lumos-teal-18: rgb(var(--lumos-land-teal) / 0.18);
        --lumos-teal-22: rgb(var(--lumos-land-teal) / 0.22);
        --lumos-teal-28: rgb(var(--lumos-land-teal) / 0.28);
        --lumos-teal-32: rgb(var(--lumos-land-teal) / 0.32);
        --lumos-teal-35: rgb(var(--lumos-land-teal) / 0.35);
        --lumos-teal-38: rgb(var(--lumos-land-teal) / 0.38);
        --lumos-teal-40: rgb(var(--lumos-land-teal) / 0.4);
        --lumos-teal-42: rgb(var(--lumos-land-teal) / 0.42);
        --lumos-teal-48: rgb(var(--lumos-land-teal) / 0.48);
        --lumos-gold-soft: rgb(var(--lumos-land-warm) / 0.22);
        --lumos-gold-line: rgb(var(--lumos-land-warm) / 0.32);
        --lumos-bg: #030714;
        --lumos-surface: rgba(4, 8, 18, 0.96);
        --lumos-border: var(--lumos-teal-22);
        --lumos-card-border: rgb(var(--lumos-land-teal) / 0.28);
        --lumos-card-inset: rgba(255, 255, 255, 0.04);
        --lumos-gold: #c6a66a;
        --lumos-accent-blue: rgb(130 206 255 / 0.92);
        --lumos-text: #d4dae8;
        --lumos-text-soft: rgb(212 218 232 / 0.82);
        --lumos-muted: #aeb6c8;
        --lumos-input-bg: #020511;
        --lumos-sidebar-bg: #020511;
        --lumos-main-bg: #030714;
        --lumos-chat-head-bg: #030714;
        --lumos-chat-history-bg: #040a14;
        --lumos-compose-bg: rgba(3, 7, 20, 0.92);
        --lumos-chat-input-bg: #020511;
        --lumos-tq-badge-inset: rgb(var(--lumos-land-teal) / 0.14);
        --lumos-tq-badge-glow: rgb(var(--lumos-land-teal) / 0.1);
        --lumos-btn-a: rgba(12, 20, 36, 0.96);
        --lumos-btn-b: #030714;
        --lumos-user-bubble: rgba(8, 14, 28, 0.92);
        --lumos-lumos-bubble: rgba(4, 10, 22, 0.55);
        --lumos-error: #f0b4b4;
        --panel-radius: 10px;
        --panel-radius-lg: 12px;
        --panel-strip-bg: linear-gradient(178deg, #010308 0%, #061022 52%, #030714 100%);
        --panel-surface-raised: rgba(6, 12, 26, 0.94);
        --panel-edge-inset: inset 0 1px 0 rgba(255, 255, 255, 0.04);
        --panel-shadow-ambient: 0 1px 3px rgba(0, 0, 0, 0.45);
        --panel-body-wash:
          radial-gradient(ellipse 130% 88% at 50% -6%, rgb(12 40 88 / 0.42), transparent 54%),
          radial-gradient(ellipse 88% 52% at 94% 38%, rgb(var(--lumos-land-teal) / 0.06), transparent 46%),
          radial-gradient(ellipse 72% 48% at 10% 72%, rgb(var(--lumos-land-warm) / 0.028), transparent 50%),
          linear-gradient(178deg, #010308 0%, #061022 44%, #030714 100%);
        --panel-chat-wash:
          radial-gradient(ellipse 120% 100% at 50% 0%, rgb(var(--lumos-land-teal-deep) / 0.42), transparent 55%),
          radial-gradient(ellipse 90% 70% at 100% 100%, rgb(var(--lumos-land-teal) / 0.07), transparent 50%),
          linear-gradient(180deg, rgb(2 5 17) 0%, rgb(4 10 22) 52%, rgb(3 8 18) 100%);
      }
      * {
        box-sizing: border-box;
      }
      html {
        height: 100%;
      }
      body {
        margin: 0;
        height: 100vh;
        height: 100dvh;
        max-height: 100vh;
        max-height: 100dvh;
        overflow: hidden;
        overflow-x: hidden;
        background-color: var(--lumos-bg);
        background-image: var(--panel-body-wash);
        background-attachment: fixed;
        color: var(--lumos-text);
        font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, sans-serif;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      .panel-shell {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        max-height: 100%;
        width: 100%;
        max-width: 100%;
        min-width: 0;
      }
      .panel-header {
        flex-shrink: 0;
        padding: clamp(0.85rem, 2vw, 1.15rem) clamp(1rem, 3vw, 1.5rem);
        border-bottom: 1px solid var(--lumos-teal-38);
        box-shadow: 0 1px 0 rgb(var(--lumos-land-warm-deep) / 0.14);
        background: var(--panel-strip-bg);
      }
      .panel-header-title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        column-gap: 0.65rem;
        row-gap: 0.45rem;
      }
      .panel-header-brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        min-width: 0;
        flex: 1 1 12rem;
        overflow: visible;
      }
      .panel-conn-badge {
        flex: 0 0 auto;
        margin-left: auto;
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        padding: 0.2rem 0.48rem;
        border-radius: 999px;
        line-height: 1.25;
        border: 1px solid rgba(255, 255, 255, 0.12);
        white-space: nowrap;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
      }
      .panel-conn-badge[data-state="pending"] {
        color: rgba(200, 188, 160, 0.95);
        background: rgba(90, 72, 44, 0.28);
        border-color: rgba(184, 148, 96, 0.35);
      }
      .panel-conn-badge[data-state="ok"] {
        color: rgb(196 234 255 / 0.96);
        background: linear-gradient(180deg, rgb(6 16 36 / 0.96) 0%, rgb(2 6 18 / 0.98) 100%);
        border-color: var(--lumos-teal-38);
        box-shadow:
          inset 0 1px 0 var(--lumos-tq-badge-inset),
          0 0 14px rgb(var(--lumos-land-teal) / 0.14),
          0 0 0 1px rgb(var(--lumos-land-warm) / 0.18);
      }
      .panel-conn-badge[data-state="bad"] {
        color: rgba(240, 195, 195, 0.96);
        background: rgba(92, 42, 42, 0.32);
        border-color: rgba(200, 120, 110, 0.38);
      }
      .panel-conn-badge[data-state="limited"] {
        color: rgba(210, 198, 168, 0.92);
        background: rgba(72, 62, 48, 0.28);
        border-color: rgba(160, 140, 108, 0.32);
      }
      .panel-health-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 0.35rem 0.6rem;
        margin-top: 0;
        margin-left: auto;
        flex: 0 1 auto;
        max-width: 100%;
      }
      .gorevler-task-bridge {
        margin: 0;
        margin-top: 0.12rem;
        font-size: 0.72rem;
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: 0.01em;
        color: rgba(198, 194, 186, 0.78);
      }
      .gorevler-task-plan {
        margin: 0;
        margin-top: 0.1rem;
        font-size: 0.72rem;
        font-weight: 500;
        line-height: 1.45;
        color: rgba(212, 188, 150, 0.88);
      }
      .gorevler-plan-card {
        max-width: 36rem;
        margin-top: 0.65rem;
        padding: 0.85rem 1rem;
        border-radius: var(--panel-radius-lg);
        border: 1px solid rgba(184, 148, 96, 0.35);
        background: rgba(14, 13, 11, 0.96);
        box-shadow: var(--panel-edge-inset);
      }
      .gorevler-plan-card__title {
        margin: 0 0 0.55rem;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: rgba(212, 188, 150, 0.92);
      }
      .gorevler-plan-card__status {
        margin: 0 0 0.45rem;
        font-size: 0.74rem;
        color: rgba(168, 206, 182, 0.9);
      }
      .gorevler-plan-card__low-risk-note {
        margin: 0.5rem 0 0;
        font-size: 0.74rem;
        line-height: 1.45;
        color: rgba(184, 200, 220, 0.9);
      }
      .gorevler-plan-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 0.65rem;
      }
      /** display:flex [hidden]'ı ezer; düşük riskte butonlar görünmesin */
      .gorevler-plan-actions[hidden] {
        display: none !important;
      }
      .gorevler-plan-actions .gorevler-add-btn {
        flex: 1 1 auto;
        min-width: 10rem;
      }
      .gorevler-plan-teshis-compact {
        margin-top: 0.55rem;
        padding-top: 0.5rem;
        border-top: 1px dashed rgba(184, 148, 96, 0.28);
      }
      .gorevler-plan-teshis-compact[hidden] {
        display: none !important;
      }
      .gorevler-plan-teshis-compact__line {
        margin: 0.22rem 0 0;
        font-size: 0.71rem;
        line-height: 1.42;
        color: rgba(198, 194, 186, 0.86);
      }
      .gorevler-plan-teshis-compact__line strong {
        font-weight: 600;
        color: rgba(212, 188, 150, 0.9);
      }
      .medya-outbox-wrap {
        margin: 0.75rem 0 1.25rem;
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--lumos-card-border);
        border-radius: var(--panel-radius-lg);
        background: var(--lumos-surface);
        box-shadow: var(--panel-edge-inset);
      }
      .medya-outbox-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.45rem;
      }
      .medya-outbox-refresh {
        font: inherit;
        font-size: 0.78rem;
        padding: 0.35rem 0.65rem;
        border-radius: 8px;
        border: 1px solid var(--lumos-teal-35);
        background: var(--lumos-btn-a);
        color: var(--lumos-text);
        cursor: pointer;
      }
      .medya-outbox-refresh:hover {
        border-color: rgb(var(--lumos-land-teal) / 0.4);
      }
      .medya-outbox-refresh:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }
      .medya-outbox-pre {
        margin: 0.5rem 0 0;
        padding: 0.5rem 0.55rem;
        max-height: 12rem;
        overflow: auto;
        font-size: 0.68rem;
        line-height: 1.45;
        white-space: pre-wrap;
        word-break: break-word;
        background: var(--lumos-main-bg);
        border: 1px solid var(--lumos-teal-18);
        border-radius: 8px;
        color: var(--lumos-muted);
      }
      @media (max-width: 520px) {
        .panel-conn-badge {
          margin-left: 0;
          flex-basis: auto;
          width: auto;
          max-width: 100%;
          align-self: flex-start;
        }
        .panel-header-title-row {
          align-items: flex-start;
        }
        /* Rozet, işaret + başlık satırının altında hizalı */
        .panel-header-brand {
          flex: 1 1 100%;
        }
        .panel-conn-badge {
          margin-left: calc(1.42rem + 0.42rem);
        }
        .panel-health-row {
          justify-content: flex-start;
          margin-left: 0;
          width: 100%;
          flex-basis: 100%;
        }
      }
      .lumos-mark {
        position: relative;
        width: clamp(1.75rem, 4.2vw, 2.125rem);
        height: clamp(1.75rem, 4.2vw, 2.125rem);
        flex-shrink: 0;
        border-radius: 50%;
        background:
          radial-gradient(circle at 32% 22%, rgb(var(--lumos-land-teal) / 0.12) 0%, transparent 42%),
          radial-gradient(circle at 70% 78%, rgb(var(--lumos-land-warm) / 0.06) 0%, transparent 45%),
          linear-gradient(155deg, #0c1428 0%, #080f1e 42%, #030714 100%);
        border: 2px solid rgb(var(--lumos-land-warm) / 0.55);
        box-shadow:
          inset 0 0 0 1px rgb(var(--lumos-land-teal) / 0.12),
          inset 0 1px 0 rgba(255, 255, 255, 0.06),
          inset 0 -1px 4px rgba(0, 0, 0, 0.4),
          0 0 0 1px rgb(var(--lumos-land-teal) / 0.08);
      }
      .lumos-mark::before {
        content: "";
        position: absolute;
        inset: 4px;
        border-radius: 50%;
        box-sizing: border-box;
        border: 1px solid rgb(var(--lumos-land-warm) / 0.28);
        background: rgba(4, 8, 18, 0.62);
        pointer-events: none;
      }
      .lumos-mark::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 0.48rem;
        height: 0.62rem;
        margin: -0.34rem 0 0 -0.22rem;
        box-sizing: border-box;
        border-left: 2.5px solid rgba(244, 226, 188, 0.88);
        border-bottom: 2.5px solid rgba(220, 188, 130, 0.82);
        border-radius: 0 0 0 2px;
        filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.35));
        pointer-events: none;
      }
      .panel-header-brand h1 {
        margin: 0;
        font-size: clamp(1rem, 2vw, 1.2rem);
        font-weight: 600;
        letter-spacing: -0.018em;
        color: #e9eef5;
      }
      /**
       * Masaüstü: sol sütunda üstte Çalışma, altta Lumos çekirdeği; sağda `main` iki satırı kaplar.
       * Mobil: aynı üç çocuk `grid-template-areas` ile Çalışma → içerik → Lumos (Safari’de `display: contents` gerekmez).
       */
      .panel-body {
        display: grid;
        flex: 1;
        min-height: 0;
        min-width: 0;
        overflow: hidden;
        grid-template-columns: clamp(10rem, 22vw, 12.75rem) minmax(0, 1fr);
        grid-template-rows: auto minmax(0, 1fr);
        grid-template-areas:
          "nav-primary main"
          "nav-lumos main";
      }
      .panel-nav__primary {
        grid-area: nav-primary;
        align-self: stretch;
        min-height: 0;
        padding: 0.65rem 0.4rem 0.45rem 0;
        border-right: 1px solid var(--lumos-teal-18);
        border-bottom: 1px solid var(--lumos-teal-12);
        background: var(--lumos-sidebar-bg);
        overflow-x: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: var(--lumos-teal-40) rgba(2, 5, 17, 0.85);
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .panel-nav__lumos {
        grid-area: nav-lumos;
        align-self: stretch;
        min-height: 0;
        padding: 0.45rem 0.4rem 0.85rem 0;
        border-right: 1px solid var(--lumos-teal-18);
        background: var(--lumos-sidebar-bg);
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: var(--lumos-teal-40) rgba(2, 5, 17, 0.85);
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .panel-nav__primary::-webkit-scrollbar,
      .panel-nav__lumos::-webkit-scrollbar {
        width: 4px;
      }
      .panel-nav__primary::-webkit-scrollbar-track,
      .panel-nav__lumos::-webkit-scrollbar-track {
        margin: 4px 0;
        background: rgba(2, 5, 17, 0.95);
        border-radius: 999px;
      }
      .panel-nav__primary::-webkit-scrollbar-thumb,
      .panel-nav__lumos::-webkit-scrollbar-thumb {
        background: var(--lumos-teal-40);
        border-radius: 999px;
        border: 1px solid rgba(0, 0, 0, 0.35);
        background-clip: padding-box;
      }
      .panel-nav__primary::-webkit-scrollbar-thumb:hover,
      .panel-nav__lumos::-webkit-scrollbar-thumb:hover {
        background: var(--lumos-teal-48);
        background-clip: padding-box;
      }
      .panel-nav-sig {
        margin: 0.15rem 0.35rem 0.45rem 0.45rem;
        padding: 0;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(132, 128, 120, 0.52);
      }
      .panel-nav-sig span {
        color: rgba(200, 185, 150, 0.42);
        letter-spacing: 0.12em;
      }
      .panel-nav-group {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin-bottom: 0.5rem;
      }
      .panel-nav-group:last-child {
        margin-bottom: 0;
      }
      .panel-nav-collapsible {
        margin-bottom: 0.5rem;
      }
      .panel-nav-collapsible:last-child {
        margin-bottom: 0;
      }
      .panel-nav-group-toggle {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.4rem;
        width: calc(100% - 0.35rem);
        margin: 0.4rem 0 0.18rem 0.35rem;
        padding: 0.35rem 0.45rem 0.35rem 0.2rem;
        border: none;
        border-radius: 8px;
        background: transparent;
        cursor: pointer;
        font: inherit;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-align: left;
        color: rgba(136, 132, 126, 0.82);
        transition:
          background 0.15s ease,
          color 0.15s ease;
      }
      .panel-nav-collapsible:first-child > .panel-nav-group-toggle {
        margin-top: 0;
      }
      .panel-nav-group-toggle:hover {
        background: rgba(255, 255, 255, 0.035);
        color: rgba(228, 218, 198, 0.88);
        box-shadow: inset 0 0 0 1px rgb(var(--lumos-land-warm-deep) / 0.14);
      }
      .panel-nav-group-toggle:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px rgb(var(--lumos-land-teal) / 0.42);
      }
      .panel-nav-group-toggle-label {
        min-width: 0;
      }
      .panel-nav-group-items {
        display: flex;
        flex-direction: column;
        gap: 0;
      }
      /** display:flex üstünde [hidden] görünür kalmasın; gerçek aç/kapa */
      .panel-nav-group-items[hidden] {
        display: none !important;
      }
      /** Mobilde Lumos çekirdeği gizliyken Kuantum araştırma sekmesine kısa yol */
      .panel-nav-research-chip {
        display: none;
      }
      .lumos-soon-badge {
        display: inline-block;
        flex-shrink: 0;
        font-size: 0.56rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(200, 178, 132, 0.78);
        background: rgba(90, 72, 44, 0.22);
        border: 1px solid rgba(184, 148, 96, 0.2);
        padding: 0.1rem 0.34rem;
        border-radius: 4px;
        line-height: 1.2;
