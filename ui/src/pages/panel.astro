          else closePanelAttachMenu({ returnFocus: false });
        });

        attachMenu?.addEventListener("keydown", (e) => {
          if (attachMenu.hidden) return;
          const items = focusableAttachMenuItems();
          if (!items.length) return;
          const focusedIdx = items.findIndex((item) => item === document.activeElement);
          const idx = focusedIdx >= 0 ? focusedIdx : 0;
          if (e.key === "ArrowDown") {
            e.preventDefault();
            items[(idx + 1) % items.length]?.focus();
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            items[(idx - 1 + items.length) % items.length]?.focus();
          } else if (e.key === "Tab") {
            if (e.shiftKey) {
              if (focusedIdx <= 0) {
                e.preventDefault();
                items[items.length - 1]?.focus();
              }
            } else if (focusedIdx === items.length - 1 || focusedIdx < 0) {
              e.preventDefault();
              items[0]?.focus();
            }
          } else if (e.key === "Escape") {
            e.preventDefault();
            closePanelAttachMenu();
          }
        });

