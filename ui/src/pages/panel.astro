  <body class="panel-page" data-panel-debug={PANEL_DEBUG ? "true" : "false"}>
    <div class="panel-shell">
      <header class="panel-header">
        <div class="panel-header-title-row">
          <div class="panel-header-brand">
            <img class="lumos-mark" src="/chat-lumos-mark.svg" alt="" width="34" height="34" decoding="async" />
