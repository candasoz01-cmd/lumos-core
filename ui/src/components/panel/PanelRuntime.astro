              hideHint();
              refreshPanelEvidenceStripIfReady();
              return;
            }
            const err =
              res && res.data && res.data.error != null ? String(res.data.error) : "restore_failed";
            const completeErrCtx = {
              rawError: err,
              httpStatus: res ? res.status : null,
              apiUnreachable,
