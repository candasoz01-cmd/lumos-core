      function gorevlerPriorityLabel(key) {
        const k = key != null ? String(key).trim() : "";
        const map = {
          dusuk: panelT("panel.modules.tasks.priority.dusuk"),
          orta: panelT("panel.modules.tasks.priority.orta"),
          yuksek: panelT("panel.modules.tasks.priority.yuksek"),
