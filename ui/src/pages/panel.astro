    <script define:vars={{ CHAT_URL, kandoToken, UPLOAD_URL, HEALTH_URL, BRIDGE_BASE_URL }}>
      /** Görevler sekmesi ile sohbet görev komutları tek diziyi paylaşır (wireGorevlerPrototype). Kalıcılık: tarayıcı localStorage. */
      const PANEL_GOREVLER_LS_KEY = "lumos_panel_gorevler_list_v1";
      const GOREVLER_FIELD_MAX_LEN = 2048;

      function truncateGorevlerField(s) {
        const t = String(s || "").trim();
        if (!t) return "";
        return t.length > GOREVLER_FIELD_MAX_LEN
          ? t.slice(0, GOREVLER_FIELD_MAX_LEN) + "…"
          : t;
      }

      const defaultGorevlerSeed = [
        { title: "Panel API durumunu kontrol et", priority: "orta", status: "onay_bekliyor" },
        { title: "Güvenlik sekmesini gözden geçir", priority: "dusuk", status: "tamamlandi" },
      ];

      function sanitizeBridgeLast(bl) {
        if (!bl || typeof bl !== "object") return null;
        const iso = String(bl.lastBridgeAt || "").trim();
        if (!iso || Number.isNaN(Date.parse(iso))) return null;
        const out = { lastBridgeAt: iso };
        for (const k of ["route", "source", "result_file", "execution_file"]) {
          const v = truncateGorevlerField(bl[k]);
          if (v) out[k] = v;
        }
        if (bl.accepted === true || bl.accepted === false) out.accepted = bl.accepted;
        return out;
      }

      function sanitizeGorevlerRow(x) {
        if (!x || typeof x !== "object") return null;
        const title = String(x.title || "").trim();
        if (!title) return null;
        const pr = ["dusuk", "orta", "yuksek"].includes(x.priority) ? x.priority : "orta";
        const st = ["bekliyor", "onay_bekliyor", "tamamlandi"].includes(x.status) ? x.status : "bekliyor";
        const row = { title, priority: pr, status: st };
        const w = x.when != null ? String(x.when).trim() : "";
        if (w) row.when = w;
        const bridge = sanitizeBridgeLast(x.bridgeLast);
        if (bridge) row.bridgeLast = bridge;
        return row;
      }

      function loadPanelGorevlerTasksFromStorage() {
        try {
          if (typeof localStorage === "undefined") return undefined;
          const raw = localStorage.getItem(PANEL_GOREVLER_LS_KEY);
          if (raw == null || raw === "") return undefined;
          const a = JSON.parse(raw);
          if (!Array.isArray(a)) return [];
          const out = [];
          for (let i = 0; i < a.length; i++) {
            const r = sanitizeGorevlerRow(a[i]);
            if (r) out.push(r);
          }
          return out;
        } catch {
          return [];
        }
      }

      function persistPanelGorevlerTasks() {
        try {
          if (typeof localStorage === "undefined") return;
          localStorage.setItem(PANEL_GOREVLER_LS_KEY, JSON.stringify(panelGorevlerTasks));
        } catch (_) {
          /* kota / gizli mod */
        }
      }

      const storedGorevler = loadPanelGorevlerTasksFromStorage();
      const panelGorevlerTasks =
        storedGorevler === undefined ? defaultGorevlerSeed.slice() : storedGorevler;

      if (storedGorevler === undefined) {
        persistPanelGorevlerTasks();
      }

      let panelGorevlerTasksRender = null;

      /** @typedef {{ title: string, whenSummary: string | null }} PanelGorevKomut */

      function pad2(n) {
        const x = String(Number(n));
        return x.length >= 2 ? x : "0" + x;
      }

      /** Kullanıcı yazımı: gorev/yarain/saar vb. — ayrıştırmadan önce tek satırda düzeltir. */
      function normalizeUserTaskMessage(s) {
        return String(s || "")
          .replace(/\bgorev\b/gi, "görev")
          .replace(/\bolustur\b/gi, "oluştur")
          .replace(/\byarain\b/gi, "yarın")
          .replace(/\byarin\b/gi, "yarın")
          .replace(/\bsaar\b/gi, "saat")
          .replace(/\bbugun\b/gi, "bugün");
      }

      /** Lumos metninden Görev:/Tarih:/Saat: satırları (ekleyemiyorum densene çalışır). */
      function parsePanelGorevFromAssistantReply(raw) {
        const t = String(raw || "")
          .replace(/\*\*/g, "")
          .replace(/\r\n/g, "\n")
          .trim();
        if (!t) return null;
        const g = /(?:^|\n)\s*Görev\s*:\s*([^\n]+)/i.exec(t);
        if (!g) return null;
        const title = g[1].trim().replace(/^>\s*/, "");
        if (!title) return null;
        const parts = [];
        const d = /(?:^|\n)\s*Tarih\s*:\s*([^\n]+)/i.exec(t);
        if (d) {
          const dl = d[1].trim().toLocaleLowerCase("tr-TR");
          if (/\byarın\b|\byarin\b|\byarain\b/.test(dl)) parts.push("Yarın");
          else if (/\bbugün\b|\bbugun\b/.test(dl)) parts.push("Bugün");
          else if (d[1].trim()) parts.push(d[1].trim());
        }
        const st = /(?:^|\n)\s*Saat\s*:\s*([^\n]+)/i.exec(t);
        if (st) {
          const sx = st[1].trim();
          const tm = /^(\d{1,2})(?:\s*[:.]\s*(\d{2}))?$/.exec(sx);
          if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
          else parts.push(sx);
        }
        const whenSummary = parts.length ? parts.join(" ") : null;
        return { title, whenSummary };
      }

      function panelGorevRowExists(title, whenSummary) {
        const w = whenSummary || null;
        return panelGorevlerTasks.some((x) => x.title === title && (x.when || null) === w);
      }

      /**
       * Onay sorusu / dış uygulama uyarısı içeren Lumos metninden mini görev başlığı.
       * Örn: Mini görev olarak 'tiss' eklemek istiyorsun, doğru mu?
       */
      function parsePanelGorevLooseFromAssistant(raw) {
        const t = String(raw || "").replace(/\*\*/g, "").replace(/\r\n/g, "\n");
        const m =
          /mini\s+görev\s+olarak\s+['"'‘’«\u201c](.+?)['"'‘’»\u201d]/i.exec(t);
        if (!m) return null;
        const title = m[1].trim();
        return title ? { title, whenSummary: null, replyKind: "mini" } : null;
      }

      /** Asistan cevabından yerel listeye aktarır; mini onay cümlelerinde sohbet metnini kısaltır. */
      function ingestAssistantPanelGorev(replyBody) {
        let cmd = parsePanelGorevFromAssistantReply(replyBody);
        if (cmd) {
          const w = cmd.whenSummary || null;
          if (!panelGorevRowExists(cmd.title, w)) applyPanelGorevKomutu(cmd);
          return { lumosText: String(replyBody || "").trim() };
        }
        const loose = parsePanelGorevLooseFromAssistant(replyBody);
        if (loose) {
          const w = loose.whenSummary || null;
          if (!panelGorevRowExists(loose.title, w)) {
            applyPanelGorevKomutu({ title: loose.title, whenSummary: loose.whenSummary || null });
          }
          if (loose.replyKind === "mini") {
            return { lumosText: `Mini görev eklendi: ${loose.title}` };
          }
        }
        return { lumosText: String(replyBody || "").trim() };
      }

      /**
       * "görev oluştur …" kuyruğundan başlık + Yarın 14:00 benzeri özet (yarain/saar toleranslı).
       */
      function parseOlusturRest(restRaw) {
        const rest = normalizeUserTaskMessage(String(restRaw || "").trim());
        if (!rest) return { title: "", whenSummary: null };
        const parts = [];
        if (/\byarın\b/i.test(rest)) parts.push("Yarın");
        else if (/\bbugün\b/i.test(rest)) parts.push("Bugün");
        const tm = /\bsaat\s*(\d{1,2})(?:\s*[:.]\s*(\d{2}))?\b/i.exec(rest);
        if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
        let titleWork = rest
          .replace(/\byarın\b/gi, " ")
          .replace(/\bbugün\b/gi, " ")
          .replace(/\bsaat\s*\d{1,2}(?:\s*[:.]\s*\d{2})?\b/gi, " ")
          .replace(/\s+/g, " ")
          .trim();
        if (!titleWork) titleWork = normalizeUserTaskMessage(String(restRaw || "").trim());
        const whenSummary = parts.length ? parts.join(" ") : null;
        return { title: titleWork, whenSummary };
      }

      /**
       * "yarın saat 14:00" / "bugün 09:30" vb. önekten görünen özet üretir (chat + liste).
       */
      function parseSchedulePrefix(prefixRaw) {
        const prefix = normalizeUserTaskMessage(String(prefixRaw || "").trim());
        if (!prefix) return { whenSummary: null };
        const pl = prefix.toLocaleLowerCase("tr-TR");
        const parts = [];
        if (/\byarın\b|\byarain\b|\byarin\b/i.test(prefix)) parts.push("Yarın");
        else if (/\bbugün\b|\bbugun\b/i.test(prefix)) parts.push("Bugün");
        const tm = /(?:saat\s*)?(\d{1,2})(?:\s*[:.]\s*(\d{2}))?\b/.exec(pl);
        if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
        const whenSummary = parts.length ? parts.join(" ") : prefix;
        return { whenSummary };
      }

      /** NBSP / büyük-küçük harf / birleşik Unicode — komut satırını tek forma çeker. */
      function canonicalizeTaskInput(raw) {
        let s = String(raw || "")
          .replace(/\u00a0/g, " ")
          .normalize("NFKC")
          .trim();
        s = normalizeUserTaskMessage(s);
        s = s.toLocaleLowerCase("tr-TR").replace(/\s+/g, " ").trim();
        return s;
      }

      /**
       * mini görev ekle … | görev oluştur … | … görev ekle … (isteğe bağlı tarih/saat öneki).
       * accepted / onay beklemez; yalnızca yerel liste ile bağlar.
       */
      function parsePanelGorevKomutu(raw) {
        const s0 = String(raw || "").trim();
        if (!s0) return null;
        const s = canonicalizeTaskInput(s0);

        let m = /^\s*mini\s+görev\s+ekle\s+(.+)$/i.exec(s);
        if (m) {
          const title = m[1].trim();
          return title ? { title, whenSummary: null, replyKind: "mini" } : null;
        }

        m = /^\s*görev\s+oluştur\s+(.+)$/i.exec(s);
        if (m) {
          const { title, whenSummary } = parseOlusturRest(m[1]);
          return title ? { title, whenSummary } : null;
        }

        m = /^\s*(?:([\s\S]*?)\s+)?görev\s+ekle\s+(.+)$/i.exec(s);
        if (!m) return null;
        const pre = (m[1] || "").trim();
        const title = (m[2] || "").trim();
        if (!title) return null;
        const { whenSummary } = parseSchedulePrefix(pre);
        return { title, whenSummary };
      }

      function buildPanelGorevConfirmation(cmd) {
        if (cmd.replyKind === "mini") return `Mini görev eklendi: ${cmd.title}`;
        return cmd.whenSummary
          ? `Görev eklendi: ${cmd.title} — ${cmd.whenSummary}`
          : `Görev eklendi: ${cmd.title}`;
      }

      function applyPanelGorevKomutu(cmd) {
        const row = {
          title: cmd.title,
          priority: "orta",
          status: "bekliyor",
        };
        if (cmd.whenSummary) row.when = cmd.whenSummary;
        panelGorevlerTasks.push(row);
        persistPanelGorevlerTasks();
        if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
      }

      function wirePanel() {
        const nav = document.querySelector(".panel-nav");
        const panels = document.querySelectorAll("[data-module-panel]");
        const sendBtn = document.getElementById("panel-send");
        const sendLabelEl = sendBtn?.querySelector(".chat-compose-send__label");
        const input = document.getElementById("panel-msg");
        const thread = document.getElementById("chat-thread");
        if (!nav || !sendBtn || !input || !thread) return;

        function expandNavGroupIfActiveHidden() {
          const active = nav.querySelector('button[data-module][aria-current="true"]');
          if (!active) return;
          const items = active.closest(".panel-nav-group-items");
          if (!items || !items.hasAttribute("hidden")) return;
          items.removeAttribute("hidden");
          const collapsible = items.closest(".panel-nav-collapsible");
          const toggle = collapsible?.querySelector(".panel-nav-group-toggle");
          if (toggle) toggle.setAttribute("aria-expanded", "true");
        }
        expandNavGroupIfActiveHidden();

        nav.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLElement)) return;
          const groupToggle = t.closest(".panel-nav-group-toggle");
          if (groupToggle) {
            const expanded = groupToggle.getAttribute("aria-expanded") === "true";
            const next = !expanded;
            groupToggle.setAttribute("aria-expanded", next ? "true" : "false");
            const cid = groupToggle.getAttribute("aria-controls");
            const panel = cid ? document.getElementById(cid) : null;
            if (panel) {
              if (next) panel.removeAttribute("hidden");
              else panel.setAttribute("hidden", "");
            }
            return;
          }
          const btn = t.closest("button[data-module]");
          if (!btn) return;
          const id = btn.getAttribute("data-module");
          if (!id) return;
          nav.querySelectorAll("button[data-module]").forEach((b) => {
            b.setAttribute("aria-current", b === btn ? "true" : "false");
          });
          panels.forEach((p) => {
            p.setAttribute("data-active", p.getAttribute("data-module-panel") === id ? "true" : "false");
          });
        });

        const sendLabel = "Gönder";
        const loadingLabel = "Gönderiliyor…";
        const CHAT_HISTORY_LIMIT = 12;
        let sending = false;

        function escapeHtml(s) {
          return String(s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        function formatAssistantHtml(raw) {
          let s = escapeHtml(String(raw));
          s = s.replace(/\*\*([\s\S]+?)\*\*/g, "<strong>$1</strong>");
          s = s.replace(/\*\*/g, "");
          s = s.replace(/\n/g, "<br />");
          return s;
        }

        /** Lumos gövdesinden (strong, br) backend geçmişi için düz metin üretir. */
        function lumosBodyToPlainText(root) {
          const out = [];
          function walk(n) {
            if (n.nodeType === Node.TEXT_NODE) out.push(n.textContent);
            else if (n.nodeType === Node.ELEMENT_NODE) {
              const el = /** @type {Element} */ (n);
              if (el.tagName === "BR") out.push("\n");
              else el.childNodes.forEach(walk);
            }
          }
          walk(root);
          return out.join("").trim();
        }

        /** Mevcut iplikten (yeni kullanıcı mesajı eklenmeden önce) son N mesajı role/content olarak döner. */
        function collectThreadHistory(threadEl) {
          const nodes = threadEl.querySelectorAll(".chat-msg");
          const items = [];
          for (const wrap of nodes) {
            let role;
            if (wrap.classList.contains("chat-msg--user")) role = "user";
            else if (wrap.classList.contains("chat-msg--lumos")) role = "assistant";
            else continue;
            const body = wrap.querySelector(".chat-msg-body");
            let text = "";
            if (role === "assistant" && body) {
              text = lumosBodyToPlainText(body);
            } else if (body && body.textContent) {
              text = body.textContent.trim();
            }
            if (!text) continue;
            items.push({ role, content: text });
          }
          if (items.length <= CHAT_HISTORY_LIMIT) return items;
          return items.slice(-CHAT_HISTORY_LIMIT);
        }

        function appendBubble(kind, text) {
          const turn = document.createElement("div");
          turn.className =
            "chat-turn " +
            (kind === "user" ? "chat-turn--user" : kind === "error" ? "chat-turn--error" : "chat-turn--lumos");

          const wrap = document.createElement("div");
          wrap.className =
            "chat-msg " +
            (kind === "user" ? "chat-msg--user" : kind === "error" ? "chat-msg--error" : "chat-msg--lumos");
          const role = document.createElement("span");
          role.className = "chat-msg-role";
          role.textContent = kind === "user" ? "Sen" : kind === "error" ? "Uyarı" : "Lumos";
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          if (kind === "lumos") {
            body.innerHTML = formatAssistantHtml(text);
          } else {
            body.textContent = text;
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        async function runSend() {
          const message = input.value.trim();
          if (!message || sending) return;

          const panelGorevCmd = parsePanelGorevKomutu(message);

          sending = true;
          sendBtn.disabled = true;
          sendBtn.setAttribute("aria-busy", "true");
          sendBtn.setAttribute("aria-label", loadingLabel);
          sendBtn.setAttribute("title", loadingLabel);
          sendBtn.classList.add("chat-compose-send--busy");
          if (sendLabelEl) sendLabelEl.textContent = loadingLabel;
          const history = collectThreadHistory(thread);
          appendBubble("user", message);

          /** Liste + onay: fetch’ten önce; aksi halde uzayan / takılan istek zinciri burada kopar (runSend hiç ilerlemez). */
          if (panelGorevCmd) {
            applyPanelGorevKomutu(panelGorevCmd);
            appendBubble("lumos", buildPanelGorevConfirmation(panelGorevCmd));
            input.value = "";
          }

          try {
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify({ message, history }),
            });
            const text = await r.text();

            if (!r.ok) {
              console.warn("[Lumos panel chat] HTTP error", r.status);
              if (!panelGorevCmd) {
                appendBubble(
                  "error",
                  "Sunucu şu anda yanıtı işleyemedi. Biraz sonra tekrar deneyebilirsin."
                );
              }
            } else {
              const INVALID_FORMAT_MSG =
                "Sunucu yanıtı beklenen formatta değil. Biraz sonra tekrar deneyebilirsin.";
              const EMPTY_REPLY_MSG =
                "Bu sefer boş bir yanıt geldi. Sorunu biraz açıp yeniden deneyebilirsin.";

              let data = null;
              let parsed = false;
              if (text && text.trim()) {
                try {
                  data = JSON.parse(text);
                  parsed = true;
                } catch {
                  if (!panelGorevCmd) appendBubble("error", INVALID_FORMAT_MSG);
                }
              } else {
                if (!panelGorevCmd) appendBubble("error", INVALID_FORMAT_MSG);
              }

              if (parsed) {
                const isPlainObject =
                  data !== null && typeof data === "object" && !Array.isArray(data);
                const hasChatBodyKey =
                  isPlainObject &&
                  ("reply" in data || "content" in data || "message" in data);
                if (!isPlainObject || !hasChatBodyKey) {
                  if (!panelGorevCmd) appendBubble("error", INVALID_FORMAT_MSG);
                } else if (!panelGorevCmd) {
                  const raw = data.reply ?? data.content ?? data.message;
                  const replyBody = raw == null ? "" : String(raw);
                  if (replyBody.trim()) {
                    const { lumosText } = ingestAssistantPanelGorev(replyBody);
                    appendBubble("lumos", lumosText);
                    input.value = "";
                  } else {
                    appendBubble("lumos", EMPTY_REPLY_MSG);
                  }
                }
              }
            }
          } catch {
            if (!panelGorevCmd) {
              appendBubble(
                "error",
                "Sunucuya ulaşılamadı. Bağlantıyı veya servis durumunu kontrol edip tekrar deneyebilirsin."
              );
            }
          } finally {
            sending = false;
            sendBtn.disabled = false;
            sendBtn.removeAttribute("aria-busy");
            sendBtn.setAttribute("aria-label", sendLabel);
            sendBtn.setAttribute("title", sendLabel);
            sendBtn.classList.remove("chat-compose-send--busy");
            if (sendLabelEl) sendLabelEl.textContent = sendLabel;
          }
        }

        sendBtn.addEventListener("click", () => {
          void runSend();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter" || e.shiftKey) return;
          e.preventDefault();
          void runSend();
        });

        const voiceBtn = document.getElementById("panel-voice-input");
        const voiceHint = document.getElementById("panel-voice-hint");
        let voiceRec = null;
        let voiceListening = false;

        function setVoiceHint(msg) {
          if (!voiceHint) return;
          voiceHint.textContent = msg;
          voiceHint.hidden = !msg;
        }

        function stopVoiceListeningUi() {
          voiceListening = false;
          if (voiceBtn) {
            voiceBtn.classList.remove("chat-compose-voice-btn--listening");
            voiceBtn.setAttribute("aria-pressed", "false");
          }
        }

        function appendVoiceTranscript(chunk) {
          const t = String(chunk || "").trim();
          if (!t) return;
          const cur = input.value;
          const sep = cur && !/\s$/.test(cur) ? " " : "";
          input.value = cur + sep + t;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }

        voiceBtn?.addEventListener("click", () => {
          const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
          if (!SR) {
            setVoiceHint("Bu tarayıcıda sesli giriş desteklenmiyor.");
            return;
          }

          if (voiceListening && voiceRec) {
            try {
              voiceRec.stop();
            } catch {
              /* ignore */
            }
            return;
          }

          voiceRec = new SR();
          voiceRec.lang = "tr-TR";
          voiceRec.interimResults = false;
          voiceRec.continuous = false;
          voiceRec.maxAlternatives = 1;

          voiceListening = true;
          voiceBtn.classList.add("chat-compose-voice-btn--listening");
          voiceBtn.setAttribute("aria-pressed", "true");
          setVoiceHint("");

          voiceRec.onresult = (ev) => {
            let spoken = "";
            for (let i = ev.resultIndex; i < ev.results.length; i++) {
              spoken += ev.results[i][0].transcript;
            }
            appendVoiceTranscript(spoken);
            if (voiceHint) voiceHint.hidden = true;
          };

          voiceRec.onerror = (ev) => {
            if (ev.error === "not-allowed" || ev.error === "service-not-allowed") {
              setVoiceHint("Mikrofon izni verilmedi.");
            }
            stopVoiceListeningUi();
          };

          voiceRec.onend = () => {
            stopVoiceListeningUi();
          };

          try {
            voiceRec.start();
          } catch {
            stopVoiceListeningUi();
            setVoiceHint("Bu tarayıcıda sesli giriş desteklenmiyor.");
          }
        });

        const cameraBtn = document.getElementById("panel-camera-input");
        const cameraHint = document.getElementById("panel-camera-hint");
        const cameraPreviewWrap = document.getElementById("panel-camera-preview-wrap");
        const cameraVideo = /** @type {HTMLVideoElement | null} */ (document.getElementById("panel-camera-video"));
        let cameraStream = null;

        function setCameraHint(msg) {
          if (!cameraHint) return;
          cameraHint.textContent = msg;
          cameraHint.hidden = !msg;
        }

        function stopCameraStream() {
          if (cameraStream) {
            cameraStream.getTracks().forEach((tr) => tr.stop());
            cameraStream = null;
          }
          if (cameraVideo) cameraVideo.srcObject = null;
          if (cameraPreviewWrap) cameraPreviewWrap.hidden = true;
          if (cameraBtn) {
            cameraBtn.classList.remove("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "false");
          }
        }

        function onDocVisibilityForCamera() {
          if (document.hidden) stopCameraStream();
        }

        document.addEventListener("visibilitychange", onDocVisibilityForCamera);
        window.addEventListener("pagehide", stopCameraStream);

        cameraBtn?.addEventListener("click", () => {
          if (cameraStream) {
            stopCameraStream();
            setCameraHint("");
            return;
          }

          if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== "function") {
            setCameraHint("Bu tarayıcıda kamera girişi desteklenmiyor.");
            return;
          }

          setCameraHint("");
          navigator.mediaDevices
            .getUserMedia({ video: true, audio: false })
            .then((stream) => {
              cameraStream = stream;
              if (cameraVideo) cameraVideo.srcObject = stream;
              if (cameraPreviewWrap) cameraPreviewWrap.hidden = false;
              if (cameraBtn) {
                cameraBtn.classList.add("chat-compose-camera-btn--active");
                cameraBtn.setAttribute("aria-pressed", "true");
              }
            })
            .catch((err) => {
              const name = err && err.name;
              if (name === "NotAllowedError" || name === "PermissionDeniedError") {
                setCameraHint("Kamera izni verilmedi.");
              } else {
                setCameraHint("Bu tarayıcıda kamera girişi desteklenmiyor.");
              }
              stopCameraStream();
            });
        });
      }

      function wireGorevlerPrototype() {
        const listEl = document.getElementById("gorevler-list");
        const titleInput = document.getElementById("gorevler-title-input");
        const prioritySel = document.getElementById("gorevler-priority");
        const statusSel = document.getElementById("gorevler-status");
        const addBtn = document.getElementById("gorevler-add");
        const hintEl = document.getElementById("gorevler-hint");
        const detailEl = document.getElementById("gorevler-detail");
        const detailTitleEl = document.getElementById("gorevler-detail-title");
        const detailDl = document.getElementById("gorevler-detail-dl");
        const detailCloseBtn = document.getElementById("gorevler-detail-close");
        if (
          !listEl ||
          !titleInput ||
          !prioritySel ||
          !statusSel ||
          !addBtn ||
          !hintEl ||
          !detailEl ||
          !detailTitleEl ||
          !detailDl ||
          !detailCloseBtn
        ) {
          console.warn("[Lumos panel görev] wireGorevlerPrototype erken çıkış — görev listesi bağlanmadı.", {
            listEl: !!listEl,
            titleInput: !!titleInput,
            prioritySel: !!prioritySel,
            statusSel: !!statusSel,
            addBtn: !!addBtn,
            hintEl: !!hintEl,
            detailEl: !!detailEl,
            detailTitleEl: !!detailTitleEl,
            detailDl: !!detailDl,
            detailCloseBtn: !!detailCloseBtn,
          });
          return;
        }

        const priorityLabels = { dusuk: "Düşük", orta: "Orta", yuksek: "Yüksek" };
        const statusLabels = {
          bekliyor: "Bekliyor",
          onay_bekliyor: "Onay bekliyor",
          tamamlandi: "Tamamlandı",
        };

        let gorevlerEscapeHandler = null;
        let lastGorevlerOpenedIndex = -1;

        function closeGorevlerDetail(restoreFocus) {
          detailEl.hidden = true;
          detailDl.replaceChildren();
          detailTitleEl.textContent = "Görev detayı";
          listEl.querySelectorAll(".gorevler-task-card").forEach((node) => {
            node.setAttribute("aria-expanded", "false");
          });
          if (gorevlerEscapeHandler) {
            document.removeEventListener("keydown", gorevlerEscapeHandler);
            gorevlerEscapeHandler = null;
          }
          if (restoreFocus && lastGorevlerOpenedIndex >= 0) {
            const li = listEl.querySelector(
              '[data-task-index="' + String(lastGorevlerOpenedIndex) + '"]',
            );
            if (li && typeof li.focus === "function") li.focus({ preventScroll: true });
          }
          lastGorevlerOpenedIndex = -1;
        }

        function formatTrDateTime(iso) {
          const s = String(iso || "").trim();
          if (!s) return "—";
          const d = new Date(s);
          if (Number.isNaN(d.getTime())) return "—";
          try {
            return d.toLocaleString("tr-TR", { dateStyle: "short", timeStyle: "medium" });
          } catch {
            return s;
          }
        }

        /** Köprü JSON alanları (detay + kalıcılık). */
        function bridgeFieldsFromJson(data) {
          const empty = {
            route: null,
            source: null,
            accepted: null,
            result_file: null,
            execution_file: null,
          };
          if (!data || typeof data !== "object") return empty;
          const route =
            data.route != null && String(data.route).trim() ? String(data.route).trim() : null;
          const source =
            data.source != null && String(data.source).trim() ? String(data.source).trim() : null;
          let accepted = null;
          if (data.accepted === true || data.accepted === false) accepted = data.accepted;
          const result_file =
            data.result_file != null && String(data.result_file).trim()
              ? String(data.result_file).trim()
              : null;
          const execution_file =
            data.execution_file != null && String(data.execution_file).trim()
              ? String(data.execution_file).trim()
              : null;
          return { route, source, accepted, result_file, execution_file };
        }

        function assignTaskBridgeLast(taskRef, data, acceptedOverride) {
          const ts = new Date().toISOString();
          const f = bridgeFieldsFromJson(data);
          const snap = { ...f, lastBridgeAt: ts };
          if (acceptedOverride === true || acceptedOverride === false) snap.accepted = acceptedOverride;
          const sane = sanitizeBridgeLast(snap) || { lastBridgeAt: ts };
          taskRef.bridgeLast = sane;
          persistPanelGorevlerTasks();
        }

        function lumosOutboxPathBasename(p) {
          const s = p != null ? String(p).trim() : "";
          if (!s) return "";
          const parts = s.replace(/\\/g, "/").split("/");
          return parts[parts.length - 1] || s;
        }

        function appendDetailRow(label, value) {
          const dt = document.createElement("dt");
          dt.textContent = label;
          const dd = document.createElement("dd");
          dd.textContent = value != null && String(value).trim() ? String(value).trim() : "—";
          detailDl.appendChild(dt);
          detailDl.appendChild(dd);
        }

        function openGorevlerDetail(taskIndex) {
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          lastGorevlerOpenedIndex = taskIndex;
          const bl = t.bridgeLast && typeof t.bridgeLast === "object" ? t.bridgeLast : null;
          detailTitleEl.textContent = "Görev detayı — " + t.title;
          detailDl.replaceChildren();

          let route = "—";
          let source = "—";
          let acceptedTxt = "—";
          let resultFile = "—";
          let execFile = "—";
          let lastOp = "—";

          if (bl) {
            lastOp = formatTrDateTime(bl.lastBridgeAt);
            if (bl.route) route = bl.route;
            if (bl.source) source = bl.source;
            if (bl.accepted === true) acceptedTxt = "Evet";
            else if (bl.accepted === false) acceptedTxt = "Hayır";
            if (bl.result_file) {
              const raw = String(bl.result_file).trim();
              const bn = lumosOutboxPathBasename(raw);
              resultFile = bn || raw;
            }
            if (bl.execution_file) {
              const raw = String(bl.execution_file).trim();
              const bn = lumosOutboxPathBasename(raw);
              execFile = bn || raw;
            }
          }

          appendDetailRow("route", route);
          appendDetailRow("source", source);
          appendDetailRow("accepted", acceptedTxt);
          appendDetailRow("result_file", resultFile);
          appendDetailRow("execution_file", execFile);
          appendDetailRow("Son işlem zamanı", lastOp);

          detailEl.hidden = false;
          if (!gorevlerEscapeHandler) {
            gorevlerEscapeHandler = (ev) => {
              if (ev.key !== "Escape" || detailEl.hidden) return;
              ev.preventDefault();
              closeGorevlerDetail(true);
            };
            document.addEventListener("keydown", gorevlerEscapeHandler);
          }
          if (typeof detailEl.focus === "function") detailEl.focus({ preventScroll: true });
        }

        function render() {
          closeGorevlerDetail(false);
          listEl.replaceChildren();
          for (let i = 0; i < panelGorevlerTasks.length; i++) {
            const t = panelGorevlerTasks[i];
            const li = document.createElement("li");
            li.className = "gorevler-task-card";
            li.tabIndex = 0;
            li.setAttribute("role", "button");
            li.setAttribute("data-task-index", String(i));
            li.setAttribute("aria-expanded", "false");
            li.setAttribute("aria-controls", "gorevler-detail");
            li.setAttribute("aria-label", "Görev: " + t.title + "; ayrıntıları göster");

            const main = document.createElement("div");
            main.className = "gorevler-task-main";

            const titleStrong = document.createElement("strong");
            titleStrong.className = "gorevler-task-title";
            titleStrong.textContent = t.title;
            main.appendChild(titleStrong);

            const metaSpan = document.createElement("span");
            metaSpan.className = "gorevler-task-meta";
            metaSpan.textContent =
              "Durum: " +
              (statusLabels[t.status] != null ? statusLabels[t.status] : String(t.status)) +
              " · Öncelik: " +
              (priorityLabels[t.priority] != null ? priorityLabels[t.priority] : String(t.priority));
            main.appendChild(metaSpan);

            if (t.when) {
              const whenEl = document.createElement("p");
              whenEl.className = "gorevler-task-when";
              whenEl.textContent = t.when;
              main.appendChild(whenEl);
            }

            li.appendChild(main);
            listEl.appendChild(li);
          }
        }

        function showHint(msg) {
          const s = msg != null ? String(msg) : "";
          hintEl.textContent = s;
          hintEl.hidden = false;
          hintEl.style.whiteSpace = s.indexOf("\n") >= 0 ? "pre-line" : "";
        }

        function hideHint() {
          hintEl.hidden = true;
          hintEl.textContent = "";
          hintEl.style.whiteSpace = "";
        }

        /**
         * POST /task 200 ve accepted !== false: ham JSON yerine kısa özet (üst hint).
         * @param {Record<string, unknown>} data
         */
        function buildTaskBridgeSuccessReadableHint(data) {
          const route =
            data.route != null && String(data.route).trim() ? String(data.route).trim() : "—";
          const source =
            data.source != null && String(data.source).trim() ? String(data.source).trim() : "—";
          const head =
            data.accepted === true || data.ok === true ? "kabul edildi" : "yanıt alındı";
          const main = "Köprü: " + head + " · route: " + route + " · source: " + source;
          const rf = data.result_file != null ? String(data.result_file).trim() : "";
          const ef = data.execution_file != null ? String(data.execution_file).trim() : "";
          const extra = [];
          const rfBn = lumosOutboxPathBasename(rf);
          if (rfBn) extra.push("result_file: " + rfBn);
          const efBn = lumosOutboxPathBasename(ef);
          if (efBn) extra.push("execution_file: " + efBn);
          if (extra.length === 0) return main;
          return main + "\n" + extra.join(" · ");
        }

        /**
         * Görevler sekmesi: önce yerel liste (panelGorevlerTasks + localStorage),
         * sonra köprü POST /task. Köprü hatası listeyi geri almaz.
         * Köprü JSON: goal (metin), source panel_gorevler; token sohbet/yükleme ile aynı.
         */
        async function addTask() {
          const title = titleInput.value.trim();
          if (!title) {
            showHint("Görev adı boş olamaz.");
            titleInput.focus();
            return;
          }
          hideHint();

          const priority = prioritySel.value;
          const status = statusSel.value;

          panelGorevlerTasks.push({
            title,
            priority,
            status,
          });
          const taskRef = panelGorevlerTasks[panelGorevlerTasks.length - 1];
          titleInput.value = "";
          persistPanelGorevlerTasks();
          render();

          try {
            const r = await fetch(`${BRIDGE_BASE_URL}/task`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify({
                goal: title,
                source: "panel_gorevler",
                priority,
                status,
              }),
            });
            const text = await r.text();
            let data = null;
            try {
              data = text && String(text).trim() ? JSON.parse(text) : null;
            } catch {
              data = null;
            }

            if (!r.ok) {
              assignTaskBridgeLast(taskRef, data, null);
              const err =
                data && typeof data === "object" && data.error != null
                  ? String(data.error)
                  : "Köprü yanıtı başarısız (" + r.status + ").";
              showHint("Görev yerel listeye eklendi; " + err);
              return;
            }
            if (data && typeof data === "object" && data.accepted === false) {
              assignTaskBridgeLast(taskRef, data, false);
              const err =
                data.error != null ? String(data.error) : "Görev köprü tarafından kabul edilmedi.";
              showHint("Görev yerel listeye eklendi; " + err);
              return;
            }
            if (data && typeof data === "object") {
              assignTaskBridgeLast(taskRef, data, null);
              showHint(buildTaskBridgeSuccessReadableHint(data));
            } else {
              assignTaskBridgeLast(taskRef, null, null);
              hideHint();
            }
          } catch (_) {
            assignTaskBridgeLast(taskRef, null, null);
            showHint("Görev yerel listeye eklendi; bridge bağlantısı başarısız.");
          }
        }

        panelGorevlerTasksRender = render;

        addBtn.addEventListener("click", addTask);
        titleInput.addEventListener("keydown", (e) => {
          if (e.key !== "Enter") return;
          e.preventDefault();
          addTask();
        });

        listEl.addEventListener("click", (e) => {
          const li = e.target && e.target.closest ? e.target.closest("li.gorevler-task-card") : null;
          if (!li || !listEl.contains(li)) return;
          const idx = Number(li.getAttribute("data-task-index"));
          if (Number.isNaN(idx) || idx < 0) return;
          listEl.querySelectorAll(".gorevler-task-card").forEach((node) => {
            node.setAttribute("aria-expanded", "false");
          });
          li.setAttribute("aria-expanded", "true");
          openGorevlerDetail(idx);
        });

        listEl.addEventListener("keydown", (e) => {
          const li = e.target && e.target.closest ? e.target.closest("li.gorevler-task-card") : null;
          if (!li || !listEl.contains(li)) return;
          if (e.key !== "Enter" && e.key !== " ") return;
          e.preventDefault();
          const idx = Number(li.getAttribute("data-task-index"));
          if (Number.isNaN(idx) || idx < 0) return;
          listEl.querySelectorAll(".gorevler-task-card").forEach((node) => {
            node.setAttribute("aria-expanded", "false");
          });
          li.setAttribute("aria-expanded", "true");
          openGorevlerDetail(idx);
        });

        detailCloseBtn.addEventListener("click", () => closeGorevlerDetail(true));

        render();
      }

      wirePanel();
      wireGorevlerPrototype();
      wireDosyalarUpload();

      function wireDosyalarUpload() {
        const input = document.getElementById("dosyalar-file-input");
        const btn = document.getElementById("dosyalar-upload-btn");
        const hint = document.getElementById("dosyalar-hint");
        const result = document.getElementById("dosyalar-result");
        const historyWrap = document.getElementById("dosyalar-history-wrap");
        const historyList = document.getElementById("dosyalar-history-list");
        if (!input || !btn || !hint || !result) return;

        /** Bellek içi; sayfa yenilenince sıfırlanır. En fazla 5 kayıt, en yeni üstte. */
        const dosyalarUploadHistory = [];

        function dosyalarHistoryShortStatus(data) {
          const u = data.unsupported != null ? String(data.unsupported).trim() : "";
          if (u) return "Uyarı";
          const s = data.summary != null ? String(data.summary).trim() : "";
          if (s) return "Özet hazır";
          return "Tamamlandı";
        }

        function replayDosyalarSnapshot(snapshot) {
          if (!snapshot || typeof snapshot !== "object") return;
          renderResult(snapshot);
          result.hidden = false;
          try {
            result.scrollIntoView({ behavior: "smooth", block: "nearest" });
          } catch (_) {
            /* eski tarayıcı */
          }
        }

        function renderDosyalarHistory() {
          if (!historyWrap || !historyList) return;
          historyList.replaceChildren();
          if (dosyalarUploadHistory.length === 0) {
            historyWrap.hidden = true;
            return;
          }
          historyWrap.hidden = false;
          for (const row of dosyalarUploadHistory) {
            const snap = row.snapshot;
            if (!snap || typeof snap !== "object") continue;

            const li = document.createElement("li");
            li.className = "dosyalar-history-row";
            li.setAttribute("role", "button");
            li.setAttribute("tabindex", "0");
            const fn = String(snap.filename ?? "");
            li.setAttribute(
              "aria-label",
              fn ? `Sonuçları yeniden göster: ${fn}` : "Sonuçları yeniden göster",
            );

            const nameEl = document.createElement("span");
            nameEl.className = "dosyalar-history-name";
            nameEl.textContent = fn || "—";

            const sizeEl = document.createElement("span");
            sizeEl.className = "dosyalar-history-meta";
            sizeEl.textContent =
              snap.size != null && snap.size !== "" ? String(snap.size) + " bayt" : "—";

            const extEl = document.createElement("span");
            extEl.className = "dosyalar-history-meta";
            extEl.textContent =
              snap.extension != null && String(snap.extension).trim()
                ? String(snap.extension)
                : "—";

            const stEl = document.createElement("p");
            stEl.className = "dosyalar-history-status";
            stEl.textContent = dosyalarHistoryShortStatus(snap);

            li.appendChild(nameEl);
            li.appendChild(sizeEl);
            li.appendChild(extEl);
            li.appendChild(stEl);

            const open = () => replayDosyalarSnapshot(snap);
            li.addEventListener("click", open);
            li.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                open();
              }
            });

            historyList.appendChild(li);
          }
        }

        function pushDosyalarHistory(data) {
          if (!data || typeof data !== "object") return;
          const snapshot = { ...data };
          dosyalarUploadHistory.unshift({ snapshot });
          if (dosyalarUploadHistory.length > 5) dosyalarUploadHistory.length = 5;
          renderDosyalarHistory();
        }

        function showHint(msg) {
          hint.textContent = msg;
          hint.hidden = false;
        }

        function hideHint() {
          hint.hidden = true;
          hint.textContent = "";
        }

        function renderResult(data) {
          result.replaceChildren();
          result.className = "dosyalar-result-stack";

          const metaCard = document.createElement("section");
          metaCard.className = "dosyalar-result-card dosyalar-result-card--meta";
          metaCard.setAttribute("aria-labelledby", "dosyalar-result-meta-title");
          const metaTitle = document.createElement("h3");
          metaTitle.id = "dosyalar-result-meta-title";
          metaTitle.className = "dosyalar-result-card__title";
          metaTitle.textContent = "Dosya bilgisi";
          metaCard.appendChild(metaTitle);

          const ul = document.createElement("ul");
          ul.className = "dosyalar-result-meta";
          const rows = [
            ["Dosya adı", String(data.filename ?? "")],
            ["Boyut", String(data.size ?? "") + " bayt"],
            ["Tür", String(data.kind ?? "")],
            ["Uzantı", data.extension ? String(data.extension) : "—"],
          ];
          for (const [k, v] of rows) {
            const li = document.createElement("li");
            const a = document.createElement("span");
            a.textContent = k;
            const b = document.createElement("span");
            b.textContent = v;
            li.appendChild(a);
            li.appendChild(b);
            ul.appendChild(li);
          }
          metaCard.appendChild(ul);
          result.appendChild(metaCard);

          const unsup = data.unsupported != null ? String(data.unsupported).trim() : "";
          if (unsup) {
            const alertCard = document.createElement("section");
            alertCard.className = "dosyalar-result-card dosyalar-result-card--alert";
            alertCard.setAttribute("aria-labelledby", "dosyalar-result-alert-title");
            alertCard.setAttribute("role", "region");
            const alertTitle = document.createElement("h3");
            alertTitle.id = "dosyalar-result-alert-title";
            alertTitle.className = "dosyalar-result-card__title";
            alertTitle.textContent = "Uyarı";
            const alertBody = document.createElement("p");
            alertBody.className = "dosyalar-result-alert-body";
            alertBody.textContent = unsup;
            alertCard.appendChild(alertTitle);
            alertCard.appendChild(alertBody);
            result.appendChild(alertCard);
          }

          if (data.summary != null && String(data.summary).trim()) {
            const sumCard = document.createElement("section");
            sumCard.className = "dosyalar-result-card dosyalar-result-card--summary";
            sumCard.setAttribute("aria-labelledby", "dosyalar-result-summary-title");
            const sumTitle = document.createElement("h3");
            sumTitle.id = "dosyalar-result-summary-title";
            sumTitle.className = "dosyalar-result-card__title";
            sumTitle.textContent = "Kısa özet";
            const sumBody = document.createElement("p");
            sumBody.className = "dosyalar-result-summary-body";
            sumBody.textContent = String(data.summary);
            sumCard.appendChild(sumTitle);
            sumCard.appendChild(sumBody);
            result.appendChild(sumCard);
          }

          result.hidden = false;
        }

        btn.addEventListener("click", async () => {
          const file = input.files && input.files[0];
          if (!file) {
            showHint("Önce bir dosya seçin.");
            return;
          }
          hideHint();
          result.hidden = true;
          btn.disabled = true;
          btn.setAttribute("aria-busy", "true");
          const fd = new FormData();
          fd.append("file", file, file.name);
          try {
            const r = await fetch(UPLOAD_URL, {
              method: "POST",
              headers: { "X-Kando-Token": kandoToken },
              body: fd,
            });
            const text = await r.text();
            let data = null;
            try {
              data = text && text.trim() ? JSON.parse(text) : null;
            } catch {
              data = null;
            }
            if (!r.ok) {
              const err =
                data && typeof data === "object" && data.error != null
                  ? String(data.error)
                  : "Yükleme başarısız.";
              showHint(err);
              return;
            }
            if (!data || typeof data !== "object" || data.ok !== true) {
              showHint("Sunucu yanıtı beklenen formatta değil.");
              return;
            }
            renderResult(data);
            pushDosyalarHistory(data);
          } catch {
            showHint("Sunucuya ulaşılamadı. Köprü adresini veya bağlantıyı kontrol edin.");
          } finally {
            btn.disabled = false;
            btn.removeAttribute("aria-busy");
          }
        });
      }

      function setPanelConnBadge(state) {
        const badge = document.getElementById("panel-conn-badge");
        if (!badge) return;
        badge.setAttribute("data-state", state);
        if (state === "ok") {
          badge.textContent = "Bağlı";
        } else if (state === "bad") {
          badge.textContent = "Çevrimdışı";
        } else {
          badge.textContent = "Bağlanıyor";
        }
      }

      async function probeBridgeHealthJson(url) {
        const r = await fetch(url, {
          method: "GET",
          cache: "no-store",
          mode: "cors",
          credentials: "omit",
        });
        const text = await r.text();
        if (!r.ok || !text || !String(text).trim()) return false;
        try {
          const data = JSON.parse(text);
          if (data === null || typeof data !== "object" || Array.isArray(data)) return false;
          if (String(data.status || "").toLowerCase() === "ok") return true;
          if (data.ok === true) return true;
          return false;
        } catch {
          return false;
        }
      }

      void (async function checkBridgeHealth() {
        setPanelConnBadge("pending");
        const candidates = [
          HEALTH_URL,
          BRIDGE_BASE_URL + "/health",
          BRIDGE_BASE_URL + "/",
        ];
        const seen = new Set();
        try {
          let ok = false;
          for (let i = 0; i < candidates.length; i++) {
            const u = candidates[i];
            if (!u || seen.has(u)) continue;
            seen.add(u);
            if (await probeBridgeHealthJson(u)) {
              ok = true;
              break;
            }
          }
          setPanelConnBadge(ok ? "ok" : "bad");
        } catch {
          setPanelConnBadge("bad");
        }
      })();
    </script>
    <GlobalMay19Corner />
  </body>
</html>
