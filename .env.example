PUBLIC_LUMOS_CHAT_URL=http://localhost:8787/chat
# İstemci panel Dosyalar yükleme (köprü POST /panel/upload). Boşsa PUBLIC_LUMOS_CHAT_URL'deki /chat → /panel/upload türetilir.
PUBLIC_LUMOS_PANEL_UPLOAD_URL=http://localhost:8787/panel/upload
# Panel sağ üst “Bağlı” rozeti (GET /health veya köprü GET /). Boşsa upload URL tabanından /health türetilir.
PUBLIC_LUMOS_PANEL_HEALTH_URL=http://localhost:8787/health
# Eski ad (isteğe bağlı): PUBLIC_LUMOS_BRIDGE_HEALTH_URL ile aynı işlev.
PUBLIC_LUMOS_BRIDGE_HEALTH_URL=http://localhost:8787/health
PORT=8787
LUMOS_BASE_DIR=.
# Köprü: POST /panel/upload için gövde üst sınırı (bayt). Varsayılan 1048576 (1 MiB).
LUMOS_PANEL_UPLOAD_MAX_BYTES=1048576
# Server-only secrets — DO NOT commit real values; do NOT expose with PUBLIC_ prefix
OPENAI_API_KEY=your_server_side_key_here
KANDO_TOKEN=your_server_side_token_here
