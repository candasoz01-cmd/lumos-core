          render();
          syncGorevlerTasksApiSkipBadge();
          scheduleEvidenceQueueFlush();
        });

        syncGorevlerTasksApiSkipBadge();
      }

      wirePanel();
      prefillPanelChatFromUrlQuery();
      wireGorevlerPrototype();
      wireEvidenceQueueFlushTriggers();
      wireDosyalarUpload();

      /** Kontrollü köprü file_rw: yalnızca yetenek probunda kullanılır. */
      const DOSYALAR_TEXT_EXT = new Set(["txt", "md", "json", "csv"]);
      const DOSYALAR_AUDIO_EXT = new Set([
        "mp3",
        "wav",
        "ogg",
        "m4a",
        "aac",
        "flac",
        "oga",
        "opus",
        "weba",
      ]);

      function formatFileSize(bytes) {
        if (typeof bytes !== "number" || !Number.isFinite(bytes) || bytes < 0) return null;
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) {
          const kb = bytes / 1024;
          return `${kb < 10 ? kb.toFixed(1) : Math.round(kb)} KB`;
        }
        const mb = bytes / (1024 * 1024);
        return `${mb < 10 ? mb.toFixed(1) : Math.round(mb)} MB`;
      }

      function dosyalarFormatSize(size) {
        const label = formatFileSize(size);
        if (label) return label;
        if (size != null && size !== "") return String(size) + panelT("panel.modules.files.messages.bytesSuffix");
        return "—";
      }

      function dosyalarIsAudioFile(ext, mime) {
        const e = String(ext ?? "").toLowerCase();
        if (e && DOSYALAR_AUDIO_EXT.has(e)) return true;
        const m = String(mime ?? "").toLowerCase();
        return m.startsWith("audio/");
      }

      function dosyalarFileExtension(name) {
        const m = String(name || "").match(/\.([^.]+)$/);
        return m ? m[1].toLowerCase() : "";
      }

      async function callControlledBridge(payload) {
        const r = await fetch(CONTROLLED_BRIDGE_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json; charset=utf-8",
          },
          body: JSON.stringify(payload),
        });
        if (taskBridgeBlockedResponse(r.status)) {
          return { ok: false, status: r.status, data: null };
        }
        const text = await r.text();
        let data = null;
        try {
          data = text && text.trim() ? JSON.parse(text) : null;
        } catch {
          data = null;
        }
        const ok = r.ok && data && data.ok === true;
        return { ok, status: r.status, data };
      }

      function controlledReadFile(path) {
        return callControlledBridge({
          permission: "file_rw",
          tool: "read_file",
          action: "read_file",
          command: "read",
          path,
        });
      }

      function controlledWriteFile(path, content) {
        return callControlledBridge({
          permission: "file_rw",
          tool: "write_file",
          action: "write_file",
          command: "write",
          path,
          content,
        });
      }

      async function uploadPanelFile(file) {
        const form = new FormData();
        form.append("file", file, file.name);
        const headers = {};
        if (kandoToken) headers["X-Kando-Token"] = kandoToken;
        const r = await fetch(UPLOAD_URL, {
          method: "POST",
          headers,
          body: form,
        });
        const text = await r.text();
        let data = null;
        try {
          data = text && text.trim() ? JSON.parse(text) : null;
        } catch {
          data = null;
        }
        return { ok: r.ok && data && data.ok === true, status: r.status, data };
      }

      function wireDosyalarUpload() {
        const input = document.getElementById("dosyalar-file-input");
        const btn = document.getElementById("dosyalar-upload-btn");
        const hint = document.getElementById("dosyalar-hint");
        const result = document.getElementById("dosyalar-result");
        const historyWrap = document.getElementById("dosyalar-history-wrap");
        const historyList = document.getElementById("dosyalar-history-list");
        if (!input || !btn || !hint || !result) return;

        /** Bu cihazda localStorage; en fazla 5 kayıt, en yeni üstte. */
        const dosyalarUploadHistory = loadDosyalarUploadHistory();
        /** Son seçilen ses dosyası (Metne çevir için blob kaynağı). */
        let dosyalarLastAudioFile = null;
        let dosyalarLastSnapshot = null;

        function loadDosyalarUploadHistory() {
          try {
            if (typeof localStorage === "undefined") return [];
            const raw = localStorage.getItem(PANEL_DOSYALAR_HISTORY_LS_KEY);
            if (!raw) return [];
            const parsed = JSON.parse(raw);
            if (!parsed || parsed.v !== 1 || !Array.isArray(parsed.items)) return [];
            return parsed.items
              .filter(
                (row) =>
                  row &&
                  typeof row === "object" &&
                  row.snapshot &&
                  typeof row.snapshot === "object",
              )
              .slice(0, 5);
          } catch {
            return [];
          }
        }

        function persistDosyalarUploadHistory() {
          try {
            if (typeof localStorage === "undefined") return;
            localStorage.setItem(
              PANEL_DOSYALAR_HISTORY_LS_KEY,
              JSON.stringify({ v: 1, items: dosyalarUploadHistory.slice(0, 5) }),
            );
          } catch {
            /* kota / gizli mod */
          }
        }

        function dosyalarHistoryShortStatus(data) {
          if (dosyalarIsAudioFile(data.extension, data.kind)) {
            return panelT("panel.modules.files.history.statusAudio");
          }
          const u = data.unsupported != null ? String(data.unsupported).trim() : "";
          if (u) return panelT("panel.modules.files.history.statusWarn");
          const i = data.info != null ? String(data.info).trim() : "";
          if (i && DOSYALAR_TEXT_EXT.has(String(data.extension ?? ""))) {
            return panelT("panel.modules.files.history.statusSummaryDone");
          }
          const s = data.summary != null ? String(data.summary).trim() : "";
          if (s) return panelT("panel.modules.files.history.statusSummaryReady");
          return panelT("panel.modules.files.history.statusDone");
        }

        function replayDosyalarSnapshot(snapshot) {
          if (!snapshot || typeof snapshot !== "object") return;
          renderResult(snapshot);
          result.hidden = false;
          try {
            result.scrollIntoView({ behavior: "smooth", block: "nearest" });
          } catch (_) {
            /* eski tarayıcı */
          }
        }

        function renderDosyalarHistory() {
          if (!historyWrap || !historyList) return;
          historyList.replaceChildren();
          if (dosyalarUploadHistory.length === 0) {
            historyWrap.hidden = true;
            return;
          }
          historyWrap.hidden = false;
          for (const row of dosyalarUploadHistory) {
            const snap = row.snapshot;
            if (!snap || typeof snap !== "object") continue;

            const li = document.createElement("li");
            li.className = "dosyalar-history-row";
            li.setAttribute("role", "button");
            li.setAttribute("tabindex", "0");
            const fn = String(snap.filename ?? "");
            li.setAttribute(
              "aria-label",
              fn
                ? panelT("panel.modules.files.history.replayAriaPrefix") + fn
                : panelT("panel.modules.files.history.replayAria"),
            );

            const nameEl = document.createElement("span");
            nameEl.className = "dosyalar-history-name";
            nameEl.textContent = fn || "—";

            const sizeEl = document.createElement("span");
            sizeEl.className = "dosyalar-history-meta";
            sizeEl.textContent = dosyalarFormatSize(snap.size);

            const extEl = document.createElement("span");
            extEl.className = "dosyalar-history-meta";
            const extVal =
              snap.extension != null && String(snap.extension).trim()
                ? String(snap.extension)
                : "";
            extEl.textContent = extVal ? "." + extVal : "—";

            const stEl = document.createElement("p");
            stEl.className = "dosyalar-history-status";
            stEl.textContent = dosyalarHistoryShortStatus(snap);

            li.appendChild(nameEl);
            li.appendChild(sizeEl);
            li.appendChild(extEl);
            li.appendChild(stEl);

            const open = () => replayDosyalarSnapshot(snap);
            li.addEventListener("click", open);
            li.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                open();
              }
            });

            historyList.appendChild(li);
          }
        }

        function pushDosyalarHistory(data) {
          if (!data || typeof data !== "object") return;
          const snapshot = { ...data };
          dosyalarUploadHistory.unshift({ snapshot });
          if (dosyalarUploadHistory.length > 5) dosyalarUploadHistory.length = 5;
          renderDosyalarHistory();
          persistDosyalarUploadHistory();
        }

        let dosyalarHintRefresh = null;

        function paintDosyalarHintFromResolver() {
          if (!dosyalarHintRefresh) return;
          hint.textContent = panelUserVisibleText(dosyalarHintRefresh());
          hint.hidden = false;
        }

        function setDosyalarHint(resolver) {
          dosyalarHintRefresh = typeof resolver === "function" ? resolver : () => String(resolver ?? "");
          paintDosyalarHintFromResolver();
        }

        function refreshDosyalarVisibleHintI18n() {
          if (hint.hidden || !dosyalarHintRefresh) return;
          paintDosyalarHintFromResolver();
        }

        function hideHint() {
          dosyalarHintRefresh = null;
          hint.hidden = true;
          hint.textContent = "";
        }

        function renderResult(data) {
          dosyalarLastSnapshot = data;
          result.replaceChildren();
          result.className = "dosyalar-result-stack";

          const metaCard = document.createElement("section");
          metaCard.className = "dosyalar-result-card dosyalar-result-card--meta";
          metaCard.setAttribute("aria-labelledby", "dosyalar-result-meta-title");
          const metaTitle = document.createElement("h3");
          metaTitle.id = "dosyalar-result-meta-title";
          metaTitle.className = "dosyalar-result-card__title";
          metaTitle.textContent = panelT("panel.modules.files.result.metaTitle");
          metaCard.appendChild(metaTitle);

          const ul = document.createElement("ul");
          ul.className = "dosyalar-result-meta";
          const rows = [
            [panelT("panel.modules.files.result.metaFilename"), String(data.filename ?? "") || "—"],
            [panelT("panel.modules.files.result.metaSize"), dosyalarFormatSize(data.size)],
            [panelT("panel.modules.files.result.metaKind"), String(data.kind ?? "") || "—"],
            [panelT("panel.modules.files.result.metaExt"), data.extension ? String(data.extension) : "—"],
          ];
          for (const [k, v] of rows) {
            const li = document.createElement("li");
            const a = document.createElement("span");
            a.textContent = k;
            const b = document.createElement("span");
            b.textContent = v;
            li.appendChild(a);
            li.appendChild(b);
            ul.appendChild(li);
          }
          metaCard.appendChild(ul);
          result.appendChild(metaCard);

          const infoMsg = data.info != null ? String(data.info).trim() : "";
          if (infoMsg) {
            const infoCard = document.createElement("section");
            infoCard.className = "dosyalar-result-card dosyalar-result-card--summary";
            infoCard.setAttribute("aria-labelledby", "dosyalar-result-info-title");
            const infoTitle = document.createElement("h3");
            infoTitle.id = "dosyalar-result-info-title";
            infoTitle.className = "dosyalar-result-card__title";
            infoTitle.textContent = panelT("panel.modules.files.result.infoTitle");
            const infoBody = document.createElement("p");
            infoBody.className = "dosyalar-result-summary-body";
            infoBody.textContent = infoMsg;
            infoCard.appendChild(infoTitle);
            infoCard.appendChild(infoBody);
            result.appendChild(infoCard);
          }

          const unsup = data.unsupported != null ? String(data.unsupported).trim() : "";
          if (unsup) {
            const alertCard = document.createElement("section");
            alertCard.className = "dosyalar-result-card dosyalar-result-card--alert";
            alertCard.setAttribute("aria-labelledby", "dosyalar-result-alert-title");
            alertCard.setAttribute("role", "region");
            const alertTitle = document.createElement("h3");
            alertTitle.id = "dosyalar-result-alert-title";
            alertTitle.className = "dosyalar-result-card__title";
            alertTitle.textContent = dosyalarIsAudioFile(data.extension, data.kind)
              ? panelT("panel.modules.files.result.infoTitle")
              : panelT("panel.modules.files.result.alertTitle");
            const alertBody = document.createElement("p");
            alertBody.className = "dosyalar-result-alert-body";
            alertBody.textContent = unsup;
            alertCard.appendChild(alertTitle);
            alertCard.appendChild(alertBody);
            result.appendChild(alertCard);
          }

