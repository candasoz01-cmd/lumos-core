        function applyAudioRecordSupportUi() {
          const supported = isAudioRecordSupported();
          if (attachRecordMenuItem instanceof HTMLButtonElement) {
            attachRecordMenuItem.disabled = !supported;
            attachRecordMenuItem.setAttribute("aria-disabled", supported ? "false" : "true");
            attachRecordMenuItem.classList.toggle("chat-compose-attach-menu__item--unsupported", !supported);
            if (supported) {
              attachRecordMenuItem.title = panelT("panel.modules.chat.compose.attachRecordTitle");
            } else {
              attachRecordMenuItem.removeAttribute("title");
            }
          }
          if (!supported) {
            setAudioRecordHintKey("panel.modules.chat.compose.record.unsupported");
          } else if (!isAudioRecording && !audioRecordObjectUrl) {
            setAudioRecordHintKey("");
          }
        }

        function revokeAudioRecordObjectUrl() {
          if (!audioRecordObjectUrl) return;
          try {
            URL.revokeObjectURL(audioRecordObjectUrl);
          } catch {
            /* ignore */
          }
          audioRecordObjectUrl = null;
        }

        function stopAudioRecordStream() {
          if (audioRecordStream) {
            audioRecordStream.getTracks().forEach((tr) => tr.stop());
            audioRecordStream = null;
          }
        }

        function syncAudioRecordPreviewVisibility() {
          if (!audioRecordPreviewWrap) return;
          audioRecordPreviewWrap.hidden = !(isAudioRecording || !!audioRecordObjectUrl);
        }

        function syncAudioRecordControlsUi() {
          if (audioRecordStopBtn) audioRecordStopBtn.hidden = !isAudioRecording;
          if (audioRecordCancelBtn) {
            audioRecordCancelBtn.hidden = !isAudioRecording && !audioRecordObjectUrl;
          }
          if (audioRecordRerecordBtn) {
            audioRecordRerecordBtn.hidden = isAudioRecording || !audioRecordObjectUrl;
          }
          if (audioRecordTranscriptBtn) {
            audioRecordTranscriptBtn.hidden = isAudioRecording || !audioRecordObjectUrl;
          }
          if (audioRecordTranscriptHost) {
            audioRecordTranscriptHost.hidden = isAudioRecording || !audioRecordObjectUrl;
          }
          if (audioRecordPlayer) {
            audioRecordPlayer.hidden = isAudioRecording || !audioRecordObjectUrl;
          }
          if (audioRecordStatus) {
            if (isAudioRecording) {
              audioRecordStatus.textContent = panelT("panel.modules.chat.compose.record.recordingStatus");
            } else if (audioRecordObjectUrl) {
              audioRecordStatus.textContent = panelT("panel.modules.chat.compose.record.previewLabel");
            } else {
              audioRecordStatus.textContent = "";
            }
          }
        }

        function clearPanelAudioRecordSelection() {
          const rec = mediaRecorder;
          mediaRecorder = null;
          if (rec) {
            rec.onstop = null;
            rec.onerror = null;
            rec.ondataavailable = null;
            if (rec.state !== "inactive") {
              try {
                rec.stop();
              } catch {
                /* ignore */
              }
            }
          }
          audioRecordChunks = [];
          isAudioRecording = false;
          audioRecordBlob = null;
          revokeAudioRecordObjectUrl();
          stopAudioRecordStream();
          if (audioRecordPlayer) {
            audioRecordPlayer.pause();
            audioRecordPlayer.removeAttribute("src");
            audioRecordPlayer.load();
            audioRecordPlayer.hidden = true;
          }
          if (audioRecordTranscriptMsg) {
            audioRecordTranscriptMsg.textContent = "";
            audioRecordTranscriptMsg.hidden = true;
          }
          resetAudioRecordTranscriptUi();
          syncAudioRecordControlsUi();
          syncAudioRecordPreviewVisibility();
          if (isAudioRecordSupported()) setAudioRecordHintKey("");
        }

        function bindAudioRecordFromBlob(blob) {
          if (!blob || blob.size < 512) {
            setAudioRecordHintKey("panel.modules.chat.compose.record.tooShort");
            clearPanelAudioRecordSelection();
            return;
          }
          revokeAudioRecordObjectUrl();
          audioRecordBlob = blob;
          audioRecordObjectUrl = URL.createObjectURL(blob);
          if (audioRecordPlayer) {
            audioRecordPlayer.src = audioRecordObjectUrl;
            audioRecordPlayer.hidden = false;
          }
          isAudioRecording = false;
          syncAudioRecordControlsUi();
          syncAudioRecordPreviewVisibility();
          setAudioRecordHintKey("");
        }

        function stopPanelAudioRecording() {
          if (!mediaRecorder || mediaRecorder.state === "inactive") return;
          try {
            mediaRecorder.stop();
          } catch {
            setAudioRecordHintKey("panel.modules.chat.compose.record.stopFailed");
            clearPanelAudioRecordSelection();
          }
        }

        function startPanelAudioRecording() {
          clearPanelAudioRecordSelection();
          if (!isAudioRecordSupported()) {
            setAudioRecordHintKey("panel.modules.chat.compose.record.unsupported");
            return;
          }
          setAudioRecordHintKey("");
          navigator.mediaDevices
            .getUserMedia({ audio: true })
            .then((stream) => {
              audioRecordStream = stream;
              audioRecordChunks = [];
              const mimeType = pickAudioRecordMimeType();
              const options = mimeType ? { mimeType } : undefined;
              let rec;
              try {
                rec = options ? new MediaRecorder(stream, options) : new MediaRecorder(stream);
              } catch {
                stopAudioRecordStream();
                setAudioRecordHintKey("panel.modules.chat.compose.record.startFailed");
                return;
              }
              mediaRecorder = rec;
              mediaRecorder.ondataavailable = (ev) => {
                if (ev.data && ev.data.size > 0) audioRecordChunks.push(ev.data);
              };
              mediaRecorder.onstop = () => {
                stopAudioRecordStream();
                const type = rec.mimeType || mimeType || "audio/webm";
                const blob = new Blob(audioRecordChunks, { type });
                mediaRecorder = null;
                audioRecordChunks = [];
                bindAudioRecordFromBlob(blob);
              };
              mediaRecorder.onerror = () => {
                setAudioRecordHintKey("panel.modules.chat.compose.record.errorDuring");
                clearPanelAudioRecordSelection();
              };
              mediaRecorder.start();
              isAudioRecording = true;
              syncAudioRecordControlsUi();
              syncAudioRecordPreviewVisibility();
              setAudioRecordHintKey("panel.modules.chat.compose.record.recordingHint");
            })
            .catch((err) => {
              const name = err && err.name;
              if (name === "NotAllowedError" || name === "PermissionDeniedError") {
                setAudioRecordHintKey("panel.modules.chat.compose.record.micDenied");
              } else {
                setAudioRecordHintKey("panel.modules.chat.compose.record.micUnavailable");
              }
              clearPanelAudioRecordSelection();
            });
        }

        applyAudioRecordSupportUi();

