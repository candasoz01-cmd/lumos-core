      function sanitizeBridgeLast(bl) {
        if (!bl || typeof bl !== "object") return null;
        const src = /** @type {Record<string, unknown>} */ (bl);
        const isoRaw = String(
          src.lastBridgeAt != null ? src.lastBridgeAt : src.last_bridge_at != null ? src.last_bridge_at : "",
        ).trim();
        const isoOk = isoRaw && !Number.isNaN(Date.parse(isoRaw));
        const out = {};
        if (isoOk) out.lastBridgeAt = isoRaw;
        for (const k of ["route", "source"]) {
          const raw = src[k];
          const v = truncateGorevlerField(raw != null ? String(raw) : "");
          if (v) out[k] = v;
        }
        for (const [outKey, aliases] of [
          ["result_file", ["result_file", "resultFile"]],
          ["execution_file", ["execution_file", "executionFile"]],
        ]) {
          let raw = null;
          for (const a of aliases) {
            if (src[a] != null && String(src[a]).trim()) {
              raw = src[a];
              break;
            }
          }
          const v = truncateGorevlerField(raw != null ? String(raw) : "");
          if (v) out[outKey] = v;
        }
        if (src.accepted === true || src.accepted === false) out.accepted = src.accepted;
        const has =
          !!out.lastBridgeAt ||
          !!out.route ||
          !!out.source ||
          !!out.result_file ||
          !!out.execution_file ||
          out.accepted !== undefined;
        return has ? out : null;
      }

      function sanitizeGorevlerRow(x) {
        if (!x || typeof x !== "object") return null;
        const title = String(x.title || "").trim();
        if (!title) return null;
        const pr = ["dusuk", "orta", "yuksek"].includes(x.priority) ? x.priority : "orta";
        const st = ["bekliyor", "onay_bekliyor", "tamamlandi"].includes(x.status) ? x.status : "bekliyor";
        const row = { title, priority: pr, status: st };
        const w = x.when != null ? String(x.when).trim() : "";
        if (w) row.when = w;
        const bridge = sanitizeBridgeLast(x.bridgeLast);
        if (bridge) row.bridgeLast = bridge;
        const id = x.id != null ? String(x.id).trim() : "";
        if (id) row.id = id;
        const plan = sanitizeGorevlerTaskPlan(x.taskPlan);
        if (plan) row.taskPlan = plan;
        return row;
      }

      /** Görev planı (Faz A): localStorage ile görev satırında saklanır. */
      function normalizeGorevlerPlanLookupToken(raw) {
        return String(raw != null ? raw : "")
          .trim()
          .toLocaleLowerCase("tr-TR")
          .replace(/ş/g, "s")
          .replace(/ı/g, "i")
          .replace(/ü/g, "u")
          .replace(/ö/g, "o")
          .replace(/ç/g, "c")
          .replace(/ğ/g, "g");
      }

      function gorevlerPlanLegacyTransmissionNorm() {
        return ["ile", "tim"].join("");
      }

      function gorevlerPlanTurToken(raw) {
        const s = String(raw != null ? raw : "").trim();
        if (!s) return "genelGorev";
        if (s === gorevlerPlanLegacyTransmissionNorm()) return "transmission";
        if (/^(genelGorev|dosyaIslemi|gorevListesi|transmission|metin)$/.test(s)) return s;
        const norm = normalizeGorevlerPlanLookupToken(s);
        if (norm === "genel gorev") return "genelGorev";
        if (norm === "dosya islemi") return "dosyaIslemi";
        if (norm === "gorev listesi") return "gorevListesi";
        if (norm === gorevlerPlanLegacyTransmissionNorm()) return "transmission";
        if (norm === "metin") return "metin";
        return s;
      }

      function gorevlerPlanTurDisplay(raw) {
        const tok = gorevlerPlanTurToken(raw);
        const key = "panel.modules.tasks.plan.tur." + tok;
        const t = panelT(key);
        return t !== key ? t : tok;
      }

      function gorevlerPlanRiskToken(raw) {
        const s = String(raw != null ? raw : "").trim();
        if (!s) return "dusuk";
        if (/^(dusuk|orta)$/.test(s)) return s;
        const norm = normalizeGorevlerPlanLookupToken(s);
        if (norm === "dusuk" || norm === "low") return "dusuk";
        if (norm === "orta" || norm === "medium") return "orta";
        return s;
      }

      function gorevlerPlanRiskDisplay(raw) {
        const tok = gorevlerPlanRiskToken(raw);
        const key = "panel.modules.tasks.plan.risk." + tok;
        const t = panelT(key);
        return t !== key ? t : tok;
      }

      function gorevlerPlanSonrakiAdimToken(raw) {
        const s = String(raw != null ? raw : "").trim();
        if (!s) return "default";
        if (s === gorevlerPlanLegacyTransmissionNorm()) return "transmission";
        if (/^(default|dosyalar|gorevler|transmission|panel)$/.test(s)) return s;
        const norm = normalizeGorevlerPlanLookupToken(s);
        if (norm === "listeden gorevi ac ve bak.") return "default";
        if (norm.includes("dosyalar") && norm.includes("yukle")) return "dosyalar";
        if (norm.includes("listed") && norm.includes("durum")) return "gorevler";
        const tx = gorevlerPlanLegacyTransmissionNorm();
        if (norm.includes(tx) && norm.includes("yanit")) return "transmission";
        if (norm.includes("panel") && norm.includes("metin")) return "panel";
        return s;
      }

      function gorevlerPlanSonrakiAdimDisplay(raw) {
        const tok = gorevlerPlanSonrakiAdimToken(raw);
        const key = "panel.modules.tasks.plan.sonrakiAdim." + tok;
        const t = panelT(key);
        return t !== key ? t : tok;
      }

      function gorevlerPlanAlanToken(raw) {
        const s = String(raw != null ? raw : "").trim();
        if (!s) return "gorevler";
        if (s === gorevlerPlanLegacyTransmissionNorm()) return "transmission";
        if (/^(gorevler|dosyalar|transmission|panel)$/.test(s)) return s;
        const norm = normalizeGorevlerPlanLookupToken(s);
        if (!norm || norm === "gorevler" || norm.startsWith("gorevler ")) return "gorevler";
        if (norm === "dosyalar" || norm.startsWith("dosyalar ")) return "dosyalar";
        const tx = gorevlerPlanLegacyTransmissionNorm();
        if (norm === tx || norm === "kopru" || norm.startsWith("kopru ")) return "transmission";
        if (norm === "panel" || norm.startsWith("panel ")) return "panel";
        return s;
      }

      function sanitizeGorevlerTaskPlan(raw) {
        if (!raw || typeof raw !== "object") return null;
        const src = /** @type {Record<string, unknown>} */ (raw);
        const tur = gorevlerPlanTurToken(truncateGorevlerField(src.tur));
        const risk = gorevlerPlanRiskToken(truncateGorevlerField(src.risk));
        const onerilenAlan = gorevlerPlanAlanToken(
          truncateGorevlerField(
            src.onerilenAlan != null ? src.onerilenAlan : src.onerilen_alan,
          ),
        );
        const sonrakiAdim = gorevlerPlanSonrakiAdimToken(
          truncateGorevlerField(
            src.sonrakiAdim != null ? src.sonrakiAdim : src.sonraki_adim,
          ),
        );
        if (!tur && !risk && !onerilenAlan && !sonrakiAdim) return null;
        const out = {
          tur: tur || "genelGorev",
          risk: risk || "dusuk",
          onerilenAlan: onerilenAlan || "gorevler",
          sonrakiAdim: sonrakiAdim || "default",
          active: src.active !== false,
        };
        const onayDurumu =
          src.onayDurumu != null
            ? truncateGorevlerField(src.onayDurumu)
            : src.onay_durumu != null
              ? truncateGorevlerField(src.onay_durumu)
              : "";
        if (onayDurumu) out.onayDurumu = onayDurumu;
        return out;
      }

      /**
       * Kural tabanlı plan: dosya → Görevler → Köprü → UI → Genel.
       * @param {string} title
       */
      function generateGorevlerTaskPlan(title) {
        const hay = canonicalizeTaskInput(title);
        let tur = "genelGorev";
        let risk = "dusuk";
        let onerilenAlan = "gorevler";
        let sonrakiAdim = "default";

        if (/\b(dosya|dosyalar|upload|exe|pdf|docx)\b/.test(hay)) {
          tur = "dosyaIslemi";
          onerilenAlan = "dosyalar";
          sonrakiAdim = "dosyalar";
          if (/\bexe\b/.test(hay)) risk = "orta";
        } else if (/\b(görev|task|tamamla|sil|geri al)\b/.test(hay)) {
          tur = "gorevListesi";
          onerilenAlan = "gorevler";
          sonrakiAdim = "gorevler";
          if (/\b(sil|geri al)\b/.test(hay)) risk = "orta";
        } else if (/\b(bridge|köprü|kopru|koprü|controlled)\b/.test(hay)) {
          tur = "transmission";
          onerilenAlan = "transmission";
          sonrakiAdim = "transmission";
          risk = "orta";
        } else if (/\b(panel|görsel|gorsel|metin|uyarı|uyari)\b/.test(hay)) {
          tur = "metin";
          onerilenAlan = "panel";
          sonrakiAdim = "panel";
        }

        return { tur, risk, onerilenAlan, sonrakiAdim, active: true };
      }

      /** Liste satırı için kısa plan özeti. */
      function formatGorevlerPlanListSummary(plan) {
        const p = sanitizeGorevlerTaskPlan(plan);
        if (!p || !p.active) return "";
        const onay =
          p.onayDurumu != null && String(p.onayDurumu).trim()
            ? " · " + String(p.onayDurumu).trim()
            : "";
        return (
          panelT("panel.modules.tasks.plan.listPrefix") +
          gorevlerPlanTurDisplay(p.tur) +
          " · " +
          gorevlerPlanRiskDisplay(p.risk) +
          onay
        );
      }

      /** Başarılı kayıttan sonra göreve plan ekler ve localStorage’a yazar. */
      function attachGorevlerTaskPlan(taskRow, title) {
        if (!taskRow) return null;
        const plan = generateGorevlerTaskPlan(title);
        taskRow.taskPlan = plan;
        persistPanelGorevlerTasks();
        return plan;
      }

      /** Motor görevi → panel satırı (`tasks.json`: active|done). */
      function engineTaskToPanelRow(t) {
        if (!t || typeof t !== "object") return null;
        const title = String(t.title || "").trim();
        if (!title) return null;
        const st = String(t.status || "active");
        let status = "bekliyor";
        if (st === "done") status = "tamamlandi";
        const row = { title, priority: "orta", status };
        const id = String(t.id || "").trim();
        if (id) row.id = id;
        const when = t.completedAt || t.createdAt;
        if (when) row.when = String(when);
        return row;
      }

      function mergePanelGorevlerMetaFromPrevious(nextRows) {
        const prev = panelGorevlerTasks;
        const byId = new Map();
        const byTitle = new Map();
        for (let i = 0; i < prev.length; i++) {
          const r = prev[i];
          if (!r) continue;
          if (r.id) byId.set(String(r.id), r);
          if (r.title) byTitle.set(String(r.title).trim().toLowerCase(), r);
        }
        for (let i = 0; i < nextRows.length; i++) {
          const r = nextRows[i];
          const old =
            (r.id && byId.get(String(r.id))) ||
            (r.title && byTitle.get(String(r.title).trim().toLowerCase()));
          if (!old) continue;
          if (old.priority && ["dusuk", "orta", "yuksek"].includes(old.priority)) {
            r.priority = old.priority;
          }
          if (old.status === "onay_bekliyor" && r.status === "bekliyor") {
            r.status = "onay_bekliyor";
          }
          const bl = sanitizeBridgeLast(old.bridgeLast);
          if (bl) r.bridgeLast = bl;
          const tp = sanitizeGorevlerTaskPlan(old.taskPlan);
          if (tp) r.taskPlan = tp;
        }
      }

      function resolveGorevlerTasksApiBase() {
        const w = typeof window !== "undefined" ? window : null;
        if (w && w.LUMOS_PANEL_TASKS_API_BASE === false) return "";
        if (w && w.LUMOS_PANEL_TASKS_API_BASE != null && String(w.LUMOS_PANEL_TASKS_API_BASE).trim()) {
          return String(w.LUMOS_PANEL_TASKS_API_BASE).replace(/\/$/, "");
        }
        const fromBuild = String(TASKS_API_URL || "").replace(/\/$/, "");
        if (fromBuild) return fromBuild;
        try {
          const loc = w && w.location;
          if (loc && /^https?:$/i.test(String(loc.protocol || ""))) {
            return String(loc.origin || "").replace(/\/$/, "");
          }
        } catch (_) {
          /* ignore */
        }
        return "http://127.0.0.1:8766";
      }

      function isLoopbackHostname(host) {
        const h = String(host || "")
          .trim()
          .toLowerCase()
          .replace(/^\[|\]$/g, "");
        if (!h) return false;
        return h === "localhost" || h === "127.0.0.1" || h === "::1" || h.endsWith(".localhost");
      }

      function isTasksApiLoopbackBase(base) {
        const b = String(base || "").trim();
        if (!b) return false;
        try {
          const u = new URL(b);
          return isLoopbackHostname(u.hostname);
        } catch {
          return /^(https?:\/\/)?(127\.0\.0\.1|localhost)(:|\/|$)/i.test(b);
        }
      }

      function isPanelOnNonLoopbackHost() {
        try {
          const w = typeof window !== "undefined" ? window : null;
          const host = w && w.location && w.location.hostname;
          if (!host) return false;
          return !isLoopbackHostname(host);
        } catch {
          return false;
        }
      }

      /** Prod panel + loopback API URL: tarayıcı erişemez; yerel yol tercih edilir. */
      function shouldSkipGorevlerTasksApi() {
        const base = resolveGorevlerTasksApiBase();
        if (!base) return true;
        return isPanelOnNonLoopbackHost() && isTasksApiLoopbackBase(base);
      }

      function syncGorevlerTasksApiSkipBadge() {
        const badge = document.getElementById("gorevler-sync-badge");
        if (!badge) return;
        const skip = shouldSkipGorevlerTasksApi();
        const shouldShow = skip;
        if (shouldShow === !badge.hidden) {
          if (shouldShow) {
            const label = panelT("panel.modules.tasks.list.syncBadge");
            if (badge.textContent !== label) badge.textContent = label;
            const title = panelT("panel.modules.tasks.list.syncBadgeTitle");
            if (badge.getAttribute("title") !== title) badge.setAttribute("title", title);
          }
          return;
        }
        badge.hidden = !skip;
        if (skip) {
          badge.textContent = panelT("panel.modules.tasks.list.syncBadge");
          badge.setAttribute("title", panelT("panel.modules.tasks.list.syncBadgeTitle"));
        }
      }

      function shouldFallbackGorevlerTasksLocal(apiUnreachable) {
        if (shouldSkipGorevlerTasksApi()) return true;
        return !!apiUnreachable;
      }

      const EVIDENCE_BRIDGE_PAIR_MAX_MS = 60000;
      /** @type {null | ((taskId: string) => void)} */
      let panelEvidenceOpenTaskDetail = null;
      /** @type {null | (() => void)} */
      let panelEvidenceRefreshStrip = null;
      let panelEvidenceLatestGroup = null;

      function parseEvidenceTsMs(ts) {
        const d = Date.parse(String(ts || ""));
        return Number.isNaN(d) ? 0 : d;
      }

      function evidenceTitlePreviewPrefixMatch(a, b) {
        const x = String(a || "").trim();
        const y = String(b || "").trim();
        if (!x || !y) return false;
        const px = x.slice(0, 20);
        const py = y.slice(0, 20);
        return x.startsWith(py) || y.startsWith(px) || px === py;
      }

      function evidenceSourceLabel(source) {
        const s = String(source || "");
        if (s === "panel_tasks_server") return panelT("panel.modules.tasks.evidence.sourcePanel");
        if (s === "kando_bridge") return panelT("panel.modules.tasks.evidence.sourceBridge");
        if (s === "guard_audit") return panelT("panel.modules.tasks.evidence.sourceGuard");
        if (s === "action_policy") return panelT("panel.modules.tasks.evidence.sourceGuard");
        if (s === "task_engine") return panelT("panel.modules.tasks.evidence.sourceEngine");
        return s || panelT("panel.modules.tasks.evidence.sourceFallback");
      }

      function buildEvidenceUiGroup(primary, kind, label) {
        const ev = primary && typeof primary === "object" ? primary : {};
        const entityRef =
          ev.entity_ref && typeof ev.entity_ref === "object" ? ev.entity_ref : null;
        const entityId = entityRef && entityRef.id ? String(entityRef.id).trim() : "";
        const titlePreview =
          ev.payload_summary &&
          ev.payload_summary.title_preview != null &&
          String(ev.payload_summary.title_preview).trim()
            ? String(ev.payload_summary.title_preview).trim()
            : "";
        let continueKind = null;
        let canContinue = false;
        if (entityId) {
          continueKind = "task";
          canContinue = true;
        } else if (titlePreview && kind !== "guard") {
          continueKind = "chat";
          canContinue = true;
        } else if (kind === "guard") {
          continueKind = "info";
          canContinue = false;
        }
        return {
          ts: ev.ts != null ? String(ev.ts) : "",
          kind,
          label,
          primaryEvent: ev,
          entityRefId: entityId || null,
          titlePreview: titlePreview || null,
          canContinue,
          continueKind,
        };
      }

      function groupEvidenceEventsForUi(events) {
        const list = Array.isArray(events) ? events.slice() : [];
        list.sort((a, b) => parseEvidenceTsMs(b && b.ts) - parseEvidenceTsMs(a && a.ts));
        const used = new Set();
        const groups = [];
        for (let i = 0; i < list.length; i++) {
          if (used.has(i)) continue;
          const ev = list[i];
          if (!ev || typeof ev !== "object") {
            used.add(i);
            continue;
          }
          const op = String(ev.operation || "");
          const phase = String(ev.phase || "");
          const source = String(ev.source || "");

          if (op === "bridge.task.post" && phase === "result") {
            let matchedAfter = null;
            for (let j = i + 1; j < list.length; j++) {
              if (used.has(j)) continue;
              const cand = list[j];
              if (!cand || String(cand.operation || "") !== "bridge.task.post") continue;
              if (String(cand.phase || "") !== "after") continue;
              const dt = Math.abs(parseEvidenceTsMs(ev.ts) - parseEvidenceTsMs(cand.ts));
              if (dt > EVIDENCE_BRIDGE_PAIR_MAX_MS) continue;
              const tp1 =
                ev.payload_summary && ev.payload_summary.title_preview != null
                  ? String(ev.payload_summary.title_preview)
                  : "";
              const tp2 =
                cand.payload_summary && cand.payload_summary.title_preview != null
                  ? String(cand.payload_summary.title_preview)
                  : "";
              if (tp1 && tp2 && !evidenceTitlePreviewPrefixMatch(tp1, tp2)) continue;
              matchedAfter = cand;
              used.add(j);
              break;
            }
            const outcome = String(ev.outcome || "ok");
            const preview =
              ev.payload_summary && ev.payload_summary.title_preview != null
                ? String(ev.payload_summary.title_preview).trim()
                : "";
            const label =
              panelT("panel.modules.tasks.evidence.bridgePrefix") +
              outcome +
              (preview
                ? " · " + preview
                : matchedAfter
                  ? panelT("panel.modules.tasks.evidence.bridgeRelay")
                  : "");
            groups.push(buildEvidenceUiGroup(ev, "bridge", label));
            used.add(i);
            continue;
          }

          if (source === "panel_tasks_server" && phase === "after") {
            const mutation =
              ev.mutation != null
                ? String(ev.mutation)
                : panelT("panel.modules.tasks.evidence.mutationDefault");
            const outcome = String(ev.outcome || "ok");
            groups.push(
              buildEvidenceUiGroup(
                ev,
                "panel",
                panelT("panel.modules.tasks.evidence.taskPrefix") + mutation + " · " + outcome,
              ),
            );
            used.add(i);
            continue;
          }

          if (op === "guard.decision" || op === "policy.blocked") {
            const code =
              ev.error && ev.error.code != null
                ? String(ev.error.code)
                : ev.payload_summary && ev.payload_summary.reason_code != null
                  ? String(ev.payload_summary.reason_code)
                  : panelT("panel.modules.tasks.evidence.guardDefault");
            groups.push(
              buildEvidenceUiGroup(
                ev,
                "guard",
                panelT("panel.modules.tasks.evidence.guardPrefix") + code,
              ),
            );
            used.add(i);
            continue;
          }

          if (source === "task_engine") {
            groups.push(
              buildEvidenceUiGroup(
                ev,
                "engine",
                panelT("panel.modules.tasks.evidence.enginePrefix") + String(ev.outcome || "ok"),
              ),
            );
            used.add(i);
            continue;
          }

          if (phase === "before") {
            used.add(i);
            continue;
          }

          groups.push(
            buildEvidenceUiGroup(
              ev,
              "other",
              evidenceSourceLabel(source) + " · " + String(ev.outcome || "ok"),
            ),
          );
          used.add(i);
        }
        groups.sort((a, b) => parseEvidenceTsMs(b.ts) - parseEvidenceTsMs(a.ts));
        return groups;
      }

      function pickLatestEvidenceGroup(groups) {
        if (!Array.isArray(groups) || !groups.length) return null;
        return groups[0];
      }

      function navigatePanelModule(moduleId) {
        const nav = document.querySelector(".panel-body");
        const btn = nav && nav.querySelector('button[data-module="' + moduleId + '"]');
        if (btn && typeof btn.click === "function") btn.click();
      }

      function prefillPanelChatFromEvidence(titlePreview) {
        const chatInput = document.getElementById("panel-msg");
        if (!(chatInput instanceof HTMLTextAreaElement)) return false;
        const text = String(titlePreview || "").trim();
        if (!text) return false;
        chatInput.value = text;
        chatInput.dispatchEvent(new Event("input", { bubbles: true }));
        try {
          chatInput.focus({ preventScroll: true });
        } catch {
          chatInput.focus();
        }
        try {
          chatInput.scrollIntoView({ behavior: "smooth", block: "center" });
        } catch {
          chatInput.scrollIntoView();
        }
        return true;
      }

      function showPanelHeroPrefillBanner() {
        const banner = document.getElementById("panel-hero-prefill-banner");
        if (!banner) return;
        banner.textContent = panelT("panel.modules.chat.empty.heroPrefillBanner");
        banner.hidden = false;
      }

      function refreshPanelHeroPrefillBannerI18n() {
        const banner = document.getElementById("panel-hero-prefill-banner");
        if (!banner || banner.hidden) return;
        banner.textContent = panelT("panel.modules.chat.empty.heroPrefillBanner");
      }

      function prefillPanelChatFromUrlQuery() {
        try {
          const q = new URLSearchParams(window.location.search).get("q");
          if (q && String(q).trim()) {
            navigatePanelModule("sohbet");
            const ok = prefillPanelChatFromEvidence(q);
            if (ok) showPanelHeroPrefillBanner();
            return ok;
          }
        } catch {
          /* ignore */
        }
        return false;
      }

      function evidenceContinueFromGroup(group) {
        if (!group || !group.canContinue) return;
        if (group.continueKind === "task" && group.entityRefId) {
          navigatePanelModule("gorevler");
          if (typeof panelEvidenceOpenTaskDetail === "function") {
            panelEvidenceOpenTaskDetail(group.entityRefId);
          }
          return;
        }
        if (group.continueKind === "chat" && group.titlePreview) {
          navigatePanelModule("sohbet");
          prefillPanelChatFromEvidence(group.titlePreview);
        }
      }

      async function fetchEvidenceRecent() {
        const base = resolveGorevlerTasksApiBase();
        if (!base) return { ok: false };
        try {
          const r = await fetch(`${base}/evidence/recent`, {
            headers: { Accept: "application/json" },
          });
          if (!r.ok) return { ok: false };
          const data = await r.json();
          if (!data || !Array.isArray(data.events)) return { ok: false };
          return { ok: true, events: data.events };
        } catch {
          return { ok: false };
        }
      }

      let panelQuantumReadinessLoaded = false;
      /** @type {null | Record<string, unknown>} */
      let panelQuantumReadinessReport = null;

      async function fetchQuantumReadiness() {
        const base = resolveGorevlerTasksApiBase();
        if (!base) return { ok: false };
        try {
          const r = await fetch(`${base}/quantum-readiness`, {
            headers: { Accept: "application/json" },
          });
          if (!r.ok) return { ok: false };
          const data = await r.json();
          if (!data || data.meta?.report_type !== "quantum_readiness") return { ok: false };
          return { ok: true, report: data };
        } catch {
          return { ok: false };
        }
      }

      function formatQuantumCryptoInventory(inv) {
        if (!inv || typeof inv !== "object") return panelT("panel.modules.quantum.mock.cryptoValue");
        const parts = []
          .concat(inv.encryption_types || [])
          .concat(inv.signature_types || [])
          .concat(inv.key_types || []);
        const note = String(inv.quantum_exposure_note || "").trim();
        if (!parts.length) return note || panelT("panel.modules.quantum.mock.cryptoValue");
        return note ? `${parts.join(", ")} — ${note}` : parts.join(", ");
      }

      function formatQuantumAgilityLevel(level) {
        const key = String(level || "").trim().toLowerCase();
        const label = panelT(`panel.modules.quantum.live.agility.${key}`);
        if (label && !label.startsWith("panel.modules.quantum")) return label;
        return String(level || panelT("panel.modules.quantum.mock.agilityValue"));
      }

      function formatQuantumPqcReadiness(pqc) {
        if (!pqc || typeof pqc !== "object") return panelT("panel.modules.quantum.mock.pqcValue");
        const status = String(pqc.pqc_status || "").trim();
        const aware = pqc.nist_pqc_awareness === true;
        const statusLabel = panelT(`panel.modules.quantum.live.pqcStatus.${status}`);
        const statusText =
          statusLabel && !statusLabel.startsWith("panel.modules.quantum") ? statusLabel : status;
        const awareText = aware
          ? panelT("panel.modules.quantum.live.pqcAwareYes")
          : panelT("panel.modules.quantum.live.pqcAwareNo");
        return `${statusText} — ${awareText}`;
      }

      function formatQuantumGeneratedAt(iso) {
        const raw = String(iso || "").trim();
        if (!raw) return "";
        const parsed = Date.parse(raw);
        if (Number.isNaN(parsed)) return raw;
        try {
          return new Date(parsed).toLocaleString(undefined, { timeZoneName: "short" });
        } catch {
          return raw;
        }
      }

      function formatQuantumFindingSeverity(severity) {
        const key = String(severity || "").trim().toLowerCase();
        const label = panelT(`panel.modules.quantum.live.severity.${key}`);
