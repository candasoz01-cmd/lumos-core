          role.className = "chat-msg-role";
          role.textContent = chatBubbleRoleLabel("user");
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          const trimmed = plainText && String(plainText).trim();
          if (trimmed) {
            const textEl = document.createElement("div");
            textEl.textContent = trimmed;
            body.appendChild(textEl);
          }
          if (imageDataUrl) {
            if (!trimmed) {
              const cap = document.createElement("div");
              cap.textContent = panelT("panel.modules.chat.compose.photoAdded");
              body.appendChild(cap);
            }
            const img = document.createElement("img");
            img.src = imageDataUrl;
            img.alt = "";
            img.decoding = "async";
            img.style.maxWidth = "100%";
            img.style.borderRadius = "8px";
            img.style.display = "block";
            img.style.marginTop = trimmed ? "8px" : "6px";
            body.appendChild(img);
          }
          if (audioObjectUrl) {
            if (!trimmed && !imageDataUrl) {
              const cap = document.createElement("div");
              cap.textContent = panelT("panel.modules.chat.compose.audioRecordAttached");
              body.appendChild(cap);
            }
            if (audioUploadMeta && typeof audioUploadMeta === "object") {
              const metaWrap = document.createElement("div");
              metaWrap.className = "chat-compose-bubble-audio-meta";
              const uploadName =
                audioUploadMeta.name != null ? String(audioUploadMeta.name).trim() : "";
              if (uploadName) {
                const nameEl = document.createElement("div");
                nameEl.className = "chat-compose-bubble-audio-meta-name";
                nameEl.textContent = uploadName;
                nameEl.title = uploadName;
                metaWrap.appendChild(nameEl);
              }
              const uploadType =
                audioUploadMeta.type != null ? String(audioUploadMeta.type).trim() : "";
              if (uploadType) {
                const typeEl = document.createElement("div");
                typeEl.className = "chat-compose-bubble-audio-meta-detail";
                typeEl.textContent = uploadType;
                metaWrap.appendChild(typeEl);
              }
              const sizeLabel = formatFileSize(audioUploadMeta.size);
              if (sizeLabel) {
                const sizeEl = document.createElement("div");
                sizeEl.className = "chat-compose-bubble-audio-meta-detail";
                sizeEl.textContent = sizeLabel;
                metaWrap.appendChild(sizeEl);
              }
              if (metaWrap.childNodes.length) {
                body.appendChild(metaWrap);
              }
            }
            const audio = document.createElement("audio");
            audio.controls = true;
            audio.src = audioObjectUrl;
            audio.setAttribute("aria-label", panelT("panel.modules.chat.compose.audioRecordAria"));
            audio.className = "chat-compose-bubble-audio";
            body.appendChild(audio);
            const txFilename =
              audioUploadMeta && audioUploadMeta.name != null
                ? String(audioUploadMeta.name).trim()
                : "recording.webm";
            const txMime =
              audioUploadMeta && audioUploadMeta.type != null
                ? String(audioUploadMeta.type).trim()
                : audioBlob && audioBlob.type
                  ? audioBlob.type
                  : "audio/webm";
            attachAudioTranscriptPlaceholder(body, audioBlob, {
              filename: txFilename || "recording.webm",
              mime: txMime || "audio/webm",
              source: audioUploadMeta ? "upload-bubble" : "record-bubble",
            });
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        function resetPanelHorizontalScrollAfterInputBlur() {
          const y = window.scrollY;
          try {
            window.scrollTo({ left: 0, top: y, behavior: "instant" });
          } catch {
            try {
              window.scrollTo({ left: 0, top: y, behavior: "auto" });
            } catch {
              window.scrollTo(0, y);
            }
          }
          const se = document.scrollingElement;
          if (se) se.scrollLeft = 0;
          document.documentElement.scrollLeft = 0;
          document.body.scrollLeft = 0;
        }

        function summarizeClientFetchError(err) {
          if (err == null) return panelT("panel.modules.chat.log.unknownError");
          if (typeof err === "object" && err !== null && typeof err.message === "string" && err.message) {
            return err.message;
          }
          return String(err);
        }

        const PANEL_CHAT_LOG_MAX = 8000;
        function truncatePanelChatLog(s) {
          const t = s == null ? "" : String(s);
          if (t.length <= PANEL_CHAT_LOG_MAX) return t;
          return (
            t.slice(0, PANEL_CHAT_LOG_MAX)
            + "\n"
            + panelT("panel.modules.chat.log.charsRemaining").replace(
              "{n}",
              String(t.length - PANEL_CHAT_LOG_MAX),
            )
          );
        }

        /** Panel /chat hata türleri — panel.modules.chat.errors.* ile hizalı. */
        const PANEL_CHAT_ERROR_KINDS = [
          "network_error",
          "timeout",
          "unauthorized",
          "server_error",
          "model_error",
          "unknown_error",
        ];

        function userMessageForPanelChatFailureKind(kind) {
          const k = PANEL_CHAT_ERROR_KINDS.includes(kind) ? kind : "unknown_error";
          return panelT("panel.modules.chat.errors." + k);
        }

        function paintPanelChatBubbleBody(wrap, body, text) {
          if (wrap.classList.contains("chat-msg--lumos")) {
            body.innerHTML = formatAssistantHtml(panelUserVisibleText(text));
          } else if (wrap.classList.contains("chat-msg--error")) {
            body.textContent = panelUserVisibleText(text);
          } else {
            body.textContent = text;
          }
        }

        function panelChatBubbleTextFromI18nMeta(wrap) {
          const key = wrap.getAttribute("data-panel-bubble-i18n");
          if (!key) return null;
          let text = panelT(key);
          const varsRaw = wrap.getAttribute("data-panel-bubble-i18n-vars");
          if (varsRaw) {
            try {
              const vars = JSON.parse(varsRaw);
              Object.keys(vars).forEach((k) => {
                text = text.replace("{" + k + "}", String(vars[k]));
              });
            } catch {
              /* ignore */
            }
          }
          const suffix = wrap.getAttribute("data-panel-bubble-i18n-suffix");
          if (suffix != null) text += suffix;
          return text;
        }

        refreshChatBubbleBodies = function refreshChatBubbleBodiesImpl() {
          document.querySelectorAll(".chat-msg").forEach((wrap) => {
            const body = wrap.querySelector(".chat-msg-body");
            if (!body) return;
            const refresher = panelChatBubbleBodyRefreshers.get(wrap);
            if (refresher) {
              paintPanelChatBubbleBody(wrap, body, refresher());
              return;
            }
            const errorKind = wrap.getAttribute("data-panel-chat-error-kind");
            if (errorKind) {
              paintPanelChatBubbleBody(
                wrap,
                body,
                userMessageForPanelChatFailureKind(errorKind),
              );
              return;
            }
            const i18nText = panelChatBubbleTextFromI18nMeta(wrap);
            if (i18nText != null) {
              paintPanelChatBubbleBody(wrap, body, i18nText);
            }
          });
        };

        function panelChatFailureUserMessage(ctx, kindOverride) {
          const kind =
            kindOverride && PANEL_CHAT_ERROR_KINDS.includes(kindOverride)
              ? kindOverride
              : classifyPanelChatFailure(ctx || {});
          const userMsg = userMessageForPanelChatFailureKind(kind);
          if (PANEL_DEBUG) {
            const raw = String(
              (ctx && (ctx.rawError || ctx.errMessage || ctx.upstreamText)) || "",
            ).trim();
            const status =
              ctx && ctx.httpStatus != null && Number.isFinite(ctx.httpStatus)
                ? " HTTP " + ctx.httpStatus
                : "";
            return raw ? userMsg + " [" + raw + status + "]" : userMsg + status;
          }
          return userMsg;
        }

        function classifyPanelChatFailure(ctx) {
          const status =
            typeof ctx.httpStatus === "number" && Number.isFinite(ctx.httpStatus)
              ? ctx.httpStatus
              : null;
          const name = String(ctx.errName || "").toLowerCase();
          const msg = String(ctx.errMessage || ctx.upstreamText || "").toLowerCase();
          if (status === 401 || status === 403) return "unauthorized";
          if (status != null && status >= 500) return "server_error";
          if (status === 429) return "model_error";
          if (/timeout|timed\s*out|etimedout|aborterror|deadline/i.test(name + " " + msg)) {
            return "timeout";
          }
          if (
            /failed to fetch|networkerror|network\s*error|econnrefused|enotfound|fetch failed|dns/i.test(
              name + " " + msg,
            )
            || (status == null && /ulaşılamadı|network|cors/i.test(msg))
          ) {
            return "network_error";
          }
          if (/unauthorized|forbidden|401|403|invalid.*token|api.?key/i.test(msg)) {
            return "unauthorized";
          }
          if (
            /openai|chat\s*llm\s*error|model|responses\.create|rate.?limit|content.?policy/i.test(
              msg,
            )
          ) {
            return "model_error";
          }
          if (/internal server|500|502|503|504|sunucu/i.test(msg)) {
            return "server_error";
          }
          return "unknown_error";
        }

        /** Gerçek hata/ayrıntı sızıntıları; normal sohbet kelimeleri (ör. token) dahil değil. */
        const PANEL_CHAT_TECH_LEAK_RE = new RegExp(
          [
            "traceback",
            "stack\\s*trace",
            "stacktrace",
            "OPENAI_API_KEY",
            "process\\.env",
            "Authorization\\s*:",
            "\\bBearer\\s+[A-Za-z0-9._-]{8,}",
            "\\bException\\b",
            "\\bError:\\s",
            "modulenotfounderror",
            "no\\s+module\\s+named",
            "node_modules[/\\\\]",
            "[/\\\\](?:src|backend|dist)[/\\\\]",
            "\\.(?:py|js|ts):\\d+",
            "chat\\s*llm\\s*error",
          ].join("|"),
          "i",
        );

        /**
         * Hata balonu / teknik önizleme metni: sızıntı kalıplarında backend ile uyumlu Türkçe mesaj.
         * Başarılı asistan yanıtlarında kullanılmaz.
         */
        function panelChatSanitizeUserVisibleChatFailureText(raw, ctx) {
          const original = String(raw ?? "").trim();
          if (!original) return "";
          if (!PANEL_CHAT_TECH_LEAK_RE.test(original)) return original;
          console.error(
            "[Lumos panel chat] User-visible text matched technical patterns; raw upstream:",
            truncatePanelChatLog(original),
          );
          const kind = classifyPanelChatFailure({
            httpStatus: ctx && ctx.httpStatus,
            errName: ctx && ctx.errName,
            errMessage: ctx && ctx.errMessage,
            upstreamText: original,
          });
          return userMessageForPanelChatFailureKind(kind);
        }

        function parsePanelChatJsonBody(trimmed) {
          try {
            let v = JSON.parse(trimmed);
            if (typeof v === "string") {
              const inner = v.trim();
              if (
                inner.length > 1
                && ((inner.startsWith("{") && inner.endsWith("}"))
                  || (inner.startsWith("[") && inner.endsWith("]")))
              ) {
                try {
                  v = JSON.parse(inner);
                } catch {
                  /* kök JSON string = asistan metni */
                }
              }
            }
            return { ok: true, value: v };
          } catch {
            return { ok: false, value: null };
          }
        }

        /**
         * HTTP 200 JSON gövdesinde hata alanı varsa sınıflandır; asistan metni olarak kullanma.
         * @returns {{ kind: string; rawError: string } | null}
         */
        function parsePanelChatErrorPayload(data) {
          if (data == null || typeof data !== "object" || Array.isArray(data)) return null;
          const rawError =
            typeof data.error === "string" && data.error.trim() ? data.error.trim() : "";
          const errorKindRaw =
            typeof data.errorKind === "string" && data.errorKind.trim()
              ? data.errorKind.trim()
              : "";
          const hasErrorKind = PANEL_CHAT_ERROR_KINDS.includes(errorKindRaw);
          if (!rawError && !hasErrorKind) return null;
          const kind = hasErrorKind
            ? errorKindRaw
            : classifyPanelChatFailure({
                httpStatus: 200,
                upstreamText: rawError,
                errMessage: rawError,
              });
          return { kind, rawError };
        }

        /** HTTP 200 + error alanları olsa bile foto fallback metni asistan yanıtı olarak önceliklidir. */
        function isPanelChatPhotoFallbackReply(text) {
          const t = text == null ? "" : String(text).trim();
          if (!t) return false;
          return t === REPLY_PHOTO_NO_VISION_TR || PANEL_REPLY_PHOTO_NO_VISION_RE.test(t);
        }

        function extractAssistantFromChatPayload(data) {
          if (data == null) return "";
          if (typeof data === "string") return String(data).trim();
          if (typeof data !== "object") return "";
          const keys = ["reply", "content", "message", "answer", "text", "response"];
          function fromObj(o) {
            if (!o || typeof o !== "object" || Array.isArray(o)) return "";
            for (let i = 0; i < keys.length; i++) {
              const k = keys[i];
              if (Object.prototype.hasOwnProperty.call(o, k) && o[k] != null) {
                const s = String(o[k]).trim();
                if (s) return s;
              }
            }
            return "";
          }
          let out = fromObj(data);
          if (out) return out;
          out = fromObj(data.data);
          if (out) return out;
          const choices = data.choices;
          if (Array.isArray(choices) && choices.length) {
            const c0 = choices[0];
            if (c0 && typeof c0 === "object") {
              const msg = c0.message;
              if (msg && typeof msg === "object" && typeof msg.content === "string") {
                const s = msg.content.trim();
                if (s) return s;
              }
              if (typeof c0.text === "string" && c0.text.trim()) return c0.text.trim();
            }
          }
          return "";
        }

        function looksLikePanelChatPlainText(trimmed) {
          if (!trimmed || trimmed.length > 100000) return false;
          const c0 = trimmed.charCodeAt(0);
          if (c0 === 0x7b || c0 === 0x5b) return false;
          if (/^<!DOCTYPE\b/i.test(trimmed) || /^<html\b/i.test(trimmed)) return false;
          return true;
        }

        async function runSend() {
          const message = input.value.trim();
          const photoFile =
            cameraPhotoInput && cameraPhotoInput.files && cameraPhotoInput.files[0]
              ? cameraPhotoInput.files[0]
              : null;
          const hasPhoto = !!(photoFile && /^image\//.test(photoFile.type));
          const hasAudio = !!(audioRecordBlob && audioRecordBlob.size >= 512);
          if ((!message && !hasPhoto && !hasAudio) || sending) return;
          if (hasPhoto && hasAudio) {
            setSendHint(() => panelT("panel.modules.chat.compose.hints.pickOneAttachment"));
            return;
          }

          setSendHint("");
          if (!hasPhoto) {
            showPanelChatPhotoTech("");
          }

          let imageDataUrlForBubble = null;
          if (hasPhoto) {
            try {
              imageDataUrlForBubble = await readFileAsDataUrl(photoFile);
            } catch {
              setSendHint(() => panelT("panel.modules.chat.compose.hints.photoReadFailed"));
              return;
            }
          }

          let audioBubbleUrl = null;
          if (hasAudio) {
            audioBubbleUrl = URL.createObjectURL(audioRecordBlob);
            audioBubbleObjectUrls.add(audioBubbleUrl);
          }

          const panelGorevCmd = parsePanelGorevKomutu(message);
          const userMode = getPanelUserMode();

          if (!hasPhoto && !hasAudio && !panelGorevCmd) {
            const localTimeReply = tryPanelLocalTimeReply(message);
            if (localTimeReply) {
              sending = true;
              sendBtn.disabled = true;
              sendBtn.setAttribute("aria-busy", "true");
              sendBtn.setAttribute("aria-label", panelSendLoadingLabel());
              sendBtn.setAttribute("title", panelSendLoadingLabel());
              sendBtn.classList.add("chat-compose-send--busy");
              try {
                appendBubble("user", message);
                appendBubble("lumos", localTimeReply);
                input.value = "";
                clearPanelCameraPhotoSelection();
                clearPanelAudioRecordSelection();
                setSendHint("");
                input.blur();
                resetPanelHorizontalScrollAfterInputBlur();
              } finally {
                sending = false;
                sendBtn.disabled = false;
                sendBtn.removeAttribute("aria-busy");
                sendBtn.setAttribute("aria-label", panelSendLabel());
                sendBtn.setAttribute("title", panelSendLabel());
                sendBtn.classList.remove("chat-compose-send--busy");
                refocusPanelChatInput();
              }
              return;
            }
          }

          if (!shouldAttemptRemoteChat()) {
            sending = true;
            sendBtn.disabled = true;
            sendBtn.setAttribute("aria-busy", "true");
            sendBtn.setAttribute("aria-label", panelSendLoadingLabel());
            sendBtn.setAttribute("title", panelSendLoadingLabel());
            sendBtn.classList.add("chat-compose-send--busy");
            const photoReply = panelComposePhotoReply(userMode);
            const audioReply = panelComposeAudioReply(userMode);
            const photoHint = panelComposePhotoHint(userMode);
            const audioHint = panelComposeAudioHint(userMode);
            try {
              if (hasPhoto) {
                appendUserComposeBubble(message, imageDataUrlForBubble);
                appendBubble("lumos", photoReply, panelComposePhotoReplyMeta(userMode));
                setSendHint(() => panelComposePhotoHint(getPanelUserMode()));
                input.value = "";
                clearPanelCameraPhotoSelection();
                input.blur();
                resetPanelHorizontalScrollAfterInputBlur();
                return;
              }

              if (hasAudio) {
                appendUserComposeBubble(message, null, audioBubbleUrl, null, audioRecordBlob);
                appendBubble("lumos", audioReply, panelComposeAudioReplyMeta(userMode));
                setSendHint(() => panelComposeAudioHint(getPanelUserMode()));
                input.value = "";
                clearPanelAudioRecordSelection();
                input.blur();
                resetPanelHorizontalScrollAfterInputBlur();
                return;
              }

              appendBubble("user", message);
              if (panelGorevCmd) {
                if (panelGorevCmd.verb === "sil") {
                  const delReply = panelGorevlerDeleteFromChat
                    ? await panelGorevlerDeleteFromChat(panelGorevCmd.ref)
                    : panelT("panel.modules.chat.gorev.deleteUnavailable");
                  appendBubble("lumos", delReply);
                } else if (panelGorevCmd.verb === "geri_al") {
                  const restoreReply = panelGorevlerRestoreFromChat
                    ? await panelGorevlerRestoreFromChat(panelGorevCmd.ref)
                    : panelT("panel.modules.chat.gorev.restoreUnavailable");
                  appendBubble("lumos", restoreReply);
                } else {
                  await applyPanelGorevKomutu(panelGorevCmd);
                  appendBubble("lumos", buildPanelGorevConfirmation(panelGorevCmd), buildPanelGorevConfirmationMeta(panelGorevCmd));
                }
              } else {
                appendBubble("lumos", buildPanelLocalModeReply(message), {
                  refreshBody: () => buildPanelLocalModeReply(message),
                });
              }
              input.value = "";
              clearPanelCameraPhotoSelection();
              setSendHint("");
              input.blur();
              resetPanelHorizontalScrollAfterInputBlur();
            } finally {
              sending = false;
              sendBtn.disabled = false;
              sendBtn.removeAttribute("aria-busy");
              sendBtn.setAttribute("aria-label", panelSendLabel());
              sendBtn.setAttribute("title", panelSendLabel());
              sendBtn.classList.remove("chat-compose-send--busy");
              refocusPanelChatInput();
            }
            return;
          }

          const outgoingMessage = message;

          sending = true;
          sendBtn.disabled = true;
          sendBtn.setAttribute("aria-busy", "true");
          sendBtn.setAttribute("aria-label", panelSendLoadingLabel());
          sendBtn.setAttribute("title", panelSendLoadingLabel());
          sendBtn.classList.add("chat-compose-send--busy");
          const history = collectThreadHistory(thread);
          if (imageDataUrlForBubble) {
            appendUserComposeBubble(message, imageDataUrlForBubble);
          } else if (hasAudio) {
            appendUserComposeBubble(message, null, audioBubbleUrl, null, audioRecordBlob);
          } else {
            appendBubble("user", message);
          }

          /** Liste + onay: fetch’ten önce; aksi halde uzayan / takılan istek zinciri burada kopar (runSend hiç ilerlemez). */
          if (panelGorevCmd) {
            if (panelGorevCmd.verb === "sil") {
              const delReply = panelGorevlerDeleteFromChat
                ? await panelGorevlerDeleteFromChat(panelGorevCmd.ref)
                : panelT("panel.modules.chat.gorev.deleteUnavailable");
              appendBubble("lumos", delReply);
              input.value = "";
              clearPanelCameraPhotoSelection();
              clearPanelAudioRecordSelection();
              setSendHint("");
              input.blur();
              resetPanelHorizontalScrollAfterInputBlur();
              sending = false;
              sendBtn.disabled = false;
              sendBtn.removeAttribute("aria-busy");
              sendBtn.setAttribute("aria-label", panelSendLabel());
              sendBtn.setAttribute("title", panelSendLabel());
              sendBtn.classList.remove("chat-compose-send--busy");
              refocusPanelChatInput();
              return;
            }
            if (panelGorevCmd.verb === "geri_al") {
              const restoreReply = panelGorevlerRestoreFromChat
                ? await panelGorevlerRestoreFromChat(panelGorevCmd.ref)
                : panelT("panel.modules.chat.gorev.restoreUnavailable");
              appendBubble("lumos", restoreReply);
              input.value = "";
              clearPanelCameraPhotoSelection();
              clearPanelAudioRecordSelection();
              setSendHint("");
              input.blur();
              resetPanelHorizontalScrollAfterInputBlur();
              sending = false;
              sendBtn.disabled = false;
              sendBtn.removeAttribute("aria-busy");
              sendBtn.setAttribute("aria-label", panelSendLabel());
              sendBtn.setAttribute("title", panelSendLabel());
              sendBtn.classList.remove("chat-compose-send--busy");
              refocusPanelChatInput();
              return;
            }
            await applyPanelGorevKomutu(panelGorevCmd);
            appendBubble("lumos", buildPanelGorevConfirmation(panelGorevCmd), buildPanelGorevConfirmationMeta(panelGorevCmd));
            input.value = "";
            clearPanelCameraPhotoSelection();
            clearPanelAudioRecordSelection();
            setSendHint("");
            input.blur();
            resetPanelHorizontalScrollAfterInputBlur();
          }

          if (hasAudio && !outgoingMessage && !hasPhoto) {
            appendBubble("lumos", panelT("panel.modules.chat.compose.hints.fullAudioReply"), {
              i18nKey: "panel.modules.chat.compose.hints.fullAudioReply",
            });
            setSendHint(() => panelT("panel.modules.chat.compose.hints.fullAudioHint"));
            input.value = "";
            clearPanelAudioRecordSelection();
            input.blur();
            resetPanelHorizontalScrollAfterInputBlur();
            sending = false;
            sendBtn.disabled = false;
            sendBtn.removeAttribute("aria-busy");
            sendBtn.setAttribute("aria-label", panelSendLabel());
            sendBtn.setAttribute("title", panelSendLabel());
            sendBtn.classList.remove("chat-compose-send--busy");
            refocusPanelChatInput();
            return;
          }

          /**
           * Sistem Durumu için fotoğraf gönderim özeti; backend'e gönderilmez, yalnızca
           * istemcide görsel analiz durumunu (aktif/fallback/hata) çıkarmak ve panele yazmak için tutulur.
           */
          const photoTelemetry = hasPhoto && photoFile
            ? {
                photoAttached: true,
                photoSize:
                  typeof photoFile.size === "number" && Number.isFinite(photoFile.size)
                    ? photoFile.size
                    : 0,
                inlineBytes: 0,
                hasInline: false,
              }
            : null;
          try {
            const chatBody = {
              message: outgoingMessage,
              history,
              locale:
                window.LumosI18n && typeof window.LumosI18n.getLocale === "function"
                  ? window.LumosI18n.getLocale()
                  : "tr",
              panelContext: {
                bridgeBaseUrl: BRIDGE_BASE_URL,
                tasksApiUrl: TASKS_API_URL,
              },
            };
            if (hasPhoto && photoFile) {
              chatBody.photoAttached = true;
              chatBody.photoName = photoFile.name || "";
              chatBody.photoType = photoFile.type || "";
              chatBody.photoSize =
                typeof photoFile.size === "number" && Number.isFinite(photoFile.size)
                  ? photoFile.size
                  : 0;
              let inlineB64 =
                imageDataUrlForBubble && dataUrlToInlineBase64ForChat(imageDataUrlForBubble, photoFile);
              let sentCompressedJpeg = false;
              if (!inlineB64) {
                inlineB64 = await compressPhotoFileForChat(photoFile);
                sentCompressedJpeg = !!inlineB64;
              }
              if (inlineB64) chatBody.imageData = inlineB64;
              if (sentCompressedJpeg) {
                chatBody.photoType = "image/jpeg";
                const rawName = photoFile.name || "photo";
                chatBody.photoName = rawName.replace(/\.[^/.]+$/, "") + ".jpg";
              }
              if (photoTelemetry) {
                photoTelemetry.hasInline = !!inlineB64;
                photoTelemetry.inlineBytes = inlineB64
                  ? decodedByteLengthFromBase64(inlineB64)
                  : 0;
              }
            }
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
                "Accept-Language":
                  window.LumosI18n && typeof window.LumosI18n.getLocale === "function"
                    ? window.LumosI18n.getLocale()
                    : "tr",
              },
              body: JSON.stringify(chatBody),
            });
            const text = await r.text();

            if (!r.ok) {
              console.warn("[Lumos panel chat] HTTP error", r.status);
              setSendHint(() =>
                panelDebugText(
                  panelT("panel.modules.chat.compose.hints.httpSendFailedDebugPrefix") +
                    r.status +
                    panelT("panel.modules.chat.compose.hints.httpSendFailedDebugSuffix"),
                  panelT("panel.modules.chat.errors.network_error"),
                ),
              );
              let upstreamErr = "";
              let upstreamKind = "";
              if (text) {
                try {
                  const errJson = JSON.parse(text);
                  if (errJson && typeof errJson === "object") {
                    if (typeof errJson.errorKind === "string" && errJson.errorKind.trim()) {
                      upstreamKind = errJson.errorKind.trim();
                    }
                    if (typeof errJson.reply === "string" && errJson.reply.trim()) {
                      upstreamErr = errJson.reply.trim();
                    } else if (typeof errJson.error === "string") {
                      upstreamErr = errJson.error.trim();
                    }
                  }
                } catch {
                  upstreamErr = String(text).trim().slice(0, 200);
                }
              }
              const httpFailKind =
                upstreamKind && PANEL_CHAT_ERROR_KINDS.includes(upstreamKind)
                  ? upstreamKind
                  : classifyPanelChatFailure({
                      httpStatus: r.status,
                      upstreamText: upstreamErr,
                    });
              appendBubble(
                "error",
                panelChatFailureUserMessage(
                  {
                    httpStatus: r.status,
                    upstreamText: upstreamErr,
                    errMessage: upstreamErr,
                  },
                  httpFailKind,
                ),
                { errorKind: httpFailKind },
              );
              reportPanelInfraUnavailable(
                "sohbet HTTP " + r.status,
                panelT("panel.shell.infra.unavailableShort"),
              );
              void loadPanelBackendStatus();
              if (photoTelemetry && PANEL_DEBUG) {
                let reason = "HTTP " + r.status;
                let missingKey = "";
                if (text) {
                  try {
                    const errJson = JSON.parse(text);
                    if (errJson && typeof errJson === "object") {
                      if (typeof errJson.error === "string") {
                        if (/OPENAI_API_KEY/i.test(errJson.error)) {
                          missingKey = " · Görsel analiz için API anahtarı eksik";
                        }
                        reason = "HTTP " + r.status + " · " + errJson.error.slice(0, 80);
                      }
                    }
                  } catch {
                    /* ham metin */
                  }
                }
                const visionGuess =
                  photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
                const replyHttpErrRaw = text ? String(text).trim() : "";
                showPanelChatPhotoTech(
                  buildPhotoTechBlock({
                    httpStatus: r.status,
                    reachedBackend: true,
                    imageDataSent: photoTelemetry.hasInline,
                    visionTriedGuess: visionGuess,
                    replyPreview: panelChatSanitizeUserVisibleChatFailureText(replyHttpErrRaw, {
                      httpStatus: r.status,
                    }).slice(0, 120),
                    fallbackExact: false,
                    fallbackRegex: false,
                    networkError: false,
                    extraReason: panelChatSanitizeUserVisibleChatFailureText(reason + missingKey, {
                      httpStatus: r.status,
                    }),
                  }),
                );
                void loadPanelBackendStatus();
              }
            } else {
              const CHAT_BODY_UNUSABLE_BUBBLE = panelT("panel.modules.chat.compose.hints.responseUnusableBubble");

              let chatFailureReported = false;
              function reportChatBodyFailure() {
                if (chatFailureReported) return;
                chatFailureReported = true;
                setSendHint(() => panelT("panel.modules.chat.compose.hints.responseUnreadable"));
                appendBubble("error", CHAT_BODY_UNUSABLE_BUBBLE, {
                  i18nKey: "panel.modules.chat.compose.hints.responseUnusableBubble",
                });
              }

              const trimmedBody = text == null ? "" : String(text).trim();
              let parsedPayload = null;
              let havePayload = false;

              if (!trimmedBody) {
                console.debug("[Lumos panel chat] Boş gövde (HTTP 200)");
                reportChatBodyFailure();
              } else {
                const jr = parsePanelChatJsonBody(trimmedBody);
                if (jr.ok) {
                  havePayload = true;
                  parsedPayload = jr.value;
                } else {
                  console.error(
                    "[Lumos panel chat] JSON ayrıştırılamadı, ham yanıt:",
                    truncatePanelChatLog(text),
                  );
                  if (looksLikePanelChatPlainText(trimmedBody)) {
                    havePayload = true;
                    parsedPayload = trimmedBody;
                  } else {
                    reportChatBodyFailure();
                  }
                }
              }

              if (havePayload) {
                const errorPayload = parsePanelChatErrorPayload(parsedPayload);
                const replyFor200 = extractAssistantFromChatPayload(parsedPayload);
                const skip200ErrorBubble =
                  !!replyFor200.trim() && isPanelChatPhotoFallbackReply(replyFor200);
                if (errorPayload && !skip200ErrorBubble) {
                  appendBubble(
                    "error",
                    panelChatFailureUserMessage(
                      {
                        httpStatus: r.status,
                        upstreamText: errorPayload.rawError,
                        errMessage: errorPayload.rawError,
                      },
                      errorPayload.kind,
                    ),
                    { errorKind: errorPayload.kind },
                  );
                  setSendHint("");
                  if (photoTelemetry && PANEL_DEBUG) {
                    showPanelChatPhotoTech(
                      buildPhotoTechBlock({
                        httpStatus: r.status,
                        reachedBackend: true,
                        imageDataSent: photoTelemetry.hasInline,
                        visionTriedGuess:
                          photoTelemetry.hasInline
                          && !!photoFile
                          && /^image\//i.test(photoFile.type || ""),
                        replyPreview: panelChatSanitizeUserVisibleChatFailureText(
                          errorPayload.rawError,
                          { httpStatus: r.status },
                        ).slice(0, 120),
                        fallbackExact: false,
                        fallbackRegex: false,
                        networkError: false,
                        extraReason: "HTTP 200 · error alanı",
                      }),
                    );
                    void loadPanelBackendStatus();
                  }
                } else {
                const replyBody = replyFor200;
                if (photoTelemetry && PANEL_DEBUG) {
                  const trimmedReply = replyBody.trim();
                  const fallbackExact = trimmedReply === REPLY_PHOTO_NO_VISION_TR;
                  const fallbackRegex = PANEL_REPLY_PHOTO_NO_VISION_RE.test(trimmedReply);
                  const visionGuess =
                    photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
                  if (fallbackRegex || fallbackExact) {
                    const extra =
                      !photoTelemetry.hasInline
                        ? "Görsel veri gitmedi (tavan veya sıkıştırma) · dosya ≈ "
                          + formatBytesShort(photoTelemetry.photoSize)
                        : "";
                    showPanelChatPhotoTech(
                      buildPhotoTechBlock({
                        httpStatus: r.status,
                        reachedBackend: true,
                        imageDataSent: photoTelemetry.hasInline,
                        visionTriedGuess: visionGuess,
                        replyPreview: trimmedReply.slice(0, 140),
                        fallbackExact,
                        fallbackRegex: fallbackRegex && !fallbackExact,
                        networkError: false,
                        extraReason: extra,
                      }),
                    );
                  } else if (trimmedReply) {
                    showPanelChatPhotoTech(
                      buildPhotoTechBlock({
                        httpStatus: r.status,
                        reachedBackend: true,
                        imageDataSent: photoTelemetry.hasInline,
                        visionTriedGuess: visionGuess,
                        replyPreview: trimmedReply.slice(0, 140),
                        fallbackExact: false,
                        fallbackRegex: false,
                        networkError: false,
                        extraReason: "",
                      }),
                    );
                  } else {
                    showPanelChatPhotoTech(
                      buildPhotoTechBlock({
                        httpStatus: r.status,
                        reachedBackend: true,
                        imageDataSent: photoTelemetry.hasInline,
                        visionTriedGuess: visionGuess,
                        replyPreview: "",
                        fallbackExact: false,
                        fallbackRegex: false,
                        networkError: false,
                        extraReason: "Boş yanıt",
                      }),
                    );
                  }
                  void loadPanelBackendStatus();
                }
                if (replyBody.trim()) {
                  const { lumosText } = await ingestAssistantPanelGorev(replyBody);
                  if (panelGorevCmd) {
                    appendBubble(
                      "lumos",
                      panelT("panel.modules.chat.compose.hints.gorevServerReplyPrefix") +
                        panelChatDisplayReply(lumosText),
                      {
                        i18nKey: "panel.modules.chat.compose.hints.gorevServerReplyPrefix",
                        i18nSuffix: panelChatDisplayReply(lumosText),
                      },
                    );
                    setSendHint("");
                  } else {
                    appendBubble("lumos", panelChatDisplayReply(lumosText));
                    input.value = "";
                    clearPanelCameraPhotoSelection();
                    clearPanelAudioRecordSelection();
                    setSendHint("");
                    input.blur();
                    resetPanelHorizontalScrollAfterInputBlur();
                  }
                } else if (panelGorevCmd) {
                  appendBubble(
                    "lumos",
                    panelT("panel.modules.chat.compose.hints.gorevNoExtraServerText"),
                    { i18nKey: "panel.modules.chat.compose.hints.gorevNoExtraServerText" },
                  );
                  setSendHint("");
                } else {
                  appendBubble("lumos", panelT("panel.modules.chat.compose.hints.emptyReply"), {
                    i18nKey: "panel.modules.chat.compose.hints.emptyReply",
                  });
                  setSendHint("");
                }
                }
              }
            }
          } catch (err) {
            const netMsg = summarizeClientFetchError(err);
            const errName =
              err && typeof err === "object" && err.name ? String(err.name) : "";
            setSendHint(() =>
              panelDebugText(
                panelT("panel.modules.chat.compose.hints.requestErrorDebugPrefix") +
                  netMsg.slice(0, 140),
                panelT("panel.modules.chat.errors.network_error"),
              ),
            );
            const netKind = classifyPanelChatFailure({
              errName,
              errMessage: netMsg,
            });
            appendBubble("error", userMessageForPanelChatFailureKind(netKind), {
              errorKind: netKind,
            });
            reportPanelInfraUnavailable(
              "sohbet ağ: " + netMsg.slice(0, 120),
              panelT("panel.shell.infra.unavailableShort"),
            );
            void loadPanelBackendStatus();
            if (photoTelemetry && PANEL_DEBUG) {
              const visionGuess =
                photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
              showPanelChatPhotoTech(
                buildPhotoTechBlock({
                  requestUrl: CHAT_URL,
                  httpStatus: "—",
                  reachedBackend: false,
                  imageDataSent: photoTelemetry.hasInline,
                  visionTriedGuess: visionGuess,
                  replyPreview: "",
                  fallbackExact: false,
                  fallbackRegex: false,
                  networkError: true,
                  extraReason: "Ağ veya istemci: " + netMsg,
                }),
              );
              void loadPanelBackendStatus();
            }
          } finally {
            sending = false;
            sendBtn.disabled = false;
            sendBtn.removeAttribute("aria-busy");
            sendBtn.setAttribute("aria-label", panelSendLabel());
            sendBtn.setAttribute("title", panelSendLabel());
            sendBtn.classList.remove("chat-compose-send--busy");
            refocusPanelChatInput();
          }
        }

        sendBtn.addEventListener("click", () => {
          sendBtn.blur();
          void runSend();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter" || e.shiftKey) return;
          e.preventDefault();
          void runSend();
        });

        const clipboardBtn = document.getElementById("panel-clipboard-to-kando");
        if (clipboardBtn) {
          const clipboardLabel = panelT("panel.modules.chat.compose.attachClipboard");
          const clipboardConfirmLabel = panelT("panel.modules.chat.compose.clipboardConfirm");
          const clipboardLoadingLabel = panelT("panel.modules.chat.compose.sendLoading");
          const CLIP_PREVIEW_MAX = 80;
          let clipboardSending = false;
          let pendingClipText = null;

          function clipPreviewSnippet(text) {
            const t = String(text || "").trim();
            if (!t) return "";
            if (t.length <= CLIP_PREVIEW_MAX) return t;
            return t.slice(0, CLIP_PREVIEW_MAX) + "…";
          }

          function clearClipPending() {
            pendingClipText = null;
            clipboardBtn.textContent = clipboardLabel;
            clipboardBtn.setAttribute("aria-label", clipboardLabel);
            clipboardBtn.removeAttribute("data-pending-clip");
            clipboardBtn.title = clipboardLabel;
          }

          function setClipPending(text) {
            pendingClipText = text;
            clipboardBtn.textContent = clipboardConfirmLabel;
            clipboardBtn.setAttribute(
              "aria-label",
              panelT("panel.modules.chat.compose.clipboardConfirmAria"),
            );
            clipboardBtn.setAttribute("data-pending-clip", "1");
            clipboardBtn.title = panelT("panel.modules.chat.compose.clipboardConfirmTitle");
            setSendHint(() => {
              const snippet = clipPreviewSnippet(pendingClipText);
              return snippet
                ? panelT("panel.modules.chat.compose.hints.clipboardReadyWithSnippet").replace(
                    "{snippet}",
                    snippet,
                  )
                : panelT("panel.modules.chat.compose.hints.clipboardReadyEmpty");
            });
          }

          async function sendClipText(trimmed) {
            clipboardSending = true;
            clipboardBtn.disabled = true;
            clipboardBtn.setAttribute("aria-busy", "true");
            clipboardBtn.classList.add("chat-compose-clipboard-btn--busy");
            clipboardBtn.textContent = clipboardLoadingLabel;
            setSendHint("");

            try {
              const r = await fetch(TASK_BRIDGE_URL, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({
                  text: trimmed,
                  source: "panel_clipboard",
                }),
              });

              let data = null;
              try {
                data = await r.json();
              } catch {
                data = null;
              }

              if (taskBridgeBlockedResponse(r.status)) {
                const bridgeHint = bridgeBlockedUserHint();
                if (bridgeHint) setSendHint(() => bridgeBlockedUserHint());
                return;
              }
              if (r.status === 401) {
                setSendHint(() => panelT("panel.modules.chat.errors.unauthorized"));
                return;
              }
              if (!r.ok) {
                setSendHint(() => panelT("panel.modules.chat.errors.network_error"));
                return;
              }

              const accepted =
                data && (data.accepted === true || data.accepted === false) ? data.accepted : null;
              if (accepted === false) {
                setSendHint(() => panelT("panel.modules.chat.errors.network_error"));
                return;
              }
              setSendHint(() => panelT("panel.modules.chat.compose.hints.sentOk"));
            } catch {
              setSendHint(() => panelT("panel.modules.chat.errors.network_error"));
            } finally {
              clipboardSending = false;
              clipboardBtn.disabled = false;
              clipboardBtn.removeAttribute("aria-busy");
              clipboardBtn.classList.remove("chat-compose-clipboard-btn--busy");
              clearClipPending();
            }
          }

          clipboardBtn.addEventListener("click", async () => {
            if (clipboardSending) return;

            if (pendingClipText) {
              const toSend = pendingClipText;
              pendingClipText = null;
              await sendClipText(toSend);
              return;
            }

            try {
              if (!navigator.clipboard || typeof navigator.clipboard.readText !== "function") {
                setSendHint(() => panelT("panel.modules.chat.compose.hints.clipboardUnsupported"));
                return;
              }

              let clipboardText = "";
              try {
                clipboardText = await navigator.clipboard.readText();
              } catch (err) {
                const name = err && typeof err === "object" && "name" in err ? String(err.name) : "";
                if (name === "NotAllowedError") {
                  setSendHint(() => panelT("panel.modules.chat.compose.hints.clipboardDenied"));
                } else {
                  const msg =
                    err && typeof err === "object" && "message" in err ? String(err.message) : String(err);
                  setSendHint(
                    () =>
                      panelT("panel.modules.chat.compose.hints.clipboardReadFailedPrefix") +
                      msg.slice(0, 120),
                  );
                }
                return;
              }

              const trimmed = String(clipboardText || "").trim();
              if (!trimmed) {
                setSendHint(() => panelT("panel.modules.chat.compose.hints.clipboardEmpty"));
                return;
              }

              setClipPending(trimmed);
            } catch {
              setSendHint(() => panelT("panel.modules.chat.compose.hints.clipboardReadFailed"));
            }
          });
        }

        const voiceBtn = document.getElementById("panel-voice-input");
        const voiceHint = document.getElementById("panel-voice-hint");
        const speechRecognitionSupported = !!(
          window.SpeechRecognition || window.webkitSpeechRecognition
        );
        const VOICE_TITLE_SUPPORTED = () => panelT("panel.modules.chat.compose.voiceTitleSupported");
        const VOICE_ARIA_SUPPORTED = () => panelT("panel.modules.chat.compose.voiceAriaSupported");
        const VOICE_TITLE_UNSUPPORTED = () => panelT("panel.modules.chat.compose.voiceTitleUnsupported");
        const VOICE_ARIA_UNSUPPORTED = () => panelT("panel.modules.chat.compose.voiceAriaUnsupported");
        /** @type {string | null} */
        let voiceHintI18nKey = null;
        let voiceRec = null;
        let voiceListening = false;
        let voiceStartPending = false;
        let voiceStopRequested = false;
        let voiceGotResult = false;
        let voiceHadError = false;
        let voiceSessionStarted = false;

        function panelSpeechRecognitionLang() {
          const loc =
            window.LumosI18n && typeof window.LumosI18n.getLocale === "function"
              ? window.LumosI18n.getLocale()
              : "tr";
          return loc === "en" ? "en-US" : "tr-TR";
        }

        function applyVoiceSupportUi() {
          if (!voiceBtn) return;
          if (!speechRecognitionSupported) {
            voiceBtn.disabled = true;
            voiceBtn.setAttribute("aria-disabled", "true");
            voiceBtn.classList.add("chat-compose-voice-btn--unsupported");
            voiceBtn.title = VOICE_TITLE_UNSUPPORTED();
            voiceBtn.setAttribute("aria-label", VOICE_ARIA_UNSUPPORTED());
            setVoiceHintKey("panel.modules.chat.compose.voiceHints.unsupported");
            return;
          }
          voiceBtn.disabled = false;
          voiceBtn.removeAttribute("aria-disabled");
          voiceBtn.classList.remove("chat-compose-voice-btn--unsupported");
          voiceBtn.title = VOICE_TITLE_SUPPORTED();
          voiceBtn.setAttribute("aria-label", VOICE_ARIA_SUPPORTED());
        }

        function setVoiceHintKey(key) {
          voiceHintI18nKey = key && String(key).trim() ? String(key) : null;
          if (!voiceHint) return;
          if (!voiceHintI18nKey) {
            voiceHint.textContent = "";
            voiceHint.hidden = true;
            return;
          }
          const s = panelUserVisibleText(panelT(voiceHintI18nKey));
          voiceHint.textContent = s;
          voiceHint.hidden = !s;
        }

        function setVoiceListeningUi(active) {
          voiceListening = active;
          if (voiceBtn) {
            voiceBtn.classList.toggle("chat-compose-voice-btn--listening", active);
            voiceBtn.setAttribute("aria-pressed", active ? "true" : "false");
          }
        }

        function stopVoiceListeningUi() {
          voiceStartPending = false;
          setVoiceListeningUi(false);
        }

        function beginVoiceListeningUi() {
          voiceStartPending = false;
          voiceSessionStarted = true;
          setVoiceListeningUi(true);
        }

        function voiceErrorHintKey(errorCode) {
          switch (errorCode) {
            case "network":
            case "service-not-allowed":
              return "panel.modules.chat.compose.voiceHints.serviceUnavailable";
            case "no-speech":
              return "panel.modules.chat.compose.voiceHints.noSpeech";
            case "audio-capture":
              return "panel.modules.chat.compose.voiceHints.micUnavailable";
            case "not-allowed":
              return "panel.modules.chat.compose.voiceHints.micDenied";
            case "aborted":
              return "panel.modules.chat.compose.voiceHints.aborted";
            default:
              return "panel.modules.chat.compose.voiceHints.failed";
          }
        }

        function appendVoiceTranscript(chunk) {
          const t = String(chunk || "").trim();
          if (!t) return;
          const cur = input.value;
          const sep = cur && !/\s$/.test(cur) ? " " : "";
          input.value = cur + sep + t;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }

