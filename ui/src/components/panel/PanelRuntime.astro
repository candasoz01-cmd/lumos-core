      async function refreshPanelAuth() {
        const slot = document.getElementById("panel-auth-slot");
        const login = document.getElementById("panel-auth-login");
        const user = document.getElementById("panel-auth-user");
        const nameEl = document.getElementById("panel-auth-name");
        const avatar = document.getElementById("panel-auth-avatar");
        if (!slot || !login || !user || !nameEl || !avatar) return;
        slot.dataset.state = "loading";
        try {
          const r = await fetch("/api/auth/session", {
            credentials: "include",
            cache: "no-store",
            headers: { Accept: "application/json" },
          });
          const data = await r.json().catch(() => ({}));
          const session = data && data.session ? data.session : null;
          const ok = r.ok && data && data.authenticated === true && session;
          if (ok) {
            panelSessionLumosId = String(session.lumos_id || "").trim();
            const label =
              String(session.name || "").trim() ||
              String(session.email || "").trim() ||
              panelT("panel.shell.auth.userFallback");
            nameEl.textContent = label;
            nameEl.title = String(session.email || label);
            const pic = String(session.picture || "").trim();
            if (pic && /^https?:\/\//i.test(pic)) {
              avatar.src = pic;
              avatar.alt = "";
              avatar.hidden = false;
            } else {
              avatar.removeAttribute("src");
              avatar.hidden = true;
            }
            login.hidden = true;
            user.hidden = false;
            slot.dataset.state = "in";
            {
              const sessionEl = document.getElementById("panel-auth-session");
              if (sessionEl) {
                sessionEl.hidden = false;
                sessionEl.dataset.state = "secure";
                sessionEl.textContent = "Güvenli oturum";
                sessionEl.title = "Google / Apple ile güvenli oturum açık";
                sessionEl.setAttribute("aria-label", "Güvenli oturum");
              }
            }
            if (new URLSearchParams(location.search).get("source") === "google_web") {
              applyPanelUserMode("full");
            }
            void checkBridgeHealth();
          } else {
            panelSessionLumosId = "";
            nameEl.textContent = "";
            avatar.removeAttribute("src");
            avatar.hidden = true;
            user.hidden = true;
            login.hidden = false;
            slot.dataset.state = "out";
            {
              const sessionEl = document.getElementById("panel-auth-session");
              if (sessionEl) {
                sessionEl.hidden = true;
                sessionEl.textContent = "";
              }
            }
          }
        } catch {
          panelSessionLumosId = "";
          nameEl.textContent = "";
          avatar.removeAttribute("src");
          avatar.hidden = true;
          user.hidden = true;
          login.hidden = false;
          slot.dataset.state = "out";
        }
      }

      document.getElementById("panel-auth-logout")?.addEventListener("click", async () => {
        try {
          await fetch("/api/auth/logout", {
            method: "POST",
            credentials: "include",
            cache: "no-store",
          });
        } catch {
          /* ignore network — yine de UI’yi temizle */
        }
        await refreshPanelAuth();
      });

      window.addEventListener("lumos:localechange", refreshPanelI18n);
      window.addEventListener("load", refreshPanelI18n, { once: true });
      window.addEventListener("load", () => {
        void refreshPanelAuth();
      }, { once: true });
      // OAuth dönüşü: ?source=google_web
      if (new URLSearchParams(location.search).get("source") === "google_web") {
        void refreshPanelAuth();
      }
</script>
