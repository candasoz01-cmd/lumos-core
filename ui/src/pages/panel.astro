        }

        const priorityLabels = { dusuk: "Düşük", orta: "Orta", yuksek: "Yüksek" };
        const statusLabels = {
          bekliyor: "Bekliyor",
          onay_bekliyor: "Onay bekliyor",
          tamamlandi: "Tamamlandı",
        };

        let gorevlerEscapeHandler = null;
        let lastGorevlerOpenedIndex = -1;
        let lastGorevlerDeletedId = "";
        let lastGorevlerDeletedLocalRow = null;
        let lastGorevlerPlanIndex = -1;
        let gorevlerListFilter = "all";

        function gorevlerTaskPassesListFilter(t) {
          const st = t && t.status != null ? String(t.status).trim() : "";
          if (gorevlerListFilter === "pending") return st !== "tamamlandi";
          if (gorevlerListFilter === "done") return st === "tamamlandi";
          return true;
        }

        function syncGorevlerListFilterUi() {
          document.querySelectorAll("[data-gorevler-filter]").forEach((btn) => {
            const v = btn.getAttribute("data-gorevler-filter");
            const active = v === gorevlerListFilter;
            btn.classList.toggle("is-active", active);
            btn.setAttribute("aria-pressed", active ? "true" : "false");
          });
        }

        function syncGorevlerDetailUiClosed(restoreFocus) {
          detailTaskDl.replaceChildren();
          detailBridgeDl.replaceChildren();
          if (detailPlanDl) detailPlanDl.replaceChildren();
          if (detailPlanSection) detailPlanSection.hidden = true;
          if (detailPlanStatusEl) {
            detailPlanStatusEl.hidden = true;
            detailPlanStatusEl.textContent = "";
          }
          detailTitleEl.textContent = "Görev";
          if (detailBridgeBtn) detailBridgeBtn.hidden = true;
          if (detailCompleteBtn) detailCompleteBtn.hidden = true;
          if (detailDeleteBtn) detailDeleteBtn.hidden = true;
          listEl.querySelectorAll(".gorevler-task-card").forEach((node) => {
            node.setAttribute("aria-expanded", "false");
          });
          if (gorevlerEscapeHandler) {
            document.removeEventListener("keydown", gorevlerEscapeHandler);
            gorevlerEscapeHandler = null;
          }
          if (restoreFocus && lastGorevlerOpenedIndex >= 0) {
            const li = listEl.querySelector(
              '[data-task-index="' + String(lastGorevlerOpenedIndex) + '"]',
            );
            if (li && typeof li.focus === "function") li.focus({ preventScroll: true });
          }
          lastGorevlerOpenedIndex = -1;
        }

        function closeGorevlerDetail(restoreFocus) {
          syncGorevlerDetailUiClosed(restoreFocus);
          if (gorevlerUseDialog) {
            if (detailEl.open) detailEl.close();
          } else {
            detailEl.hidden = true;
          }
        }

        function formatTrDateTime(iso) {
          const s = String(iso || "").trim();
          if (!s) return "—";
          const d = new Date(s);
          if (Number.isNaN(d.getTime())) return "—";
          try {
            return d.toLocaleString("tr-TR", { dateStyle: "short", timeStyle: "medium" });
          } catch {
            return s;
          }
        }

        /** Köprü JSON alanları (detay + kalıcılık). */
        function bridgeFieldsFromJson(data) {
          const empty = {
            route: null,
            source: null,
            accepted: null,
            result_file: null,
            execution_file: null,
          };
          if (!data || typeof data !== "object") return empty;
          const d = /** @type {Record<string, unknown>} */ (data);
          const routeRaw = d.route != null ? String(d.route).trim() : "";
          const route = routeRaw ? routeRaw : null;
          const sourceRaw = d.source != null ? String(d.source).trim() : "";
          const source = sourceRaw ? sourceRaw : null;
          let accepted = null;
          if (d.accepted === true || d.accepted === false) accepted = d.accepted;
          const rfRaw =
            d.result_file != null
              ? String(d.result_file).trim()
              : d.resultFile != null
                ? String(d.resultFile).trim()
                : "";
          const result_file = rfRaw ? rfRaw : null;
          const efRaw =
            d.execution_file != null
              ? String(d.execution_file).trim()
              : d.executionFile != null
                ? String(d.executionFile).trim()
                : "";
          const execution_file = efRaw ? efRaw : null;
          return { route, source, accepted, result_file, execution_file };
        }

        function assignTaskBridgeLast(taskRef, data, acceptedOverride) {
          const ts = new Date().toISOString();
          const f = bridgeFieldsFromJson(data);
          const snap = { ...f, lastBridgeAt: ts };
          if (acceptedOverride === true || acceptedOverride === false) snap.accepted = acceptedOverride;
          const sane = sanitizeBridgeLast(snap) || { lastBridgeAt: ts };
          taskRef.bridgeLast = sane;
          persistPanelGorevlerTasks();
        }

        function lumosOutboxPathBasename(p) {
          const s = p != null ? String(p).trim() : "";
          if (!s) return "";
          const parts = s.replace(/\\/g, "/").split("/");
          return parts[parts.length - 1] || s;
        }

        function appendDetailRow(dl, label, value) {
          const dt = document.createElement("dt");
          dt.textContent = label;
          const dd = document.createElement("dd");
          const raw = value != null && String(value).trim() ? String(value).trim() : "—";
          dd.textContent = panelUserVisibleText(raw);
          dl.appendChild(dt);
          dl.appendChild(dd);
        }

        function normalizeGorevlerPlanRiskToken(risk) {
          return String(risk != null ? risk : "")
            .trim()
            .toLocaleLowerCase("tr-TR")
            .replace(/ş/g, "s")
            .replace(/ı/g, "i")
            .replace(/ü/g, "u")
            .replace(/ö/g, "o")
            .replace(/ç/g, "c")
            .replace(/ğ/g, "g");
        }

        function isGorevlerPlanLowRisk(plan) {
          const p = sanitizeGorevlerTaskPlan(plan);
          if (!p) return false;
          const r = normalizeGorevlerPlanRiskToken(p.risk);
          return r === "dusuk" || r === "low";
        }

        function applyVisibilityForPlanRisk(plan) {
          const low = isGorevlerPlanLowRisk(plan);
          if (planInlineActionsEl) planInlineActionsEl.hidden = low;
          if (planInlineConfirmBtn) planInlineConfirmBtn.hidden = low;
          if (planInlineDismissBtn) planInlineDismissBtn.hidden = low;
          if (planInlineLowRiskNoteEl) planInlineLowRiskNoteEl.hidden = true;
          if (detailPlanActionsEl) detailPlanActionsEl.hidden = low;
          if (detailPlanConfirmBtn) detailPlanConfirmBtn.hidden = low;
          if (detailPlanDismissBtn) detailPlanDismissBtn.hidden = low;
          if (detailPlanLowRiskNoteEl) detailPlanLowRiskNoteEl.hidden = true;
        }

        const GOREVLER_TESHIS_LABELS = [
          "Özet",
          "Alan",
          "Not",
          "Sırada",
          "Risk",
          "Onay",
        ];

        const GOREVLER_PLAN_KOK_NEDEN_PLACEHOLDER =
          "Kod taranmadı; ilk sınıflandırma.";

        function gorevlerPlanAlanDisplay(plan) {
          const p = sanitizeGorevlerTaskPlan(plan);
          const raw = p && p.onerilenAlan ? String(p.onerilenAlan).trim() : "";
          if (!raw || /^görevler(\s+sekmesi)?$/i.test(raw)) return "Görevler";
          if (/^dosyalar(\s+sekmesi)?$/i.test(raw)) return "Dosyalar";
          if (/^köprü(\s+sekmesi)?$/i.test(raw)) return "İletim";
          return raw.replace(/\s+sekmesi$/i, "");
        }

        function updateGorevlerPlanCardTitles(_plan) {
          const title = "Görev planı";
          if (planInlineTitleEl) planInlineTitleEl.textContent = title;
          if (detailPlanSecTitleEl) detailPlanSecTitleEl.textContent = title;
        }

        function buildGorevlerMediumHighRiskTeshisLines(_title, plan) {
          const p = sanitizeGorevlerTaskPlan(plan);
          const tespit = p && p.tur ? String(p.tur) + "." : "Plan hazır; işlem yok.";
          const cozum =
            p && p.sonrakiAdim
              ? String(p.sonrakiAdim)
              : "Listeden görevi aç ve bak.";
          const onay =
            p && p.onayDurumu && String(p.onayDurumu).trim()
              ? String(p.onayDurumu).trim()
              : "Onay gerekir; plan onayı iletim veya kod çalıştırmaz.";
          return [
            tespit,
            gorevlerPlanAlanDisplay(p),
            GOREVLER_PLAN_KOK_NEDEN_PLACEHOLDER,
            cozum,
            p && p.risk ? String(p.risk) : "Orta",
            onay,
          ];
        }

        function clearGorevlerTeshisEl(el) {
          if (!el) return;
          el.hidden = true;
          el.replaceChildren();
        }

        function appendGorevlerTeshisCompactLine(container, label, value) {
          const p = document.createElement("p");
          p.className = "gorevler-plan-teshis-compact__line";
          const strong = document.createElement("strong");
          strong.textContent = label + ": ";
          p.appendChild(strong);
          p.appendChild(document.createTextNode(value != null ? String(value) : "—"));
          container.appendChild(p);
        }

        function gorevlerPlanTitleForIndex(taskIndex) {
          if (taskIndex >= 0 && panelGorevlerTasks[taskIndex]) {
            const t = panelGorevlerTasks[taskIndex];
            return t.title != null ? String(t.title).trim() : "";
          }
          return titleInput && titleInput.value != null ? String(titleInput.value).trim() : "";
        }

        function renderGorevlerPlanTeshis(el, title, plan) {
          if (!el) return;
          if (isGorevlerPlanLowRisk(plan)) {
            clearGorevlerTeshisEl(el);
            return;
          }
          const lines = buildGorevlerMediumHighRiskTeshisLines(title, plan);
          el.replaceChildren();
          for (let i = 0; i < GOREVLER_TESHIS_LABELS.length; i++) {
            appendGorevlerTeshisCompactLine(el, GOREVLER_TESHIS_LABELS[i], lines[i]);
          }
          el.hidden = false;
        }

        function fillGorevlerPlanDl(dl, plan) {
          if (!dl) return;
          dl.replaceChildren();
          const p = sanitizeGorevlerTaskPlan(plan);
          if (!p) return;
          const low = isGorevlerPlanLowRisk(p);
          if (low) {
            appendDetailRow(dl, "Durum", "Plan hazırlandı, işlem yapılmadı.");
            appendDetailRow(dl, "Risk", p.risk);
            appendDetailRow(dl, "Alan", gorevlerPlanAlanDisplay(p));
            appendDetailRow(dl, "Sonraki adım", "Görevi listede açıp detayları kontrol et.");
            appendDetailRow(dl, "Not", "Kod, iletim veya terminal çalıştırılmadı.");
            return;
          }
          const durum =
            p.onayDurumu && String(p.onayDurumu).trim()
              ? String(p.onayDurumu).trim()
              : "Plan hazır; onay bekleniyor.";
          appendDetailRow(dl, "Tür", p.tur);
          appendDetailRow(dl, "Risk", p.risk);
          appendDetailRow(dl, "Alan", gorevlerPlanAlanDisplay(p));
          appendDetailRow(dl, "Sırada", p.sonrakiAdim);
          appendDetailRow(dl, "Not", GOREVLER_PLAN_KOK_NEDEN_PLACEHOLDER);
        }

        function renderGorevlerPlanStatusEl(statusEl, plan) {
          if (!statusEl) return;
          const p = sanitizeGorevlerTaskPlan(plan);
          const od = p && p.onayDurumu != null ? String(p.onayDurumu).trim() : "";
          if (od) {
            statusEl.textContent = od;
            statusEl.hidden = false;
          } else {
            statusEl.textContent = "";
            statusEl.hidden = true;
          }
        }

        function hideGorevlerPlanInline() {
          lastGorevlerPlanIndex = -1;
          if (!planInlineEl) return;
          planInlineEl.hidden = true;
          if (planInlineDl) planInlineDl.replaceChildren();
          if (planInlineStatusEl) {
            planInlineStatusEl.hidden = true;
            planInlineStatusEl.textContent = "";
          }
          if (planInlineLowRiskNoteEl) planInlineLowRiskNoteEl.hidden = true;
          if (planInlineActionsEl) planInlineActionsEl.hidden = false;
          if (planInlineConfirmBtn) planInlineConfirmBtn.hidden = false;
          if (planInlineDismissBtn) planInlineDismissBtn.hidden = false;
          clearGorevlerTeshisEl(planInlineTeshisEl);
        }

        function showGorevlerPlanInline(plan, taskIndex) {
          if (!planInlineEl || !planInlineDl) return;
          const p = sanitizeGorevlerTaskPlan(plan);
          if (!p || !p.active) {
            hideGorevlerPlanInline();
            return;
          }
          lastGorevlerPlanIndex = taskIndex;
          updateGorevlerPlanCardTitles(p);
          fillGorevlerPlanDl(planInlineDl, p);
          renderGorevlerPlanStatusEl(planInlineStatusEl, p);
          applyVisibilityForPlanRisk(p);
          planInlineEl.hidden = false;
          if (planInlineConfirmBtn) {
            planInlineConfirmBtn.disabled = !!(p.onayDurumu && String(p.onayDurumu).trim());
          }
          renderGorevlerPlanTeshis(
            planInlineTeshisEl,
            gorevlerPlanTitleForIndex(taskIndex),
            p,
          );
        }

        function syncGorevlerDetailPlanSection(t, taskIndex) {
          if (!detailPlanSection || !detailPlanDl) return;
          const p = sanitizeGorevlerTaskPlan(t && t.taskPlan);
          if (!p || !p.active) {
            detailPlanSection.hidden = true;
            detailPlanDl.replaceChildren();
            if (detailPlanStatusEl) {
              detailPlanStatusEl.hidden = true;
              detailPlanStatusEl.textContent = "";
            }
            if (detailPlanLowRiskNoteEl) detailPlanLowRiskNoteEl.hidden = true;
            if (detailPlanActionsEl) detailPlanActionsEl.hidden = false;
            if (detailPlanConfirmBtn) detailPlanConfirmBtn.hidden = false;
            if (detailPlanDismissBtn) detailPlanDismissBtn.hidden = false;
            clearGorevlerTeshisEl(detailPlanTeshisEl);
            return;
          }
          lastGorevlerPlanIndex = taskIndex;
          detailPlanSection.hidden = false;
          updateGorevlerPlanCardTitles(p);
          fillGorevlerPlanDl(detailPlanDl, p);
          renderGorevlerPlanStatusEl(detailPlanStatusEl, p);
          applyVisibilityForPlanRisk(p);
          if (detailPlanConfirmBtn) {
            detailPlanConfirmBtn.disabled = !!(p.onayDurumu && String(p.onayDurumu).trim());
          }
          renderGorevlerPlanTeshis(
            detailPlanTeshisEl,
            t && t.title != null ? String(t.title).trim() : "",
            p,
          );
        }

        /** Plan onayı: köprü çalıştırmaz; yalnızca «Onay kaydedildi» yazar. */
        function confirmGorevlerTaskPlan(taskIndex) {
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          const p = sanitizeGorevlerTaskPlan(t.taskPlan);
          if (!p || !p.active) return;
          p.onayDurumu = "Onay kaydedildi";
          t.taskPlan = p;
          persistPanelGorevlerTasks();
          render();
          if (lastGorevlerOpenedIndex === taskIndex) openGorevlerDetail(taskIndex);
          else if (lastGorevlerPlanIndex === taskIndex) showGorevlerPlanInline(p, taskIndex);
        }

        function dismissGorevlerTaskPlan(taskIndex) {
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          const p = sanitizeGorevlerTaskPlan(t.taskPlan);
          if (!p) return;
          p.active = false;
          t.taskPlan = p;
          persistPanelGorevlerTasks();
          hideGorevlerPlanInline();
          render();
          if (lastGorevlerOpenedIndex === taskIndex) openGorevlerDetail(taskIndex);
        }

        function openGorevlerDetail(taskIndex) {
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          lastGorevlerOpenedIndex = taskIndex;
          const bl = t.bridgeLast && typeof t.bridgeLast === "object" ? t.bridgeLast : null;
          detailTitleEl.textContent = t.title != null ? String(t.title).trim() || "—" : "—";
          detailTaskDl.replaceChildren();
          detailBridgeDl.replaceChildren();

          const statusTxt =
            statusLabels[t.status] != null ? statusLabels[t.status] : t.status != null ? String(t.status) : "—";
          const priorityTxt =
            priorityLabels[t.priority] != null
              ? priorityLabels[t.priority]
              : t.priority != null
                ? String(t.priority)
                : "—";
          const whenRaw = t.when != null ? String(t.when).trim() : "";
          const whenTxt = whenRaw ? whenRaw : "—";

          appendDetailRow(detailTaskDl, "Durum", statusTxt);
          appendDetailRow(detailTaskDl, "Öncelik", priorityTxt);
          appendDetailRow(detailTaskDl, "Tarih", whenTxt);

          let route = "—";
          let source = "—";
          let acceptedTxt = "—";
          let resultFile = "—";
          let execFile = "—";
          let lastOp = "—";

          if (bl) {
            lastOp = formatTrDateTime(bl.lastBridgeAt);
            if (bl.route != null && String(bl.route).trim()) route = String(bl.route).trim();
            if (bl.source != null && String(bl.source).trim()) source = String(bl.source).trim();
            if (bl.accepted === true) acceptedTxt = "Evet";
            else if (bl.accepted === false) acceptedTxt = "Hayır";
            if (bl.result_file) {
              const raw = String(bl.result_file).trim();
              const bn = lumosOutboxPathBasename(raw);
              resultFile = bn || raw;
            }
            if (bl.execution_file) {
              const raw = String(bl.execution_file).trim();
              const bn = lumosOutboxPathBasename(raw);
              execFile = bn || raw;
            }
          }

          if (PANEL_DEBUG) {
            appendDetailRow(detailBridgeDl, "Rota", route);
            appendDetailRow(detailBridgeDl, "Kaynak", source);
          }
          appendDetailRow(detailBridgeDl, "Kabul", acceptedTxt);
          appendDetailRow(detailBridgeDl, "Sonuç dosyası", resultFile);
          appendDetailRow(detailBridgeDl, "Çalıştırma dosyası", execFile);
          appendDetailRow(detailBridgeDl, "İletim zamanı", lastOp);

          syncGorevlerDetailPlanSection(t, taskIndex);

          const hasId = !!(t.id && String(t.id).trim());
          const titleOk = !!(t.title && String(t.title).trim());
          const canComplete = hasId || titleOk;
          const bridgeRelayEligible = titleOk && t.status !== "tamamlandi";
          if (detailBridgeBtn) {
            detailBridgeBtn.hidden = bridgeOpsBlocked() || !bridgeRelayEligible;
          }
          if (detailBridgeNote) {
            detailBridgeNote.hidden = !(bridgeOpsBlocked() && bridgeRelayEligible);
          }
          if (detailCompleteBtn) {
            detailCompleteBtn.hidden = !canComplete || t.status === "tamamlandi";
          }
          if (detailDeleteBtn) {
            detailDeleteBtn.hidden = !hasId;
          }

          if (gorevlerUseDialog) {
            try {
              if (!detailEl.open) detailEl.showModal();
            } catch (_) {
              gorevlerUseDialog = false;
              detailEl.classList.add("gorevler-detail--fallback");
            }
          }
          if (!gorevlerUseDialog) {
            detailEl.hidden = false;
            if (!gorevlerEscapeHandler) {
              gorevlerEscapeHandler = (ev) => {
                if (ev.key !== "Escape" || detailEl.hidden) return;
                ev.preventDefault();
                closeGorevlerDetail(true);
              };
              document.addEventListener("keydown", gorevlerEscapeHandler);
            }
          }
          if (typeof detailEl.focus === "function") detailEl.focus({ preventScroll: true });
        }

        /**
         * Görev kartı iletim özeti: geçerli zaman damgası varsa “Son iletim”, aksi halde “Henüz iletilmedi”.
         * Detay paneli ham `bridgeLast` ile doldurulmaya devam eder.
         * @param {Record<string, unknown> | null} blRow
         */
        function formatGorevlerTaskBridgeLine(blRow) {
          const blSumm = sanitizeBridgeLast(blRow);
          const iso =
            blSumm && blSumm.lastBridgeAt != null ? String(blSumm.lastBridgeAt).trim() : "";
          const isoOk = iso && !Number.isNaN(Date.parse(iso));
          if (blSumm && isoOk) {
            const whenBridge = formatTrDateTime(blSumm.lastBridgeAt);
            if (PANEL_DEBUG) {
              const routeBit =
                blSumm.route != null && String(blSumm.route).trim()
                  ? " · " + truncateGorevlerField(String(blSumm.route).trim()).slice(0, 56)
                  : "";
              return "Son iletim: " + whenBridge + panelUserVisibleText(routeBit);
            }
            let statusBit = "";
            if (blSumm.accepted === true) statusBit = " · iletildi";
            else if (blSumm.accepted === false) statusBit = " · iletilemedi";
            return "Son iletim: " + whenBridge + statusBit;
          }
          return "Henüz iletilmedi";
        }

        function gorevlerTaskBadgeSlug(v) {
          const s = v != null ? String(v).trim().toLowerCase() : "";
          const slug = s.replace(/_/g, "-").replace(/[^a-z0-9-]/g, "") || "unknown";
          return slug;
        }

        function render() {
          closeGorevlerDetail(false);
          listEl.replaceChildren();
          for (let i = 0; i < panelGorevlerTasks.length; i++) {
            const t = panelGorevlerTasks[i];
            if (!gorevlerTaskPassesListFilter(t)) continue;
            const li = document.createElement("li");
            li.className = "gorevler-task-card";
            li.tabIndex = 0;
            li.setAttribute("role", "button");
            li.setAttribute("data-task-index", String(i));
            li.setAttribute("aria-expanded", "false");
            li.setAttribute("aria-controls", "gorevler-detail");
            li.setAttribute("aria-label", "Görev: " + t.title + "; ayrıntıları göster");

            const main = document.createElement("div");
            main.className = "gorevler-task-main";

            const titleEl = document.createElement("div");
            titleEl.className = "gorevler-task-title";
            titleEl.textContent = t.title != null ? String(t.title).trim() : "";
            main.appendChild(titleEl);

            const metaEl = document.createElement("div");
            metaEl.className = "gorevler-task-meta";
            const statusLabel =
              statusLabels[t.status] != null ? statusLabels[t.status] : String(t.status);
            const priorityLabel =
              priorityLabels[t.priority] != null ? priorityLabels[t.priority] : String(t.priority);
            metaEl.textContent = "Durum: " + statusLabel + " · Öncelik: " + priorityLabel;
            main.appendChild(metaEl);

            const whenEl = document.createElement("div");
            whenEl.className = "gorevler-task-when";
            const whenText = t.when != null ? String(t.when).trim() : "";
            whenEl.textContent = whenText || "\u00a0";
            if (!whenText) {
              whenEl.setAttribute("data-gorevler-when-empty", "");
              whenEl.setAttribute("aria-hidden", "true");
            }
            main.appendChild(whenEl);

            const blRow = t.bridgeLast && typeof t.bridgeLast === "object" ? t.bridgeLast : null;
            const bridgeEl = document.createElement("div");
            bridgeEl.className = "gorevler-task-bridge";
            bridgeEl.textContent = formatGorevlerTaskBridgeLine(blRow);
            main.appendChild(bridgeEl);

            const planSummary = formatGorevlerPlanListSummary(t.taskPlan);
            if (planSummary) {
              const planEl = document.createElement("div");
              planEl.className = "gorevler-task-plan";
              planEl.textContent = planSummary;
              main.appendChild(planEl);
            }

            if (sanitizeBridgeLast(blRow)) {
              li.classList.add("gorevler-task-card--has-bridge");
            }

            li.appendChild(main);
            listEl.appendChild(li);
          }
        }

        function showHint(msg) {
          const s = panelUserVisibleText(msg != null ? String(msg) : "");
          hintEl.textContent = s;
          hintEl.hidden = false;
          hintEl.style.whiteSpace = s.indexOf("\n") >= 0 ? "pre-line" : "";
        }

        function hideHint() {
          hintEl.hidden = true;
          hintEl.textContent = "";
          hintEl.style.whiteSpace = "";
        }

        /**
         * POST /task 200 ve accepted !== false: ham JSON yerine kısa özet (üst hint).
         * @param {Record<string, unknown>} data
         */
        function buildTaskBridgeSuccessReadableHint(data) {
          if (data.accepted === false) {
            return "İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.";
          }
          if (data.accepted === true) return "Görev iletildi.";
          if (data.ok === true) return "İşleme alındı.";
          return "İşleme alındı.";
        }

        function findPanelGorevlerRow(taskId, title) {
          const tid = taskId != null ? String(taskId).trim() : "";
          const tt = title != null ? String(title).trim() : "";
          for (let i = 0; i < panelGorevlerTasks.length; i++) {
            const x = panelGorevlerTasks[i];
            if (tid && x.id === tid) return x;
            if (tt && x.title === tt) return x;
          }
          return null;
        }

        /**
         * Görevler: POST /tasks → .lumos/tasks.json; isteğe bağlı POST /tasks/complete;
         * ardından yerel plan kartı (görev eklerken köprü yok).
         */
        function finishAddTaskLocal(title, priority, status) {
          const taskRef = pushGorevlerTaskLocalRow(title, priority, status);
          titleInput.value = "";
          const savedPlan = taskRef.taskPlan;
          const savedIdx = panelGorevlerTasks.indexOf(taskRef);
          if (savedPlan && savedIdx >= 0) showGorevlerPlanInline(savedPlan, savedIdx);
          showHint("Görev yerel olarak kaydedildi.");
          return taskRef;
        }

        async function addTask() {
          const title = titleInput.value.trim();
          if (!title) {
            showHint("Görev adı boş olamaz.");
            titleInput.focus();
            return;
          }
          hideHint();

          const priority = prioritySel.value;
          const status = statusSel.value;

          if (shouldSkipGorevlerTasksApi()) {
            finishAddTaskLocal(title, priority, status);
            return;
          }

          let createRes;
          let apiUnreachable = false;
          try {
            createRes = await tasksApiPost("/tasks", { title });
          } catch {
            apiUnreachable = true;
          }
          if (
            apiUnreachable ||
            !createRes ||
            !createRes.ok ||
            !createRes.data ||
            !createRes.data.ok
          ) {
            if (shouldFallbackGorevlerTasksLocal(apiUnreachable)) {
              finishAddTaskLocal(title, priority, status);
              return;
            }
            const err =
              createRes &&
              createRes.data &&
              createRes.data.error != null
                ? String(createRes.data.error)
                : panelDebugText(
                    "create_failed (" + (createRes ? createRes.status : "?") + ")",
                    "kayıt başarısız",
                  );
            showHint("Görev kaydedilemedi (" + err + ").");
            return;
          }

          const taskId =
            createRes.data.task && createRes.data.task.id != null
              ? String(createRes.data.task.id).trim()
              : "";
          if (status === "tamamlandi" && taskId) {
            await tasksApiPost("/tasks/complete", { ref: taskId });
          }

          const refreshed = await refreshPanelGorevlerFromTasksApi();
          if (!refreshed && createRes.data.task) {
            const row = engineTaskToPanelRow(createRes.data.task);
            if (row) {
              if (priority) row.priority = priority;
              if (status === "onay_bekliyor") row.status = "onay_bekliyor";
              else if (status === "tamamlandi") row.status = "tamamlandi";
              panelGorevlerTasks.push(row);
              persistPanelGorevlerTasks();
              render();
            }
          }

          const taskRef = findPanelGorevlerRow(taskId, title);
          if (taskRef) {
            if (priority) taskRef.priority = priority;
            if (status === "onay_bekliyor") taskRef.status = "onay_bekliyor";
            persistPanelGorevlerTasks();
            render();
          }

          titleInput.value = "";

          if (!taskRef) {
            hideHint();
            return;
          }

          const savedPlan = attachGorevlerTaskPlan(taskRef, title);
          render();
          const savedIdx = panelGorevlerTasks.indexOf(taskRef);
          if (savedPlan && savedIdx >= 0) showGorevlerPlanInline(savedPlan, savedIdx);

          showHint("Görev kaydedildi; plan gösteriliyor.");
        }

        async function sendBridgeOpenGorevlerTask() {
          const taskIndex = lastGorevlerOpenedIndex;
          if (taskIndex < 0) return;
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          const title = t.title != null ? String(t.title).trim() : "";
          if (!title || t.status === "tamamlandi") return;

          hideHint();
          const priority =
            t.priority != null && String(t.priority).trim()
              ? String(t.priority).trim()
              : prioritySel.value;
          const status =
            t.status != null && String(t.status).trim() ? String(t.status).trim() : "bekliyor";

          if (detailBridgeBtn) {
            detailBridgeBtn.disabled = true;
            detailBridgeBtn.setAttribute("aria-busy", "true");
          }

          try {
            const r = await fetch(TASK_BRIDGE_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                goal: title,
                source: "panel_gorevler",
                priority,
                status,
              }),
            });

            let data = null;
            try {
              data = await r.json();
            } catch {
              data = null;
            }

            if (taskBridgeBlockedResponse(r.status)) {
              const bridgeHint = bridgeBlockedUserHint();
              if (bridgeHint) showHint(bridgeHint);
              return;
            }
            if (r.status === 401) {
              showHint("Bağlantı doğrulanamadı. Cihaz ayarlarını kontrol edip tekrar dene.");
              return;
            }
            if (!r.ok) {
              showHint(
                panelDebugText(
                  "Köprüye gönderilemedi (HTTP " +
                    r.status +
                    ")." +
                    (data && (data.error || data.message)
                      ? " " + String(data.error || data.message).trim().slice(0, 80)
                      : ""),
                  "İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.",
                ),
              );
              return;
            }

            assignTaskBridgeLast(t, data);
            render();
            openGorevlerDetail(taskIndex);
            showHint(buildTaskBridgeSuccessReadableHint(data));
          } catch {
            showHint("İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.");
          } finally {
            if (detailBridgeBtn) {
              detailBridgeBtn.disabled = false;
              detailBridgeBtn.removeAttribute("aria-busy");
            }
          }
        }

        function completeGorevlerTaskLocal(t) {
          t.status = "tamamlandi";
          persistPanelGorevlerTasks();
          render();
        }

        async function completeOpenGorevlerTask() {
          const t = panelGorevlerTasks[lastGorevlerOpenedIndex];
          if (!t) return;
          const ref = t.id ? String(t.id).trim() : String(t.title || "").trim();
          if (!ref) return;
          hideHint();
          if (shouldSkipGorevlerTasksApi()) {
            completeGorevlerTaskLocal(t);
            closeGorevlerDetail(true);
            hideHint();
            return;
          }
          let res;
          let apiUnreachable = false;
          try {
            res = await tasksApiPost("/tasks/complete", { ref });
          } catch {
            apiUnreachable = true;
          }
          if (apiUnreachable || !res || !res.ok || !res.data || !res.data.ok) {
            if (shouldFallbackGorevlerTasksLocal(apiUnreachable)) {
              completeGorevlerTaskLocal(t);
              closeGorevlerDetail(true);
              hideHint();
              return;
            }
            const err =
              res && res.data && res.data.error != null ? String(res.data.error) : "complete_failed";
            showHint("Tamamlanamadı (" + err + ").");
            return;
          }
          await refreshPanelGorevlerFromTasksApi();
          closeGorevlerDetail(true);
          hideHint();
        }

        function removeGorevlerTaskLocalById(deletedId) {
          const id = String(deletedId || "").trim();
          if (!id) return false;
          for (let i = panelGorevlerTasks.length - 1; i >= 0; i--) {
            if (panelGorevlerTasks[i] && String(panelGorevlerTasks[i].id || "").trim() === id) {
              panelGorevlerTasks.splice(i, 1);
              persistPanelGorevlerTasks();
              return true;
            }
          }
          return false;
        }

        function finishDeleteGorevlerTaskLocal(t, deletedId) {
          lastGorevlerDeletedId = deletedId;
          lastGorevlerDeletedLocalRow = { ...t };
          if (restoreLastBtn) restoreLastBtn.hidden = false;
          removeGorevlerTaskLocalById(deletedId);
          closeGorevlerDetail(true);
          render();
          showHint("Görev silindi.");
        }

        async function deleteOpenGorevlerTask() {
          const t = panelGorevlerTasks[lastGorevlerOpenedIndex];
          if (!t || !t.id) return;
          if (!confirm("Görev silinsin mi?")) return;
          hideHint();
          const deletedId = String(t.id).trim();
          if (shouldSkipGorevlerTasksApi()) {
            finishDeleteGorevlerTaskLocal(t, deletedId);
            return;
          }
          let res;
          let apiUnreachable = false;
          try {
            res = await tasksApiPost("/tasks/delete", { id: deletedId });
          } catch {
            apiUnreachable = true;
          }
          if (apiUnreachable || !res || !res.ok || !res.data || !res.data.ok) {
            if (shouldFallbackGorevlerTasksLocal(apiUnreachable)) {
              finishDeleteGorevlerTaskLocal(t, deletedId);
              return;
            }
            const err =
              res && res.data && res.data.error != null ? String(res.data.error) : "delete_failed";
            showHint("Silinemedi (" + err + ").");
            return;
          }
          lastGorevlerDeletedId = deletedId;
          lastGorevlerDeletedLocalRow = null;
          if (restoreLastBtn) restoreLastBtn.hidden = false;
          const refreshed = await refreshPanelGorevlerFromTasksApi();
          if (!refreshed) {
            removeGorevlerTaskLocalById(deletedId);
          }
          closeGorevlerDetail(true);
          render();
          showHint("Görev silindi.");
        }

        async function restoreLastGorevlerTask() {
          if (!lastGorevlerDeletedId) return;
          hideHint();
          if (shouldSkipGorevlerTasksApi() || lastGorevlerDeletedLocalRow) {
            if (lastGorevlerDeletedLocalRow) {
