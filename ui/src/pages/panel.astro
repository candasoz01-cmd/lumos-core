      .gorevler-list-heading {
        margin: 0;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: rgba(172, 168, 160, 0.9);
      }
      #panel-sohbet {
        gap: 0;
        background: transparent;
      }
      /** Sohbet: kaydırılan geçmiş, altta compose. */
      .chat-workspace {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        gap: 0.75rem;
        background: transparent;
      }
      .chat-history-shell {
        flex: 1;
        min-height: 10rem;
        min-width: 0;
        display: flex;
        flex-direction: column;
        border-radius: 14px;
        border: 1px solid var(--lumos-border);
        background: var(--lumos-chat-history-bg);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.025),
          0 8px 28px rgba(0, 0, 0, 0.72);
        overflow: hidden;
      }
      .chat-thread {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1rem 1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(184, 148, 96, 0.35) rgba(5, 5, 5, 0.35);
      }
      .chat-thread:not(:has(> .chat-turn)) {
        justify-content: center;
      }
      .chat-empty-hint {
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: center;
        max-width: min(22rem, 92%);
        padding: 0.65rem 1rem;
        text-align: center;
        user-select: none;
        pointer-events: none;
        transition: color 0.35s ease, opacity 0.35s ease;
      }
      .chat-empty-hint__text {
        font-size: 0.88rem;
        font-weight: 600;
        letter-spacing: -0.015em;
        line-height: 1.5;
        color: rgba(232, 218, 188, 0.82);
      }
      .chat-thread:has(> .chat-turn) > .chat-empty-hint {
        display: none;
      }
      .chat-thread::-webkit-scrollbar {
        width: 7px;
      }
      .chat-thread::-webkit-scrollbar-track {
        margin: 6px 0;
        background: rgba(0, 0, 0, 0.18);
        border-radius: 999px;
      }
      .chat-thread::-webkit-scrollbar-thumb {
        background: rgba(115, 95, 68, 0.42);
        border-radius: 999px;
        border: 2px solid transparent;
        background-clip: padding-box;
      }
      .chat-thread::-webkit-scrollbar-thumb:hover {
        background: rgba(145, 118, 82, 0.48);
        background-clip: padding-box;
      }
      .chat-turn {
        display: flex;
        width: 100%;
        min-width: 0;
        flex-shrink: 0;
        justify-content: flex-start;
      }
      .chat-turn--user {
        justify-content: flex-end;
      }
      .chat-turn--lumos,
      .chat-turn--error {
        justify-content: flex-start;
      }
      .chat-msg {
        display: flex;
        flex-direction: column;
        min-width: 0;
        max-width: 100%;
        padding: 0.55rem 0.78rem 0.65rem;
        border-radius: 14px;
        white-space: pre-wrap;
        word-break: break-word;
        overflow-wrap: anywhere;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.22);
      }
      .chat-msg--user {
        max-width: min(100%, 22rem, 82%);
        margin-left: clamp(1.5rem, 8vw, 3.5rem);
        padding: 0.62rem 0.82rem 0.72rem;
        background: #050505;
        border: 1px solid var(--lumos-border);
        border-radius: 14px 14px 5px 14px;
        color: #f5efe6;
        box-shadow:
          0 2px 14px rgba(0, 0, 0, 0.58),
          inset 0 1px 0 rgba(255, 255, 255, 0.03);
      }
      .chat-msg--lumos {
        max-width: min(100%, 46rem, 94%);
        margin-right: clamp(0.75rem, 5vw, 2.5rem);
        padding: 0.65rem 0.92rem 0.78rem;
        background: #080808;
        border: 1px solid var(--lumos-border);
        border-radius: 14px 14px 14px 5px;
        color: #ebe8e2;
        box-shadow:
          0 2px 14px rgba(0, 0, 0, 0.55),
          inset 0 1px 0 rgba(255, 255, 255, 0.028);
      }
      .chat-msg--error {
        max-width: min(100%, 40rem, 92%);
        margin-right: clamp(0.75rem, 5vw, 2.25rem);
        border: 1px solid rgba(240, 180, 180, 0.32);
        color: #ffd6d6;
        background: linear-gradient(165deg, rgba(48, 22, 28, 0.55) 0%, rgba(32, 16, 20, 0.65) 100%);
        border-radius: 14px 14px 14px 5px;
      }
      .chat-msg-role {
        display: block;
        font-size: 0.62rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        margin-bottom: 0.35rem;
        opacity: 0.88;
      }
      .chat-msg--user .chat-msg-role {
        color: rgba(212, 182, 128, 0.72);
        text-align: right;
      }
      .chat-msg--lumos .chat-msg-role {
        color: rgba(236, 207, 147, 0.85);
        text-align: left;
      }
      .chat-msg--error .chat-msg-role {
        color: rgba(255, 200, 200, 0.75);
      }
      .chat-msg-body {
        font-size: 0.9rem;
        line-height: 1.68;
        letter-spacing: -0.01em;
      }
      .chat-msg--lumos .chat-msg-body {
        white-space: pre-wrap;
        line-height: 1.75;
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .chat-msg--lumos .chat-msg-body strong {
        font-weight: 700;
        color: #f0e8d8;
      }
      .chat-compose-stack {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
      }
      .chat-compose-bar {
        flex-shrink: 0;
        padding: 0.45rem 0.55rem 0.45rem 0.5rem;
        border-radius: 999px;
        border: 1px solid var(--lumos-border);
        background: var(--lumos-compose-bg);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.03),
          0 4px 22px rgba(0, 0, 0, 0.65);
      }
      .chat-compose {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.35rem;
        align-items: flex-end;
        max-width: 100%;
        min-width: 0;
      }
      .chat-compose--gpt {
        align-items: center;
      }
      .chat-compose-camera-btn {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: center;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        margin: 0;
        border: none;
        border-radius: 999px;
        background: transparent;
        color: rgba(212, 182, 128, 0.72);
        cursor: pointer;
        transition:
          color 0.15s ease,
          background 0.15s ease,
          box-shadow 0.15s ease;
      }
      .chat-compose-camera-btn:hover {
        color: rgba(236, 207, 147, 0.92);
        background: rgba(255, 255, 255, 0.05);
      }
      .chat-compose-camera-btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px rgba(184, 148, 96, 0.45);
      }
      .chat-compose-camera-btn--active {
        color: rgba(248, 236, 210, 0.98);
        background: rgba(212, 182, 128, 0.14);
        box-shadow: inset 0 0 0 1px rgba(212, 182, 128, 0.38);
      }
      .chat-compose-camera-btn svg {
        width: 1.15rem;
        height: 1.15rem;
      }
      .chat-camera-preview-wrap {
        display: block;
        padding: 0.45rem 0.5rem;
        border-radius: 12px;
        border: 1px solid var(--lumos-border);
        background: #050505;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.03),
          0 3px 16px rgba(0, 0, 0, 0.45);
        max-width: 100%;
        min-width: 0;
      }
      .chat-camera-video {
        display: block;
        width: 100%;
        max-width: 13rem;
        max-height: 10rem;
        border-radius: 10px;
        background: #000;
        object-fit: cover;
      }
      .chat-compose-voice-btn {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: center;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        margin: 0;
        border: none;
        border-radius: 999px;
        background: transparent;
        color: rgba(212, 182, 128, 0.72);
        cursor: pointer;
        transition:
          color 0.15s ease,
          background 0.15s ease,
          box-shadow 0.15s ease;
      }
      .chat-compose-voice-btn:hover {
        color: rgba(236, 207, 147, 0.92);
        background: rgba(255, 255, 255, 0.05);
      }
      .chat-compose-voice-btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px rgba(184, 148, 96, 0.45);
      }
      .chat-compose-voice-btn--listening {
        color: rgba(248, 236, 210, 0.98);
        background: rgba(212, 182, 128, 0.14);
        box-shadow: inset 0 0 0 1px rgba(212, 182, 128, 0.38);
      }
      .chat-compose-voice-btn svg {
        width: 1.15rem;
        height: 1.15rem;
      }
      .chat-compose--gpt textarea {
        flex: 1;
        min-width: 0;
        min-height: 2.35rem;
        max-height: 9rem;
        padding: 0.48rem 0.5rem 0.48rem 0.45rem;
        border-radius: 0;
        border: none;
        background: transparent;
        color: #f4efe8;
        font-size: 0.88rem;
        font-family: inherit;
        line-height: 1.45;
        resize: none;
        field-sizing: content;
        box-shadow: none;
      }
      .chat-compose--gpt textarea::placeholder {
        color: rgba(148, 142, 132, 0.75);
      }
      .chat-compose--gpt textarea:focus {
        outline: none;
      }
      .chat-compose-bar:focus-within {
        border-color: rgba(184, 148, 96, 0.42);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.04),
          0 4px 22px rgba(0, 0, 0, 0.65),
          0 0 0 1px rgba(184, 148, 96, 0.18);
      }
      .chat-compose-send {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        align-self: center;
        min-height: 2.35rem;
        padding: 0.38rem 0.72rem;
        margin: 0;
        border-radius: 999px;
        border: 1px solid rgba(212, 182, 128, 0.46);
        background: linear-gradient(180deg, #161413 0%, #0a0908 100%);
        color: var(--lumos-gold);
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        line-height: 1.2;
        white-space: nowrap;
        cursor: pointer;
        box-shadow:
          0 2px 14px rgba(0, 0, 0, 0.65),
          inset 0 1px 0 rgba(236, 207, 147, 0.1),
          inset 0 -1px 0 rgba(22, 20, 18, 0.95);
        transition:
          filter 0.15s ease,
          border-color 0.15s ease,
          box-shadow 0.15s ease;
      }
      .chat-compose-send__label {
        display: block;
      }
      .chat-compose-send:hover:not(:disabled) {
        filter: brightness(1.06);
        border-color: rgba(228, 198, 138, 0.55);
      }
      .chat-compose-send:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        filter: none;
      }
      .chat-compose-send--busy .chat-compose-send__label {
        animation: chat-compose-send-pulse 0.9s ease-in-out infinite;
      }
      @keyframes chat-compose-send-pulse {
        50% {
          opacity: 0.35;
        }
      }
      @media (max-width: 479.98px) {
        .chat-compose-bar {
          padding: 0.38rem 0.42rem 0.38rem 0.38rem;
        }
        .chat-compose {
          gap: 0.28rem;
        }
        .chat-compose-camera-btn {
          width: 2.05rem;
          height: 2.05rem;
        }
        .chat-compose-camera-btn svg {
          width: 1.05rem;
          height: 1.05rem;
        }
        .chat-compose-voice-btn {
          width: 2.05rem;
          height: 2.05rem;
        }
        .chat-compose-voice-btn svg {
          width: 1.05rem;
          height: 1.05rem;
        }
        .chat-compose-send {
          min-height: 2.15rem;
          padding: 0.32rem 0.55rem;
          font-size: 0.72rem;
        }
      }
      .chat-voice-hint,
      .chat-camera-hint {
        margin: 0;
        padding: 0 0.4rem;
        font-size: 0.68rem;
        line-height: 1.45;
        letter-spacing: 0.01em;
        color: rgba(184, 160, 130, 0.88);
      }
      .lumos-security-note {
        margin: 0;
        align-self: flex-start;
        max-width: 100%;
        padding: 0.35rem 0.55rem;
        border-radius: 10px;
        font-size: 0.72rem;
        line-height: 1.45;
        letter-spacing: 0.02em;
        color: rgba(164, 160, 154, 0.94);
        background: #050505;
        border: 1px solid rgba(115, 95, 68, 0.18);
      }
      @media (max-width: 639.98px) {
        .panel-body {
          flex-direction: column;
          min-height: 0;
        }
        .panel-nav {
          flex: 0 0 auto;
          align-self: stretch;
          max-height: min(44vh, 15rem);
          display: flex;
          flex-direction: column;
          flex-wrap: nowrap;
          gap: 0.15rem;
          padding: 0.45rem 0.5rem 0.5rem;
          border-right: none;
          border-bottom: 1px solid rgba(115, 95, 68, 0.16);
          overflow-y: auto;
          overflow-x: hidden;
          overscroll-behavior: contain;
        }
        .panel-nav-group,
        .panel-nav-collapsible {
          flex-direction: row;
          flex-wrap: wrap;
          align-items: center;
          align-content: flex-start;
          margin-bottom: 0.35rem;
          gap: 0.2rem;
        }
        .panel-nav-group-toggle {
          flex: 1 0 100%;
          width: auto;
          margin: 0.2rem 0.35rem 0.1rem;
        }
        .panel-nav-group-items {
          flex: 1 1 100%;
          flex-direction: row;
          flex-wrap: wrap;
          align-items: center;
          align-content: flex-start;
          gap: 0.2rem;
        }
        .panel-nav button[data-module] {
          flex: 1 1 auto;
          min-width: calc(33.333% - 0.35rem);
          width: auto;
          margin: 0.1rem;
          border-left: none;
          border-bottom: 2px solid transparent;
          border-radius: 10px;
          justify-content: center;
          padding: 0.4rem 0.45rem;
        }
        .panel-nav button[data-module][aria-current="true"] {
          border-left-color: transparent;
          border-bottom-color: rgba(236, 207, 147, 0.78);
          background: #0b0b0b;
        }
        .panel-main {
          flex: 1;
          min-height: 0;
        }
      }
    
    /* Görev listesi: başlık ve meta bilgiyi zorla ayrı satıra al */
    #gorevler-list strong,
    #gorevler-list .gorevler-task-title {
      display: block !important;
      margin: 0 0 0.22rem 0;
      line-height: 1.25;
    }
    #gorevler-list .gorevler-task-meta,
    #gorevler-list .task-status-badge,
    #gorevler-list .task-priority-badge {
      display: inline-block;
      margin-top: 0.08rem;
      font-size: 0.92rem;
      color: var(--lumos-muted);
      font-weight: 500;
    }

  
    /* Görev listesi: başlık ve meta aynı satırda sıkışmasın */
    #gorevler-list .gorevler-task-main {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 0.16rem;
      min-width: 0;
    }
    #gorevler-list .gorevler-task-title {
      display: block !important;
      line-height: 1.25;
    }
    #gorevler-list .gorevler-task-meta {
      display: block !important;
      margin-top: 0.08rem;
      color: var(--lumos-muted);
      font-size: 0.92rem;
      font-weight: 500;
      line-height: 1.35;
    }

  
    /* Dinamik görev listesi: Astro scoped CSS dışına çıkar */
    :global(#gorevler-list strong),
    :global(#gorevler-list .gorevler-task-title) {
      display: block !important;
      margin: 0 0 0.22rem 0 !important;
      line-height: 1.25 !important;
      font-weight: 700 !important;
    }
    :global(#gorevler-list .gorevler-task-meta),
    :global(#gorevler-list .task-status-badge),
    :global(#gorevler-list .task-priority-badge) {
      display: block !important;
      margin-top: 0.08rem !important;
      color: var(--lumos-muted) !important;
      font-size: 0.92rem !important;
      font-weight: 500 !important;
      line-height: 1.35 !important;
    }

  </style>
  </head>
  <body>
    <div class="panel-shell">
      <header class="panel-header">
        <div class="panel-header-title-row">
          <div class="panel-header-brand">
            <span class="lumos-mark" aria-hidden="true"></span>
