      .chat-thread:not(:has(> .chat-turn)) {
        justify-content: center;
      }
      .chat-empty-hint {
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: center;
        max-width: min(22rem, 92%);
        padding: 0.65rem 1rem;
        text-align: center;
        user-select: none;
        pointer-events: none;
        transition: color 0.35s ease, opacity 0.35s ease;
      }
      .chat-empty-hint__text {
