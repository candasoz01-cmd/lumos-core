---
const title = "Canlı ses — Lumos";
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0c151b" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #0c151b;
        color: #f4f0e7;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        background:
          radial-gradient(circle at 50% 25%, rgba(110, 213, 197, .18), transparent 34rem),
          linear-gradient(155deg, #0c151b, #12242b 65%, #18343a);
      }
      main {
        width: min(34rem, 100%);
        min-height: 100svh;
        padding: max(2rem, env(safe-area-inset-top)) 1.5rem max(2rem, env(safe-area-inset-bottom));
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;
      }
      .brand {
        margin: 0 0 .5rem;
        color: #9fe3d8;
        font-size: .78rem;
        font-weight: 750;
        letter-spacing: .16em;
        text-transform: uppercase;
      }
      h1 { margin: 0; font-size: clamp(2rem, 10vw, 3.4rem); line-height: 1; }
      .lead { margin: 1rem auto 2rem; max-width: 27rem; color: #c9d4d3; line-height: 1.55; }
      .orb {
        width: 10rem;
        height: 10rem;
        margin: 0 auto 2rem;
        border-radius: 50%;
        border: 1px solid rgba(159, 227, 216, .45);
        background: radial-gradient(circle at 35% 30%, #b9fff2, #43a99d 30%, #15383d 68%);
        box-shadow: 0 0 4rem rgba(94, 217, 198, .24);
        transition: transform .25s ease, box-shadow .25s ease;
      }
      .orb[data-live="true"] {
        animation: breathe 1.8s ease-in-out infinite;
        box-shadow: 0 0 5rem rgba(94, 217, 198, .5);
      }
      @keyframes breathe {
        50% { transform: scale(1.08); }
      }
      button {
        width: 100%;
        min-height: 3.5rem;
        border: 0;
        border-radius: 999px;
        padding: .9rem 1.25rem;
        font: inherit;
        font-weight: 760;
        color: #0b1a1e;
        background: #a8eadf;
      }
      button[data-stop="true"] {
        color: #fff;
        background: #9b3e45;
      }
      .mode-picker {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .6rem;
        margin-bottom: .8rem;
      }
      .mode-picker button {
        min-height: 2.8rem;
        color: #c9d4d3;
        background: rgba(255, 255, 255, .08);
      }
      .mode-picker button[aria-pressed="true"] {
        color: #0b1a1e;
        background: #a8eadf;
      }
      #push-to-talk {
        margin-top: .8rem;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
      }
      #push-to-talk[data-talking="true"] {
        color: #fff;
        background: #2d8f82;
        transform: scale(.98);
      }
      #mute {
        margin-top: .8rem;
        color: #f4f0e7;
        background: rgba(255, 255, 255, .12);
      }
      #mute[aria-pressed="true"] {
        color: #fff;
        background: #7a5a16;
      }
      [hidden] { display: none !important; }
      button:disabled { opacity: .48; }
      #status { min-height: 1.5rem; margin: 1rem 0 0; color: #c9d4d3; }
      .note { margin: 1.2rem auto 0; color: #829694; font-size: .82rem; line-height: 1.45; }
      audio { display: none; }
    </style>
  </head>
  <body>
    <main>
      <p class="brand">Lumos · Canlı ses</p>
      <h1>Konuşalım.</h1>
      <p class="lead">Serbest konuş veya mikrofonu yalnız düğmeye basarken aç.</p>
      <div class="orb" id="orb" aria-hidden="true"></div>
      <div class="mode-picker" id="mode-picker" role="group" aria-label="Konuşma modu">
        <button id="mode-auto" type="button" aria-pressed="true">Serbest konuş</button>
        <button id="mode-push" type="button" aria-pressed="false">Bas konuş</button>
      </div>
      <button id="toggle" type="button">Canlı konuşmayı başlat</button>
      <button id="push-to-talk" type="button" hidden>Basılı tut ve konuş</button>
      <button id="mute" type="button" hidden aria-pressed="false">Mikrofonu kapat</button>
      <p id="status" role="status" aria-live="polite">Hazır</p>
      <p class="note">Mikrofon yalnız bu görüşme açıkken kullanılır. Standart API anahtarı telefona gönderilmez.</p>
      <audio id="remote-audio" autoplay></audio>
    </main>
    <script is:inline>
      (() => {
        const button = document.getElementById("toggle");
        const status = document.getElementById("status");
        const orb = document.getElementById("orb");
        const audio = document.getElementById("remote-audio");
        const modePicker = document.getElementById("mode-picker");
        const autoModeButton = document.getElementById("mode-auto");
        const pushModeButton = document.getElementById("mode-push");
        const pushToTalkButton = document.getElementById("push-to-talk");
        const muteButton = document.getElementById("mute");
        const token = new URLSearchParams(location.hash.slice(1)).get("token") || "";
        history.replaceState(null, "", location.pathname);

        let pc = null;
        let stream = null;
        let mode = "auto";
        let eventsChannel = null;
        // Mute is the user's decision. Nothing in this page turns it off
        // again: not a mode switch, push-to-talk, a reconnect or a timer.
        let muted = false;
        let microphoneSender = null;
        let connectTimer = null;
        let recoveryTimer = null;
        let recovering = false;
        // A transient "disconnected" is given time to heal by itself.
        // Checks back off (1 s, 2 s, 4 s, 8 s); after 15 s the call ends.
        const RECOVERY_BACKOFF_MS = [1000, 2000, 4000, 8000];
        const CONNECT_TIMEOUT_MS = 20000;
        const SESSION_REQUEST_TIMEOUT_MS = 15000;

        const schedule = (fn, ms) => (typeof setTimeout === "function" ? setTimeout(fn, ms) : null);
        const cancel = (timer) => { if (timer !== null && typeof clearTimeout === "function") clearTimeout(timer); };
        const clearTimers = () => {
          cancel(connectTimer);
          cancel(recoveryTimer);
          connectTimer = null;
          recoveryTimer = null;
          recovering = false;
        };

        const setStatus = (text) => { status.textContent = text; };
        const microphoneTrack = () => stream?.getAudioTracks()[0] || null;
        // While muted the sender carries no track at all, so no microphone
        // audio (not even silence frames) leaves the device.
        const applyMute = () => {
          const track = microphoneTrack();
          if (muted && track) track.enabled = false;
          if (microphoneSender && typeof microphoneSender.replaceTrack === "function") {
            const wanted = muted ? null : track;
            if (microphoneSender.track !== wanted) {
              Promise.resolve(microphoneSender.replaceTrack(wanted)).catch(() => {
                // Could not detach the track: fail closed, keep it disabled.
                if (track) track.enabled = false;
              });
            }
          }
          muteButton.setAttribute("aria-pressed", String(muted));
          muteButton.dataset.muted = String(muted);
          muteButton.textContent = muted ? "Mikrofonu aç" : "Mikrofonu kapat";
        };
        const setMuted = (next) => {
          muted = Boolean(next);
          if (!muted) {
            const track = microphoneTrack();
            // Unmute restores the current mode's rule: open in free talk,
            // closed in push-to-talk until the button is held again.
            if (track) track.enabled = mode !== "push";
          }
          applyMute();
          if (pc?.connectionState === "connected" && !recovering) {
            if (muted) setStatus("Mikrofon kapalı — Lumos seni duymuyor");
            else setStatus(mode === "push" ? "Canlı — konuşmak için basılı tut" : "Canlı — konuşabilirsin");
          }
        };
        const setTalking = (talking) => {
          if (mode !== "push" || pc?.connectionState !== "connected") return;
          if (muted) {
            setStatus("Mikrofon kapalı — konuşmak için önce mikrofonu aç");
            return;
          }
          const track = microphoneTrack();
          if (track) track.enabled = talking;
          audio.muted = talking;
          if (talking && eventsChannel?.readyState === "open") {
            eventsChannel.send(JSON.stringify({ type: "response.cancel" }));
          }
          pushToTalkButton.dataset.talking = String(talking);
          pushToTalkButton.textContent = talking ? "Dinliyorum…" : "Basılı tut ve konuş";
          setStatus(talking ? "Canlı — seni dinliyorum" : "Canlı — konuşmak için basılı tut");
        };
        const applyMode = () => {
          const pushMode = mode === "push";
          if (!pushMode) audio.muted = false;
          autoModeButton.setAttribute("aria-pressed", String(!pushMode));
          pushModeButton.setAttribute("aria-pressed", String(pushMode));
          pushToTalkButton.hidden = !pushMode || pc?.connectionState !== "connected";
          const track = microphoneTrack();
          if (track) track.enabled = !pushMode && !muted;
          applyMute();
          if (pc?.connectionState === "connected") {
            if (muted) setStatus("Mikrofon kapalı — Lumos seni duymuyor");
            else setStatus(pushMode ? "Canlı — konuşmak için basılı tut" : "Canlı — konuşabilirsin");
          }
        };
        const selectMode = (nextMode) => {
          mode = nextMode;
          applyMode();
        };
        const stop = (message = "Yeniden başlatmak için Lumos uygulamasına dön.") => {
          clearTimers();
          stream?.getTracks().forEach((track) => track.stop());
          stream = null;
          microphoneSender = null;
          // Closing the peer must not re-enter stop through its state callback.
          if (pc) pc.onconnectionstatechange = null;
          eventsChannel?.close();
          pc?.close();
          pc = null;
          eventsChannel = null;
          audio.pause();
          audio.muted = false;
          audio.srcObject = null;
          orb.dataset.live = "false";
          button.dataset.stop = "false";
          button.textContent = "Görüşme sona erdi";
          button.disabled = true;
          modePicker.hidden = true;
          pushToTalkButton.hidden = true;
          muteButton.hidden = true;
          setStatus(message);
        };

        // Called on every check of a "disconnected" peer. The same peer is
        // never renegotiated and no new session is created: a new session
        // would need a new token and would replay chat context to the model.
        const checkRecovery = (attempt) => {
          recoveryTimer = null;
          if (!pc || !recovering) return;
          const state = pc.connectionState;
          if (state === "connected") return;
          if (state === "failed" || state === "closed") {
            stop("Bağlantı geri gelmedi. Yeniden başlatmak için Lumos uygulamasına dön.");
            return;
          }
          if (attempt >= RECOVERY_BACKOFF_MS.length) {
            stop("Bağlantı geri gelmedi. Yeniden başlatmak için Lumos uygulamasına dön.");
            return;
          }
          recoveryTimer = schedule(() => checkRecovery(attempt + 1), RECOVERY_BACKOFF_MS[attempt]);
        };
        const beginRecovery = () => {
          if (recovering) return;
          recovering = true;
          orb.dataset.live = "false";
          pushToTalkButton.hidden = true;
          pushToTalkButton.dataset.talking = "false";
          audio.muted = false;
          const track = microphoneTrack();
          if (track && mode === "push") track.enabled = false;
          applyMute();
          setStatus("Bağlantı koptu — yeniden bağlanılıyor…");
          checkRecovery(0);
        };
        const handleConnectionState = () => {
          const state = pc?.connectionState;
          if (state === "connected") {
            cancel(connectTimer);
            connectTimer = null;
            cancel(recoveryTimer);
            recoveryTimer = null;
            recovering = false;
            orb.dataset.live = "true";
            button.disabled = false;
            button.dataset.stop = "true";
            button.textContent = "Görüşmeyi bitir";
            modePicker.hidden = false;
            muteButton.hidden = false;
            applyMode();
            return;
          }
          if (state === "disconnected") {
            beginRecovery();
            return;
          }
          if (state === "failed" || state === "closed") {
            stop(state === "failed"
              ? "Bağlantı koptu. Yeniden başlatmak için Lumos uygulamasına dön."
              : undefined);
          }
        };
        const permissionMessage = (error) => {
          const name = error?.name || "";
          if (name === "NotAllowedError" || name === "SecurityError" || name === "PermissionDeniedError") {
            return "Mikrofon izni verilmedi. Ayarlar > Lumos > Mikrofon'dan izin verip yeniden dene.";
          }
          if (name === "NotFoundError" || name === "OverconstrainedError") {
            return "Kullanılabilir mikrofon bulunamadı.";
          }
          if (name === "NotReadableError" || name === "AbortError" || name === "TrackStartError") {
            return "Mikrofon başka bir uygulama tarafından kullanılıyor olabilir.";
          }
          return null;
        };

        const isSpokenEndRequest = (text) => {
          // Whole utterances only: never treat a mention, question, negation or
          // quoted instruction as authority to close the microphone.
          if (typeof text !== "string" || /[?"'“”‘’«»`]/u.test(text)) return false;
          const normalized = text.trim().normalize("NFKC").toLocaleLowerCase("tr-TR")
            .normalize("NFD").replace(/\p{M}/gu, "").replace(/ı/g, "i")
            .replace(/[.!…]+$/u, "").replace(/,/g, " ").trim().replace(/\s+/g, " ");
          // Remove address/filler only at the edges. The entire remaining
          // utterance must express a supported action on this conversation;
          // never search for a command inside reported or withdrawn speech.
          const request = normalized
            .replace(/^(?:(?:lumos|lutfen|tamam|hadi|artik|simdi|madem (?:buradasin|oradasin)) ){0,4}/u, "")
            .replace(/(?: (?:lutfen|artik|simdi|bakalim|bakayim)){0,2}$/u, "");
          if (/^(?:hosca ?kal(?: gorusuruz)?|gorusuruz)$/u.test(request)) return true;

          // Imperative, permission, joint decision and explicit request forms.
          // A permission to end the current call is actionable too; statements
          // about capability, questions and negations are deliberately absent.
          const actions = [
            { verb: /^(?:kapat|kapatabilirsin|kapatalim|kapatmani (?:istiyorum|rica ediyorum))$/u, self: true },
            { verb: /^(?:bitir|bitirebilirsin|bitirelim|bitirmeni (?:istiyorum|rica ediyorum))$/u, self: false },
            { verb: /^(?:sonlandir|sonlandirabilirsin|sonlandiralim|sonlandirmani (?:istiyorum|rica ediyorum))$/u, self: false },
          ];
          const targets = [
            "kendini", "canli sesi", "gorusmeyi", "konusmayi", "sohbeti",
            "bu gorusmeyi", "bu konusmayi", "bu sohbeti",
            "canli gorusmeyi", "canli konusmayi", "sesli gorusmeyi",
            "sesli sohbeti", "bu sesli gorusmeyi",
          ];
          return targets.some((target) => {
            let action;
            if (request.startsWith(target + " ")) action = request.slice(target.length + 1);
            else if (request.endsWith(" " + target)) action = request.slice(0, -target.length - 1);
            else return false;
            // Preserve the existing emphatic imperative, without permitting
            // arbitrary trailing words or mixing two different targets.
            if (target === "kendini" && action === "kapat kendini") action = "kapat";
            return actions.some(({ verb, self }) => (target !== "kendini" || self) && verb.test(action));
          });
        };

        const handleSpokenEnd = (message) => {
          if (pc?.connectionState !== "connected") return;
          let event;
          try { event = JSON.parse(message.data); } catch { return; }
          if (event?.type !== "conversation.item.input_audio_transcription.completed"
              || !event.item_id || !isSpokenEndRequest(event.transcript)) return;
          // Consume the local command before iOS can create a model response.
          message.stopImmediatePropagation();
          stop();
        };

        // Install before the iOS document-end script wraps this same method.
        // RTCDataChannel listeners run in registration order, even with capture.
        const createDataChannel = RTCPeerConnection.prototype.createDataChannel;
        RTCPeerConnection.prototype.createDataChannel = function (label, options) {
          const channel = createDataChannel.call(this, label, options);
          if (label === "oai-events") channel.addEventListener("message", handleSpokenEnd);
          return channel;
        };

        const start = async () => {
          if (!token) {
            button.disabled = true;
            setStatus("Canlı ses oturumu bulunamadı. Lumos uygulamasından yeniden aç.");
            return;
          }
          button.disabled = true;
          setStatus("Mikrofon hazırlanıyor…");
          // Which step failed decides the message: a microphone AbortError
          // and an aborted session request share the same error name.
          let phase = "microphone";
          try {
            pc = new RTCPeerConnection();
            pc.ontrack = (event) => { audio.srcObject = event.streams[0]; };
            pc.onconnectionstatechange = handleConnectionState;
            connectTimer = schedule(() => {
              connectTimer = null;
              if (pc && pc.connectionState !== "connected") {
                stop("Bağlantı zaman aşımına uğradı. Yeniden başlatmak için Lumos uygulamasına dön.");
              }
            }, CONNECT_TIMEOUT_MS);

            stream = await navigator.mediaDevices.getUserMedia({
              audio: {
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true,
              },
            });
            phase = "session";
            stream.getTracks().forEach((track) => {
              const sender = pc.addTrack(track, stream);
              if (track.kind !== "video" && sender) microphoneSender = sender;
            });
            applyMute();
            eventsChannel = pc.createDataChannel("oai-events");

            const offer = await pc.createOffer();
            await pc.setLocalDescription(offer);
            const controller = typeof AbortController === "function" ? new AbortController() : null;
            const abortTimer = controller ? schedule(() => controller.abort(), SESSION_REQUEST_TIMEOUT_MS) : null;
            let response;
            try {
              response = await fetch("https://api.openai.com/v1/realtime/calls", {
                method: "POST",
                headers: {
                  Authorization: `Bearer ${token}`,
                  "Content-Type": "application/sdp",
                },
                body: offer.sdp,
                ...(controller ? { signal: controller.signal } : {}),
              });
            } finally {
              cancel(abortTimer);
            }
            if (!response.ok) throw new Error("session_failed");
            await pc.setRemoteDescription({
              type: "answer",
              sdp: await response.text(),
            });
          } catch (error) {
            clearTimers();
            stream?.getTracks().forEach((track) => track.stop());
            stream = null;
            microphoneSender = null;
            if (pc) pc.onconnectionstatechange = null;
            eventsChannel?.close?.();
            eventsChannel = null;
            pc?.close();
            pc = null;
            button.disabled = true;
            muteButton.hidden = true;
            setStatus((phase === "microphone" && permissionMessage(error))
              || (error?.name === "AbortError" || error?.name === "TimeoutError"
                ? "Canlı ses sunucusu zamanında yanıt vermedi. Lumos uygulamasından yeniden dene."
                : "Canlı ses başlatılamadı. Mikrofon iznini ve bağlantını kontrol et."));
          }
        };

        button.addEventListener("click", () => {
          if (pc) stop();
          else start();
        });
        muteButton.addEventListener("click", () => {
          if (!pc) return;
          setMuted(!muted);
        });
        autoModeButton.addEventListener("click", () => selectMode("auto"));
        pushModeButton.addEventListener("click", () => selectMode("push"));
        pushToTalkButton.addEventListener("pointerdown", (event) => {
          event.preventDefault();
          pushToTalkButton.setPointerCapture?.(event.pointerId);
          setTalking(true);
        });
        ["pointerup", "pointercancel", "lostpointercapture"].forEach((eventName) => {
          pushToTalkButton.addEventListener(eventName, () => setTalking(false));
        });
        if (!token) {
          button.disabled = true;
          setStatus("Lumos uygulamasından açılması gereken güvenli oturum eksik.");
        }
      })();
    </script>
  </body>
</html>
