            dismissGorevlerTaskPlan(lastGorevlerOpenedIndex);
          });
        }

        clearTestBtn.addEventListener("click", async () => {
          if (
            !confirm(
              "Yerel görev listesi temizlensin mi? Sunucudaki görev kayıtlarına dokunulmaz.",
            )
          ) {
            return;
          }
          hideHint();
          try {
            if (typeof localStorage !== "undefined") {
              localStorage.removeItem(PANEL_GOREVLER_LS_KEY);
            }
          } catch (_) {
            /* ignore */
          }
          panelGorevlerTasks.length = 0;
          hideGorevlerPlanInline();
          lastGorevlerDeletedId = "";
          lastGorevlerDeletedLocalRow = null;
          if (restoreLastBtn) restoreLastBtn.hidden = true;
          render();
          await refreshPanelGorevlerFromTasksApi();
          showHint("Yerel liste temizlendi; sunucu kayıtlarına dokunulmadı.");
        });

        refreshPanelGorevlerFromTasksApi().then((ok) => {
          if (!ok) {
            const stored = loadPanelGorevlerTasksFromStorage();
            panelGorevlerTasks.length = 0;
            const rows = stored === undefined ? [] : stored;
            for (let i = 0; i < rows.length; i++) {
              const r = sanitizeGorevlerRow(rows[i]);
              if (r) panelGorevlerTasks.push(r);
            }
            persistPanelGorevlerTasks();
          }
          render();
        });
      }

      wirePanel();
      wireGorevlerPrototype();
      wireDosyalarUpload();

      /** Kontrollü köprü file_rw: yalnızca POST /controlled (genel /task akışına dokunulmaz). */
      const CONTROLLED_MAX_WRITE_BYTES = 64000;
      const DOSYALAR_TEXT_EXT = new Set(["txt", "md", "json", "csv"]);
      const DOSYALAR_READ_EXT = new Set(["txt", "md", "json", "csv", "py"]);
      const DOSYALAR_DOC_EXT = new Set(["pdf", "docx"]);

      function dosyalarUnsupportedMessage(ext) {
        if (ext === "exe") {
          return "Dosya çalıştırılmaz; yalnızca dosya bilgisi kaydedilir.";
        }
        if (DOSYALAR_DOC_EXT.has(ext)) {
          return "PDF ve Word (DOCX) içeriği bu fazda işlenmez.";
        }
        return "Bu dosya türü bu fazda işlenmez.";
      }

      function dosyalarInfoMessageForExt(ext) {
        if (DOSYALAR_TEXT_EXT.has(ext)) return "Bu dosya için özet üretildi.";
        if (ext === "py") {
          return "Dosya metin dosyası gibi gösterilir; bu fazda kod çalıştırılmaz.";
        }
        return "";
      }

      function dosyalarSafeUploadPath(filename) {
        const base =
          String(filename || "upload")
            .replace(/\\/g, "/")
            .split("/")
            .pop() || "upload";
        const safe = base.replace(/[^\w.\-()+@]/g, "_").slice(0, 120);
        return "uploads/" + safe;
      }

      function dosyalarFileExtension(name) {
        const m = String(name || "").match(/\.([^.]+)$/);
        return m ? m[1].toLowerCase() : "";
      }

      async function callControlledBridge(payload) {
        const r = await fetch(CONTROLLED_BRIDGE_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json; charset=utf-8",
          },
          body: JSON.stringify(payload),
        });
        if (taskBridgeBlockedResponse(r.status)) {
          return { ok: false, status: r.status, data: null };
        }
        const text = await r.text();
        let data = null;
        try {
          data = text && text.trim() ? JSON.parse(text) : null;
        } catch {
          data = null;
        }
        const ok = r.ok && data && data.ok === true;
        return { ok, status: r.status, data };
      }

      function controlledReadFile(path) {
        return callControlledBridge({
          permission: "file_rw",
          tool: "read_file",
          action: "read_file",
          command: "read",
          path,
        });
      }

      function controlledWriteFile(path, content) {
        return callControlledBridge({
          permission: "file_rw",
          tool: "write_file",
          action: "write_file",
          command: "write",
          path,
          content,
        });
      }

      function readBlobAsUtf8(file) {
        return new Promise((resolve, reject) => {
          const fr = new FileReader();
          fr.onload = () => resolve(String(fr.result ?? ""));
          fr.onerror = () => reject(new Error("read failed"));
          fr.readAsText(file, "utf-8");
        });
      }

      function dosyalarClientSummary(text, ext) {
        const t = String(text || "").trim();
        if (!t) return "";
        if (ext === "json") {
          try {
            const o = JSON.parse(t);
            if (Array.isArray(o)) return "JSON dizi: " + o.length + " öğe.";
            if (o && typeof o === "object") {
              return "JSON nesne: " + Object.keys(o).length + " anahtar.";
            }
          } catch {
            /* geçersiz JSON — düz metin özeti */
          }
        }
        if (ext === "csv") {
          const lines = t.split(/\r?\n/).filter((l) => l.trim());
          return "CSV: yaklaşık " + lines.length + " satır.";
        }
        const flat = t.replace(/\s+/g, " ").trim();
        if (flat.length <= 320) return flat;
        const cut = flat.slice(0, 317) + "…";
        const sentences = cut.match(/[^.!?]+[.!?]+/g);
        if (sentences && sentences.length >= 2) {
          return sentences.slice(0, 3).join(" ").trim();
        }
        return cut;
      }

      function wireDosyalarUpload() {
        const input = document.getElementById("dosyalar-file-input");
        const btn = document.getElementById("dosyalar-upload-btn");
        const hint = document.getElementById("dosyalar-hint");
        const result = document.getElementById("dosyalar-result");
        const historyWrap = document.getElementById("dosyalar-history-wrap");
        const historyList = document.getElementById("dosyalar-history-list");
        if (!input || !btn || !hint || !result) return;

        /** Bellek içi; sayfa yenilenince sıfırlanır. En fazla 5 kayıt, en yeni üstte. */
        const dosyalarUploadHistory = [];

        function dosyalarHistoryShortStatus(data) {
          const u = data.unsupported != null ? String(data.unsupported).trim() : "";
          if (u) return "Uyarı";
          const i = data.info != null ? String(data.info).trim() : "";
          if (i && DOSYALAR_TEXT_EXT.has(String(data.extension ?? ""))) return "Özet üretildi";
          const s = data.summary != null ? String(data.summary).trim() : "";
          if (s) return "Özet hazır";
          return "Tamamlandı";
        }

        function replayDosyalarSnapshot(snapshot) {
          if (!snapshot || typeof snapshot !== "object") return;
          renderResult(snapshot);
          result.hidden = false;
          try {
            result.scrollIntoView({ behavior: "smooth", block: "nearest" });
          } catch (_) {
            /* eski tarayıcı */
          }
        }

        function renderDosyalarHistory() {
          if (!historyWrap || !historyList) return;
          historyList.replaceChildren();
          if (dosyalarUploadHistory.length === 0) {
            historyWrap.hidden = true;
            return;
          }
          historyWrap.hidden = false;
          for (const row of dosyalarUploadHistory) {
            const snap = row.snapshot;
            if (!snap || typeof snap !== "object") continue;

            const li = document.createElement("li");
            li.className = "dosyalar-history-row";
            li.setAttribute("role", "button");
            li.setAttribute("tabindex", "0");
            const fn = String(snap.filename ?? "");
            li.setAttribute(
              "aria-label",
              fn ? `Sonuçları yeniden göster: ${fn}` : "Sonuçları yeniden göster",
            );

            const nameEl = document.createElement("span");
            nameEl.className = "dosyalar-history-name";
            nameEl.textContent = fn || "—";

            const sizeEl = document.createElement("span");
            sizeEl.className = "dosyalar-history-meta";
            sizeEl.textContent =
              snap.size != null && snap.size !== "" ? String(snap.size) + " bayt" : "—";

            const extEl = document.createElement("span");
            extEl.className = "dosyalar-history-meta";
            extEl.textContent =
              snap.extension != null && String(snap.extension).trim()
                ? String(snap.extension)
                : "—";

            const stEl = document.createElement("p");
            stEl.className = "dosyalar-history-status";
            stEl.textContent = dosyalarHistoryShortStatus(snap);

            li.appendChild(nameEl);
            li.appendChild(sizeEl);
            li.appendChild(extEl);
            li.appendChild(stEl);

            const open = () => replayDosyalarSnapshot(snap);
            li.addEventListener("click", open);
            li.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                open();
              }
            });

            historyList.appendChild(li);
          }
        }

        function pushDosyalarHistory(data) {
          if (!data || typeof data !== "object") return;
          const snapshot = { ...data };
          dosyalarUploadHistory.unshift({ snapshot });
          if (dosyalarUploadHistory.length > 5) dosyalarUploadHistory.length = 5;
          renderDosyalarHistory();
        }

        function showHint(msg) {
          hint.textContent = panelUserVisibleText(msg != null ? String(msg) : "");
          hint.hidden = false;
        }

        function hideHint() {
          hint.hidden = true;
          hint.textContent = "";
        }

        function renderResult(data) {
          result.replaceChildren();
          result.className = "dosyalar-result-stack";

          const metaCard = document.createElement("section");
          metaCard.className = "dosyalar-result-card dosyalar-result-card--meta";
          metaCard.setAttribute("aria-labelledby", "dosyalar-result-meta-title");
          const metaTitle = document.createElement("h3");
          metaTitle.id = "dosyalar-result-meta-title";
          metaTitle.className = "dosyalar-result-card__title";
          metaTitle.textContent = "Dosya bilgisi";
          metaCard.appendChild(metaTitle);

          const ul = document.createElement("ul");
          ul.className = "dosyalar-result-meta";
          const rows = [
            ["Dosya adı", String(data.filename ?? "")],
            ["Boyut", String(data.size ?? "") + " bayt"],
            ["Tür", String(data.kind ?? "")],
            ["Uzantı", data.extension ? String(data.extension) : "—"],
          ];
          for (const [k, v] of rows) {
            const li = document.createElement("li");
            const a = document.createElement("span");
            a.textContent = k;
            const b = document.createElement("span");
            b.textContent = v;
            li.appendChild(a);
            li.appendChild(b);
            ul.appendChild(li);
          }
          metaCard.appendChild(ul);
          result.appendChild(metaCard);

          const infoMsg = data.info != null ? String(data.info).trim() : "";
          if (infoMsg) {
            const infoCard = document.createElement("section");
            infoCard.className = "dosyalar-result-card dosyalar-result-card--summary";
            infoCard.setAttribute("aria-labelledby", "dosyalar-result-info-title");
            const infoTitle = document.createElement("h3");
            infoTitle.id = "dosyalar-result-info-title";
            infoTitle.className = "dosyalar-result-card__title";
