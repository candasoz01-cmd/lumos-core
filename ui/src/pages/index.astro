---
/** Canlı köprü testi: istek adresi sabit (deploy ortamı yanlış env ile kırılmasın). */
const CHAT_URL = "https://lumos-core-1.onrender.com/chat";
const kandoToken = import.meta.env.PUBLIC_KANDO_TOKEN || "test123";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lumos — Açık mektup</title>
    <style>
      html {
        scroll-behavior: smooth;
      }
      .lumos-hero-row {
        display: flex;
        align-items: stretch;
        width: 100%;
        min-height: 0;
      }
      .lumos-hero-dna {
        flex: 0 0 13px;
        width: 13px;
        min-width: 13px;
        position: relative;
        pointer-events: none;
        opacity: 1;
      }
      .lumos-hero-dna svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      .lumos-hero-imgwrap {
        flex: 1 1 auto;
        min-width: 0;
      }
      .lumos-hero-brand {
        box-sizing: border-box;
        width: 100%;
        margin: 0;
        border-radius: 12px;
        padding: clamp(1.2rem, 3vw, 2.2rem) clamp(1rem, 3vw, 2.1rem);
        overflow: hidden;
        background: radial-gradient(circle at 12% 18%, rgba(61, 169, 164, 0.16), transparent 42%),
          radial-gradient(circle at 85% 78%, rgba(201, 161, 98, 0.16), transparent 44%),
          linear-gradient(165deg, #0a0c12 0%, #141118 42%, #120f0a 100%);
        border: 1px solid rgba(148, 112, 68, 0.52);
        box-shadow: inset 0 1px 0 rgba(188, 148, 92, 0.14), 0 0 0 1px rgba(98, 72, 44, 0.38),
          0 10px 36px rgba(0, 0, 0, 0.55), 0 0 26px rgba(32, 88, 86, 0.08), 0 0 44px rgba(130, 96, 56, 0.1);
      }
      .lumos-hero-copy {
        max-width: 920px;
      }
      .lumos-hero-kicker {
        margin: 0 0 0.65rem;
        font-size: clamp(1.25rem, 4.4vw, 2.3rem);
        line-height: 1.08;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #5dc9c5;
      }
      .lumos-hero-title {
        margin: 0 0 0.75rem;
        font-size: clamp(2.05rem, 9.1vw, 5rem);
        line-height: 0.95;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: #eccf93;
        text-shadow: 0 0 22px rgba(201, 161, 98, 0.2);
      }
      .lumos-hero-subtitle {
        margin: 0 0 0.85rem;
        max-width: 32ch;
        font-size: clamp(1.02rem, 2.6vw, 1.5rem);
        line-height: 1.35;
        font-weight: 500;
        color: #d9deea;
      }
      .lumos-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin: 0;
        padding: 0.28rem 0.55rem 0.28rem 0.38rem;
        border-radius: 8px;
        border: 1px solid rgba(148, 112, 68, 0.38);
        background: linear-gradient(
          165deg,
          rgba(18, 15, 22, 0.72) 0%,
          rgba(12, 14, 22, 0.55) 100%
        );
        box-shadow: inset 0 1px 0 rgba(188, 148, 92, 0.08), 0 1px 0 rgba(0, 0, 0, 0.22);
        max-width: 100%;
      }
      .lumos-hero-badge img {
        display: block;
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        border-radius: 5px;
        object-fit: cover;
        opacity: 0.92;
      }
      .lumos-hero-badge span {
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgba(201, 206, 217, 0.82);
        line-height: 1.2;
      }
      @media (max-width: 559.98px) {
        .lumos-hero-dna {
          display: none;
        }
      }
      .lumos-cap {
        box-sizing: border-box;
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0.35rem clamp(0.65rem, 2vw, 1.25rem) clamp(1.25rem, 3vw, 2rem);
      }
      .lumos-cap-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.1rem 1.2rem;
      }
      @media (min-width: 640px) {
        .lumos-cap-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 1.15rem 1.25rem;
        }
      }
      @media (min-width: 1024px) {
        .lumos-cap-grid {
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 1.2rem 1.3rem;
        }
      }
      .lumos-cap-card {
        box-sizing: border-box;
        margin: 0;
        padding: 1rem 1.05rem;
        border-radius: 14px;
        border: 1px solid rgba(184, 148, 96, 0.22);
        background: linear-gradient(
          168deg,
          rgba(9, 11, 18, 0.97) 0%,
          rgba(11, 10, 14, 0.94) 48%,
          rgba(10, 9, 12, 0.96) 100%
        );
        box-shadow: inset 0 1px 0 rgba(200, 165, 110, 0.06), 0 4px 18px rgba(0, 0, 0, 0.28);
      }
      .lumos-cap-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .lumos-cap-card-link:hover,
      .lumos-cap-card-link:focus-visible {
        border-color: rgba(93, 201, 197, 0.42);
        box-shadow: inset 0 1px 0 rgba(200, 165, 110, 0.1), 0 8px 24px rgba(0, 0, 0, 0.34),
          0 0 0 1px rgba(93, 201, 197, 0.15);
        transform: translateY(-2px);
      }
      .lumos-cap-card-link:focus-visible {
        outline: 2px solid rgba(93, 201, 197, 0.55);
        outline-offset: 3px;
      }
      .lumos-cap-card-link:focus:not(:focus-visible) {
        outline: none;
      }
      .lumos-cap-card-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        margin-top: 0.55rem;
        font-size: 0.76rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: rgba(147, 188, 186, 0.55);
        transition: color 0.2s ease, transform 0.2s ease;
      }
      .lumos-cap-card-cta::after {
        content: "→";
        font-size: 0.85em;
        transform: translateX(0);
        transition: transform 0.2s ease;
      }
      .lumos-cap-card-link:hover .lumos-cap-card-cta,
      .lumos-cap-card-link:focus-visible .lumos-cap-card-cta {
        color: rgba(93, 201, 197, 0.95);
      }
      .lumos-cap-card-link:hover .lumos-cap-card-cta::after,
      .lumos-cap-card-link:focus-visible .lumos-cap-card-cta::after {
        transform: translateX(3px);
      }
      .lumos-cap-card h3 {
        margin: 0 0 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.015em;
        color: #eccf93;
        line-height: 1.28;
      }
      .lumos-cap-card p {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.62;
        color: #c9ced9;
      }
      .lumos-cap-title {
        margin: 0 0 0.95rem;
        padding-bottom: 0.45rem;
        font-size: clamp(1.12rem, 2.4vw, 1.28rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #f0e6d4;
        line-height: 1.28;
        border-bottom: 1px solid rgba(184, 148, 96, 0.28);
      }
      .lumos-modules {
        box-sizing: border-box;
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 clamp(0.65rem, 2vw, 1.25rem) clamp(1.2rem, 3vw, 2rem);
      }
      .lumos-modules-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.8rem;
      }
      @media (min-width: 920px) {
        .lumos-modules-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .lumos-module-item {
        scroll-margin-top: 1.25rem;
        padding: 0.85rem 0.95rem;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: linear-gradient(165deg, rgba(11, 16, 32, 0.96) 0%, rgba(13, 13, 18, 0.95) 100%);
      }
      .lumos-module-item h3 {
        margin: 0 0 0.35rem;
        font-size: 1.02rem;
        font-weight: 600;
        color: #f2e6cf;
        letter-spacing: -0.015em;
      }
      .lumos-module-item p {
        margin: 0;
        font-size: 0.89rem;
        line-height: 1.58;
        color: #c9ced9;
      }
      .lumos-reply-panel {
        margin: 0.75rem 0 0;
      }
      .lumos-reply-heading {
        margin: 0 0 0.4rem;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: #e8ecf4;
      }
      .lumos-reply-body {
        box-sizing: border-box;
        margin: 0;
        padding: 0.65rem 0.75rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(0, 0, 0, 0.25);
        min-height: 2.75rem;
        font-size: 0.8rem;
        color: #dce3f0;
        text-align: left;
        white-space: pre-wrap;
        word-break: break-word;
        line-height: 1.55;
      }
      .lumos-reply-body:empty::before {
        content: "Henüz cevap yok.";
        color: #8b95ab;
      }
      .lumos-reply-body--error {
        color: #f0b4b4;
        border-color: rgba(240, 180, 180, 0.28);
      }
    </style>
  </head>
  <body
    style="margin:0;background:#0b1020;color:#f2f2f2;font-family:ui-sans-serif,system-ui,Segoe UI,Roboto,sans-serif;line-height:1.6;"
  >
    <section
      aria-label="Lumos görseli"
      style="box-sizing:border-box;width:100%;max-width:100%;padding:clamp(0.4rem, 1.4vw, 0.75rem) clamp(0.65rem, 2vw, 1.25rem) clamp(0.65rem, 2vw, 1.15rem);display:flex;justify-content:center;"
    >
      <div
        style="box-sizing:border-box;width:100%;max-width:1240px;margin:0 auto;min-width:0;"
      >
        <div class="lumos-hero-brand">
          <div class="lumos-hero-row">
            <aside class="lumos-hero-dna" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 320" preserveAspectRatio="none" focusable="false">
                <path
                  fill="none"
                  stroke="rgba(72, 188, 184, 0.16)"
                  stroke-width="0.55"
                  stroke-linecap="round"
                  d="M5.2 0c-2.8 28 5.2 56 2.2 84s-4.8 56-1.8 84 5.8 56 2.8 84-4.8 56-1.8 84"
                ></path>
                <path
                  fill="none"
                  stroke="rgba(72, 188, 184, 0.11)"
                  stroke-width="0.5"
                  stroke-linecap="round"
                  d="M10.8 0c2.8 28-5.2 56-2.2 84s4.8 56 1.8 84-5.8 56-2.8 84 4.8 56 1.8 84"
                ></path>
              </svg>
            </aside>
            <div class="lumos-hero-imgwrap">
              <div class="lumos-hero-copy">
                <p class="lumos-hero-kicker">WE LOCK AI</p>
                <h1 class="lumos-hero-title">LUMOS</h1>
                <p class="lumos-hero-subtitle">İnsan merkezli yapay zekâ kontrol katmanı</p>
                <div class="lumos-hero-badge" aria-label="Lumos AI kimlik rozeti">
                  <img src="/assets/lumos-ai-badge.png" alt="" width="22" height="22" loading="eager" decoding="async" />
                  <span>Lumos AI</span>
                </div>
              </div>
            </div>
            <aside class="lumos-hero-dna" aria-hidden="true" style="transform:scaleX(-1);">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 320" preserveAspectRatio="none" focusable="false">
                <path
                  fill="none"
                  stroke="rgba(72, 188, 184, 0.16)"
                  stroke-width="0.55"
                  stroke-linecap="round"
                  d="M5.2 0c-2.8 28 5.2 56 2.2 84s-4.8 56-1.8 84 5.8 56 2.8 84-4.8 56-1.8 84"
                ></path>
                <path
                  fill="none"
                  stroke="rgba(72, 188, 184, 0.11)"
                  stroke-width="0.5"
                  stroke-linecap="round"
                  d="M10.8 0c2.8 28-5.2 56-2.2 84s4.8 56 1.8 84-5.8 56-2.8 84 4.8 56 1.8 84"
                ></path>
              </svg>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section
      aria-label="Lumos kimliği"
      style="box-sizing:border-box;width:100%;max-width:100%;padding:0 clamp(0.65rem, 2vw, 1.25rem) clamp(0.9rem, 2.4vw, 1.2rem);display:flex;justify-content:center;"
    >
      <div style="box-sizing:border-box;width:100%;max-width:1240px;margin:0 auto;min-width:0;">
        <p
          style="margin:0 0 0.1rem;font-size:clamp(1.05rem, 2.1vw, 1.3rem);line-height:1.25;font-weight:600;letter-spacing:-0.015em;color:#f2f4fa;"
        >
          Lumos Açık Mektup
        </p>
        <p style="margin:0 0 0.55rem;font-size:0.93rem;line-height:1.5;color:#d0d7e4;">
          Lumos’un neden geliştirildiğini, hangi sınırlarla ilerlediğini ve kullanıcıya nasıl bir kontrol alanı sunmayı hedeflediğini anlatan kısa açıklama.
        </p>
        <p style="margin:0 0 0.4rem;font-size:0.95rem;line-height:1.62;color:#d9deea;">
          Lumos, kullanıcının cihazı ve dijital işlemleri üzerinde daha bilinçli, kontrollü ve güvenli hareket
          etmesini sağlayan yardımcı bir kontrol katmanıdır.
        </p>
        <p style="margin:0;font-size:0.95rem;line-height:1.62;color:#d9deea;">
          Kararı kullanıcı verir. Lumos; riski, bağlamı ve sonraki adımı görünür kılar.
        </p>
      </div>
    </section>

    <section class="lumos-cap" aria-labelledby="lumos-cap-title">
      <h2 id="lumos-cap-title" class="lumos-cap-title">Lumos'un ana modülleri</h2>
      <div class="lumos-cap-grid">
        <a class="lumos-cap-card lumos-cap-card-link" href="#publishing" aria-label="Yayıncılık modülüne git">
          <h3>Yayıncılık</h3>
          <p>Yayın akışlarını görünür ve kontrollü hale getirir.</p>
          <span class="lumos-cap-card-cta">Detaya git</span>
        </a>
        <a class="lumos-cap-card lumos-cap-card-link" href="#media" aria-label="Medya modülüne git">
          <h3>Medya</h3>
          <p>Ses, görüntü ve dosya akışlarını düzenli tutar.</p>
          <span class="lumos-cap-card-cta">Detaya git</span>
        </a>
        <a class="lumos-cap-card lumos-cap-card-link" href="#ai" aria-label="Yapay Zekâ modülüne git">
          <h3>Yapay Zekâ</h3>
          <p>Karar desteği sunan insan merkezli bir katman sunar.</p>
          <span class="lumos-cap-card-cta">Detaya git</span>
        </a>
        <a class="lumos-cap-card lumos-cap-card-link" href="#quantum" aria-label="Kuantum modülüne git">
          <h3>Kuantum</h3>
          <p>Araştırma ve geleceğe açık hesaplama alanını temsil eder.</p>
          <span class="lumos-cap-card-cta">Detaya git</span>
        </a>
        <a class="lumos-cap-card lumos-cap-card-link" href="#integration" aria-label="Entegrasyon modülüne git">
          <h3>Entegrasyon</h3>
          <p>Servisleri tek bir kontrollü akışta birleştirir.</p>
          <span class="lumos-cap-card-cta">Detaya git</span>
        </a>
        <a class="lumos-cap-card lumos-cap-card-link" href="#identity" aria-label="Kimlik modülüne git">
          <h3>Kimlik</h3>
          <p>Dijital kimlik ve tercihleri daha yönetilebilir kılar.</p>
          <span class="lumos-cap-card-cta">Detaya git</span>
        </a>
        <a class="lumos-cap-card lumos-cap-card-link" href="#security" aria-label="Güvenlik modülüne git">
          <h3>Güvenlik</h3>
          <p>Riskli işlemlerde onay ve görünürlüğü önceliklendirir.</p>
          <span class="lumos-cap-card-cta">Detaya git</span>
        </a>
        <a class="lumos-cap-card lumos-cap-card-link" href="#world" aria-label="Dünya modülüne git">
          <h3>Dünya</h3>
          <p>Farklı kullanıcı ve çalışma biçimlerine uyumu temsil eder.</p>
          <span class="lumos-cap-card-cta">Detaya git</span>
        </a>
      </div>
    </section>
    <section class="lumos-modules" aria-labelledby="lumos-module-detail-title">
      <h2 id="lumos-module-detail-title" class="lumos-cap-title">Modül açıklamaları</h2>
      <div class="lumos-modules-grid">
        <article id="publishing" class="lumos-module-item">
          <h3>Yayıncılık</h3>
          <p>
            Canlı ve kayıtlı yayın akışlarında kullanıcının neyin, nereye ve hangi onayla yayıldığını daha net
            görmesini hedefler.
          </p>
        </article>
        <article id="media" class="lumos-module-item">
          <h3>Medya</h3>
          <p>
            Ses, görüntü ve dosya akışlarını daha düzenli, izlenebilir ve kontrollü hale getirmeyi amaçlar.
          </p>
        </article>
        <article id="ai" class="lumos-module-item">
          <h3>Yapay Zekâ</h3>
          <p>
            Kullanıcının yerine geçen değil, kullanıcının kararını daha bilinçli vermesine yardımcı olan yapay zekâ
            katmanıdır.
          </p>
        </article>
        <article id="quantum" class="lumos-module-item">
          <h3>Kuantum</h3>
          <p>
            Gelecekteki ileri hesaplama ve güvenlik yaklaşımlarına açık, araştırma odaklı bir alan olarak düşünülür.
          </p>
        </article>
        <article id="integration" class="lumos-module-item">
          <h3>Entegrasyon</h3>
          <p>
            Farklı uygulama ve servisleri tek bir kontrollü akış içinde bir araya getirmeyi hedefler.
          </p>
        </article>
        <article id="identity" class="lumos-module-item">
          <h3>Kimlik</h3>
          <p>
            Kullanıcının dijital kimliğini, tercihlerini ve sınırlarını daha görünür ve yönetilebilir hale getirmeyi
            amaçlar.
          </p>
        </article>
        <article id="security" class="lumos-module-item">
          <h3>Güvenlik</h3>
          <p>
            Riskli, kalıcı veya geri dönüşü zor işlemlerde kullanıcı onayını ve görünürlüğü öncelikli tutar.
          </p>
        </article>
        <article id="world" class="lumos-module-item">
          <h3>Dünya</h3>
          <p>
            Lumos’un farklı kullanıcılar, diller ve çalışma biçimleriyle uyumlu büyüyebilmesi için genel yönünü temsil
            eder.
          </p>
        </article>
      </div>
    </section>

    <main style="max-width:40rem;margin:0 auto;padding:clamp(1.35rem,3.2vw,1.85rem) clamp(1rem, 4vw, 1.5rem) 3rem;">
      <article style="text-align:left;color:#e4e7ef;">
        <p style="margin:0 0 0.75rem;font-size:1.06rem;line-height:1.68;">
          Lumos’u tek bir fikirle başlattım: teknolojiyi insanın yerine geçen bir güç değil, insanı daha güçlü ve
          daha bilinçli yapan bir yardımcı haline getirmek.
        </p>
        <p style="margin:0 0 0.75rem;font-size:1.06rem;line-height:1.68;">
          Bugün yapay zekâ birçok alanda hızla gelişiyor. Ama benim için asıl mesele sadece daha akıllı sistemler
          kurmak değil; bu sistemlerin insanla nasıl ilişki kurduğu, neye ne kadar müdahale ettiği ve sorumluluğu
          kimde bıraktığı.
        </p>
        <p style="margin:0 0 0.75rem;font-size:1.06rem;line-height:1.68;">Lumos bu düşünceden doğdu.</p>
        <p style="margin:0 0 0.75rem;font-size:1.06rem;line-height:1.68;">
          Amacım, insanla dijital dünya arasında daha anlaşılır, daha güvenli ve daha kontrollü bir katman
          oluşturmak. Lumos kullanıcının yerine karar veren bir sistem değil; kullanıcının ne yaptığını daha iyi
          görmesini, seçenekleri daha net anlamasını ve kendi kararını daha bilinçli vermesini sağlayan bir yardımcı
          olmalı.
        </p>
        <p style="margin:0 0 0.75rem;font-size:1.06rem;line-height:1.68;">
          Bu proje şu anda yolun başında. Her şey tamamlanmış değil. Ama yönü net: sade, güvenilir, kullanıcıyı
          merkeze alan ve gereksiz karmaşadan uzak bir yapay zekâ deneyimi oluşturmak.
        </p>
        <p style="margin:0 0 1.85rem;color:#c5cad6;font-size:0.99rem;line-height:1.68;">
          Lumos’un benim için değeri burada başlıyor. Çünkü bu sadece bir yazılım fikri değil; teknolojiyle
          kurduğumuz ilişkiyi daha dürüst, daha güvenli ve daha insani hale getirme çabası.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Lumos nedir?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.68;">
          Lumos, kullanıcının cihazlar, dijital işlemler ve bağlantılı sistemlerle çalışırken ne olup bittiğini daha
          kolay görmesini, anlamasını ve kontrol etmesini sağlayan yardımcı bir kontrol katmanıdır.
        </p>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.68;">
          Ev otomasyonu, binek araçlar, bilgisayar, telefon, uygulamalar ve benzeri sistemlerde amaç; işlemleri
          karmaşık teknik detaylara boğmadan sadeleştirmek, riskli adımları görünür kılmak ve kullanıcıya daha
          güvenli ilerleme alanı açmaktır.
        </p>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.68;">
          Birçok alanda kullanıcı, yapmak istediğini Lumos’a sesli olarak ifade edebilir. Lumos bu isteği güvenli,
          kontrollü ve anlaşılır adımlara ayırarak işlemin daha kolay ilerlemesini sağlar.
        </p>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.68;">
          Lumos kullanıcının yerine karar vermez; seçenekleri, bağlamı, riskleri ve olası sonuçları anlaşılır hale
          getirir. Kalıcı, maliyetli veya başkalarını etkileyen işlemlerde son onay kullanıcıda kalır.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Kurulu olduğu cihazda ne sağlar?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Kurulu olduğu cihazda Lumos, yerel arayüz ve görev akışlarını toparlayan bir merkez gibi davranır.
          Gerektiğinde medya işleme, sohbet, yönlendirme, kimlik ve servis bağlantılarını güvenli köprülerle
          dış dünyaya açar. Silme, değiştirme, paylaşma veya dış servise gönderme gibi etkili işlemlerde
          kontrolün kullanıcıda kalmasını esas alır.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Kullanıcı Lumos ile ne kazanır?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Kullanıcı, dağınık araçlar arasında kaybolmak yerine tek bir sakin çalışma alanı kazanır. Ne yaptığını,
          neyin cihazda kaldığını, neyin dış servise gittiğini ve hangi adımda onay gerektiğini daha açık görür.
          Lumos’un değeri, insanı hızın peşinde ezmek değil; hızı, kontrol ve sorumlulukla birlikte kullanılabilir
          hale getirmektir.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Temel ilkeler
        </h2>
        <ul style="margin:0;padding-left:1.15rem;color:#c5cad6;font-size:0.98rem;line-height:1.55;">
          <li style="margin-bottom:0.5rem">Karar kullanıcıdadır.</li>
          <li style="margin-bottom:0.5rem">Güven görünür davranışla kurulur.</li>
          <li style="margin-bottom:0.5rem">Hız, kontrolün önüne geçmez.</li>
          <li style="margin-bottom:0.5rem">Dış bağlantılar gizlenmez; kullanıcı neyin nereye gittiğini bilmelidir.</li>
          <li style="margin-bottom:0.5rem">Yıkıcı veya kalıcı işlemler açık onay gerektirir.</li>
          <li style="margin-bottom:0.5rem">Teknoloji insanı küçültmek için değil, insanın alanını genişletmek için kullanılır.</li>
        </ul>
      </article>

      <section
        style="margin-top:2.75rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,0.1);font-size:0.8rem;color:#9aa4b5;text-align:left;line-height:1.55;"
        aria-label="Lumos'a bir şey söyle"
      >
        <p style="margin:0 0 0.6rem;font-weight:600;color:#e8ecf4;font-size:0.88rem;letter-spacing:-0.01em;">
          Lumos'a bir şey söyle
        </p>
        <p style="margin:0 0 0.7rem;color:#aeb6c8;font-size:0.82rem;line-height:1.55;">
          Kısa bir düşünce, soru ya da görev yazın. Lumos yanıtı burada gösterecek; belirsiz yerlerde açık
          konuşacak.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
          <input
            id="msg"
            type="text"
            placeholder="Ne üzerinde düşünelim?"
            style="flex:1;min-width:12rem;max-width:100%;padding:0.45rem 0.55rem;border-radius:8px;border:1px solid rgba(255,255,255,0.15);background:#12182a;color:#f2f2f2;font-size:0.8rem;"
          />
          <button
            type="button"
            id="api-test-send"
            style="padding:0.45rem 0.85rem;border-radius:8px;border:none;background:#2a3f6d;color:#fff;font-size:0.8rem;cursor:pointer;"
          >
            Gönder
          </button>
        </div>
        <div class="lumos-reply-panel">
          <p class="lumos-reply-heading">Lumos cevabı</p>
          <div
            id="lumos-reply"
            class="lumos-reply-body"
            role="region"
            aria-live="polite"
            aria-label="Son Lumos cevabı"
          ></div>
        </div>
      </section>
    </main>
    <script define:vars={{ CHAT_URL, kandoToken }}>
      function apiTestWire() {
        const btn = document.getElementById("api-test-send");
        const input = document.getElementById("msg");
        const replyEl = document.getElementById("lumos-reply");
        if (!btn || !input || !replyEl) return;

        const sendLabel = "Gönder";
        const loadingLabel = "Gönderiliyor...";
        let sending = false;

        function setLumosReply(bodyText, opts) {
          const isError = opts && opts.error;
          replyEl.textContent = bodyText;
          replyEl.classList.toggle("lumos-reply-body--error", !!isError);
        }

        async function runApiTest() {
          const message = input.value.trim();
          if (!message) return;
          if (sending) return;

          sending = true;
          btn.disabled = true;
          btn.textContent = loadingLabel;
          try {
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify({ message }),
            });
            const text = await r.text();
            let data = null;
            try {
              data = text ? JSON.parse(text) : null;
            } catch {
              data = null;
            }
            if (r.ok) {
              let replyBody = "";
              if (data && typeof data === "object" && "reply" in data) {
                const raw = data.reply;
                replyBody = raw == null ? "" : String(raw);
              }
              if (!replyBody.trim() && text && text.trim()) {
                replyBody =
                  data && typeof data === "object" && "reply" in data
                    ? ""
                    : "Bu kez yanıtı okuyamadık. Biraz sonra yeniden denebilirsin.";
              }
              const lumosText = replyBody.trim()
                ? replyBody
                : "Bu sefer boş bir yanıt geldi. Sorunu biraz açıp yeniden deneyebilirsin.";
              setLumosReply(lumosText, { error: false });
              input.value = "";
            } else {
              let errHuman = "";
              if (data && typeof data === "object" && data.error != null) {
                errHuman = String(data.error);
              } else if (text && text.trim()) {
                errHuman = text.trim();
              } else {
                errHuman = r.statusText || "Beklenmeyen bir durum oluştu.";
              }
              if (errHuman === "OPENAI_API_KEY missing") {
                errHuman = "Şu an yanıt üretilemiyor; kısa süre içinde yeniden denebilirsin.";
              } else if (errHuman === "message required") {
                errHuman = "Önce kısa bir mesaj yazman gerekiyor.";
              }
              setLumosReply("Şimdilik yanıt veremedik. " + errHuman, { error: true });
            }
          } catch {
            setLumosReply(
              "Bağlantıda kısa bir kesinti oldu. İnternetini kontrol edip biraz sonra yeniden deneyebilirsin.",
              { error: true }
            );
          } finally {
            sending = false;
            btn.disabled = false;
            btn.textContent = sendLabel;
          }
        }

        btn.addEventListener("click", () => {
          void runApiTest();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter") return;
          e.preventDefault();
          void runApiTest();
        });
      }
      apiTestWire();
    </script>
  </body>
</html>
