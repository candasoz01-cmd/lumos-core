        btn.addEventListener("click", async () => {
          const file = input.files && input.files[0];
          if (!file) {
            setDosyalarHint(() => panelT("panel.modules.files.hints.pickFirst"));
            return;
          }
          dosyalarLastAudioFile = dosyalarIsAudioFile(
            dosyalarFileExtension(file.name),
            file.type,
          )
            ? file
            : null;
          hideHint();
          result.hidden = true;
          btn.disabled = true;
          btn.setAttribute("aria-busy", "true");
          const ext = dosyalarFileExtension(file.name);
          try {
            const uploaded = await uploadPanelFile(file);
            if (!uploaded.ok) {
              if (taskBridgeBlockedResponse(uploaded.status)) {
                const bridgeHint = bridgeBlockedUserHint();
                if (bridgeHint) setDosyalarHint(() => panelUserVisibleText(bridgeHint));
                return;
              }
              const serverMessage =
                uploaded.data && uploaded.data.message != null
                  ? String(uploaded.data.message).trim()
                  : "";
              const rawError =
                uploaded.data && uploaded.data.error != null
                  ? String(uploaded.data.error)
                  : "upload_failed";
              setDosyalarHint(() =>
                serverMessage
                  ? panelUserVisibleText(serverMessage)
                  : panelProdErrorUserMessage({
                      rawError,
                      httpStatus: uploaded.status,
                    }),
              );
              return;
            }

            const meta =
              uploaded.data && uploaded.data.file && typeof uploaded.data.file === "object"
                ? uploaded.data.file
                : {};
            const filename = meta.name != null && String(meta.name).trim()
              ? String(meta.name).trim()
              : file.name;
            const data = {
              ok: true,
              filename,
              size: typeof meta.size === "number" ? meta.size : file.size,
              kind: meta.mime || file.type || "application/octet-stream",
              extension: dosyalarFileExtension(filename) || ext,
              summary: "",
              info: "",
              unsupported: "",
              duplicate: uploaded.data.duplicate === true,
            };
            renderResult(data);
            pushDosyalarHistory(data);
          } catch {
            setDosyalarHint(() => panelT("panel.modules.files.hints.unreachable"));
          } finally {
            btn.disabled = false;
            btn.removeAttribute("aria-busy");
          }
        });

