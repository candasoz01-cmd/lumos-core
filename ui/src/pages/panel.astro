        border-color: rgba(212, 182, 128, 0.32);
      }
      .dosyalar-history-row:focus-visible {
        outline: none;
        border-color: rgba(184, 148, 96, 0.45);
        box-shadow: 0 0 0 1px rgba(184, 148, 96, 0.22);
