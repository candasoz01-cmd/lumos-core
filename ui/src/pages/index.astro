---
/** Canlı köprü testi: istek adresi sabit (deploy ortamı yanlış env ile kırılmasın). */
const CHAT_URL = "https://lumos-core-1.onrender.com/chat";
const kandoToken = import.meta.env.PUBLIC_KANDO_TOKEN || "test123";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lumos — Açık mektup</title>
  </head>
  <body
    style="margin:0;background:#0b1020;color:#f2f2f2;font-family:ui-sans-serif,system-ui,Segoe UI,Roboto,sans-serif;line-height:1.6;"
  >
    <section
      aria-label="Lumos görseli"
      style="box-sizing:border-box;width:100%;padding:clamp(0.55rem, 2vw, 0.95rem) clamp(0.12rem, 0.55vw, 0.35rem) clamp(0.95rem, 3vw, 1.5rem);"
    >
      <div
        style="box-sizing:border-box;width:100%;margin:0 auto;border-radius:12px;padding:0;overflow:hidden;background:linear-gradient(165deg,#070b14 0%,#0c1424 42%,#0a1620 100%);border:1px solid rgba(82, 148, 158, 0.38);box-shadow:inset 0 1px 0 rgba(190, 165, 115, 0.14),0 0 0 1px rgba(45, 110, 105, 0.25),0 6px 28px rgba(0,0,0,0.45),0 0 40px rgba(40, 120, 115, 0.1);display:flex;justify-content:center;align-items:center;min-height:0;"
      >
        <img
          src="/assets/lumos/lumos-last.png"
          alt="Lumos"
          width="1536"
          height="1024"
          loading="eager"
          decoding="async"
          style="display:block;margin:0;max-width:100%;width:auto;height:auto;max-height:min(60vh, 580px);object-fit:contain;"
        />
      </div>
    </section>

    <main style="max-width:40rem;margin:0 auto;padding:0 clamp(1rem, 4vw, 1.5rem) 3rem;">
      <article style="text-align:left;color:#e4e7ef;">
        <p style="margin:0 0 1rem;font-size:1.05rem;line-height:1.65;">
          Merhaba. Kıbrıs’tan dünyaya uzanan bu satırlar, akıllı ses ve medyayı insanı küçültmeden, abartısız
          ve net bir dille bir araya getirme niyetimizin özeti. Karşınızda broşür değil, açık bir mektup var:
          neye inanıyoruz, nerede duruyoruz, bunu paylaşmak istedik.
        </p>
        <p style="margin:0 0 1.75rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Lumos sihirli bir vaat değil; birlikte düşünmek, dinlemek ve üretmek için açık bir kapı. Aşağıda
          bu kapının ardındakileri ve yol alırken tuttuğumuz pusulayı, kısa ve içten bir dille anlatıyoruz.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Lumos nedir?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Ses, görüntü ve metni aynı sohbet akışında buluşturan bir yardımcı: önce sizin cihazınızda durur,
          gerektiğinde güvendiğiniz köprülerden geçer. Amacımız daha çok düğme değil; anlaşılır akış, net geri
          bildirim ve insanı merkeze alan sakin bir tempo.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Kurulu olduğu cihazda ne sağlar?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Arayüz ve günlük işler cihazda yerel çalışır; uzak hizmetlere yalnızca siz adım attığınızda gidilir.
          Medya, sohbet ve küçük görevler aynı yerde toplanır; neyin cihazda kaldığı, neyin köprüden geçtiği
          gizlenmez.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Kullanıcı Lumos ile ne kazanır?
        </h2>
        <p style="margin:0 0 1rem;color:#c5cad6;font-size:0.98rem;line-height:1.65;">
          Biraz daha az dağınıklık: üretmek, dinlemek ve düzenlemek için tek bir sakin köşe. Abartılı sözler
          yerine küçük adımlar; “şimdi ne olacak?” sorusuna düz yanıtlar. Ses ve görsel yükünüzü hafifletmeye
          çalışırken sizi küçültmeden yanınızda olmayı umuyoruz.
        </p>

        <h2 style="margin:1.75rem 0 0.5rem;font-size:1.1rem;font-weight:600;color:#e8ecf4;letter-spacing:-0.01em;">
          Temel ilkeler
        </h2>
        <ul style="margin:0;padding-left:1.15rem;color:#c5cad6;font-size:0.98rem;line-height:1.55;">
          <li style="margin-bottom:0.5rem">İnsan ölçeği: dil sade, ton saygılı.</li>
          <li style="margin-bottom:0.5rem">Gizlilik ve kontrol: paylaşım sizinle başlar; izi görünür tutarız.</li>
          <li style="margin-bottom:0.5rem">Şeffaflık: sınırlar ve riskler saklanmaz.</li>
          <li style="margin-bottom:0.5rem">Birlikte gelişim: dinlediğimizi işe döker, ürünü paylaşarak ilerletiriz.</li>
        </ul>
      </article>

      <section
        style="margin-top:2.75rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,0.1);font-size:0.8rem;color:#9aa4b5;text-align:left;line-height:1.55;"
        aria-label="API bağlantı testi"
      >
        <p style="margin:0 0 0.6rem;font-weight:600;color:#aeb6c8;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;">
          API bağlantı testi
        </p>
        <p style="margin:0 0 0.7rem;">
          Canlı sunucuya tek bir mesaj gönderip yanıtı burada görebilirsiniz. Adres:
          <code style="color:#c8d0e0;font-size:0.78rem;">https://lumos-core-1.onrender.com/chat</code>
          — özel token kullanacaksanız build sırasında
          <code style="color:#c8d0e0;font-size:0.78rem;">PUBLIC_KANDO_TOKEN</code> tanımlayın.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
          <input
            id="msg"
            type="text"
            placeholder="Kısa bir test mesajı"
            style="flex:1;min-width:12rem;max-width:100%;padding:0.45rem 0.55rem;border-radius:8px;border:1px solid rgba(255,255,255,0.15);background:#12182a;color:#f2f2f2;font-size:0.8rem;"
          />
          <button
            type="button"
            id="api-test-send"
            style="padding:0.45rem 0.85rem;border-radius:8px;border:none;background:#2a3f6d;color:#fff;font-size:0.8rem;cursor:pointer;"
          >
            Gönder
          </button>
        </div>
        <pre
          id="out"
          role="status"
          aria-live="polite"
          aria-relevant="additions text"
          style="margin:0.65rem 0 0;padding:0.65rem 0.75rem;border-radius:10px;border:1px solid rgba(255,255,255,0.12);background:rgba(0,0,0,0.25);min-height:2.75rem;white-space:pre-wrap;word-break:break-word;font-size:0.8rem;color:#dce3f0;"
        ></pre>
      </section>
    </main>
    <script define:vars={{ CHAT_URL, kandoToken }}>
      function apiTestWire() {
        const btn = document.getElementById("api-test-send");
        const input = document.getElementById("msg");
        const out = document.getElementById("out");
        if (!btn || !input || !out) return;

        async function runApiTest() {
          const message = input.value.trim();
          if (!message) return;

          const label = btn.textContent;
          btn.disabled = true;
          btn.textContent = "Gönderiliyor...";
          out.textContent = "";
          try {
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify({ message }),
            });
            const text = await r.text();
            let data = null;
            try {
              data = text ? JSON.parse(text) : null;
            } catch {
              data = null;
            }
            if (r.ok) {
              const body =
                data && typeof data === "object"
                  ? JSON.stringify(data, null, 2)
                  : text || "(boş yanıt)";
              out.textContent = "Backend cevabı: " + body;
            } else {
              const detail =
                data && typeof data === "object"
                  ? JSON.stringify(data, null, 2)
                  : text || r.statusText;
              out.textContent = "Bağlantı hatası: HTTP " + r.status + " — " + detail;
            }
          } catch (e) {
            const msg = e instanceof Error ? e.message : String(e);
            out.textContent = "Bağlantı hatası: " + msg;
          } finally {
            btn.disabled = false;
            btn.textContent = label;
          }
        }

        btn.addEventListener("click", () => {
          void runApiTest();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter") return;
          e.preventDefault();
          void runApiTest();
        });
      }
      apiTestWire();
    </script>
  </body>
</html>
