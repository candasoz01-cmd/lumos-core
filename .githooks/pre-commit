#!/usr/bin/env bash
# Commit guard: merkezi claim kapısı + ruff + pytest (docs/dev-commit-guard.md)
# Kurulum: make setup-commit-guard | Bypass: git commit --no-verify
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# 1) Lumos Board merkezi claim kapısı — ruff/pytest'ten ÖNCE ve git'in hook
# ortamı (özellikle `git commit <yol>` için geçici GIT_INDEX_FILE) silinmeden
# önce koşar; aksi halde yanlış index denetlenir. Pano erişilemezse reddeder.
echo ">>> pre-commit: merkezi claim kapısı (LUMOS_AGENT=${LUMOS_AGENT:-<yok>})"
if [[ ! -x "$ROOT/ops/claim_guard/claim-pre-commit" ]]; then
  echo "claim-guard: ops/claim_guard/claim-pre-commit bulunamadı; commit engellendi" >&2
  exit 1
fi
"$ROOT/ops/claim_guard/claim-pre-commit"

# When committing from a linked worktree, git sets these for the hook process;
# left in place they leak into any git command tests spawn in their own
# throwaway repos (e.g. tests/cando/test_branch_cleanup_review.py), pointing
# those commands at this repo instead of the test's tmp_path repo.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_CEILING_DIRECTORIES

for venv in .venv venv; do
  if [[ -f "$ROOT/$venv/bin/activate" ]]; then
    # shellcheck source=/dev/null
    source "$ROOT/$venv/bin/activate"
    break
  fi
done

echo ">>> pre-commit: ruff check ."
if command -v ruff >/dev/null 2>&1; then
  ruff check .
else
  python3 -m ruff check .
fi

echo ">>> pre-commit: pytest -q"
if command -v pytest >/dev/null 2>&1; then
  pytest -q
else
  python3 -m pytest -q
fi

echo ">>> pre-commit: OK"
