---
interface Props {
  githubUrl: string;
}

const { githubUrl } = Astro.props;

/** Pin %: x ≈ (lon+180)/360×100, y ≈ (90−lat)/180×100 (plate carrée). */
const pins = [
  {
    id: "neden",
    label: "Neden Lumos?",
    /** Türkiye (~35°N, 35°E) */
    leftPct: 59.7,
    topPct: 31.5,
    title: "Neden Lumos?",
    desc: "İnsan merkezli kontrol katmanı vizyonunu okuyun.",
    href: "#neden-lumos",
    external: false,
    cta: "Bölüme git",
  },
  {
    id: "moduller",
    label: "Modüller",
    /** Orta Avrupa (~51°N, 10°E) */
    leftPct: 52.8,
    topPct: 22.5,
    title: "Modüller",
    desc: "Yayıncılıktan güvenliğe modül özetleri ve detaylar.",
    href: "#modules",
    external: false,
    cta: "Modüllere git",
  },
  {
    id: "gelistirici",
    label: "Geliştirici",
    /** US Doğu (~40°N, 74°W) */
    leftPct: 29.4,
    topPct: 29.5,
    title: "Geliştirici erişimi",
    desc: "Kaynak kodu ve yerel çalıştırma için GitHub.",
    href: "#developer-access",
    external: false,
    cta: "Bölüme git",
  },
  {
    id: "panel",
    label: "Panel",
    /** Uzak Doğu (~35°N, 139°E) */
    leftPct: 88.6,
    topPct: 31.0,
    title: "Panel",
    desc: "Çalışma alanına geçin; sohbet ve görev akışı.",
    href: "/panel",
    external: false,
    cta: "Paneli aç",
  },
  {
    id: "github",
    label: "GitHub",
    /** US Batı (~37°N, 122°W) */
    leftPct: 16.1,
    topPct: 30.8,
    title: "GitHub",
    desc: "Açık kaynak deposu ve katkı noktaları.",
    href: githubUrl,
    external: true,
    cta: "Repoyu aç",
  },
] as const;
---

<section class="lumos-world-hero" aria-labelledby="lumos-world-hero-title">
  <div class="lumos-world-hero__inner">
    <header class="lumos-world-hero__head">
      <p id="lumos-world-hero-title" class="lumos-world-hero__title">
        Lumos · insan merkezli yapay zekâ kontrol katmanı
      </p>
      <p class="lumos-world-hero__sub">
        Dünya görünümünden ilgi alanınıza gidin veya aşağı kaydırarak site içeriğini keşfedin.
      </p>
    </header>

    <div class="lumos-world-hero__stage">
      <svg
        class="lumos-world-hero__svg"
        viewBox="0 0 1000 520"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="lumos-map-ocean" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#050811"></stop>
            <stop offset="45%" stop-color="#080f1c"></stop>
            <stop offset="100%" stop-color="#060914"></stop>
          </linearGradient>
          <linearGradient id="lumos-map-land" x1="30%" y1="0%" x2="70%" y2="100%">
            <stop offset="0%" stop-color="#3d4f68"></stop>
            <stop offset="100%" stop-color="#283446"></stop>
          </linearGradient>
        </defs>
        <rect width="1000" height="520" fill="url(#lumos-map-ocean)" rx="2"></rect>
        <g
          class="lumos-world-hero__grid"
          fill="none"
          stroke="rgba(93,201,197,0.055)"
          stroke-width="0.45"
        >
          {
            Array.from({ length: 11 }).map((_, i) => (
              <line x1={i * 100} y1="0" x2={i * 100} y2="520"></line>
            ))
          }
          {
            Array.from({ length: 6 }).map((_, i) => (
              <line x1="0" y1={i * 104} x2="1000" y2={i * 104}></line>
            ))
          }
        </g>
        <!-- Ekvatör / başlık meridyeni — okuma için hafif referans -->
        <line
          x1="0"
          y1="260"
          x2="1000"
          y2="260"
          stroke="rgba(93,201,197,0.07)"
          stroke-width="0.6"
          stroke-dasharray="5 9"></line>
        <line
          x1="500"
          y1="0"
          x2="500"
          y2="520"
          stroke="rgba(93,201,197,0.05)"
          stroke-width="0.45"
          stroke-dasharray="4 8"></line>
        <g
          class="lumos-world-hero__land"
          fill="url(#lumos-map-land)"
          stroke="rgba(105, 188, 178, 0.26)"
          stroke-width="1.05"
          stroke-linejoin="round"
        >
          <!-- Kuzey Amerika -->
          <path
            d="M92 118 L118 82 L168 68 L248 78 L305 102 L322 138 L312 178 L268 212 L228 228 L182 218 L132 188 L98 152 Z M245 218 L278 208 L292 248 L268 268 L238 252 Z"
          ></path>
          <!-- Greenland -->
          <path d="M332 58 L392 52 L408 118 L372 142 L338 122 Z"></path>
          <!-- Güney Amerika -->
          <path d="M258 258 L302 248 L328 292 L332 358 L308 418 L272 432 L248 392 L236 322 Z"></path>
          <!-- Avrupa -->
          <path
            d="M438 108 L468 92 L528 88 L556 118 L548 158 L512 178 L468 172 L438 148 Z M418 158 L442 152 L452 182 L428 188 Z"
          ></path>
          <!-- Anadolu / Türkiye — pin okunabilirliği -->
          <path d="M528 162 L578 155 L592 188 L568 208 L538 202 L518 182 Z"></path>
          <!-- Afrika -->
          <path
            d="M472 182 L538 172 L562 212 L556 278 L528 372 L492 418 L458 408 L438 348 L432 268 L448 212 Z"
          ></path>
          <!-- Asya anakarası -->
          <path
            d="M548 92 L698 78 L798 95 L862 132 L895 185 L882 248 L842 278 L768 268 L692 248 L628 218 L558 178 L538 138 Z"
          ></path>
          <!-- Hindistan yarımadası -->
          <path d="M668 218 L712 228 L722 278 L698 312 L658 292 L652 248 Z"></path>
          <!-- Güney Doğu Asya / Malay -->
          <path d="M738 268 L798 258 L822 298 L785 318 L752 302 Z"></path>
          <!-- Japonya takımadası -->
          <path d="M862 168 L895 162 L902 192 L878 198 Z M878 208 L912 205 L918 232 L888 238 Z"></path>
          <!-- Avustralya -->
          <path d="M758 338 L858 332 L882 368 L868 398 L812 408 L772 388 Z"></path>
          <!-- Yeni Zelanda -->
          <path d="M928 382 L948 378 L958 418 L938 422 Z"></path>
          <!-- İngiltere / İrlanda -->
          <path d="M432 128 L452 122 L458 142 L438 152 Z M418 138 L432 132 L436 152 L422 156 Z"></path>
        </g>
      </svg>

      <div class="lumos-world-hero__pins">
        {
          pins.map((p) => (
            <button
              type="button"
              class="lumos-world-pin"
              style={`left:${p.leftPct}%;top:${p.topPct}%`}
              data-pin-id={p.id}
              data-title={p.title}
              data-desc={p.desc}
              data-href={p.href}
              data-external={p.external ? "1" : "0"}
              data-cta={p.cta}
              aria-label={p.label}
            >
              <span class="lumos-world-pin__dot" aria-hidden="true"></span>
              <span class="lumos-world-pin__ring" aria-hidden="true"></span>
            </button>
          ))
        }
      </div>
    </div>

    <nav class="lumos-world-hero__mobile" aria-label="Hızlı gezinme">
      {
        pins.map((p) => (
          <button
            type="button"
            class="lumos-world-hero__chip"
            data-pin-id={p.id}
            data-title={p.title}
            data-desc={p.desc}
            data-href={p.href}
            data-external={p.external ? "1" : "0"}
            data-cta={p.cta}
          >
            {p.label}
          </button>
        ))
      }
    </nav>

    <p class="lumos-world-hero__hint">
      <a class="lumos-world-hero__hint-link" href="#giris">
        <span class="lumos-world-hero__hint-text">İçeriği göster · aşağı kaydır</span>
        <span class="lumos-world-hero__hint-arrow" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
            <path
              d="M9 1v10M4 8l5 5 5-5"
              stroke="currentColor"
              stroke-width="1.35"
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity="0.85"></path>
          </svg>
        </span>
      </a>
    </p>
  </div>

  <div
    id="lumos-world-hero-card"
    class="lumos-world-hero__card"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="lumos-world-hero-card-title"
  >
    <button type="button" class="lumos-world-hero__card-x" aria-label="Kapat">×</button>
    <h3 id="lumos-world-hero-card-title" class="lumos-world-hero__card-title"></h3>
    <p class="lumos-world-hero__card-desc"></p>
    <a class="lumos-world-hero__card-cta lumos-github-btn" href="#">Git</a>
  </div>
  <div id="lumos-world-hero-card-backdrop" class="lumos-world-hero__backdrop" hidden aria-hidden="true"
  ></div>
</section>

<style is:global>
  .lumos-world-hero {
    box-sizing: border-box;
    position: relative;
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: stretch;
    padding: clamp(0.55rem, 2vw, 1rem);
    padding-bottom: clamp(1.25rem, 4vw, 2rem);
    background:
      linear-gradient(
        180deg,
        transparent 0%,
        transparent 58%,
        rgba(11, 16, 32, 0.55) 88%,
        rgba(11, 16, 32, 0.92) 100%
      ),
      radial-gradient(ellipse 120% 80% at 50% 0%, rgba(61, 169, 164, 0.09), transparent 52%),
      radial-gradient(ellipse 90% 60% at 88% 72%, rgba(201, 161, 98, 0.07), transparent 48%),
      linear-gradient(168deg, #070910 0%, #0c101c 48%, #09070d 100%);
    border-bottom: none;
    box-shadow: 0 28px 56px -28px rgba(0, 0, 0, 0.65);
  }
  .lumos-world-hero::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(72px, 12vh, 140px);
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(11, 16, 32, 0.35) 55%, #0b1020 100%);
  }
  .lumos-world-hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
    gap: clamp(0.45rem, 1.5vw, 0.85rem);
  }
  .lumos-world-hero__head {
    flex-shrink: 0;
    text-align: center;
    padding: 0 clamp(0.25rem, 2vw, 0.5rem);
  }
  .lumos-world-hero__title {
    margin: 0;
    font-size: clamp(0.82rem, 2.2vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(236, 207, 147, 0.82);
  }
  .lumos-world-hero__sub {
    margin: 0.35rem 0 0;
    font-size: clamp(0.78rem, 2vw, 0.9rem);
    line-height: 1.45;
    color: rgba(170, 182, 198, 0.82);
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }
  .lumos-world-hero__stage {
    position: relative;
    flex: 1;
    min-height: clamp(220px, 42svh, 420px);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(148, 112, 68, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(188, 148, 92, 0.08),
      0 12px 40px rgba(0, 0, 0, 0.45);
    background: radial-gradient(ellipse 85% 70% at 48% 42%, rgba(14, 22, 38, 0.55), rgba(4, 7, 14, 0.92));
  }
  .lumos-world-hero__svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lumos-world-hero__pins {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .lumos-world-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    border-radius: 999px;
  }
  .lumos-world-pin:focus-visible {
    outline: 2px solid rgba(93, 201, 197, 0.55);
    outline-offset: 3px;
  }
  .lumos-world-pin__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    margin: -0.275rem 0 0 -0.275rem;
    border-radius: 999px;
    background: radial-gradient(circle at 35% 30%, #e8f8f6, #3da9a4 55%, #1c5c58);
    box-shadow: 0 0 10px rgba(93, 201, 197, 0.35);
    transition: transform 0.18s ease;
  }
  .lumos-world-pin__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.55rem;
    height: 1.55rem;
    margin: -0.775rem 0 0 -0.775rem;
    border-radius: 999px;
    border: 1px solid rgba(93, 201, 197, 0.22);
    opacity: 0.65;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .lumos-world-pin:hover .lumos-world-pin__dot,
  .lumos-world-pin:focus-visible .lumos-world-pin__dot {
    transform: scale(1.08);
  }
  .lumos-world-pin:hover .lumos-world-pin__ring,
  .lumos-world-pin:focus-visible .lumos-world-pin__ring {
    opacity: 0.95;
    transform: scale(1.05);
  }
  .lumos-world-hero__mobile {
    display: none;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: center;
    padding: 0.15rem 0 0.25rem;
  }
  .lumos-world-hero__chip {
    appearance: none;
    border-radius: 999px;
    padding: 0.38rem 0.72rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(210, 218, 230, 0.92);
    background: rgba(14, 18, 28, 0.88);
    border: 1px solid rgba(148, 112, 68, 0.32);
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }
  .lumos-world-hero__chip:hover,
  .lumos-world-hero__chip:focus-visible {
    border-color: rgba(93, 201, 197, 0.35);
    background: rgba(18, 24, 34, 0.95);
  }
  .lumos-world-hero__chip:focus-visible {
    outline: 2px solid rgba(93, 201, 197, 0.45);
    outline-offset: 2px;
  }
  .lumos-world-hero__hint {
    margin: 0;
    text-align: center;
    flex-shrink: 0;
  }
  .lumos-world-hero__hint-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(147, 188, 186, 0.85);
    text-decoration: none;
    padding: 0.35rem 0.55rem 0.28rem;
    border-radius: 8px;
    border: 1px solid transparent;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }
  .lumos-world-hero__hint-text {
    display: block;
    text-align: center;
    line-height: 1.35;
  }
  .lumos-world-hero__hint-arrow {
    display: flex;
    color: rgba(147, 188, 186, 0.72);
    animation: lumos-world-hint-nudge 2.4s ease-in-out infinite;
  }
  @keyframes lumos-world-hint-nudge {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(5px);
      opacity: 0.95;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lumos-world-hero__hint-arrow {
      animation: none;
      opacity: 0.75;
    }
  }
  .lumos-world-hero__hint-link:hover,
  .lumos-world-hero__hint-link:focus-visible {
    color: #9fe8e4;
    border-color: rgba(93, 201, 197, 0.28);
    background: rgba(14, 22, 32, 0.45);
  }
  .lumos-world-hero__hint-link:hover .lumos-world-hero__hint-arrow,
  .lumos-world-hero__hint-link:focus-visible .lumos-world-hero__hint-arrow {
    color: rgba(159, 232, 228, 0.88);
  }
  .lumos-world-hero__hint-link:focus-visible {
    outline: 2px solid rgba(93, 201, 197, 0.45);
    outline-offset: 2px;
  }

  @media (max-width: 719.98px) {
    .lumos-world-hero__pins {
      display: none;
    }
    .lumos-world-hero__mobile {
      display: flex;
    }
    .lumos-world-hero__stage {
      min-height: clamp(180px, 28svh, 260px);
    }
  }

  .lumos-world-hero__backdrop {
    position: fixed;
    inset: 0;
    z-index: 12000;
    background: rgba(4, 6, 12, 0.48);
    backdrop-filter: blur(2px);
  }
  .lumos-world-hero__backdrop[hidden] {
    display: none !important;
  }
  .lumos-world-hero__card {
    position: fixed;
    z-index: 12001;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    width: min(22rem, calc(100vw - 1.5rem));
    padding: 1rem 1rem 1rem;
    border-radius: 14px;
    background: linear-gradient(158deg, rgba(18, 22, 32, 0.98), rgba(10, 12, 20, 0.99));
    border: 1px solid rgba(148, 112, 68, 0.42);
    box-shadow:
      0 18px 48px rgba(0, 0, 0, 0.58),
      inset 0 1px 0 rgba(188, 148, 92, 0.12);
  }
  .lumos-world-hero__card[hidden] {
    display: none !important;
  }
  .lumos-world-hero__card-x {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(210, 205, 195, 0.88);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
  }
  .lumos-world-hero__card-x:hover,
  .lumos-world-hero__card-x:focus-visible {
    background: rgba(255, 255, 255, 0.1);
  }
  .lumos-world-hero__card-title {
    margin: 0 1.75rem 0.35rem 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #eccf93;
  }
  .lumos-world-hero__card-desc {
    margin: 0 0 0.85rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(190, 198, 212, 0.9);
  }
  .lumos-world-hero__card .lumos-world-hero__card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-sizing: border-box;
  }
</style>

<script is:inline>
  (function () {
    var card = document.getElementById("lumos-world-hero-card");
    var backdrop = document.getElementById("lumos-world-hero-card-backdrop");
    var closeBtn = card ? card.querySelector(".lumos-world-hero__card-x") : null;
    var titleEl = card ? card.querySelector(".lumos-world-hero__card-title") : null;
    var descEl = card ? card.querySelector(".lumos-world-hero__card-desc") : null;
    var ctaEl = card ? card.querySelector(".lumos-world-hero__card-cta") : null;
    if (!card || !backdrop || !closeBtn || !titleEl || !descEl || !ctaEl) return;

    function closeCard() {
      card.setAttribute("hidden", "");
      backdrop.setAttribute("hidden", "");
      card.setAttribute("aria-hidden", "true");
      document.removeEventListener("keydown", onKey);
    }

    function onKey(e) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeCard();
      }
    }

    function openFromTrigger(trigger) {
      var title = trigger.getAttribute("data-title") || "";
      var desc = trigger.getAttribute("data-desc") || "";
      var href = trigger.getAttribute("data-href") || "#";
      var external = trigger.getAttribute("data-external") === "1";
      var cta = trigger.getAttribute("data-cta") || "Git";

      titleEl.textContent = title;
      descEl.textContent = desc;
      ctaEl.textContent = cta;
      ctaEl.setAttribute("href", href);
      if (external) {
        ctaEl.setAttribute("target", "_blank");
        ctaEl.setAttribute("rel", "noopener noreferrer");
      } else {
        ctaEl.removeAttribute("target");
        ctaEl.removeAttribute("rel");
      }

      card.removeAttribute("hidden");
      backdrop.removeAttribute("hidden");
      card.setAttribute("aria-hidden", "false");
      document.addEventListener("keydown", onKey);
      closeBtn.focus();
    }

    document.querySelectorAll(".lumos-world-pin, .lumos-world-hero__chip").forEach(function (el) {
      el.addEventListener("click", function () {
        openFromTrigger(el);
      });
    });

    closeBtn.addEventListener("click", closeCard);
    backdrop.addEventListener("click", closeCard);
  })();
</script>
