        border: 1px solid var(--lumos-border);
        background: #0b0b0b;
        box-shadow:
          inset 0 1px 0 rgba(236, 207, 147, 0.035),
          0 2px 12px rgba(0, 0, 0, 0.45);
        font-size: 0.8rem;
        line-height: 1.45;
