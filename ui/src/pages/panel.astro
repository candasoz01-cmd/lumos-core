        refreshSendHintI18n = () => {
          if (!sendHint || sendHint.hidden || !sendHintRefresh) return;
          paintSendHintFromResolver();
        };

        refreshPanelSendButtonI18n = () => {
          if (!sendBtn) return;
          const label = sending ? panelSendLoadingLabel() : panelSendLabel();
          sendBtn.setAttribute("aria-label", label);
          sendBtn.setAttribute("title", label);
        };

        function revokeCameraPhotoObjectUrl() {
          if (!cameraPhotoObjectUrl) return;
          try {
            URL.revokeObjectURL(cameraPhotoObjectUrl);
          } catch {
            /* ignore */
          }
          cameraPhotoObjectUrl = null;
        }

        function syncPanelCameraPhotoBarVisibility() {
          const hasPhoto = !!cameraPhotoObjectUrl;
          const hasStream = !!cameraStream;
          if (!cameraPreviewWrap) return;
          cameraPreviewWrap.hidden = !(hasPhoto || hasStream);
          if (hasStream) cameraPreviewWrap.classList.add("chat-camera-preview-wrap--stream");
          else cameraPreviewWrap.classList.remove("chat-camera-preview-wrap--stream");
        }

        function stopPanelCameraStream() {
          if (cameraStream) {
            cameraStream.getTracks().forEach((tr) => tr.stop());
            cameraStream = null;
          }
          if (cameraVideo) {
            cameraVideo.srcObject = null;
            cameraVideo.hidden = true;
          }
          if (cameraBtn && !cameraPhotoObjectUrl) {
            cameraBtn.classList.remove("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "false");
          }
          syncPanelCameraPhotoBarVisibility();
        }

        function togglePanelCameraStream() {
          if (cameraStream) {
            stopPanelCameraStream();
            setCameraHintKey("");
            return;
          }
          if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== "function") {
            setCameraHintKey("panel.modules.chat.compose.cameraHints.unsupported");
            return;
          }
          setCameraHintKey("");
          navigator.mediaDevices
            .getUserMedia({ video: true, audio: false })
            .then((stream) => {
              cameraStream = stream;
              if (cameraVideo) {
                cameraVideo.srcObject = stream;
                cameraVideo.hidden = false;
              }
              if (cameraBtn) {
                cameraBtn.classList.add("chat-compose-camera-btn--active");
                cameraBtn.setAttribute("aria-pressed", "true");
              }
              syncPanelCameraPhotoBarVisibility();
            })
            .catch((err) => {
              const name = err && err.name;
              if (name === "NotAllowedError" || name === "PermissionDeniedError") {
                setCameraHintKey("panel.modules.chat.compose.cameraHints.permissionDenied");
              } else {
                setCameraHintKey("panel.modules.chat.compose.cameraHints.unsupported");
              }
              stopPanelCameraStream();
            });
        }

        function clearPanelCameraPhotoSelection() {
          revokeCameraPhotoObjectUrl();
          if (cameraPhotoPreview) {
            cameraPhotoPreview.onload = null;
            cameraPhotoPreview.removeAttribute("src");
            cameraPhotoPreview.removeAttribute("title");
            cameraPhotoPreview.alt = "";
            cameraPhotoPreview.hidden = true;
          }
          if (cameraPhotoInput) cameraPhotoInput.value = "";
          cameraPhotoFileName = null;
          if (cameraPhotoStatus) {
            cameraPhotoStatus.textContent = "";
            cameraPhotoStatus.hidden = true;
          }
          if (cameraBtn && !cameraStream) {
            cameraBtn.classList.remove("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "false");
          }
          syncPanelCameraPhotoBarVisibility();
        }

        function bindCameraPhotoFromFile(file) {
          stopPanelCameraStream();
          if (!file || !/^image\//.test(file.type)) {
            setCameraHintKey("panel.modules.chat.compose.cameraHints.pickImageFile");
            return;
          }
          setCameraHintKey("");
          revokeCameraPhotoObjectUrl();
          try {
            cameraPhotoObjectUrl = URL.createObjectURL(file);
          } catch {
            setCameraHintKey("panel.modules.chat.compose.cameraHints.previewFailed");
            return;
          }
          cameraPhotoFileName = file.name && String(file.name).trim() ? String(file.name).trim() : null;
          if (cameraPhotoPreview) {
            cameraPhotoPreview.hidden = true;
            cameraPhotoPreview.onload = () => {
              cameraPhotoPreview.hidden = false;
            };
            cameraPhotoPreview.src = cameraPhotoObjectUrl;
          }
          syncCameraPhotoStatusText();
          if (cameraBtn) {
            cameraBtn.classList.add("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "true");
          }
          syncPanelCameraPhotoBarVisibility();
        }

        function escapeHtml(s) {
          return String(s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        function formatAssistantHtml(raw) {
          let s = escapeHtml(String(raw));
          s = s.replace(/\*\*([\s\S]+?)\*\*/g, "<strong>$1</strong>");
          s = s.replace(/\*\*/g, "");
          s = s.replace(/\n/g, "<br />");
          return s;
        }

        /** Lumos gövdesinden (strong, br) backend geçmişi için düz metin üretir. */
        function lumosBodyToPlainText(root) {
          const out = [];
          function walk(n) {
            if (n.nodeType === Node.TEXT_NODE) out.push(n.textContent);
            else if (n.nodeType === Node.ELEMENT_NODE) {
              const el = /** @type {Element} */ (n);
              if (el.tagName === "BR") out.push("\n");
              else el.childNodes.forEach(walk);
            }
          }
          walk(root);
          return out.join("").trim();
        }

        const PANEL_TTS_FLASH_KINDS = ["ok", "info", "warn", "error"];
        function panelTtsIconMarkup(kind) {
          if (kind === "stop") {
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><rect x="9" y="9" width="6" height="6" fill="currentColor" stroke="none"></rect></svg>';
          }
          return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" stroke-linejoin="round"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07" stroke-linecap="round"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14" stroke-linecap="round"></path></svg>';
        }
        function panelBubbleCopyIconMarkup() {
          return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
        }
        function panelBubblePlainText(wrap, kind) {
          const body = wrap.querySelector(".chat-msg-body");
          if (!body) return "";
          if (kind === "lumos") return lumosBodyToPlainText(body);
          return body.textContent.trim();
        }
        function panelWriteTextToClipboard(text) {
          if (navigator.clipboard && typeof navigator.clipboard.writeText === "function") {
            return navigator.clipboard.writeText(text);
          }
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.setAttribute("readonly", "");
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          try {
            const ok = document.execCommand("copy");
            document.body.removeChild(ta);
            return ok ? Promise.resolve() : Promise.reject(new Error("execCommand failed"));
          } catch (err) {
            document.body.removeChild(ta);
            return Promise.reject(err);
          }
        }
        function createChatBubbleCopyButton() {
          const copyBtn = document.createElement("button");
          copyBtn.type = "button";
          copyBtn.className = "chat-msg-action";
          copyBtn.setAttribute("data-panel-copy", "");
          const copyIcon = document.createElement("span");
          copyIcon.className = "chat-msg-action__icon chat-msg-action__icon--copy";
          copyIcon.innerHTML = panelBubbleCopyIconMarkup();
          copyBtn.appendChild(copyIcon);
          copyBtn.title = panelT("panel.modules.chat.bubbles.copy");
          copyBtn.setAttribute("aria-label", panelT("panel.modules.chat.bubbles.copy"));
          return copyBtn;
        }
        const panelTtsSupported = !!(
          typeof window !== "undefined" &&
          window.speechSynthesis &&
          typeof window.SpeechSynthesisUtterance !== "undefined"
        );
        const panelTtsDiagEnabled = (() => {
          try {
            const v = new URLSearchParams(window.location.search).get("tts_diag");
            return v === "1" || v === "true";
          } catch {
            /* ignore */
          }
          return false;
        })();
        /** @type {WeakMap<HTMLButtonElement, { el: HTMLSpanElement; parts: string[] }>} */
        const panelTtsDiagState = new WeakMap();
        /** @type {HTMLButtonElement | null} */
        let panelTtsActiveBtn = null;
        /** @type {SpeechSynthesisVoice[] | null} */
        let panelTtsVoicesCache = null;

        /** @param {HTMLButtonElement} btn */
        function panelEnsureTtsDiag(btn) {
          if (!panelTtsDiagEnabled) return null;
          let state = panelTtsDiagState.get(btn);
          if (state) return state.el;
          const actions = btn.closest(".chat-msg-actions");
          if (!actions) return null;
          let el = actions.querySelector(".chat-msg-tts-diag");
          if (!(el instanceof HTMLSpanElement)) {
            el = document.createElement("span");
            el.className = "chat-msg-tts-diag";
            el.setAttribute("aria-live", "polite");
            el.textContent = "TTS diag ready — click speaker";
            el.hidden = false;
            actions.appendChild(el);
          }
          state = { el, parts: [] };
          panelTtsDiagState.set(btn, state);
          return el;
        }

        /** @param {HTMLButtonElement} btn */
        function panelTtsDiagReset(btn) {
          if (!panelTtsDiagEnabled) return;
          const el = panelEnsureTtsDiag(btn);
          if (!el) return;
          const state = panelTtsDiagState.get(btn);
          if (state) state.parts = [];
          el.textContent = "";
          el.hidden = false;
        }

        /**
         * @param {HTMLButtonElement} btn
         * @param {string} append
         */
        function panelTtsDiag(btn, append) {
          if (!panelTtsDiagEnabled) return;
          const el = panelEnsureTtsDiag(btn);
          if (!el) return;
          const state = panelTtsDiagState.get(btn);
          if (!state) return;
          state.parts.push(append);
          el.textContent = state.parts.join(" · ");
          el.hidden = false;
        }

        function panelIsSpeaking() {
          try {
            const synth = window.speechSynthesis;
            return !!(synth && (synth.speaking || synth.pending));
          } catch {
            return false;
          }
        }

        function panelActionFlash(btn, label, kind) {
          if (!btn) return;
          if (btn._panelFlashTimer) {
            clearTimeout(btn._panelFlashTimer);
            btn._panelFlashTimer = null;
          }
          if (btn._panelOrigAria == null) {
            btn._panelOrigAria = btn.getAttribute("aria-label");
            btn._panelOrigTitle = btn.title;
          }
          btn.setAttribute("aria-label", label);
          btn.title = label;
          btn.classList.add("is-flash");
          for (const k of PANEL_TTS_FLASH_KINDS) btn.classList.remove("is-flash--" + k);
          if (kind && PANEL_TTS_FLASH_KINDS.includes(kind)) btn.classList.add("is-flash--" + kind);
          btn._panelFlashTimer = window.setTimeout(() => {
            if (panelTtsActiveBtn === btn && panelIsSpeaking()) {
              btn.setAttribute("aria-label", panelT("panel.modules.chat.tts.stopSpeaking"));
              btn.title = panelT("panel.modules.chat.tts.stop");
            } else if (btn._panelOrigAria != null) {
              btn.setAttribute("aria-label", btn._panelOrigAria);
              btn.title = btn._panelOrigTitle || "";
            }
            btn._panelOrigAria = null;
            btn._panelOrigTitle = null;
            btn.classList.remove("is-flash");
            for (const k of PANEL_TTS_FLASH_KINDS) btn.classList.remove("is-flash--" + k);
            btn._panelFlashTimer = null;
          }, 1400);
        }

        function syncPanelTtsButtons(activeBtn) {
          thread.querySelectorAll("[data-panel-tts]").forEach((raw) => {
            const btn = /** @type {HTMLButtonElement} */ (raw);
            const speakIcon = btn.querySelector(".chat-msg-action__icon--speak");
            const stopIcon = btn.querySelector(".chat-msg-action__icon--stop");
            if (!speakIcon || !stopIcon) return;
            const speaking = activeBtn === btn && panelIsSpeaking();
            speakIcon.hidden = speaking;
            stopIcon.hidden = !speaking;
            btn.setAttribute("aria-label", speaking ? panelT("panel.modules.chat.tts.stopSpeaking") : panelT("panel.modules.chat.tts.speak"));
            btn.title = speaking ? panelT("panel.modules.chat.tts.stop") : panelT("panel.modules.chat.tts.speak");
            btn.classList.toggle("chat-msg-action--speaking", speaking);
            btn._panelOrigAria = speaking ? panelT("panel.modules.chat.tts.stopSpeaking") : panelT("panel.modules.chat.tts.speak");
            btn._panelOrigTitle = speaking ? panelT("panel.modules.chat.tts.stop") : panelT("panel.modules.chat.tts.speak");
          });
        }

        refreshPanelTtsI18n = () => {
          syncPanelTtsButtons(panelTtsActiveBtn);
          document.querySelectorAll(".chat-msg-actions[role='toolbar']").forEach((raw) => {
            raw.setAttribute("aria-label", panelT("panel.modules.chat.bubbles.actionsAria"));
          });
          document.querySelectorAll("[data-panel-copy]").forEach((raw) => {
            const btn = /** @type {HTMLButtonElement} */ (raw);
            btn.title = panelT("panel.modules.chat.bubbles.copy");
            btn.setAttribute("aria-label", panelT("panel.modules.chat.bubbles.copy"));
          });
        };

        function panelStopSpeaking(btn) {
          try {
            if (window.speechSynthesis?.cancel) window.speechSynthesis.cancel();
          } catch {
            /* ignore */
          }
          panelTtsActiveBtn = null;
          syncPanelTtsButtons(null);
          if (btn) panelActionFlash(btn, panelT("panel.modules.chat.tts.stopped"), "ok");
        }

        /** @param {SpeechSynthesisVoice[] | null | undefined} [voicesIn] */
        function panelPickTrVoice(voicesIn) {
          try {
            const voices =
              voicesIn && voicesIn.length
                ? voicesIn
                : panelTtsVoicesCache && panelTtsVoicesCache.length
                  ? panelTtsVoicesCache
                  : window.speechSynthesis.getVoices();
            if (!voices || !voices.length) return null;
            const trLocal = voices.find((v) => v.lang === "tr-TR" && v.localService);
            if (trLocal) return trLocal;
            const trExact = voices.find((v) => v.lang === "tr-TR");
            if (trExact) return trExact;
            return voices.find((v) => (v.lang || "").toLowerCase().startsWith("tr")) || null;
          } catch {
            return null;
          }
        }

        function panelInitTtsVoiceCache() {
          if (!panelTtsSupported) return;
          try {
            const synth = window.speechSynthesis;
            const refresh = () => {
              const v = synth.getVoices();
              if (v && v.length) panelTtsVoicesCache = v;
            };
            refresh();
            synth.addEventListener("voiceschanged", refresh);
          } catch {
            /* ignore */
          }
        }

        /**
         * Must run synchronously inside the user click handler (WebKit gesture chain).
         * @param {HTMLButtonElement} btn
         * @param {string} text
         */
        function panelDoSpeak(btn, text) {
          try {
            const synth = window.speechSynthesis;
            const voices = synth.getVoices();
            if (voices && voices.length) panelTtsVoicesCache = voices;
            panelTtsDiag(btn, "voices count: " + (voices ? voices.length : 0));
            panelTtsDiag(btn, "voice/lang: default / tr-TR");
            const u = new SpeechSynthesisUtterance(text);
            u.lang = "tr-TR";
            u.onstart = () => {
              panelTtsDiag(btn, "onstart");
            };
            u.onend = () => {
              panelTtsDiag(btn, "onend");
              if (panelTtsActiveBtn === btn) {
                panelTtsActiveBtn = null;
                syncPanelTtsButtons(null);
              }
            };
            u.onerror = (ev) => {
              const errName = ev && "error" in ev && ev.error ? String(ev.error) : "unknown";
              panelTtsDiag(btn, "onerror: " + errName);
              if (panelTtsActiveBtn === btn) {
                panelTtsActiveBtn = null;
                syncPanelTtsButtons(null);
              }
              panelActionFlash(btn, panelT("panel.modules.chat.tts.failed"), "error");
            };
            panelTtsActiveBtn = btn;
            panelTtsDiag(btn, "speak called");
            synth.speak(u);
            if (synth.paused) synth.resume();
            syncPanelTtsButtons(btn);
          } catch {
            panelActionFlash(btn, panelT("panel.modules.chat.tts.error"), "error");
          }
        }

        function panelSpeakLumosBubble(wrap, btn) {
          panelTtsDiagReset(btn);
          panelTtsDiag(btn, "click received");
          if (!panelTtsSupported) {
            panelActionFlash(btn, panelT("panel.modules.chat.tts.unsupported"), "warn");
            return;
          }
          if (panelIsSpeaking()) {
            if (btn === panelTtsActiveBtn) {
              panelStopSpeaking(btn);
              return;
            }
            try {
              window.speechSynthesis.cancel();
            } catch {
              /* ignore */
            }
            panelTtsActiveBtn = null;
            syncPanelTtsButtons(null);
          }
          const body = wrap.querySelector(".chat-msg-body");
          const text = body ? lumosBodyToPlainText(body) : "";
          panelTtsDiag(btn, "text length: " + text.length);
          if (!text) {
            panelActionFlash(btn, panelT("panel.modules.chat.tts.empty"), "info");
            return;
          }
          panelDoSpeak(btn, text);
        }

        panelInitTtsVoiceCache();

        thread.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          const copyBtn = t.closest("button[data-panel-copy]");
          if (copyBtn instanceof HTMLButtonElement) {
            const wrap = copyBtn.closest(".chat-msg");
            if (!wrap) return;
            let kind = "lumos";
            if (wrap.classList.contains("chat-msg--user")) kind = "user";
            else if (wrap.classList.contains("chat-msg--error")) kind = "error";
            const text = panelBubblePlainText(wrap, kind);
            if (!text) {
              panelActionFlash(copyBtn, panelT("panel.modules.chat.bubbles.copyEmpty"), "info");
              return;
            }
            panelWriteTextToClipboard(text)
              .then(() => {
                panelActionFlash(copyBtn, panelT("panel.modules.chat.bubbles.copied"), "ok");
              })
              .catch(() => {
                panelActionFlash(copyBtn, panelT("panel.modules.chat.bubbles.copyFailed"), "error");
              });
            return;
          }
          const btn = t.closest("button[data-panel-tts]");
          if (!btn) return;
          const wrap = btn.closest(".chat-msg--lumos");
          if (!wrap) return;
          panelTtsDiag(btn, "click received");
          if (btn.disabled) {
            panelActionFlash(btn, panelT("panel.modules.chat.tts.unsupported"), "warn");
            return;
          }
          panelSpeakLumosBubble(wrap, btn);
        });

        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "hidden") {
            try {
              window.speechSynthesis?.cancel();
            } catch {
              /* ignore */
            }
            panelTtsActiveBtn = null;
            syncPanelTtsButtons(null);
          }
        });
        window.addEventListener("pagehide", () => {
          try {
            window.speechSynthesis?.cancel();
          } catch {
            /* ignore */
          }
          panelTtsActiveBtn = null;
          syncPanelTtsButtons(null);
        });

        /** Mevcut iplikten (yeni kullanıcı mesajı eklenmeden önce) son N mesajı role/content olarak döner. */
        function collectThreadHistory(threadEl) {
          const nodes = threadEl.querySelectorAll(".chat-msg");
          const items = [];
          for (const wrap of nodes) {
            let role;
            if (wrap.classList.contains("chat-msg--user")) role = "user";
            else if (wrap.classList.contains("chat-msg--lumos")) role = "assistant";
            else continue;
            const body = wrap.querySelector(".chat-msg-body");
            let text = "";
            if (role === "assistant" && body) {
              text = lumosBodyToPlainText(body);
            } else if (body && body.textContent) {
              text = body.textContent.trim();
            }
            if (!text) continue;
            items.push({ role, content: text });
          }
          if (items.length <= CHAT_HISTORY_LIMIT) return items;
          return items.slice(-CHAT_HISTORY_LIMIT);
        }

        const panelChatBubbleBodyRefreshers = new WeakMap();

        function appendBubble(kind, text, meta) {
          const turn = document.createElement("div");
          turn.className =
            "chat-turn " +
            (kind === "user" ? "chat-turn--user" : kind === "error" ? "chat-turn--error" : "chat-turn--lumos");

          const wrap = document.createElement("div");
          wrap.className =
            "chat-msg " +
            (kind === "user" ? "chat-msg--user" : kind === "error" ? "chat-msg--error" : "chat-msg--lumos");
          const role = document.createElement("span");
          role.className = "chat-msg-role";
          role.textContent = chatBubbleRoleLabel(kind);
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          if (kind === "lumos") {
            body.innerHTML = formatAssistantHtml(panelUserVisibleText(text));
          } else if (kind === "error") {
            body.textContent = panelUserVisibleText(text);
          } else {
            body.textContent = text;
          }
          if (meta && typeof meta === "object") {
            if (typeof meta.refreshBody === "function") {
              panelChatBubbleBodyRefreshers.set(wrap, meta.refreshBody);
            } else if (meta.errorKind) {
              wrap.setAttribute("data-panel-chat-error-kind", String(meta.errorKind));
            } else if (meta.i18nKey) {
              wrap.setAttribute("data-panel-bubble-i18n", String(meta.i18nKey));
              if (meta.i18nVars && typeof meta.i18nVars === "object") {
                wrap.setAttribute("data-panel-bubble-i18n-vars", JSON.stringify(meta.i18nVars));
              }
              if (meta.i18nSuffix != null) {
                wrap.setAttribute("data-panel-bubble-i18n-suffix", String(meta.i18nSuffix));
              }
            }
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          const actions = document.createElement("div");
          actions.className = "chat-msg-actions";
          actions.setAttribute("role", "toolbar");
          actions.setAttribute("aria-label", panelT("panel.modules.chat.bubbles.actionsAria"));
          actions.appendChild(createChatBubbleCopyButton());
          if (kind === "lumos") {
            const ttsBtn = document.createElement("button");
            ttsBtn.type = "button";
            ttsBtn.className = "chat-msg-action";
            ttsBtn.setAttribute("data-panel-tts", "");
            const speakIcon = document.createElement("span");
            speakIcon.className = "chat-msg-action__icon chat-msg-action__icon--speak";
            speakIcon.innerHTML = panelTtsIconMarkup("speak");
            const stopIcon = document.createElement("span");
            stopIcon.className = "chat-msg-action__icon chat-msg-action__icon--stop";
            stopIcon.innerHTML = panelTtsIconMarkup("stop");
            stopIcon.hidden = true;
            ttsBtn.appendChild(speakIcon);
            ttsBtn.appendChild(stopIcon);
            if (!panelTtsSupported) {
              ttsBtn.disabled = true;
              ttsBtn.setAttribute("aria-disabled", "true");
              ttsBtn.classList.add("chat-msg-action--unsupported");
              ttsBtn.title = panelT("panel.modules.chat.tts.unsupportedFeature");
              ttsBtn.setAttribute("aria-label", panelT("panel.modules.chat.tts.unsupportedFeature"));
            } else {
              ttsBtn.title = panelT("panel.modules.chat.tts.speak");
              ttsBtn.setAttribute("aria-label", panelT("panel.modules.chat.tts.speak"));
            }
            actions.appendChild(ttsBtn);
            const ttsDiag = document.createElement("span");
            ttsDiag.className = "chat-msg-tts-diag";
            ttsDiag.setAttribute("aria-live", "polite");
            if (panelTtsDiagEnabled) {
              ttsDiag.textContent = "TTS diag ready — click speaker";
              ttsDiag.hidden = false;
              panelTtsDiagState.set(ttsBtn, { el: ttsDiag, parts: ["TTS diag ready — click speaker"] });
            } else {
              ttsDiag.hidden = true;
            }
            actions.appendChild(ttsDiag);
          }
          wrap.appendChild(actions);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        /**
         * /chat: JSON gövdesi; isteğe bağlı küçük görsel base64 (tavan backend ile uyumlu).
         * Ham bayt tavanı 256 KiB — üzerinde yalnızca photo* metadata gider.
         */
        const PANEL_CHAT_IMAGE_INLINE_MAX_BYTES = 256 * 1024;

        /** Sunucunun `Buffer.from(b64, "base64")` uzunluğu ile aynı: ham bayt sayısı. */
        function decodedByteLengthFromBase64(b64) {
          if (!b64) return 0;
          let pad = 0;
          if (b64.endsWith("==")) pad = 2;
          else if (b64.endsWith("=")) pad = 1;
          return Math.floor((b64.length * 3) / 4) - pad;
        }

        /** Yerel önizleme (data URL); sunucuya ayrıca şartlara uygunsa imageData olarak gider. */
        function readFileAsDataUrl(file) {
          return new Promise((resolve, reject) => {
            const fr = new FileReader();
            fr.onload = () => resolve(String(fr.result || ""));
            fr.onerror = () => reject(new Error("read failed"));
            fr.readAsDataURL(file);
          });
        }

        /** data:image/...;base64, sonrası — tavan ve MIME image/ iken kullanılır. */
        function dataUrlToInlineBase64ForChat(dataUrl, file) {
          if (!dataUrl || !file || !/^image\//.test(file.type)) return null;
          if (file.size > PANEL_CHAT_IMAGE_INLINE_MAX_BYTES) return null;
          const marker = "base64,";
          const i = dataUrl.indexOf(marker);
          if (i < 0) return null;
          const b64 = dataUrl.slice(i + marker.length).replace(/\s/g, "");
          if (!b64) return null;
          if (decodedByteLengthFromBase64(b64) > PANEL_CHAT_IMAGE_INLINE_MAX_BYTES) return null;
          return b64;
        }

        /**
         * Orijinal dosyayı sıkıştırıp ham base64 (data: öneki yok) üretir; `PANEL_CHAT_IMAGE_INLINE_MAX_BYTES` altına indiremezse null.
         * null iken mevcut davranış: `photo*` metadata gider, `imageData` gönderilmez.
         */
        async function compressPhotoFileForChat(file) {
          if (!file || !/^image\//.test(file.type)) return null;
          const cap = PANEL_CHAT_IMAGE_INLINE_MAX_BYTES;
          const maxSide = 1024;

          let bmp;
          try {
            bmp = await createImageBitmap(file);
          } catch {
            return null;
          }

          const iw = bmp.width;
          const ih = bmp.height;
          if (!iw || !ih) {
            try {
              bmp.close();
            } catch {
              /* ignore */
            }
            return null;
          }

          const canvas = document.createElement("canvas");
          const ctx = canvas.getContext("2d");
          if (!ctx) {
            try {
              bmp.close();
            } catch {
              /* ignore */
            }
            return null;
          }

          let dimScale = Math.min(1, maxSide / Math.max(iw, ih));
          let quality = 0.7;
          const minQuality = 0.25;
          const maxAttempts = 28;

          for (let attempt = 0; attempt < maxAttempts; attempt++) {
            const w = Math.max(1, Math.round(iw * dimScale));
            const h = Math.max(1, Math.round(ih * dimScale));
            canvas.width = w;
            canvas.height = h;
            ctx.drawImage(bmp, 0, 0, w, h);

            const blob = await new Promise((resolve) => {
              canvas.toBlob((b) => resolve(b), "image/jpeg", quality);
            });
            if (blob && blob.size <= cap) {
              let b64 = "";
              try {
                b64 = await new Promise((resolve, reject) => {
                  const fr = new FileReader();
                  fr.onload = () => {
                    const s = String(fr.result || "");
                    const marker = "base64,";
                    const j = s.indexOf(marker);
                    resolve(j >= 0 ? s.slice(j + marker.length).replace(/\s/g, "") : "");
                  };
                  fr.onerror = () => reject(new Error("blob read"));
                  fr.readAsDataURL(blob);
                });
              } catch {
                b64 = "";
              }
              try {
                bmp.close();
              } catch {
                /* ignore */
              }
              /* blob.size = decode edilen JPEG baytı; backend tavanı ile aynı ölçü. */
              if (b64 && decodedByteLengthFromBase64(b64) <= cap) return b64;
              return null;
            }

            if (quality > minQuality) {
              quality = Math.max(minQuality, quality - 0.08);
            } else {
              dimScale *= 0.9;
              quality = 0.55;
            }
            if (Math.round(iw * dimScale) < 8 || Math.round(ih * dimScale) < 8) {
              try {
                bmp.close();
              } catch {
                /* ignore */
              }
              return null;
            }
          }

          try {
            bmp.close();
          } catch {
            /* ignore */
          }
          return null;
        }

        function formatFileSize(bytes) {
          if (typeof bytes !== "number" || !Number.isFinite(bytes) || bytes < 0) return null;
          if (bytes < 1024) return `${bytes} B`;
          if (bytes < 1024 * 1024) {
            const kb = bytes / 1024;
            return `${kb < 10 ? kb.toFixed(1) : Math.round(kb)} KB`;
          }
          const mb = bytes / (1024 * 1024);
          return `${mb < 10 ? mb.toFixed(1) : Math.round(mb)} MB`;
        }

        /** Kullanıcı balonu: düz metin, isteğe bağlı yerel görsel veya ses (sunucu ikili almaz). */
        function appendUserComposeBubble(
          plainText,
          imageDataUrl,
          audioObjectUrl,
          audioUploadMeta,
          audioBlob,
        ) {
          const turn = document.createElement("div");
          turn.className = "chat-turn chat-turn--user";
          const wrap = document.createElement("div");
          wrap.className = "chat-msg chat-msg--user";
