        btn.addEventListener("click", async () => {
          const file = input.files && input.files[0];
          if (!file) {
            setDosyalarHint(() => panelT("panel.modules.files.hints.pickFirst"));
            return;
          }
          dosyalarLastAudioFile = dosyalarIsAudioFile(
            dosyalarFileExtension(file.name),
            file.type,
          )
            ? file
            : null;
          hideHint();
          result.hidden = true;
          btn.disabled = true;
          btn.setAttribute("aria-busy", "true");
          const ext = dosyalarFileExtension(file.name);
          const relPath = dosyalarSafeUploadPath(file.name);
          try {
            let data = {
              ok: true,
              filename: file.name,
              size: file.size,
              kind: file.type || "application/octet-stream",
              extension: ext,
              summary: "",
              info: "",
              unsupported: "",
            };

            if (!DOSYALAR_READ_EXT.has(ext)) {
              data.unsupported = dosyalarUnsupportedMessage(ext, file.type);
              renderResult(data);
              pushDosyalarHistory(data);
              return;
            }

            if (file.size > CONTROLLED_MAX_WRITE_BYTES) {
              data.unsupported =
                panelT("panel.modules.files.hints.sizeLimitPrefix") +
                CONTROLLED_MAX_WRITE_BYTES +
                panelT("panel.modules.files.hints.sizeLimitSuffix");
              renderResult(data);
              pushDosyalarHistory(data);
              return;
            }

            let textContent = "";
            try {
              textContent = await readBlobAsUtf8(file);
            } catch {
              setDosyalarHint(() => panelT("panel.modules.files.hints.readFailed"));
              return;
            }

            const w = await controlledWriteFile(relPath, textContent);
            if (!w.ok) {
              if (taskBridgeBlockedResponse(w.status)) {
                const bridgeHint = bridgeBlockedUserHint();
                if (bridgeHint) setDosyalarHint(() => panelUserVisibleText(bridgeHint));
                return;
              }
              const err =
                w.data && w.data.error != null
                  ? String(w.data.error)
                  : "write_file başarısız";
              const writeErrCtx = {
                rawError: err,
                httpStatus: w.status,
              };
              setDosyalarHint(() => panelProdErrorUserMessage(writeErrCtx));
              return;
            }

            const rd = await controlledReadFile(relPath);
            if (!rd.ok) {
              if (taskBridgeBlockedResponse(rd.status)) {
                const bridgeHint = bridgeBlockedUserHint();
                if (bridgeHint) setDosyalarHint(() => panelUserVisibleText(bridgeHint));
                return;
              }
              const err =
                rd.data && rd.data.error != null
                  ? String(rd.data.error)
                  : "read_file başarısız";
              const readErrCtx = {
                rawError: err,
                httpStatus: rd.status,
              };
              setDosyalarHint(() => panelProdErrorUserMessage(readErrCtx));
              return;
            }

            const readBack =
              rd.data && rd.data.content != null ? String(rd.data.content) : "";
            data.summary = dosyalarClientSummary(readBack, ext);
            data.info = dosyalarInfoMessageForExt(ext);
            renderResult(data);
            pushDosyalarHistory(data);
          } catch {
            setDosyalarHint(() => panelT("panel.modules.files.hints.unreachable"));
          } finally {
            btn.disabled = false;
            btn.removeAttribute("aria-busy");
          }
        });

        renderDosyalarHistory();
        refreshDosyalarPanelI18n = () => {
          renderDosyalarHistory();
          if (dosyalarLastSnapshot && !result.hidden) {
            renderResult(dosyalarLastSnapshot);
          }
          refreshDosyalarVisibleHintI18n();
        };
      }

      function wireCapabilityProbe() {
        const btn = document.getElementById("lumos-capability-test-btn");
        const hint = document.getElementById("lumos-capability-hint");
        const caps = {
          fileRead: document.getElementById("cap-file-read"),
          fileWrite: document.getElementById("cap-file-write"),
          taskCreate: document.getElementById("cap-task-create"),
          taskComplete: document.getElementById("cap-task-complete"),
        };
        if (!btn) return;

        function capKeyFromProbe(ok, limited) {
          if (ok) return limited ? "aktif" : "aktif";
          return "pasif";
        }

        btn.addEventListener("click", async () => {
          if (hint) {
            hint.hidden = false;
            hint.textContent = panelUserVisibleText(panelT("panel.modules.capabilities.testRunning"));
          }
          btn.disabled = true;
          const probePath = "capability/_probe.txt";
          const probeBody = "lumos capability probe\n";

          const w = await controlledWriteFile(probePath, probeBody);
          setCap(caps.fileWrite, capKeyFromProbe(w.ok, false));

          const rd = await controlledReadFile(probePath);
          const readOk =
            rd.ok &&
            String((rd.data && rd.data.content) || "").indexOf("lumos capability") >= 0;
          setCap(caps.fileRead, capKeyFromProbe(readOk, false));
          const controlledBridgeBlocked =
            taskBridgeBlockedResponse(w.status) || taskBridgeBlockedResponse(rd.status);

          let taskOk = false;
          try {
            const r = await fetch(TASK_BRIDGE_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                goal: "lumos capability probe",
                source: "panel_capability_test",
              }),
            });
            taskOk = r.ok && !taskBridgeBlockedResponse(r.status);
          } catch {
            taskOk = false;
          }
          setCap(caps.taskCreate, capKeyFromProbe(taskOk, false));

          const localComplete =
            typeof panelGorevlerTasks !== "undefined" && Array.isArray(panelGorevlerTasks);
          setCap(caps.taskComplete, localComplete ? "aktif" : "pasif");

          if (hint) {
            const blockedHint = controlledBridgeBlocked ? bridgeBlockedUserHint() : "";
            hint.textContent = panelUserVisibleText(
              controlledBridgeBlocked
                ? blockedHint ||
                  panelDebugText(
                    "Köprü yapılandırılmamış veya erişilemiyor.",
                    panelT("panel.modules.capabilities.testBridgeUnavailable"),
                  )
                : w.ok && readOk && taskOk
                  ? panelDebugText(
                      "Köprü kanıtı doğrulandı. 4–7. satırlar politika özetidir.",
                      panelT("panel.modules.capabilities.testDone"),
                    )
                  : panelDebugText(
                      "Kısmi veya başarısız sonuç; köprü adresini ve bağlantı bilgisini kontrol edin.",
                      panelT("panel.modules.capabilities.testPartialFailed"),
                    ),
            );
          }
          btn.disabled = false;
        });
      }

