        const PANEL_CHAT_LOG_MAX = 8000;
        function truncatePanelChatLog(s) {
          const t = s == null ? "" : String(s);
          if (t.length <= PANEL_CHAT_LOG_MAX) return t;
          return (
            t.slice(0, PANEL_CHAT_LOG_MAX)
            + "\n"
            + panelT("panel.modules.chat.log.charsRemaining").replace(
              "{n}",
