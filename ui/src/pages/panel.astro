              <h1 data-i18n="panel.header.title">ChatLumos</h1>
              <p class="panel-header-tagline" data-i18n="panel.header.subtitle">Sohbet ve görevler tek yerde</p>
            </div>
          </div>
          <div class="panel-health-row">
            <div id="panel-auth-slot" class="panel-auth-slot" data-state="loading" aria-live="polite">
              <a
                id="panel-auth-login"
                class="panel-auth-login"
                href="/auth/google/start"
                data-i18n="panel.shell.auth.login"
                hidden
              >Google ile Giriş</a>
              <div id="panel-auth-user" class="panel-auth-user" hidden>
                <img id="panel-auth-avatar" class="panel-auth-avatar" alt="" width="28" height="28" decoding="async" hidden />
                <span
                  id="panel-auth-session"
                  class="panel-auth-session"
                  data-state="secure"
                  hidden
                  title="Google / Apple ile güvenli oturum açık"
                  aria-label="Güvenli oturum"
                >Güvenli oturum</span>

                <span id="panel-auth-name" class="panel-auth-name"></span>
                <button
                  type="button"
                  id="panel-auth-logout"
                  class="panel-auth-logout"
                  data-i18n="panel.shell.auth.logout"
                >Çıkış Yap</button>
              </div>
            </div>
            <div class="panel-user-mode-wrap">
              <button
                type="button"
                id="panel-user-mode-badge"
                class="panel-user-mode-badge"
                data-mode="limited"
                aria-live="polite"
                data-i18n-aria-label="panel.shell.userMode.badgeAria"
                data-i18n-title="panel.shell.userMode.badgeTitle"
                aria-label="Kullanıcı modu seç"
                title="Mod değiştir (Offline, Sınırlı, Tam)"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-controls="panel-user-mode-menu"
              >Mod · Sınırlı</button>
              <div
                id="panel-user-mode-menu"
                class="panel-user-mode-menu"
                role="menu"
                hidden
                data-i18n-aria-label="panel.shell.userMode.menuAria"
                aria-label="Mod seçimi"
              >
                <button
                  type="button"
                  class="panel-user-mode-menu__item"
                  role="menuitemradio"
                  data-mode="offline"
                  aria-checked="false"
                >
                  <span class="panel-user-mode-menu__label" data-i18n="panel.shell.userMode.menuOffline">Offline</span>
                  <span class="panel-user-mode-menu__check" aria-hidden="true">✓</span>
                </button>
                <button
                  type="button"
                  class="panel-user-mode-menu__item"
                  role="menuitemradio"
                  data-mode="limited"
                  aria-checked="true"
                >
                  <span class="panel-user-mode-menu__label" data-i18n="panel.shell.userMode.menuLimited">Sınırlı</span>
                  <span class="panel-user-mode-menu__check" aria-hidden="true">✓</span>
                </button>
                <button
                  type="button"
                  class="panel-user-mode-menu__item"
                  role="menuitemradio"
                  data-mode="full"
                  aria-checked="false"
                >
                  <span class="panel-user-mode-menu__label" data-i18n="panel.shell.userMode.menuFull">Tam</span>
                  <span class="panel-user-mode-menu__check" aria-hidden="true">✓</span>
                </button>
              </div>
            </div>
            <span
              id="panel-conn-badge"
              class="panel-conn-badge"
              data-state="pending"
              role="status"
              aria-live="polite"
              data-i18n-aria-label="panel.shell.conn.ariaLabel"
