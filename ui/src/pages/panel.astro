    <script define:vars={{ CHAT_URL, kandoToken, UPLOAD_URL, HEALTH_URL, BRIDGE_BASE_URL, STATUS_URL, TASKS_API_URL, PANEL_DEBUG }}>
      /** Görevler: panel_tasks_server → .lumos/tasks.json; localStorage önbellek (görev eklerken köprü yok). */
      const PANEL_GOREVLER_LS_KEY = "lumos_panel_gorevler_list_v1";
      const GOREVLER_FIELD_MAX_LEN = 2048;
      const bridgeTokenMissing = !PANEL_DEBUG && !String(kandoToken || "").trim();
      const BRIDGE_TOKEN_MSG =
        "Panel bağlantısı yapılandırılmamış. Köprü ve pano işlemleri bu ortamda devre dışı; cihaz yöneticinizden bağlantı anahtarını tanımlamasını isteyin.";
      /** Phase 1: görev köprüsü same-origin proxy; tarayıcı token taşımaz. */
      const TASK_BRIDGE_URL = "/api/bridge/task";
      /** Phase 2: medya outbox (last-result) same-origin proxy; tarayıcı token taşımaz. */
      const LAST_RESULT_BRIDGE_URL = "/api/bridge/last-result";
      /** Phase 2: kontrollü dosya köprüsü same-origin proxy; tarayıcı token taşımaz. */
      const CONTROLLED_BRIDGE_URL = "/api/bridge/controlled";

      function bridgeOpsBlocked() {
        return bridgeTokenMissing;
      }

      const BRIDGE_BADGE_LIMITED_LABEL = "Sınırlı mod";
      const CHAT_EMPTY_LIMITED_TEXT = "Sınırlı mod · Yerel işlemler kullanılabilir";
      const CHAT_EMPTY_LIMITED_SUBTEXT =
        "Yerel görevler kullanılabilir; dış köprü gerektiren işlemler beklemede.";
      const SEND_LIMITED_HINT =
        "Sınırlı mod: dış sohbet köprüsü yok; yerel yanıtlar ve görev komutları kullanılabilir.";
      const PANEL_LIMITED_PHOTO_REPLY =
        "Sınırlı modda fotoğraf analizi yapılamaz; dış görsel API köprüsü bağlı değil.";
      const CAP_LIMITED_NOTE = "Köprü bağlantısı bekleniyor.";
      const KISITLI_CAP_IDS = ["cap-file-read", "cap-file-write", "cap-task-create", "cap-live-deploy", "cap-terminal"];

      const CAP_STATUS = {
        aktif: { label: "AKTİF", state: "ok" },
        pasif: { label: "PASİF", state: "no" },
        kisitli: { label: "KISITLI", state: "kisitli" },
        gelistirme: { label: "GELİŞTİRME AŞAMASINDA", state: "hedef" },
      };

      function setCap(el, key) {
        if (!el) return;
        const row = CAP_STATUS[key];
        if (!row) return;
        el.textContent = row.label;
        el.setAttribute("data-state", row.state);
      }

      function applyBridgeLimitedUi() {
        if (!bridgeOpsBlocked()) return;
        const chatEmptyText = document.querySelector(".chat-empty-hint__text");
        if (chatEmptyText) chatEmptyText.textContent = CHAT_EMPTY_LIMITED_TEXT;
        const chatEmptySub = document.getElementById("chat-empty-limited-sub");
        if (chatEmptySub) {
          chatEmptySub.textContent = CHAT_EMPTY_LIMITED_SUBTEXT;
          chatEmptySub.hidden = false;
        }
        const sendLimitedHint = document.getElementById("panel-send-limited-hint");
        if (sendLimitedHint) {
          sendLimitedHint.textContent = SEND_LIMITED_HINT;
          sendLimitedHint.hidden = false;
        }
        const emptySecretNote = document.getElementById("panel-empty-secret-note");
        if (emptySecretNote) emptySecretNote.hidden = true;
        for (const id of KISITLI_CAP_IDS) {
          setCap(document.getElementById(id), "kisitli");
          const note = document.querySelector('[data-cap-note-for="' + id + '"]');
          if (note) {
            note.textContent = CAP_LIMITED_NOTE;
            note.hidden = false;
          }
        }
        setCap(document.getElementById("cap-task-complete"), "aktif");
      }

      /** Rozet zaten köprü kapalı durumunu gösteriyorsa uzun BRIDGE_TOKEN_MSG tekrarlanmasın. */
      function shouldSuppressBridgeHint() {
        return bridgeOpsBlocked();
      }

      function bridgeBlockedUserHint() {
        return shouldSuppressBridgeHint() ? "" : BRIDGE_TOKEN_MSG;
      }

      function taskBridgeBlockedResponse(status) {
        return status === 503;
      }

      function maskBridgeSensitive(text) {
        if (text == null) return "";
        let s = String(text);
        s = s.replace(
          /("(?:token|api[_-]?key|secret|password|bearer|cookie|session|authorization|x-kando-token)"\s*:\s*")([^"]+)(")/gi,
          "$1***$3",
        );
        s = s.replace(
          /\b(Bearer|Token|ApiKey|API-Key|Password|Secret|Cookie|Session|Authorization)\s*[:=]\s*\S+/gi,
          "$1: ***",
        );
        s = s.replace(/\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b/g, "***");
        s = s.replace(/\b[a-f0-9]{32,}\b/gi, "***");
        s = s.replace(/\bX-Kando-Token\s*[:=]\s*\S+/gi, "Bağlantı: ***");
        return s;
      }

      function stripPanelTechnicalLeak(text) {
        if (PANEL_DEBUG || text == null) return text == null ? "" : String(text);
        let s = String(text);
        s = s.replace(/\bX-Kando-Token\b/gi, "bağlantı anahtarı");
        s = s.replace(/\b(?:Kando|Cando)\b/gi, "Lumos");
        s = s.replace(/\bajan\b/gi, "cihaz");
        s = s.replace(/\bagent\b/gi, "cihaz");
        s = s.replace(/\b(?:PUBLIC\s+)?token\b/gi, "bağlantı bilgisi");
        s = s.replace(/\bendpoint\b/gi, "bağlantı");
        s = s.replace(/\broute\b/gi, "yol");
        s = s.replace(/\bbridge\b/gi, "bağlantı");
        s = s.replace(/\bk[öo]pr[üu]\b/gi, "iletim");
        s = s.replace(/127\.0\.0\.1(?::\d+)?/gi, "yerel sunucu");
        s = s.replace(/https?:\/\/[^\s)]+/gi, "bağlantı");
        s = s.replace(/\/last-result/gi, "son sonuç");
        s = s.replace(/\.lumos\/tasks\.json/gi, "görev kaydı");
        s = s.replace(/\/tasks\b/gi, "görev");
        s = s.replace(/\/controlled\b/gi, "kontrollü dosya");
        s = s.replace(/\/task\b/gi, "görev");
        s = s.replace(/\/status\b/gi, "durum");
        s = s.replace(/\/health\b/gi, "sağlık");
        s = s.replace(/\/chat\b/gi, "sohbet");
        s = s.replace(/\b(GET|POST|PUT|DELETE|OPTIONS)\b/gi, "");
        s = s.replace(/\bHTTP\s+\d+\b/gi, "istek hatası");
        s = s.replace(/panel_tasks_server/gi, "görev servisi");
        s = s.replace(/bridge_start\.sh/gi, "bağlantı başlatma");
        s = s.replace(/\bcomplete_failed\b/gi, "kayıt tamamlanamadı");
        s = s.replace(/\bcreate_failed\b/gi, "kayıt başarısız");
        s = s.replace(/\bdelete_failed\b/gi, "silme başarısız");
        s = s.replace(/\brestore_failed\b/gi, "geri alma başarısız");
        s = s.replace(/\bCORS\b/gi, "tarayıcı kısıtı");
        s = s.replace(/:\d{4,5}\b/g, "");
        s = s.replace(/\s{2,}/g, " ").trim();
        return s;
      }

      function panelUserVisibleText(text) {
        return stripPanelTechnicalLeak(maskBridgeSensitive(text));
      }

      function panelDebugText(debugMsg, userMsg) {
        return PANEL_DEBUG ? debugMsg : userMsg;
      }

      function dataFlowBadge(kind) {
        if (kind === "local") return "[Yerel]";
        if (kind === "external") return "[Harici Servis]";
        return "[Bilinmiyor]";
      }

      function truncateGorevlerField(s) {
        const t = String(s || "").trim();
        if (!t) return "";
        return t.length > GOREVLER_FIELD_MAX_LEN
          ? t.slice(0, GOREVLER_FIELD_MAX_LEN) + "…"
          : t;
      }

      function sanitizeBridgeLast(bl) {
        if (!bl || typeof bl !== "object") return null;
        const src = /** @type {Record<string, unknown>} */ (bl);
        const isoRaw = String(
          src.lastBridgeAt != null ? src.lastBridgeAt : src.last_bridge_at != null ? src.last_bridge_at : "",
        ).trim();
        const isoOk = isoRaw && !Number.isNaN(Date.parse(isoRaw));
        const out = {};
        if (isoOk) out.lastBridgeAt = isoRaw;
        for (const k of ["route", "source"]) {
          const raw = src[k];
          const v = truncateGorevlerField(raw != null ? String(raw) : "");
          if (v) out[k] = v;
        }
        for (const [outKey, aliases] of [
          ["result_file", ["result_file", "resultFile"]],
          ["execution_file", ["execution_file", "executionFile"]],
        ]) {
          let raw = null;
          for (const a of aliases) {
            if (src[a] != null && String(src[a]).trim()) {
              raw = src[a];
              break;
            }
          }
          const v = truncateGorevlerField(raw != null ? String(raw) : "");
          if (v) out[outKey] = v;
        }
        if (src.accepted === true || src.accepted === false) out.accepted = src.accepted;
        const has =
          !!out.lastBridgeAt ||
          !!out.route ||
          !!out.source ||
          !!out.result_file ||
          !!out.execution_file ||
          out.accepted !== undefined;
        return has ? out : null;
      }

      function sanitizeGorevlerRow(x) {
        if (!x || typeof x !== "object") return null;
        const title = String(x.title || "").trim();
        if (!title) return null;
        const pr = ["dusuk", "orta", "yuksek"].includes(x.priority) ? x.priority : "orta";
        const st = ["bekliyor", "onay_bekliyor", "tamamlandi"].includes(x.status) ? x.status : "bekliyor";
        const row = { title, priority: pr, status: st };
        const w = x.when != null ? String(x.when).trim() : "";
        if (w) row.when = w;
        const bridge = sanitizeBridgeLast(x.bridgeLast);
        if (bridge) row.bridgeLast = bridge;
        const id = x.id != null ? String(x.id).trim() : "";
        if (id) row.id = id;
        const plan = sanitizeGorevlerTaskPlan(x.taskPlan);
        if (plan) row.taskPlan = plan;
        return row;
      }

      /** Görev planı (Faz A): localStorage ile görev satırında saklanır. */
      function sanitizeGorevlerTaskPlan(raw) {
        if (!raw || typeof raw !== "object") return null;
        const src = /** @type {Record<string, unknown>} */ (raw);
        const tur = truncateGorevlerField(src.tur);
        const risk = truncateGorevlerField(src.risk);
        const onerilenAlan = truncateGorevlerField(
          src.onerilenAlan != null ? src.onerilenAlan : src.onerilen_alan,
        );
        const sonrakiAdim = truncateGorevlerField(
          src.sonrakiAdim != null ? src.sonrakiAdim : src.sonraki_adim,
        );
        if (!tur && !risk && !onerilenAlan && !sonrakiAdim) return null;
        const out = {
          tur: tur || "Genel görev",
          risk: risk || "Düşük",
          onerilenAlan: onerilenAlan || "Görevler",
          sonrakiAdim: sonrakiAdim || "Listeden görevi aç ve bak.",
          active: src.active !== false,
        };
        const onayDurumu =
          src.onayDurumu != null
            ? truncateGorevlerField(src.onayDurumu)
            : src.onay_durumu != null
              ? truncateGorevlerField(src.onay_durumu)
              : "";
        if (onayDurumu) out.onayDurumu = onayDurumu;
        return out;
      }

      /**
       * Kural tabanlı plan: dosya → Görevler → Köprü → UI → Genel.
       * @param {string} title
       */
      function generateGorevlerTaskPlan(title) {
        const hay = canonicalizeTaskInput(title);
        let tur = "Genel görev";
        let risk = "Düşük";
        let onerilenAlan = "Görevler";
        let sonrakiAdim = "Listeden görevi aç ve bak.";

        if (/\b(dosya|dosyalar|upload|exe|pdf|docx)\b/.test(hay)) {
          tur = "Dosya işlemi";
          onerilenAlan = "Dosyalar";
          sonrakiAdim = "Dosyalar'da yükle veya önizle.";
          if (/\bexe\b/.test(hay)) risk = "Orta";
        } else if (/\b(görev|task|tamamla|sil|geri al)\b/.test(hay)) {
          tur = "Görev listesi";
          onerilenAlan = "Görevler";
          sonrakiAdim = "Listede durumu güncelle veya tamamla.";
          if (/\b(sil|geri al)\b/.test(hay)) risk = "Orta";
        } else if (/\b(bridge|köprü|kopru|koprü|controlled)\b/.test(hay)) {
          tur = "İletim";
          onerilenAlan = "İletim";
          sonrakiAdim = "Detayda iletim yanıtına bak. Onay işlem çalıştırmaz.";
          risk = "Orta";
        } else if (/\b(panel|görsel|gorsel|metin|uyarı|uyari)\b/.test(hay)) {
          tur = "Metin";
          onerilenAlan = "Panel";
          sonrakiAdim = "Panel metnini düzenle.";
        }

        return { tur, risk, onerilenAlan, sonrakiAdim, active: true };
      }

      /** Liste satırı için kısa plan özeti. */
      function formatGorevlerPlanListSummary(plan) {
        const p = sanitizeGorevlerTaskPlan(plan);
        if (!p || !p.active) return "";
        const onay =
          p.onayDurumu != null && String(p.onayDurumu).trim()
            ? " · " + String(p.onayDurumu).trim()
            : "";
        return "Plan: " + p.tur + " · " + p.risk + onay;
      }

      /** Başarılı kayıttan sonra göreve plan ekler ve localStorage’a yazar. */
      function attachGorevlerTaskPlan(taskRow, title) {
        if (!taskRow) return null;
        const plan = generateGorevlerTaskPlan(title);
        taskRow.taskPlan = plan;
        persistPanelGorevlerTasks();
        return plan;
      }

      /** Motor görevi → panel satırı (`tasks.json`: active|done). */
      function engineTaskToPanelRow(t) {
        if (!t || typeof t !== "object") return null;
        const title = String(t.title || "").trim();
        if (!title) return null;
        const st = String(t.status || "active");
        let status = "bekliyor";
        if (st === "done") status = "tamamlandi";
        const row = { title, priority: "orta", status };
        const id = String(t.id || "").trim();
        if (id) row.id = id;
        const when = t.completedAt || t.createdAt;
        if (when) row.when = String(when);
        return row;
      }

      function mergePanelGorevlerMetaFromPrevious(nextRows) {
        const prev = panelGorevlerTasks;
        const byId = new Map();
        const byTitle = new Map();
        for (let i = 0; i < prev.length; i++) {
          const r = prev[i];
          if (!r) continue;
          if (r.id) byId.set(String(r.id), r);
          if (r.title) byTitle.set(String(r.title).trim().toLowerCase(), r);
        }
        for (let i = 0; i < nextRows.length; i++) {
          const r = nextRows[i];
          const old =
            (r.id && byId.get(String(r.id))) ||
            (r.title && byTitle.get(String(r.title).trim().toLowerCase()));
          if (!old) continue;
          if (old.priority && ["dusuk", "orta", "yuksek"].includes(old.priority)) {
            r.priority = old.priority;
          }
          if (old.status === "onay_bekliyor" && r.status === "bekliyor") {
            r.status = "onay_bekliyor";
          }
          const bl = sanitizeBridgeLast(old.bridgeLast);
          if (bl) r.bridgeLast = bl;
          const tp = sanitizeGorevlerTaskPlan(old.taskPlan);
          if (tp) r.taskPlan = tp;
        }
      }

      function resolveGorevlerTasksApiBase() {
        const w = typeof window !== "undefined" ? window : null;
        if (w && w.LUMOS_PANEL_TASKS_API_BASE === false) return "";
        if (w && w.LUMOS_PANEL_TASKS_API_BASE != null && String(w.LUMOS_PANEL_TASKS_API_BASE).trim()) {
          return String(w.LUMOS_PANEL_TASKS_API_BASE).replace(/\/$/, "");
        }
        const fromBuild = String(TASKS_API_URL || "").replace(/\/$/, "");
        if (fromBuild) return fromBuild;
        try {
          const loc = w && w.location;
          if (loc && /^https?:$/i.test(String(loc.protocol || ""))) {
            return String(loc.origin || "").replace(/\/$/, "");
          }
        } catch (_) {
          /* ignore */
        }
        return "http://127.0.0.1:8766";
      }

      function isLoopbackHostname(host) {
        const h = String(host || "")
          .trim()
          .toLowerCase()
          .replace(/^\[|\]$/g, "");
        if (!h) return false;
        return h === "localhost" || h === "127.0.0.1" || h === "::1" || h.endsWith(".localhost");
      }

      function isTasksApiLoopbackBase(base) {
        const b = String(base || "").trim();
        if (!b) return false;
        try {
          const u = new URL(b);
          return isLoopbackHostname(u.hostname);
        } catch {
          return /^(https?:\/\/)?(127\.0\.0\.1|localhost)(:|\/|$)/i.test(b);
        }
      }

      function isPanelOnNonLoopbackHost() {
        try {
          const w = typeof window !== "undefined" ? window : null;
          const host = w && w.location && w.location.hostname;
          if (!host) return false;
          return !isLoopbackHostname(host);
        } catch {
          return false;
        }
      }

      /** Prod panel + loopback API URL: tarayıcı erişemez; yerel yol tercih edilir. */
      function shouldSkipGorevlerTasksApi() {
        const base = resolveGorevlerTasksApiBase();
        if (!base) return true;
        return isPanelOnNonLoopbackHost() && isTasksApiLoopbackBase(base);
      }

      function shouldFallbackGorevlerTasksLocal(apiUnreachable) {
        if (shouldSkipGorevlerTasksApi()) return true;
        return !!apiUnreachable;
      }

      async function tasksApiPost(path, body) {
        const base = resolveGorevlerTasksApiBase();
        if (!base) throw new Error("tasks_api_disabled");
        const p = path.charAt(0) === "/" ? path : "/" + path;
        const r = await fetch(`${base}${p}`, {
          method: "POST",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          body: JSON.stringify(body != null ? body : {}),
        });
        let data = null;
        try {
          data = await r.json();
        } catch {
          data = null;
        }
        return { ok: r.ok, status: r.status, data };
      }

      async function refreshPanelGorevlerFromTasksApi() {
        const base = resolveGorevlerTasksApiBase();
        if (!base) return false;
        try {
          const r = await fetch(`${base}/tasks`, {
            headers: { Accept: "application/json" },
          });
          if (!r.ok) return false;
          const doc = await r.json();
          if (!doc || !Array.isArray(doc.tasks)) return false;
          const next = [];
          for (let i = 0; i < doc.tasks.length; i++) {
            const t = doc.tasks[i];
            if (!t || typeof t !== "object") continue;
            if (String(t.status || "") === "deleted") continue;
            const row = engineTaskToPanelRow(t);
            if (row) next.push(row);
          }
          mergePanelGorevlerMetaFromPrevious(next);
          panelGorevlerTasks.length = 0;
          panelGorevlerTasks.push(...next);
          persistPanelGorevlerTasks();
          if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
          return true;
        } catch {
          return false;
        }
      }

      function loadPanelGorevlerTasksFromStorage() {
        try {
          if (typeof localStorage === "undefined") return undefined;
          const raw = localStorage.getItem(PANEL_GOREVLER_LS_KEY);
          if (raw == null || raw === "") return undefined;
          const a = JSON.parse(raw);
          if (!Array.isArray(a)) return [];
          const out = [];
          for (let i = 0; i < a.length; i++) {
            const r = sanitizeGorevlerRow(a[i]);
            if (r) out.push(r);
          }
          return out;
        } catch {
          return [];
        }
      }

      function persistPanelGorevlerTasks() {
        try {
          if (typeof localStorage === "undefined") return;
          localStorage.setItem(PANEL_GOREVLER_LS_KEY, JSON.stringify(panelGorevlerTasks));
        } catch (_) {
          /* kota / gizli mod */
        }
      }

      let panelGorevlerTasks = [];

      let panelGorevlerTasksRender = null;

      /** @typedef {{ title: string, whenSummary: string | null }} PanelGorevKomut */

      function pad2(n) {
        const x = String(Number(n));
        return x.length >= 2 ? x : "0" + x;
      }

      /** Kullanıcı yazımı: gorev/yarain/saar vb. — ayrıştırmadan önce tek satırda düzeltir. */
      function normalizeUserTaskMessage(s) {
        return String(s || "")
          .replace(/\bgorev\b/gi, "görev")
          .replace(/\bolustur\b/gi, "oluştur")
          .replace(/\byarain\b/gi, "yarın")
          .replace(/\byarin\b/gi, "yarın")
          .replace(/\bsaar\b/gi, "saat")
          .replace(/\bbugun\b/gi, "bugün");
      }

      /** Lumos metninden Görev:/Tarih:/Saat: satırları (ekleyemiyorum densene çalışır). */
      function parsePanelGorevFromAssistantReply(raw) {
        const t = String(raw || "")
          .replace(/\*\*/g, "")
          .replace(/\r\n/g, "\n")
          .trim();
        if (!t) return null;
        const g = /(?:^|\n)\s*Görev\s*:\s*([^\n]+)/i.exec(t);
        if (!g) return null;
        const title = g[1].trim().replace(/^>\s*/, "");
        if (!title) return null;
        const parts = [];
        const d = /(?:^|\n)\s*Tarih\s*:\s*([^\n]+)/i.exec(t);
        if (d) {
          const dl = d[1].trim().toLocaleLowerCase("tr-TR");
          if (/\byarın\b|\byarin\b|\byarain\b/.test(dl)) parts.push("Yarın");
          else if (/\bbugün\b|\bbugun\b/.test(dl)) parts.push("Bugün");
          else if (d[1].trim()) parts.push(d[1].trim());
        }
        const st = /(?:^|\n)\s*Saat\s*:\s*([^\n]+)/i.exec(t);
        if (st) {
          const sx = st[1].trim();
          const tm = /^(\d{1,2})(?:\s*[:.]\s*(\d{2}))?$/.exec(sx);
          if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
          else parts.push(sx);
        }
        const whenSummary = parts.length ? parts.join(" ") : null;
        return { title, whenSummary };
      }

      function panelGorevRowExists(title, whenSummary) {
        const w = whenSummary || null;
        return panelGorevlerTasks.some((x) => x.title === title && (x.when || null) === w);
      }

      /**
       * Onay sorusu / dış uygulama uyarısı içeren Lumos metninden mini görev başlığı.
       * Örn: Mini görev olarak 'tiss' eklemek istiyorsun, doğru mu?
       */
      function parsePanelGorevLooseFromAssistant(raw) {
        const t = String(raw || "").replace(/\*\*/g, "").replace(/\r\n/g, "\n");
        const m =
          /mini\s+görev\s+olarak\s+['"'‘’«\u201c](.+?)['"'‘’»\u201d]/i.exec(t);
        if (!m) return null;
        const title = m[1].trim();
        return title ? { title, whenSummary: null, replyKind: "mini" } : null;
      }

      /** Asistan cevabından yerel listeye aktarır; mini onay cümlelerinde sohbet metnini kısaltır. */
      function ingestAssistantPanelGorev(replyBody) {
        let cmd = parsePanelGorevFromAssistantReply(replyBody);
        if (cmd) {
          const w = cmd.whenSummary || null;
          if (!panelGorevRowExists(cmd.title, w)) applyPanelGorevKomutu(cmd);
          return { lumosText: String(replyBody || "").trim() };
        }
        const loose = parsePanelGorevLooseFromAssistant(replyBody);
        if (loose) {
          const w = loose.whenSummary || null;
          if (!panelGorevRowExists(loose.title, w)) {
            applyPanelGorevKomutu({ title: loose.title, whenSummary: loose.whenSummary || null });
          }
          if (loose.replyKind === "mini") {
            return { lumosText: `Mini görev eklendi: ${loose.title}` };
          }
        }
        return { lumosText: String(replyBody || "").trim() };
      }

      /**
       * "görev oluştur …" kuyruğundan başlık + Yarın 14:00 benzeri özet (yarain/saar toleranslı).
       */
      function parseOlusturRest(restRaw) {
        const rest = normalizeUserTaskMessage(String(restRaw || "").trim());
        if (!rest) return { title: "", whenSummary: null };
        const parts = [];
        if (/\byarın\b/i.test(rest)) parts.push("Yarın");
        else if (/\bbugün\b/i.test(rest)) parts.push("Bugün");
        const tm = /\bsaat\s*(\d{1,2})(?:\s*[:.]\s*(\d{2}))?\b/i.exec(rest);
        if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
        let titleWork = rest
          .replace(/\byarın\b/gi, " ")
          .replace(/\bbugün\b/gi, " ")
          .replace(/\bsaat\s*\d{1,2}(?:\s*[:.]\s*\d{2})?\b/gi, " ")
          .replace(/\s+/g, " ")
          .trim();
        if (!titleWork) titleWork = normalizeUserTaskMessage(String(restRaw || "").trim());
        const whenSummary = parts.length ? parts.join(" ") : null;
        return { title: titleWork, whenSummary };
      }

      /**
       * "yarın saat 14:00" / "bugün 09:30" vb. önekten görünen özet üretir (chat + liste).
       */
      function parseSchedulePrefix(prefixRaw) {
        const prefix = normalizeUserTaskMessage(String(prefixRaw || "").trim());
        if (!prefix) return { whenSummary: null };
        const pl = prefix.toLocaleLowerCase("tr-TR");
        const parts = [];
        if (/\byarın\b|\byarain\b|\byarin\b/i.test(prefix)) parts.push("Yarın");
        else if (/\bbugün\b|\bbugun\b/i.test(prefix)) parts.push("Bugün");
        const tm = /(?:saat\s*)?(\d{1,2})(?:\s*[:.]\s*(\d{2}))?\b/.exec(pl);
        if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
        const whenSummary = parts.length ? parts.join(" ") : prefix;
        return { whenSummary };
      }

      /** NBSP / büyük-küçük harf / birleşik Unicode — komut satırını tek forma çeker. */
      function canonicalizeTaskInput(raw) {
        let s = String(raw || "")
          .replace(/\u00a0/g, " ")
          .normalize("NFKC")
          .trim();
        s = normalizeUserTaskMessage(s);
        s = s.toLocaleLowerCase("tr-TR").replace(/\s+/g, " ").trim();
        return s;
      }

      /**
       * mini görev ekle … | görev oluştur … | … görev ekle … (isteğe bağlı tarih/saat öneki).
       * accepted / onay beklemez; yalnızca yerel liste ile bağlar.
       */
      function parsePanelGorevKomutu(raw) {
        const s0 = String(raw || "").trim();
        if (!s0) return null;
        const s = canonicalizeTaskInput(s0);

        let m = /^\s*mini\s+görev\s+ekle\s+(.+)$/i.exec(s);
        if (m) {
          const title = m[1].trim();
          return title ? { title, whenSummary: null, replyKind: "mini" } : null;
        }

        m = /^\s*görev\s+oluştur\s+(.+)$/i.exec(s);
        if (m) {
          const { title, whenSummary } = parseOlusturRest(m[1]);
          return title ? { title, whenSummary } : null;
        }

        m = /^\s*(?:([\s\S]*?)\s+)?görev\s+ekle\s+(.+)$/i.exec(s);
        if (!m) return null;
        const pre = (m[1] || "").trim();
        const title = (m[2] || "").trim();
        if (!title) return null;
        const { whenSummary } = parseSchedulePrefix(pre);
        return { title, whenSummary };
      }

      function buildPanelGorevConfirmation(cmd) {
        if (cmd.replyKind === "mini") return `Mini görev eklendi: ${cmd.title}`;
        return cmd.whenSummary
          ? `Görev eklendi: ${cmd.title} — ${cmd.whenSummary}`
          : `Görev eklendi: ${cmd.title}`;
      }

      function normalizePanelLimitedIntentKey(text) {
        return String(text || "")
          .trim()
          .toLocaleLowerCase("tr-TR")
          .replace(/\s+/g, " ");
      }

      function applyPanelGorevKomutu(cmd) {
        const row = {
          title: cmd.title,
          priority: "orta",
          status: "bekliyor",
        };
        if (cmd.whenSummary) row.when = cmd.whenSummary;
        panelGorevlerTasks.push(row);
        attachGorevlerTaskPlan(row, cmd.title);
        if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
      }

      function pushGorevlerTaskLocalRow(title, priority, status) {
        const row = {
          title,
          priority:
            priority && ["dusuk", "orta", "yuksek"].includes(priority) ? priority : "orta",
          status: "bekliyor",
        };
        if (status === "onay_bekliyor") row.status = "onay_bekliyor";
        else if (status === "tamamlandi") row.status = "tamamlandi";
        panelGorevlerTasks.push(row);
        persistPanelGorevlerTasks();
        attachGorevlerTaskPlan(row, title);
        if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
        return row;
      }

      function wirePanel() {
        const nav = document.querySelector(".panel-body");
        const panels = document.querySelectorAll("[data-module-panel]");
        const sendBtn = document.getElementById("panel-send");
        const input = document.getElementById("panel-msg");
        const thread = document.getElementById("chat-thread");
        if (!nav || !sendBtn || !input || !thread) return;

        function expandNavGroupIfActiveHidden() {
          const active = nav.querySelector('button[data-module][aria-current="true"]');
          if (!active) return;
          const items = active.closest(".panel-nav-group-items");
          if (!items || !items.hasAttribute("hidden")) return;
          items.removeAttribute("hidden");
          const collapsible = items.closest(".panel-nav-collapsible");
          const toggle = collapsible?.querySelector(".panel-nav-group-toggle");
          if (toggle) toggle.setAttribute("aria-expanded", "true");
        }
        expandNavGroupIfActiveHidden();

        const vv = window.visualViewport;
        if (vv) {
          let vvTimer = 0;
          const onVisualViewportMove = () => {
            if (vvTimer) return;
            vvTimer = window.setTimeout(() => {
              vvTimer = 0;
              const se = document.scrollingElement;
              const docSl = Math.max(
                document.documentElement.scrollLeft || 0,
                document.body.scrollLeft || 0,
                se ? se.scrollLeft || 0 : 0,
              );
              const offL = vv.offsetLeft;
              if ((offL !== 0 && Number.isFinite(offL)) || docSl > 0) {
                window.scrollTo(0, window.scrollY);
                if (se) se.scrollLeft = 0;
                document.documentElement.scrollLeft = 0;
                document.body.scrollLeft = 0;
              }
            }, 100);
          };
          vv.addEventListener("resize", onVisualViewportMove, { passive: true });
          vv.addEventListener("scroll", onVisualViewportMove, { passive: true });
        }

        nav.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLElement)) return;
          const groupToggle = t.closest(".panel-nav-group-toggle");
          if (groupToggle) {
            const expanded = groupToggle.getAttribute("aria-expanded") === "true";
            const next = !expanded;
            groupToggle.setAttribute("aria-expanded", next ? "true" : "false");
            const cid = groupToggle.getAttribute("aria-controls");
            const panel = cid ? document.getElementById(cid) : null;
            if (panel) {
              if (next) panel.removeAttribute("hidden");
              else panel.setAttribute("hidden", "");
            }
            return;
          }
          const btn = t.closest("button[data-module]");
          if (!btn) return;
          const id = btn.getAttribute("data-module");
          if (!id) return;
          nav.querySelectorAll("button[data-module]").forEach((b) => {
            b.setAttribute("aria-current", b === btn ? "true" : "false");
          });
          panels.forEach((p) => {
            p.setAttribute("data-active", p.getAttribute("data-module-panel") === id ? "true" : "false");
          });
        });

        function panelNavigateToModule(moduleId) {
          const btn = nav.querySelector('button[data-module="' + moduleId + '"]');
          if (!btn) return false;
          nav.querySelectorAll("button[data-module]").forEach((b) => {
            b.setAttribute("aria-current", b === btn ? "true" : "false");
          });
          panels.forEach((p) => {
            p.setAttribute(
              "data-active",
              p.getAttribute("data-module-panel") === moduleId ? "true" : "false",
            );
          });
          return true;
        }

        function tryPanelLimitedNavigationIntent(trimmed) {
          const k = normalizePanelLimitedIntentKey(trimmed)
            .replace(/[.?!…]+$/g, "")
            .trim();
          if (!k) return null;
          if (/^(görevler|gorevler)$/.test(k)) {
            panelNavigateToModule("gorevler");
            return "Görevler ekranına geçtim; listeden görevleri görebilir veya «görev oluştur başlık» ile yeni görev ekleyebilirsin.";
          }
          if (/^(durum|sistem|sistem durumu|system)$/.test(k)) {
            panelNavigateToModule("ayarlar");
            return "Ayarlar ekranına geçtim. Bağlantı köprüsü olmadan dış sohbet devre dışı; yerel görevler kullanılabilir.";
          }
          if (/^(anahtar\s+kasası|anahtar\s+kasasi|keystore|kimlik)$/.test(k)) {
            panelNavigateToModule("kimlik");
            return "Kimlik ekranına geçtim; bağlantı ve kimlik ayarlarını buradan görebilirsin.";
          }
          return null;
        }

        function buildPanelLimitedReply(userText) {
          const trimmed = String(userText || "").trim();
          if (!trimmed) return "Bir mesaj yazın.";
          const navReply = tryPanelLimitedNavigationIntent(trimmed);
          if (navReply) return navReply;
          const keyTr = normalizePanelLimitedIntentKey(trimmed);
          const keyAscii = keyTr
            .replace(/ğ/g, "g")
            .replace(/ü/g, "u")
            .replace(/ş/g, "s")
            .replace(/ı/g, "i")
            .replace(/ö/g, "o")
            .replace(/ç/g, "c");
          if (keyTr.indexOf("görev") !== -1 || keyAscii.indexOf("gorev") !== -1) {
            return "Görevler ekranından listeyi görebilirsin. Yeni görev için: «görev oluştur başlık» (ör. görev oluştur alışveriş).";
          }
          if (keyTr.indexOf("kayıt") !== -1 || keyAscii.indexOf("kayit") !== -1) {
            return "Medya ekranına geçip dosyaları inceleyebilirsin.";
          }
          if (keyTr.indexOf("akış") !== -1 || keyAscii.indexOf("akis") !== -1) {
            return "Sosyal ekranına geçip güncel listeyi görebilirsin.";
          }
          return "Sınırlı moddasın; dış köprü yok. Yerel görevler ve kısa yönlendirmeler kullanılabilir — örn. «görev oluştur başlık» veya «görevler».";
        }

        const sendLabel = "Gönder";
        const loadingLabel = "Gönderiliyor…";
        const CHAT_HISTORY_LIMIT = 12;
        let sending = false;
        const mqPanelChatFinePointer = window.matchMedia("(pointer: fine)");
        const mqPanelChatTouchPrimary = window.matchMedia("(pointer: coarse) and (hover: none)");
        const mqPanelChatDesktopWidth = window.matchMedia("(min-width: 768px)");

        function refocusPanelChatInput() {
          if (mqPanelChatTouchPrimary.matches) return;
          if (!mqPanelChatFinePointer.matches && !mqPanelChatDesktopWidth.matches) return;
          if (input.disabled || input.readOnly) return;
          const el = input;
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (el.disabled || el.readOnly) return;
              try {
                el.focus({ preventScroll: true });
              } catch {
                el.focus();
              }
            });
          });
        }

        const attachToggle = document.getElementById("panel-attach-toggle");
        const attachMenu = document.getElementById("panel-attach-menu");
        const attachAudioInput = /** @type {HTMLInputElement | null} */ (
          document.getElementById("panel-attach-audio-input")
        );
        const cameraBtn = document.getElementById("panel-camera-input");
        const cameraHint = document.getElementById("panel-camera-hint");
        const sendHint = document.getElementById("panel-send-hint");
        const cameraPhotoInput = /** @type {HTMLInputElement | null} */ (document.getElementById("panel-camera-photo-input"));
        const cameraPhotoPreview = /** @type {HTMLImageElement | null} */ (document.getElementById("panel-camera-photo-preview"));
        const cameraPhotoStatus = document.getElementById("panel-camera-photo-status");
        const cameraPreviewWrap = document.getElementById("panel-camera-preview-wrap");
        const cameraVideo = /** @type {HTMLVideoElement | null} */ (document.getElementById("panel-camera-video"));
        const mqPanelCameraMobile = window.matchMedia("(max-width: 767.98px)");

        function isPanelCameraNativeCapture() {
          return mqPanelCameraMobile.matches || mqPanelChatTouchPrimary.matches;
        }
        /** @type {string | null} */
        let cameraPhotoObjectUrl = null;
        /** @type {MediaStream | null} */
        let cameraStream = null;

        function setCameraHint(msg) {
          if (!cameraHint) return;
          cameraHint.textContent = msg;
          cameraHint.hidden = !msg;
        }

        function setSendHint(msg) {
          if (!sendHint) return;
          const s = panelUserVisibleText(msg != null ? String(msg) : "");
          sendHint.textContent = s;
          sendHint.hidden = !s;
        }

        function revokeCameraPhotoObjectUrl() {
          if (!cameraPhotoObjectUrl) return;
          try {
            URL.revokeObjectURL(cameraPhotoObjectUrl);
          } catch {
            /* ignore */
          }
          cameraPhotoObjectUrl = null;
        }

        function syncPanelCameraPhotoBarVisibility() {
          const hasPhoto = !!cameraPhotoObjectUrl;
          const hasStream = !!cameraStream;
          if (!cameraPreviewWrap) return;
          cameraPreviewWrap.hidden = !(hasPhoto || hasStream);
          if (hasStream) cameraPreviewWrap.classList.add("chat-camera-preview-wrap--stream");
          else cameraPreviewWrap.classList.remove("chat-camera-preview-wrap--stream");
        }

        function stopPanelCameraStream() {
          if (cameraStream) {
            cameraStream.getTracks().forEach((tr) => tr.stop());
            cameraStream = null;
          }
          if (cameraVideo) {
            cameraVideo.srcObject = null;
            cameraVideo.hidden = true;
          }
          if (cameraBtn && !cameraPhotoObjectUrl) {
            cameraBtn.classList.remove("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "false");
          }
          syncPanelCameraPhotoBarVisibility();
        }

        function togglePanelCameraStream() {
          if (cameraStream) {
            stopPanelCameraStream();
            setCameraHint("");
            return;
          }
          if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== "function") {
            setCameraHint("Bu tarayıcıda kamera girişi desteklenmiyor.");
            return;
          }
          setCameraHint("");
          navigator.mediaDevices
            .getUserMedia({ video: true, audio: false })
            .then((stream) => {
              cameraStream = stream;
              if (cameraVideo) {
                cameraVideo.srcObject = stream;
                cameraVideo.hidden = false;
              }
              if (cameraBtn) {
                cameraBtn.classList.add("chat-compose-camera-btn--active");
                cameraBtn.setAttribute("aria-pressed", "true");
              }
              syncPanelCameraPhotoBarVisibility();
            })
            .catch((err) => {
              const name = err && err.name;
              if (name === "NotAllowedError" || name === "PermissionDeniedError") {
                setCameraHint("Kamera izni verilmedi.");
              } else {
                setCameraHint("Bu tarayıcıda kamera girişi desteklenmiyor.");
              }
              stopPanelCameraStream();
            });
        }

        function clearPanelCameraPhotoSelection() {
          revokeCameraPhotoObjectUrl();
          if (cameraPhotoPreview) {
            cameraPhotoPreview.onload = null;
            cameraPhotoPreview.removeAttribute("src");
            cameraPhotoPreview.removeAttribute("title");
            cameraPhotoPreview.alt = "";
            cameraPhotoPreview.hidden = true;
          }
          if (cameraPhotoInput) cameraPhotoInput.value = "";
          if (cameraPhotoStatus) {
            cameraPhotoStatus.textContent = "";
            cameraPhotoStatus.hidden = true;
          }
          if (cameraBtn && !cameraStream) {
            cameraBtn.classList.remove("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "false");
          }
          syncPanelCameraPhotoBarVisibility();
        }

        function bindCameraPhotoFromFile(file) {
          stopPanelCameraStream();
          if (!file || !/^image\//.test(file.type)) {
            setCameraHint("Lütfen bir görsel dosyası seçin.");
            return;
          }
          setCameraHint("");
          revokeCameraPhotoObjectUrl();
          try {
            cameraPhotoObjectUrl = URL.createObjectURL(file);
          } catch {
            setCameraHint("Önizleme oluşturulamadı.");
            return;
          }
          const name = file.name && String(file.name).trim();
          if (cameraPhotoPreview) {
            cameraPhotoPreview.hidden = true;
            const label = name ? name : "Seçilen görsel";
            cameraPhotoPreview.alt = label;
            cameraPhotoPreview.title = label;
            cameraPhotoPreview.onload = () => {
              cameraPhotoPreview.hidden = false;
            };
            cameraPhotoPreview.src = cameraPhotoObjectUrl;
          }
          if (cameraPhotoStatus) {
            cameraPhotoStatus.textContent = name ? name : "Fotoğraf alındı";
            syncCameraPhotoStatusVisibilityForViewport();
          }
          if (cameraBtn) {
            cameraBtn.classList.add("chat-compose-camera-btn--active");
            cameraBtn.setAttribute("aria-pressed", "true");
          }
          syncPanelCameraPhotoBarVisibility();
        }

        function escapeHtml(s) {
          return String(s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        function formatAssistantHtml(raw) {
          let s = escapeHtml(String(raw));
          s = s.replace(/\*\*([\s\S]+?)\*\*/g, "<strong>$1</strong>");
          s = s.replace(/\*\*/g, "");
          s = s.replace(/\n/g, "<br />");
          return s;
        }

        /** Lumos gövdesinden (strong, br) backend geçmişi için düz metin üretir. */
        function lumosBodyToPlainText(root) {
          const out = [];
          function walk(n) {
            if (n.nodeType === Node.TEXT_NODE) out.push(n.textContent);
            else if (n.nodeType === Node.ELEMENT_NODE) {
              const el = /** @type {Element} */ (n);
              if (el.tagName === "BR") out.push("\n");
              else el.childNodes.forEach(walk);
            }
          }
          walk(root);
          return out.join("").trim();
        }

        /** Mevcut iplikten (yeni kullanıcı mesajı eklenmeden önce) son N mesajı role/content olarak döner. */
        function collectThreadHistory(threadEl) {
          const nodes = threadEl.querySelectorAll(".chat-msg");
          const items = [];
          for (const wrap of nodes) {
            let role;
            if (wrap.classList.contains("chat-msg--user")) role = "user";
            else if (wrap.classList.contains("chat-msg--lumos")) role = "assistant";
            else continue;
            const body = wrap.querySelector(".chat-msg-body");
            let text = "";
            if (role === "assistant" && body) {
              text = lumosBodyToPlainText(body);
            } else if (body && body.textContent) {
              text = body.textContent.trim();
            }
            if (!text) continue;
            items.push({ role, content: text });
          }
          if (items.length <= CHAT_HISTORY_LIMIT) return items;
          return items.slice(-CHAT_HISTORY_LIMIT);
        }

        function appendBubble(kind, text) {
          const turn = document.createElement("div");
          turn.className =
            "chat-turn " +
            (kind === "user" ? "chat-turn--user" : kind === "error" ? "chat-turn--error" : "chat-turn--lumos");

          const wrap = document.createElement("div");
          wrap.className =
            "chat-msg " +
            (kind === "user" ? "chat-msg--user" : kind === "error" ? "chat-msg--error" : "chat-msg--lumos");
          const role = document.createElement("span");
          role.className = "chat-msg-role";
          role.textContent = kind === "user" ? "Sen" : kind === "error" ? "Uyarı" : "Lumos";
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          if (kind === "lumos") {
            body.innerHTML = formatAssistantHtml(panelUserVisibleText(text));
          } else if (kind === "error") {
            body.textContent = panelUserVisibleText(text);
          } else {
            body.textContent = text;
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        /**
         * /chat: JSON gövdesi; isteğe bağlı küçük görsel base64 (tavan backend ile uyumlu).
         * Ham bayt tavanı 256 KiB — üzerinde yalnızca photo* metadata gider.
         */
        const PANEL_CHAT_IMAGE_INLINE_MAX_BYTES = 256 * 1024;

        /** Sunucunun `Buffer.from(b64, "base64")` uzunluğu ile aynı: ham bayt sayısı. */
        function decodedByteLengthFromBase64(b64) {
          if (!b64) return 0;
          let pad = 0;
          if (b64.endsWith("==")) pad = 2;
          else if (b64.endsWith("=")) pad = 1;
          return Math.floor((b64.length * 3) / 4) - pad;
        }

        /** Yerel önizleme (data URL); sunucuya ayrıca şartlara uygunsa imageData olarak gider. */
        function readFileAsDataUrl(file) {
          return new Promise((resolve, reject) => {
            const fr = new FileReader();
            fr.onload = () => resolve(String(fr.result || ""));
            fr.onerror = () => reject(new Error("read failed"));
            fr.readAsDataURL(file);
          });
        }

        /** data:image/...;base64, sonrası — tavan ve MIME image/ iken kullanılır. */
        function dataUrlToInlineBase64ForChat(dataUrl, file) {
          if (!dataUrl || !file || !/^image\//.test(file.type)) return null;
          if (file.size > PANEL_CHAT_IMAGE_INLINE_MAX_BYTES) return null;
          const marker = "base64,";
          const i = dataUrl.indexOf(marker);
          if (i < 0) return null;
          const b64 = dataUrl.slice(i + marker.length).replace(/\s/g, "");
          if (!b64) return null;
          if (decodedByteLengthFromBase64(b64) > PANEL_CHAT_IMAGE_INLINE_MAX_BYTES) return null;
          return b64;
        }

        /**
         * Orijinal dosyayı sıkıştırıp ham base64 (data: öneki yok) üretir; `PANEL_CHAT_IMAGE_INLINE_MAX_BYTES` altına indiremezse null.
         * null iken mevcut davranış: `photo*` metadata gider, `imageData` gönderilmez.
         */
        async function compressPhotoFileForChat(file) {
          if (!file || !/^image\//.test(file.type)) return null;
          const cap = PANEL_CHAT_IMAGE_INLINE_MAX_BYTES;
          const maxSide = 1024;

          let bmp;
          try {
            bmp = await createImageBitmap(file);
          } catch {
            return null;
          }

          const iw = bmp.width;
          const ih = bmp.height;
          if (!iw || !ih) {
            try {
              bmp.close();
            } catch {
              /* ignore */
            }
            return null;
          }

          const canvas = document.createElement("canvas");
          const ctx = canvas.getContext("2d");
          if (!ctx) {
            try {
              bmp.close();
            } catch {
              /* ignore */
            }
            return null;
          }

          let dimScale = Math.min(1, maxSide / Math.max(iw, ih));
          let quality = 0.7;
          const minQuality = 0.25;
          const maxAttempts = 28;

          for (let attempt = 0; attempt < maxAttempts; attempt++) {
            const w = Math.max(1, Math.round(iw * dimScale));
            const h = Math.max(1, Math.round(ih * dimScale));
            canvas.width = w;
            canvas.height = h;
            ctx.drawImage(bmp, 0, 0, w, h);

            const blob = await new Promise((resolve) => {
              canvas.toBlob((b) => resolve(b), "image/jpeg", quality);
            });
            if (blob && blob.size <= cap) {
              let b64 = "";
              try {
                b64 = await new Promise((resolve, reject) => {
                  const fr = new FileReader();
                  fr.onload = () => {
                    const s = String(fr.result || "");
                    const marker = "base64,";
                    const j = s.indexOf(marker);
                    resolve(j >= 0 ? s.slice(j + marker.length).replace(/\s/g, "") : "");
                  };
                  fr.onerror = () => reject(new Error("blob read"));
                  fr.readAsDataURL(blob);
                });
              } catch {
                b64 = "";
              }
              try {
                bmp.close();
              } catch {
                /* ignore */
              }
              /* blob.size = decode edilen JPEG baytı; backend tavanı ile aynı ölçü. */
              if (b64 && decodedByteLengthFromBase64(b64) <= cap) return b64;
              return null;
            }

            if (quality > minQuality) {
              quality = Math.max(minQuality, quality - 0.08);
            } else {
              dimScale *= 0.9;
              quality = 0.55;
            }
            if (Math.round(iw * dimScale) < 8 || Math.round(ih * dimScale) < 8) {
              try {
                bmp.close();
              } catch {
                /* ignore */
              }
              return null;
            }
          }

          try {
            bmp.close();
          } catch {
            /* ignore */
          }
          return null;
        }

        /** Kullanıcı balonu: düz metin ve isteğe bağlı yerel görsel (sunucu ikili almaz). */
        function appendUserComposeBubble(plainText, imageDataUrl) {
          const turn = document.createElement("div");
          turn.className = "chat-turn chat-turn--user";
          const wrap = document.createElement("div");
          wrap.className = "chat-msg chat-msg--user";
          const role = document.createElement("span");
          role.className = "chat-msg-role";
          role.textContent = "Sen";
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          const trimmed = plainText && String(plainText).trim();
          if (trimmed) {
            const textEl = document.createElement("div");
            textEl.textContent = trimmed;
            body.appendChild(textEl);
          }
          if (imageDataUrl) {
            if (!trimmed) {
              const cap = document.createElement("div");
              cap.textContent = "Fotoğraf eklendi";
              body.appendChild(cap);
            }
            const img = document.createElement("img");
            img.src = imageDataUrl;
            img.alt = "";
            img.decoding = "async";
            img.style.maxWidth = "100%";
            img.style.borderRadius = "8px";
            img.style.display = "block";
            img.style.marginTop = trimmed ? "8px" : "6px";
            body.appendChild(img);
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        function resetPanelHorizontalScrollAfterInputBlur() {
          const y = window.scrollY;
          try {
            window.scrollTo({ left: 0, top: y, behavior: "instant" });
          } catch {
            try {
              window.scrollTo({ left: 0, top: y, behavior: "auto" });
            } catch {
              window.scrollTo(0, y);
            }
          }
          const se = document.scrollingElement;
          if (se) se.scrollLeft = 0;
          document.documentElement.scrollLeft = 0;
          document.body.scrollLeft = 0;
        }

        function summarizeClientFetchError(err) {
          if (err == null) return "Bilinmeyen hata";
          if (typeof err === "object" && err !== null && typeof err.message === "string" && err.message) {
            return err.message;
          }
          return String(err);
        }

        const PANEL_CHAT_LOG_MAX = 8000;
        function truncatePanelChatLog(s) {
          const t = s == null ? "" : String(s);
          if (t.length <= PANEL_CHAT_LOG_MAX) return t;
          return (
            t.slice(0, PANEL_CHAT_LOG_MAX) + "\n… (" + (t.length - PANEL_CHAT_LOG_MAX) + " karakter daha)"
          );
        }

        /** Panel /chat hata türleri — backend/panelChatErrors.js ile eşleşmeli. */
        const PANEL_CHAT_ERROR_MESSAGES_TR = {
          network_error: "İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.",
          timeout: "Yanıt süresi doldu. Biraz sonra tekrar dene.",
          unauthorized: "Bağlantı doğrulanamadı. Cihaz ayarlarını kontrol edip tekrar dene.",
          server_error: "Sohbet geçici olarak yanıt veremedi. Biraz sonra tekrar dene.",
          model_error: "Yanıt üretilemedi. Biraz sonra tekrar dene.",
          unknown_error: "Beklenmeyen bir sorun oluştu. Biraz sonra tekrar dene.",
        };

        function userMessageForPanelChatFailureKind(kind) {
          return PANEL_CHAT_ERROR_MESSAGES_TR[kind] || PANEL_CHAT_ERROR_MESSAGES_TR.unknown_error;
        }

        function classifyPanelChatFailure(ctx) {
          const status =
            typeof ctx.httpStatus === "number" && Number.isFinite(ctx.httpStatus)
              ? ctx.httpStatus
              : null;
          const name = String(ctx.errName || "").toLowerCase();
          const msg = String(ctx.errMessage || ctx.upstreamText || "").toLowerCase();
          if (status === 401 || status === 403) return "unauthorized";
          if (status != null && status >= 500) return "server_error";
          if (status === 429) return "model_error";
          if (/timeout|timed\s*out|etimedout|aborterror|deadline/i.test(name + " " + msg)) {
            return "timeout";
          }
          if (
            /failed to fetch|networkerror|network\s*error|econnrefused|enotfound|fetch failed|dns/i.test(
              name + " " + msg,
            )
            || (status == null && /ulaşılamadı|network|cors/i.test(msg))
          ) {
            return "network_error";
          }
          if (/unauthorized|forbidden|401|403|invalid.*token|api.?key/i.test(msg)) {
            return "unauthorized";
          }
          if (
            /openai|chat\s*llm\s*error|model|responses\.create|rate.?limit|content.?policy/i.test(
              msg,
            )
          ) {
            return "model_error";
          }
          if (/internal server|500|502|503|504|sunucu/i.test(msg)) {
            return "server_error";
          }
          return "unknown_error";
        }

        /** Gerçek hata/ayrıntı sızıntıları; normal sohbet kelimeleri (ör. token) dahil değil. */
        const PANEL_CHAT_TECH_LEAK_RE = new RegExp(
          [
            "traceback",
            "stack\\s*trace",
            "stacktrace",
            "OPENAI_API_KEY",
            "process\\.env",
            "Authorization\\s*:",
            "\\bBearer\\s+[A-Za-z0-9._-]{8,}",
            "\\bException\\b",
            "\\bError:\\s",
            "modulenotfounderror",
            "no\\s+module\\s+named",
            "node_modules[/\\\\]",
            "[/\\\\](?:src|backend|dist)[/\\\\]",
            "\\.(?:py|js|ts):\\d+",
            "chat\\s*llm\\s*error",
          ].join("|"),
          "i",
        );

        /**
         * Hata balonu / teknik önizleme metni: sızıntı kalıplarında backend ile uyumlu Türkçe mesaj.
         * Başarılı asistan yanıtlarında kullanılmaz.
         */
        function panelChatSanitizeUserVisibleChatFailureText(raw, ctx) {
          const original = String(raw ?? "").trim();
          if (!original) return "";
          if (!PANEL_CHAT_TECH_LEAK_RE.test(original)) return original;
          console.error(
            "[Lumos panel chat] User-visible text matched technical patterns; raw upstream:",
            truncatePanelChatLog(original),
          );
          const kind = classifyPanelChatFailure({
            httpStatus: ctx && ctx.httpStatus,
            errName: ctx && ctx.errName,
            errMessage: ctx && ctx.errMessage,
            upstreamText: original,
          });
          return userMessageForPanelChatFailureKind(kind);
        }

        function parsePanelChatJsonBody(trimmed) {
          try {
            let v = JSON.parse(trimmed);
            if (typeof v === "string") {
              const inner = v.trim();
              if (
                inner.length > 1
                && ((inner.startsWith("{") && inner.endsWith("}"))
                  || (inner.startsWith("[") && inner.endsWith("]")))
              ) {
                try {
                  v = JSON.parse(inner);
                } catch {
                  /* kök JSON string = asistan metni */
                }
              }
            }
            return { ok: true, value: v };
          } catch {
            return { ok: false, value: null };
          }
        }

        function extractAssistantFromChatPayload(data) {
          if (data == null) return "";
          if (typeof data === "string") return String(data).trim();
          if (typeof data !== "object") return "";
          const keys = ["reply", "content", "message", "answer", "text", "response"];
          function fromObj(o) {
            if (!o || typeof o !== "object" || Array.isArray(o)) return "";
            for (let i = 0; i < keys.length; i++) {
              const k = keys[i];
              if (Object.prototype.hasOwnProperty.call(o, k) && o[k] != null) {
                const s = String(o[k]).trim();
                if (s) return s;
              }
            }
            return "";
          }
          let out = fromObj(data);
          if (out) return out;
          out = fromObj(data.data);
          if (out) return out;
          const choices = data.choices;
          if (Array.isArray(choices) && choices.length) {
            const c0 = choices[0];
            if (c0 && typeof c0 === "object") {
              const msg = c0.message;
              if (msg && typeof msg === "object" && typeof msg.content === "string") {
                const s = msg.content.trim();
                if (s) return s;
              }
              if (typeof c0.text === "string" && c0.text.trim()) return c0.text.trim();
            }
          }
          if (typeof data.error === "string" && data.error.trim()) return data.error.trim();
          return "";
        }

        function looksLikePanelChatPlainText(trimmed) {
          if (!trimmed || trimmed.length > 100000) return false;
          const c0 = trimmed.charCodeAt(0);
          if (c0 === 0x7b || c0 === 0x5b) return false;
          if (/^<!DOCTYPE\b/i.test(trimmed) || /^<html\b/i.test(trimmed)) return false;
          return true;
        }

        async function runSend() {
          const message = input.value.trim();
          const photoFile =
            cameraPhotoInput && cameraPhotoInput.files && cameraPhotoInput.files[0]
              ? cameraPhotoInput.files[0]
              : null;
          const hasPhoto = !!(photoFile && /^image\//.test(photoFile.type));
          if ((!message && !hasPhoto) || sending) return;

          setSendHint("");
          if (!hasPhoto) {
            showPanelChatPhotoTech("");
          }

          let imageDataUrlForBubble = null;
          if (hasPhoto) {
            try {
              imageDataUrlForBubble = await readFileAsDataUrl(photoFile);
            } catch {
              setSendHint("Fotoğraf okunamadı.");
              return;
            }
          }

          const panelGorevCmd = parsePanelGorevKomutu(message);

          if (bridgeOpsBlocked()) {
            sending = true;
            sendBtn.disabled = true;
            sendBtn.setAttribute("aria-busy", "true");
            sendBtn.setAttribute("aria-label", loadingLabel);
            sendBtn.setAttribute("title", loadingLabel);
            sendBtn.classList.add("chat-compose-send--busy");
            try {
              if (hasPhoto) {
                appendUserComposeBubble(message, imageDataUrlForBubble);
                appendBubble("lumos", PANEL_LIMITED_PHOTO_REPLY);
                setSendHint("Sınırlı modda görsel analizi kullanılamaz.");
                input.value = "";
                clearPanelCameraPhotoSelection();
                input.blur();
                resetPanelHorizontalScrollAfterInputBlur();
                return;
              }

              appendBubble("user", message);
              if (panelGorevCmd) {
                applyPanelGorevKomutu(panelGorevCmd);
                appendBubble("lumos", buildPanelGorevConfirmation(panelGorevCmd));
              } else {
                appendBubble("lumos", buildPanelLimitedReply(message));
              }
              input.value = "";
              clearPanelCameraPhotoSelection();
              setSendHint("");
              input.blur();
              resetPanelHorizontalScrollAfterInputBlur();
            } finally {
              sending = false;
              sendBtn.disabled = false;
              sendBtn.removeAttribute("aria-busy");
              sendBtn.setAttribute("aria-label", sendLabel);
              sendBtn.setAttribute("title", sendLabel);
              sendBtn.classList.remove("chat-compose-send--busy");
              refocusPanelChatInput();
            }
            return;
          }

          const outgoingMessage = message;

          sending = true;
          sendBtn.disabled = true;
          sendBtn.setAttribute("aria-busy", "true");
          sendBtn.setAttribute("aria-label", loadingLabel);
          sendBtn.setAttribute("title", loadingLabel);
          sendBtn.classList.add("chat-compose-send--busy");
          const history = collectThreadHistory(thread);
          if (imageDataUrlForBubble) {
            appendUserComposeBubble(message, imageDataUrlForBubble);
          } else {
            appendBubble("user", message);
          }

          /** Liste + onay: fetch’ten önce; aksi halde uzayan / takılan istek zinciri burada kopar (runSend hiç ilerlemez). */
          if (panelGorevCmd) {
            applyPanelGorevKomutu(panelGorevCmd);
            appendBubble("lumos", buildPanelGorevConfirmation(panelGorevCmd));
            input.value = "";
            clearPanelCameraPhotoSelection();
            setSendHint("");
            input.blur();
            resetPanelHorizontalScrollAfterInputBlur();
          }

          /**
           * Sistem Durumu için fotoğraf gönderim özeti; backend'e gönderilmez, yalnızca
           * istemcide görsel analiz durumunu (aktif/fallback/hata) çıkarmak ve panele yazmak için tutulur.
           */
          const photoTelemetry = hasPhoto && photoFile
            ? {
                photoAttached: true,
                photoSize:
                  typeof photoFile.size === "number" && Number.isFinite(photoFile.size)
                    ? photoFile.size
                    : 0,
                inlineBytes: 0,
                hasInline: false,
              }
            : null;
          try {
            const chatBody = {
              message: outgoingMessage,
              history,
              panelContext: {
                bridgeBaseUrl: BRIDGE_BASE_URL,
                tasksApiUrl: TASKS_API_URL,
              },
            };
            if (hasPhoto && photoFile) {
              chatBody.photoAttached = true;
              chatBody.photoName = photoFile.name || "";
              chatBody.photoType = photoFile.type || "";
              chatBody.photoSize =
                typeof photoFile.size === "number" && Number.isFinite(photoFile.size)
                  ? photoFile.size
                  : 0;
              let inlineB64 =
                imageDataUrlForBubble && dataUrlToInlineBase64ForChat(imageDataUrlForBubble, photoFile);
              let sentCompressedJpeg = false;
              if (!inlineB64) {
                inlineB64 = await compressPhotoFileForChat(photoFile);
                sentCompressedJpeg = !!inlineB64;
              }
              if (inlineB64) chatBody.imageData = inlineB64;
              if (sentCompressedJpeg) {
                chatBody.photoType = "image/jpeg";
                const rawName = photoFile.name || "photo";
                chatBody.photoName = rawName.replace(/\.[^/.]+$/, "") + ".jpg";
              }
              if (photoTelemetry) {
                photoTelemetry.hasInline = !!inlineB64;
                photoTelemetry.inlineBytes = inlineB64
                  ? decodedByteLengthFromBase64(inlineB64)
                  : 0;
              }
            }
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify(chatBody),
            });
            const text = await r.text();

            if (!r.ok) {
              console.warn("[Lumos panel chat] HTTP error", r.status);
              setSendHint(
                panelDebugText(
                  "Gönderilemedi (HTTP " + r.status + "). Tekrar dene.",
                  "İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.",
                ),
              );
              let upstreamErr = "";
              let upstreamKind = "";
              if (text) {
                try {
                  const errJson = JSON.parse(text);
                  if (errJson && typeof errJson === "object") {
                    if (typeof errJson.errorKind === "string" && errJson.errorKind.trim()) {
                      upstreamKind = errJson.errorKind.trim();
                    }
                    if (typeof errJson.reply === "string" && errJson.reply.trim()) {
                      upstreamErr = errJson.reply.trim();
                    } else if (typeof errJson.error === "string") {
                      upstreamErr = errJson.error.trim();
                    }
                  }
                } catch {
                  upstreamErr = String(text).trim().slice(0, 200);
                }
              }
              const httpFailKind =
                upstreamKind && Object.prototype.hasOwnProperty.call(PANEL_CHAT_ERROR_MESSAGES_TR, upstreamKind)
                  ? upstreamKind
                  : classifyPanelChatFailure({
                      httpStatus: r.status,
                      upstreamText: upstreamErr,
                    });
              const httpFailMsg =
                upstreamErr && !PANEL_CHAT_TECH_LEAK_RE.test(upstreamErr)
                  ? panelUserVisibleText(upstreamErr)
                  : userMessageForPanelChatFailureKind(httpFailKind);
              appendBubble("error", httpFailMsg);
              if (photoTelemetry) {
                let reason = "HTTP " + r.status;
                let missingKey = "";
                if (text) {
                  try {
                    const errJson = JSON.parse(text);
                    if (errJson && typeof errJson === "object") {
                      if (typeof errJson.error === "string") {
                        if (/OPENAI_API_KEY/i.test(errJson.error)) {
                          missingKey = " · Görsel analiz için API anahtarı eksik";
                        }
                        reason = "HTTP " + r.status + " · " + errJson.error.slice(0, 80);
                      }
                    }
                  } catch {
                    /* ham metin */
                  }
                }
                const visionGuess =
                  photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
                const replyHttpErrRaw = text ? String(text).trim() : "";
                showPanelChatPhotoTech(
                  buildPhotoTechBlock({
                    httpStatus: r.status,
                    reachedBackend: true,
                    imageDataSent: photoTelemetry.hasInline,
                    visionTriedGuess: visionGuess,
                    replyPreview: panelChatSanitizeUserVisibleChatFailureText(replyHttpErrRaw, {
                      httpStatus: r.status,
                    }).slice(0, 120),
                    fallbackExact: false,
                    fallbackRegex: false,
                    networkError: false,
                    extraReason: panelChatSanitizeUserVisibleChatFailureText(reason + missingKey, {
                      httpStatus: r.status,
                    }),
                  }),
                );
                void loadPanelBackendStatus();
              }
            } else {
              const EMPTY_REPLY_MSG =
                "Bu turda net bir yanıt üretemedim; biraz sonra tekrar deneyeceğim.";
              const CHAT_BODY_UNUSABLE_HINT = "Yanıt okunamadı.";
              const CHAT_BODY_UNUSABLE_BUBBLE =
                "Sunucudan gelen yanıtı işleyemedik. Biraz sonra yeniden deneyebilirsin.";

              let chatFailureReported = false;
              function reportChatBodyFailure() {
                if (chatFailureReported) return;
                chatFailureReported = true;
                setSendHint(CHAT_BODY_UNUSABLE_HINT);
                appendBubble("error", CHAT_BODY_UNUSABLE_BUBBLE);
              }

              const trimmedBody = text == null ? "" : String(text).trim();
              let parsedPayload = null;
              let havePayload = false;

              if (!trimmedBody) {
                console.debug("[Lumos panel chat] Boş gövde (HTTP 200)");
                reportChatBodyFailure();
              } else {
                const jr = parsePanelChatJsonBody(trimmedBody);
                if (jr.ok) {
                  havePayload = true;
                  parsedPayload = jr.value;
                } else {
                  console.error(
                    "[Lumos panel chat] JSON ayrıştırılamadı, ham yanıt:",
                    truncatePanelChatLog(text),
                  );
                  if (looksLikePanelChatPlainText(trimmedBody)) {
                    havePayload = true;
                    parsedPayload = trimmedBody;
                  } else {
                    reportChatBodyFailure();
                  }
                }
              }

              if (havePayload) {
                const replyBody = extractAssistantFromChatPayload(parsedPayload);
                if (photoTelemetry) {
                  const trimmedReply = replyBody.trim();
                  const fallbackExact = trimmedReply === REPLY_PHOTO_NO_VISION_TR;
                  const fallbackRegex = PANEL_REPLY_PHOTO_NO_VISION_RE.test(trimmedReply);
                  const visionGuess =
                    photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
                  if (fallbackRegex || fallbackExact) {
                    const extra =
                      !photoTelemetry.hasInline
                        ? "Görsel veri gitmedi (tavan veya sıkıştırma) · dosya ≈ "
                          + formatBytesShort(photoTelemetry.photoSize)
                        : "";
                    showPanelChatPhotoTech(
                      buildPhotoTechBlock({
                        httpStatus: r.status,
                        reachedBackend: true,
                        imageDataSent: photoTelemetry.hasInline,
                        visionTriedGuess: visionGuess,
                        replyPreview: trimmedReply.slice(0, 140),
                        fallbackExact,
                        fallbackRegex: fallbackRegex && !fallbackExact,
                        networkError: false,
                        extraReason: extra,
                      }),
                    );
                  } else if (trimmedReply) {
                    showPanelChatPhotoTech(
                      buildPhotoTechBlock({
                        httpStatus: r.status,
                        reachedBackend: true,
                        imageDataSent: photoTelemetry.hasInline,
                        visionTriedGuess: visionGuess,
                        replyPreview: trimmedReply.slice(0, 140),
                        fallbackExact: false,
                        fallbackRegex: false,
                        networkError: false,
                        extraReason: "",
                      }),
                    );
                  } else {
                    showPanelChatPhotoTech(
                      buildPhotoTechBlock({
                        httpStatus: r.status,
                        reachedBackend: true,
                        imageDataSent: photoTelemetry.hasInline,
                        visionTriedGuess: visionGuess,
                        replyPreview: "",
                        fallbackExact: false,
                        fallbackRegex: false,
                        networkError: false,
                        extraReason: "Boş yanıt",
                      }),
                    );
                  }
                  void loadPanelBackendStatus();
                }
                if (replyBody.trim()) {
                  const { lumosText } = ingestAssistantPanelGorev(replyBody);
                  if (panelGorevCmd) {
                    appendBubble("lumos", "Sunucu yanıtı:\n" + lumosText);
                    setSendHint("");
                  } else {
                    appendBubble("lumos", lumosText);
                    input.value = "";
                    clearPanelCameraPhotoSelection();
                    setSendHint("");
                    input.blur();
                    resetPanelHorizontalScrollAfterInputBlur();
                  }
                } else if (panelGorevCmd) {
                  appendBubble(
                    "lumos",
                    "Sunucu bu istek için ek metin dönmedi (görev zaten yerelde kayıtlı).",
                  );
                  setSendHint("");
                } else {
                  appendBubble("lumos", EMPTY_REPLY_MSG);
                  setSendHint("");
                }
              }
            }
          } catch (err) {
            const netMsg = summarizeClientFetchError(err);
            const errName =
              err && typeof err === "object" && err.name ? String(err.name) : "";
            setSendHint(
              panelDebugText(
                "İstek hatası: " + netMsg.slice(0, 140),
                "İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.",
              ),
            );
            const netKind = classifyPanelChatFailure({
              errName,
              errMessage: netMsg,
            });
            appendBubble("error", userMessageForPanelChatFailureKind(netKind));
            if (photoTelemetry) {
              const visionGuess =
                photoTelemetry.hasInline && !!photoFile && /^image\//i.test(photoFile.type || "");
              showPanelChatPhotoTech(
                buildPhotoTechBlock({
                  requestUrl: CHAT_URL,
                  httpStatus: "—",
                  reachedBackend: false,
                  imageDataSent: photoTelemetry.hasInline,
                  visionTriedGuess: visionGuess,
                  replyPreview: "",
                  fallbackExact: false,
                  fallbackRegex: false,
                  networkError: true,
                  extraReason: "Ağ veya istemci: " + netMsg,
                }),
              );
              void loadPanelBackendStatus();
            }
          } finally {
            sending = false;
            sendBtn.disabled = false;
            sendBtn.removeAttribute("aria-busy");
            sendBtn.setAttribute("aria-label", sendLabel);
            sendBtn.setAttribute("title", sendLabel);
            sendBtn.classList.remove("chat-compose-send--busy");
            refocusPanelChatInput();
          }
        }

        sendBtn.addEventListener("click", () => {
          sendBtn.blur();
          void runSend();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter" || e.shiftKey) return;
          e.preventDefault();
          void runSend();
        });

        const clipboardBtn = document.getElementById("panel-clipboard-to-kando");
        if (clipboardBtn) {
          const clipboardLabel = "Panodaki metni ilet";
          const clipboardConfirmLabel = "Onayla ve gönder";
          const clipboardLoadingLabel = "Gönderiliyor…";
          const CLIP_PREVIEW_MAX = 80;
          let clipboardSending = false;
          let pendingClipText = null;

          function clipPreviewSnippet(text) {
            const t = String(text || "").trim();
            if (!t) return "";
            if (t.length <= CLIP_PREVIEW_MAX) return t;
            return t.slice(0, CLIP_PREVIEW_MAX) + "…";
          }

          function clearClipPending() {
            pendingClipText = null;
            clipboardBtn.textContent = clipboardLabel;
            clipboardBtn.setAttribute("aria-label", "Panodaki metni ilet");
            clipboardBtn.removeAttribute("data-pending-clip");
            clipboardBtn.title = "Panodaki metni ilet";
          }

          function setClipPending(text) {
            pendingClipText = text;
            clipboardBtn.textContent = clipboardConfirmLabel;
            clipboardBtn.setAttribute("aria-label", "Panodaki metni onayla ve gönder");
            clipboardBtn.setAttribute("data-pending-clip", "1");
            clipboardBtn.title = "Onayla ve panodaki metni gönder";
            const snippet = clipPreviewSnippet(text);
            const hint = snippet
              ? 'Panodaki metin hazır: "' + snippet + '" Göndermek için tekrar bas.'
              : 'Panodaki metin hazır: "" Göndermek için tekrar bas.';
            setSendHint(hint);
          }

          async function sendClipText(trimmed) {
            clipboardSending = true;
            clipboardBtn.disabled = true;
            clipboardBtn.setAttribute("aria-busy", "true");
            clipboardBtn.classList.add("chat-compose-clipboard-btn--busy");
            clipboardBtn.textContent = clipboardLoadingLabel;
            setSendHint("");

            try {
              const r = await fetch(TASK_BRIDGE_URL, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({
                  text: trimmed,
                  source: "panel_clipboard",
                }),
              });

              let data = null;
              try {
                data = await r.json();
              } catch {
                data = null;
              }

              if (taskBridgeBlockedResponse(r.status)) {
                const bridgeHint = bridgeBlockedUserHint();
                if (bridgeHint) setSendHint(bridgeHint);
                return;
              }
              if (r.status === 401) {
                setSendHint("Bağlantı doğrulanamadı. Cihaz ayarlarını kontrol edip tekrar dene.");
                return;
              }
              if (!r.ok) {
                setSendHint("İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.");
                return;
              }

              const accepted =
                data && (data.accepted === true || data.accepted === false) ? data.accepted : null;
              if (accepted === false) {
                setSendHint("İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.");
                return;
              }
              setSendHint("Metin iletildi.");
            } catch {
              setSendHint("İletim tamamlanamadı. Bağlantıyı kontrol edip tekrar dene.");
            } finally {
              clipboardSending = false;
              clipboardBtn.disabled = false;
              clipboardBtn.removeAttribute("aria-busy");
              clipboardBtn.classList.remove("chat-compose-clipboard-btn--busy");
              clearClipPending();
            }
          }

          clipboardBtn.addEventListener("click", async () => {
            if (clipboardSending) return;

            if (pendingClipText) {
              const toSend = pendingClipText;
              pendingClipText = null;
              await sendClipText(toSend);
              return;
            }

            try {
              if (!navigator.clipboard || typeof navigator.clipboard.readText !== "function") {
                setSendHint("Panodan okuma bu tarayıcıda desteklenmiyor.");
                return;
              }

              let clipboardText = "";
              try {
                clipboardText = await navigator.clipboard.readText();
              } catch (err) {
                const name = err && typeof err === "object" && "name" in err ? String(err.name) : "";
                if (name === "NotAllowedError") {
                  setSendHint("Pano erişimi reddedildi. Tarayıcı iznini veya sayfa odakını kontrol edin.");
                } else {
                  const msg =
                    err && typeof err === "object" && "message" in err ? String(err.message) : String(err);
                  setSendHint("Panodan okunamadı: " + msg.slice(0, 120));
                }
                return;
              }

              const trimmed = String(clipboardText || "").trim();
              if (!trimmed) {
                setSendHint("Pano boş görünüyor.");
                return;
              }

              setClipPending(trimmed);
            } catch {
              setSendHint("Panodan okunamadı.");
            }
          });
        }

        const voiceBtn = document.getElementById("panel-voice-input");
        const voiceHint = document.getElementById("panel-voice-hint");
        const speechRecognitionSupported = !!(
          window.SpeechRecognition || window.webkitSpeechRecognition
        );
        const VOICE_TITLE_SUPPORTED =
          "Sesle yazma (deneysel — tarayıcı/ağ servisine bağlı)";
        const VOICE_ARIA_SUPPORTED =
          "Sesle yazma, deneysel; tarayıcı ve ağ servisine bağlı";
        const VOICE_TITLE_UNSUPPORTED = "Sesle yazma desteklenmiyor";
        const VOICE_ARIA_UNSUPPORTED =
          "Bu tarayıcıda sesle yazma desteklenmiyor";
        const VOICE_UNSUPPORTED_HINT =
          "Bu tarayıcıda sesle yazma desteklenmiyor.";
        let voiceRec = null;
        let voiceListening = false;
        let voiceStartPending = false;
        let voiceStopRequested = false;
        let voiceGotResult = false;
        let voiceHadError = false;
        let voiceSessionStarted = false;

        function applyVoiceSupportUi() {
          if (!voiceBtn) return;
          if (!speechRecognitionSupported) {
            voiceBtn.disabled = true;
            voiceBtn.setAttribute("aria-disabled", "true");
            voiceBtn.classList.add("chat-compose-voice-btn--unsupported");
            voiceBtn.title = VOICE_TITLE_UNSUPPORTED;
            voiceBtn.setAttribute("aria-label", VOICE_ARIA_UNSUPPORTED);
            setVoiceHint(VOICE_UNSUPPORTED_HINT);
            return;
          }
          voiceBtn.disabled = false;
          voiceBtn.removeAttribute("aria-disabled");
          voiceBtn.classList.remove("chat-compose-voice-btn--unsupported");
          voiceBtn.title = VOICE_TITLE_SUPPORTED;
          voiceBtn.setAttribute("aria-label", VOICE_ARIA_SUPPORTED);
        }

        function setVoiceHint(msg) {
          if (!voiceHint) return;
          const s = panelUserVisibleText(msg != null ? String(msg) : "");
          voiceHint.textContent = s;
          voiceHint.hidden = !s;
        }

        function setVoiceListeningUi(active) {
          voiceListening = active;
          if (voiceBtn) {
            voiceBtn.classList.toggle("chat-compose-voice-btn--listening", active);
            voiceBtn.setAttribute("aria-pressed", active ? "true" : "false");
          }
        }

        function stopVoiceListeningUi() {
          voiceStartPending = false;
          setVoiceListeningUi(false);
        }

        function beginVoiceListeningUi() {
          voiceStartPending = false;
          voiceSessionStarted = true;
          setVoiceListeningUi(true);
        }

        function voiceErrorHint(errorCode) {
          switch (errorCode) {
            case "network":
              return "Tarayıcının ses tanıma servisine ulaşılamıyor; hata mikrofonunuzdan değil ağ veya servis kaynaklı olabilir. Mikrofon iznini, VPN/güvenlik duvarını kontrol edip tekrar deneyin.";
            case "no-speech":
              return "Konuşma algılanmadı.";
            case "audio-capture":
              return "Mikrofon kullanılamıyor.";
            case "service-not-allowed":
            case "not-allowed":
              return "Mikrofon izni verilmedi.";
            case "aborted":
              return "Sesli giriş iptal edildi.";
            default:
              return "Sesli giriş başarısız oldu.";
          }
        }

        function appendVoiceTranscript(chunk) {
          const t = String(chunk || "").trim();
          if (!t) return;
          const cur = input.value;
          const sep = cur && !/\s$/.test(cur) ? " " : "";
          input.value = cur + sep + t;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }

        applyVoiceSupportUi();

        if (speechRecognitionSupported) {
          voiceBtn?.addEventListener("click", () => {
          const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
          if (!SR) return;

          if (voiceListening || voiceStartPending) {
            if (voiceRec) {
              voiceStopRequested = true;
              try {
                voiceRec.stop();
              } catch {
                /* ignore */
              }
            }
            return;
          }

          voiceRec = new SR();
          voiceRec.lang = "tr-TR";
          voiceRec.interimResults = false;
          voiceRec.continuous = false;
          voiceRec.maxAlternatives = 1;

          voiceStartPending = true;
          voiceStopRequested = false;
          voiceGotResult = false;
          voiceHadError = false;
          voiceSessionStarted = false;
          setVoiceHint("");

          voiceRec.onstart = () => {
            beginVoiceListeningUi();
          };

          voiceRec.onaudiostart = () => {
            if (!voiceListening) beginVoiceListeningUi();
          };

          voiceRec.onresult = (ev) => {
            let spoken = "";
            for (let i = ev.resultIndex; i < ev.results.length; i++) {
              spoken += ev.results[i][0].transcript;
            }
            const trimmed = String(spoken || "").trim();
            if (!trimmed) return;
            voiceGotResult = true;
            appendVoiceTranscript(spoken);
            if (voiceHint) voiceHint.hidden = true;
          };

          voiceRec.onerror = (ev) => {
            const code = ev.error || "";
            if (code !== "aborted" || !voiceStopRequested) {
              setVoiceHint(voiceErrorHint(code));
              voiceHadError = true;
            }
            stopVoiceListeningUi();
          };

          voiceRec.onend = () => {
            const userStopped = voiceStopRequested;
            const gotResult = voiceGotResult;
            const hadError = voiceHadError;
            const sessionStarted = voiceSessionStarted;
            const startPendingButNeverStarted =
              voiceStartPending && !voiceSessionStarted;
            stopVoiceListeningUi();
            voiceStopRequested = false;
            voiceGotResult = false;
            voiceHadError = false;
            voiceSessionStarted = false;
            if (gotResult || userStopped || hadError) return;
            if (startPendingButNeverStarted) {
              setVoiceHint("Ses tanıma başlatılamadı. Tekrar deneyin.");
              return;
            }
            if (sessionStarted) {
              setVoiceHint(
                "Ses algılanmadı veya tarayıcı konuşma sonucu üretmedi. Tekrar deneyin."
              );
            }
          };

          try {
            voiceRec.start();
          } catch {
            stopVoiceListeningUi();
            setVoiceHint("Ses tanıma başlatılamadı. Tekrar deneyin.");
          }
        });
        }

        function syncCameraPhotoStatusVisibilityForViewport() {
          if (!cameraPhotoStatus || !cameraPhotoObjectUrl) return;
          cameraPhotoStatus.hidden = isPanelCameraNativeCapture();
        }

        function onPanelCameraViewportChange() {
          if (isPanelCameraNativeCapture() && cameraStream) stopPanelCameraStream();
          syncPanelCameraPhotoBarVisibility();
          syncCameraPhotoStatusVisibilityForViewport();
        }

        mqPanelCameraMobile.addEventListener("change", onPanelCameraViewportChange);
        mqPanelChatTouchPrimary.addEventListener("change", onPanelCameraViewportChange);
        syncPanelCameraPhotoBarVisibility();

        function panelAttachMenuGapPx() {
          const root = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
          return root * 0.4;
        }

        function positionPanelAttachMenu() {
          if (!attachMenu || !attachToggle || attachMenu.hidden) return;
          const btn = attachToggle.getBoundingClientRect();
          const menu = attachMenu.getBoundingClientRect();
          const gap = panelAttachMenuGapPx();
          const margin = Math.max(8, gap);
          const menuW = menu.width;
          const menuH = menu.height;

          let left = btn.left;
          let top = btn.top - menuH - gap;

          if (top < margin) {
            const below = btn.bottom + gap;
            if (below + menuH + margin <= window.innerHeight) {
              top = below;
            } else {
              top = Math.max(margin, top);
            }
          }

          left = Math.max(margin, Math.min(left, window.innerWidth - menuW - margin));
          top = Math.max(margin, Math.min(top, window.innerHeight - menuH - margin));

          attachMenu.style.top = `${Math.round(top)}px`;
          attachMenu.style.left = `${Math.round(left)}px`;
        }

        function closePanelAttachMenu() {
          if (!attachMenu || !attachToggle) return;
          attachMenu.hidden = true;
          attachMenu.classList.remove("chat-compose-attach-menu--fixed");
          attachMenu.style.top = "";
          attachMenu.style.left = "";
          attachToggle.setAttribute("aria-expanded", "false");
          attachToggle.classList.remove("chat-compose-attach-btn--open");
        }

        function openPanelAttachMenu() {
          if (!attachMenu || !attachToggle) return;
          attachMenu.hidden = false;
          attachMenu.classList.add("chat-compose-attach-menu--fixed");
          attachToggle.setAttribute("aria-expanded", "true");
          attachToggle.classList.add("chat-compose-attach-btn--open");
          requestAnimationFrame(() => {
            positionPanelAttachMenu();
          });
        }

        function onPanelAttachMenuViewportChange() {
          if (!attachMenu || attachMenu.hidden) return;
          positionPanelAttachMenu();
        }

        window.addEventListener("resize", onPanelAttachMenuViewportChange);
        window.addEventListener("scroll", onPanelAttachMenuViewportChange, true);

        function switchPanelModule(moduleId) {
          const navBtn = nav.querySelector(`button[data-module="${moduleId}"]`);
          if (navBtn instanceof HTMLButtonElement) {
            navBtn.click();
            return;
          }
          nav.querySelectorAll("button[data-module]").forEach((b) => {
            b.setAttribute("aria-current", b.getAttribute("data-module") === moduleId ? "true" : "false");
          });
          panels.forEach((p) => {
            p.setAttribute("data-active", p.getAttribute("data-module-panel") === moduleId ? "true" : "false");
          });
        }

        function triggerPanelCameraPhotoInput(mode) {
          if (!cameraPhotoInput) {
            setCameraHint(
              mode === "camera"
                ? "Bu tarayıcıda kamera desteklenmiyor."
                : "Bu tarayıcıda görsel seçimi desteklenmiyor.",
            );
            return;
          }
          if (mode === "camera") {
            closePanelAttachMenu();
            stopPanelCameraStream();
            setCameraHint("");
            cameraPhotoInput.setAttribute("capture", "environment");
            cameraPhotoInput.click();
            return;
          }
          stopPanelCameraStream();
          setCameraHint("");
          cameraPhotoInput.removeAttribute("capture");
          cameraPhotoInput.click();
        }

        const audioRecordPreviewWrap = document.getElementById("panel-audio-record-preview-wrap");
        const audioRecordPlayer = /** @type {HTMLAudioElement | null} */ (
          document.getElementById("panel-audio-record-player")
        );
        const audioRecordStatus = document.getElementById("panel-audio-record-status");
        const audioRecordHint = document.getElementById("panel-audio-record-hint");
        const audioRecordStopBtn = document.getElementById("panel-audio-record-stop");
        const audioRecordCancelBtn = document.getElementById("panel-audio-record-cancel");
        const audioRecordRerecordBtn = document.getElementById("panel-audio-record-rerecord");
        const attachRecordMenuItem = attachMenu?.querySelector('[data-attach-action="record"]');

        const AUDIO_RECORD_PREVIEW_LABEL = "Ses kaydı önizlemesi (henüz gönderilemez)";
        const AUDIO_RECORD_UNSUPPORTED_HINT = "Bu tarayıcıda ses kaydı desteklenmiyor.";

        /** @type {MediaRecorder | null} */
        let mediaRecorder = null;
        /** @type {MediaStream | null} */
        let audioRecordStream = null;
        /** @type {BlobPart[]} */
        let audioRecordChunks = [];
        /** @type {string | null} */
        let audioRecordObjectUrl = null;
        let isAudioRecording = false;

        function isAudioRecordSupported() {
          return !!(
            navigator.mediaDevices &&
            typeof navigator.mediaDevices.getUserMedia === "function" &&
            typeof MediaRecorder !== "undefined"
          );
        }

        function pickAudioRecordMimeType() {
          const candidates = ["audio/webm;codecs=opus", "audio/mp4", "audio/webm"];
          if (typeof MediaRecorder.isTypeSupported !== "function") return "";
          for (const t of candidates) {
            if (MediaRecorder.isTypeSupported(t)) return t;
          }
          return "";
        }

        function setAudioRecordHint(msg) {
          if (!audioRecordHint) return;
          const s = panelUserVisibleText(msg != null ? String(msg) : "");
          audioRecordHint.textContent = s;
          audioRecordHint.hidden = !s;
        }

        function applyAudioRecordSupportUi() {
          const supported = isAudioRecordSupported();
          if (attachRecordMenuItem instanceof HTMLButtonElement) {
            attachRecordMenuItem.disabled = !supported;
            attachRecordMenuItem.setAttribute("aria-disabled", supported ? "false" : "true");
            attachRecordMenuItem.classList.toggle("chat-compose-attach-menu__item--unsupported", !supported);
          }
          if (!supported) {
            setAudioRecordHint(AUDIO_RECORD_UNSUPPORTED_HINT);
          } else if (!isAudioRecording && !audioRecordObjectUrl) {
            setAudioRecordHint("");
          }
        }

        function revokeAudioRecordObjectUrl() {
          if (!audioRecordObjectUrl) return;
          try {
            URL.revokeObjectURL(audioRecordObjectUrl);
          } catch {
            /* ignore */
          }
          audioRecordObjectUrl = null;
        }

        function stopAudioRecordStream() {
          if (audioRecordStream) {
            audioRecordStream.getTracks().forEach((tr) => tr.stop());
            audioRecordStream = null;
          }
        }

        function syncAudioRecordPreviewVisibility() {
          if (!audioRecordPreviewWrap) return;
          audioRecordPreviewWrap.hidden = !(isAudioRecording || !!audioRecordObjectUrl);
        }

        function syncAudioRecordControlsUi() {
          if (audioRecordStopBtn) audioRecordStopBtn.hidden = !isAudioRecording;
          if (audioRecordCancelBtn) {
            audioRecordCancelBtn.hidden = !isAudioRecording && !audioRecordObjectUrl;
          }
          if (audioRecordRerecordBtn) {
            audioRecordRerecordBtn.hidden = isAudioRecording || !audioRecordObjectUrl;
          }
          if (audioRecordPlayer) {
            audioRecordPlayer.hidden = isAudioRecording || !audioRecordObjectUrl;
          }
          if (audioRecordStatus) {
            if (isAudioRecording) {
              audioRecordStatus.textContent = "Kayıt yapılıyor…";
            } else if (audioRecordObjectUrl) {
              audioRecordStatus.textContent = AUDIO_RECORD_PREVIEW_LABEL;
            } else {
              audioRecordStatus.textContent = "";
            }
          }
        }

        function clearPanelAudioRecordSelection() {
          const rec = mediaRecorder;
          mediaRecorder = null;
          if (rec) {
            rec.onstop = null;
            rec.onerror = null;
            rec.ondataavailable = null;
            if (rec.state !== "inactive") {
              try {
                rec.stop();
              } catch {
                /* ignore */
              }
            }
          }
          audioRecordChunks = [];
          isAudioRecording = false;
          revokeAudioRecordObjectUrl();
          stopAudioRecordStream();
          if (audioRecordPlayer) {
            audioRecordPlayer.pause();
            audioRecordPlayer.removeAttribute("src");
            audioRecordPlayer.load();
            audioRecordPlayer.hidden = true;
          }
          syncAudioRecordControlsUi();
          syncAudioRecordPreviewVisibility();
          if (isAudioRecordSupported()) setAudioRecordHint("");
        }

        function bindAudioRecordFromBlob(blob) {
          if (!blob || blob.size < 512) {
            setAudioRecordHint("Kayıt çok kısa veya boş; tekrar deneyin.");
            clearPanelAudioRecordSelection();
            return;
          }
          revokeAudioRecordObjectUrl();
          audioRecordObjectUrl = URL.createObjectURL(blob);
          if (audioRecordPlayer) {
            audioRecordPlayer.src = audioRecordObjectUrl;
            audioRecordPlayer.hidden = false;
          }
          isAudioRecording = false;
          syncAudioRecordControlsUi();
          syncAudioRecordPreviewVisibility();
          setAudioRecordHint("");
        }

        function stopPanelAudioRecording() {
          if (!mediaRecorder || mediaRecorder.state === "inactive") return;
          try {
            mediaRecorder.stop();
          } catch {
            setAudioRecordHint("Kayıt durdurulamadı.");
            clearPanelAudioRecordSelection();
          }
        }

        function startPanelAudioRecording() {
          clearPanelAudioRecordSelection();
          if (!isAudioRecordSupported()) {
            setAudioRecordHint(AUDIO_RECORD_UNSUPPORTED_HINT);
            return;
          }
          setAudioRecordHint("");
          navigator.mediaDevices
            .getUserMedia({ audio: true })
            .then((stream) => {
              audioRecordStream = stream;
              audioRecordChunks = [];
              const mimeType = pickAudioRecordMimeType();
              const options = mimeType ? { mimeType } : undefined;
              let rec;
              try {
                rec = options ? new MediaRecorder(stream, options) : new MediaRecorder(stream);
              } catch {
                stopAudioRecordStream();
                setAudioRecordHint("Bu tarayıcıda ses kaydı başlatılamadı.");
                return;
              }
              mediaRecorder = rec;
              mediaRecorder.ondataavailable = (ev) => {
                if (ev.data && ev.data.size > 0) audioRecordChunks.push(ev.data);
              };
              mediaRecorder.onstop = () => {
                stopAudioRecordStream();
                const type = rec.mimeType || mimeType || "audio/webm";
                const blob = new Blob(audioRecordChunks, { type });
                mediaRecorder = null;
                audioRecordChunks = [];
                bindAudioRecordFromBlob(blob);
              };
              mediaRecorder.onerror = () => {
                setAudioRecordHint("Kayıt sırasında hata oluştu.");
                clearPanelAudioRecordSelection();
              };
              mediaRecorder.start();
              isAudioRecording = true;
              syncAudioRecordControlsUi();
              syncAudioRecordPreviewVisibility();
            })
            .catch((err) => {
              const name = err && err.name;
              if (name === "NotAllowedError" || name === "PermissionDeniedError") {
                setAudioRecordHint("Mikrofon izni verilmedi.");
              } else {
                setAudioRecordHint("Mikrofon kullanılamıyor.");
              }
              clearPanelAudioRecordSelection();
            });
        }

        applyAudioRecordSupportUi();

        audioRecordStopBtn?.addEventListener("click", () => {
          stopPanelAudioRecording();
        });

        audioRecordCancelBtn?.addEventListener("click", () => {
          clearPanelAudioRecordSelection();
        });

        audioRecordRerecordBtn?.addEventListener("click", () => {
          clearPanelAudioRecordSelection();
          startPanelAudioRecording();
        });

        function onDocVisibilityForCamera() {
          if (document.hidden) {
            stopPanelCameraStream();
            if (isAudioRecording) clearPanelAudioRecordSelection();
          }
        }

        function onPanelPageHide() {
          stopPanelCameraStream();
          clearPanelAudioRecordSelection();
        }

        document.addEventListener("visibilitychange", onDocVisibilityForCamera);
        window.addEventListener("pagehide", onPanelPageHide);

        attachToggle?.addEventListener("click", (e) => {
          e.stopPropagation();
          if (!attachMenu) return;
          if (attachMenu.hidden) openPanelAttachMenu();
          else closePanelAttachMenu();
        });

        attachMenu?.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLElement)) return;
          const item = t.closest("[data-attach-action]");
          if (!(item instanceof HTMLElement)) return;
          const action = item.getAttribute("data-attach-action");
          closePanelAttachMenu();
          if (action === "file") {
            switchPanelModule("dosyalar");
            const dosyaInput = document.getElementById("dosyalar-file-input");
            const dosyaHint = document.getElementById("dosyalar-hint");
            if (dosyaHint) {
              dosyaHint.textContent = "Dosyayı seçin; ardından «Yükle ve analiz et».";
              dosyaHint.hidden = false;
            }
            if (dosyaInput instanceof HTMLInputElement) {
              window.setTimeout(() => {
                try {
                  dosyaInput.click();
                } catch {
                  /* tarayıcı engeli */
                }
              }, 120);
            } else {
              setCameraHint("Dosya yükleme bu görünümde hazırlanıyor.");
            }
            return;
          }
          if (action === "photo") {
            triggerPanelCameraPhotoInput("photo");
            return;
          }
          if (action === "camera") {
            triggerPanelCameraPhotoInput("camera");
            return;
          }
          if (action === "clipboard") {
            clipboardBtn?.click();
            return;
          }
          if (action === "audio") {
            if (attachAudioInput) {
              attachAudioInput.click();
            } else {
              setCameraHint("Ses dosyasını sohbete ekleme yakında.");
            }
            return;
          }
          if (action === "record") {
            if (!isAudioRecordSupported()) {
              setAudioRecordHint(AUDIO_RECORD_UNSUPPORTED_HINT);
              return;
            }
            startPanelAudioRecording();
          }
        });

        document.addEventListener("click", (e) => {
          if (!attachMenu || attachMenu.hidden) return;
          const t = e.target;
          if (!(t instanceof Node)) return;
          if (attachToggle?.contains(t) || attachMenu.contains(t)) return;
          closePanelAttachMenu();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closePanelAttachMenu();
        });

        attachAudioInput?.addEventListener("change", () => {
          const f = attachAudioInput.files && attachAudioInput.files[0];
          attachAudioInput.value = "";
          if (!f) return;
          const name = f.name && String(f.name).trim() ? String(f.name).trim() : "ses dosyası";
          setCameraHint(`«${name}» — sohbete ses ekleme yakında.`);
        });

        cameraBtn?.addEventListener("click", () => {
          closePanelAttachMenu();
          triggerPanelCameraPhotoInput("camera");
        });

        cameraPhotoInput?.addEventListener("change", () => {
          const f = cameraPhotoInput.files && cameraPhotoInput.files[0];
          if (!f) return;
          bindCameraPhotoFromFile(f);
        });
      }

      function wireGorevlerPrototype() {
        const listEl = document.getElementById("gorevler-list");
        const titleInput = document.getElementById("gorevler-title-input");
        const prioritySel = document.getElementById("gorevler-priority");
