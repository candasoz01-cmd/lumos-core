import os
import json
import time
from pathlib import Path
from getpass import getpass

from security.permissions import PermissionManager
from security.keystore import FileKeyStore
from memory.secure_store import SecureNotesStore

from core.lumos import Lumos
from context.context import Context
from policy.offline_engine import OfflineEngineV1
from engine.online_engine import OnlineEngineV1


def _base_dir() -> str:
    if Path("src/.lumos").exists():
        return "src/.lumos"
    if Path(".lumos").exists():
        return ".lumos"
    return "src/.lumos"


def _read_identity(base_dir: str) -> dict:
    try:
        p = Path(base_dir) / "identity.json"
        if not p.exists():
            return {}
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return {}


def main() -> None:
    MODE = os.getenv("LUMOS_MODE", "offline").strip() or "offline"

    perm = PermissionManager(enabled=True)

    offline_engine = OfflineEngineV1(perm=perm)
    engine = offline_engine if MODE == "offline" else OnlineEngineV1()

    lumos = Lumos(mode=MODE, engine=engine)
    lumos.boot()

    base_dir = _base_dir()

    unlocked = False

    auto_lock_enabled = True
    auto_lock_timeout = 60
    last_activity = time.time()

    ident = _read_identity(base_dir)
    lumos_id = str(ident.get("lumos_id", "")).strip()

    def lock_now() -> None:
        nonlocal unlocked, last_activity
        unlocked = False
        last_activity = time.time()
        try:
            lumos.note_memory.root_key = None
        except Exception:
            pass
        try:
            lumos.note_memory._is_unlocked = False
        except Exception:
            pass

    def unlock_with_passphrase(passphrase: str) -> tuple[bool, str]:
        nonlocal unlocked, last_activity
        passphrase = (passphrase or "").strip()
        if not passphrase:
            return False, "EMPTY"

        try:
            ks = FileKeyStore(base_dir=base_dir)
            root_key = ks.load_root_key(passphrase)

            store = SecureNotesStore(base_dir=base_dir)
            lumos.note_memory.attach_store(store, root_key)

            unlocked = True
            last_activity = time.time()
            return True, "OK"
        except Exception:
            unlocked = False
            return False, "FAIL"

    def lock_status() -> str:
        return "UNLOCKED" if unlocked else "LOCKED"

    def lock_console() -> None:
        print("LOCK")
        while True:
            cmd = input("Kilit> ").strip().lower()
            if not cmd:
                continue

            if cmd in ["cik", "çık", "exit", "quit"]:
                print("OK")
                return

            if cmd in ["durum", "status"]:
                print(lock_status())
                continue

            if cmd in ["ac", "aç"]:
                p = getpass("Passphrase: ")
                ok, _ = unlock_with_passphrase(p)
                print("OK" if ok else "FAIL")
                continue

            if cmd in ["kapat", "lock"]:
                lock_now()
                print("OK")
                continue

            print("ERR")

    if MODE == "offline":
        offline_engine.unlock_cb = unlock_with_passphrase
        offline_engine.lock_cb = lock_now
        offline_engine.lock_status_cb = lambda: {"response": lock_status()}

    env_pass = os.getenv("LUMOS_PASSPHRASE", "").strip()
    if env_pass:
        ok, _ = unlock_with_passphrase(env_pass)
        if os.getenv("LUMOS_DEBUG", "0") == "1":
            print("[MEM] " + ("OK" if ok else "FAIL"))

    if os.getenv("LUMOS_DEBUG", "0") == "1":
        print(f"[ID] lumos_id={'OK' if lumos_id else 'MISSING'}")

    while True:
        if unlocked and auto_lock_enabled:
            if time.time() - last_activity > auto_lock_timeout:
                lock_now()
                print("AUTO-LOCK")
                continue

        user_in = input("Sen: ").strip()
        if not user_in:
            continue

        low = user_in.lower().strip()

        if low in ["exit", "quit", "çık", "cik"]:
            break

        if not unlocked:
            if low in ["kilit", "lock"]:
                lock_console()
                continue
            print("LOCKED")
            continue

        last_activity = time.time()

        if low.startswith("autolock"):
            parts = low.split()
            if len(parts) == 1 or (len(parts) >= 2 and parts[1] in ["durum", "status"]):
                state = "ON" if auto_lock_enabled else "OFF"
                print(f"AUTOLOCK: {state} ({auto_lock_timeout}s)")
                continue

            if len(parts) >= 2 and parts[1] in ["kapat", "off"]:
                auto_lock_enabled = False
                print("AUTOLOCK: OFF")
                continue

            if len(parts) >= 2 and parts[1] in ["ac", "on"]:
                auto_lock_enabled = True
                print(f"AUTOLOCK: ON ({auto_lock_timeout}s)")
                continue

            if len(parts) >= 2 and parts[1].isdigit():
                t = int(parts[1])
                if t < 10:
                    t = 10
                auto_lock_enabled = True
                auto_lock_timeout = t
                print(f"AUTOLOCK: {auto_lock_timeout}s")
                continue

            print("ERR")
            continue

        if low in ["reset", "sil", "temizle"]:
            lumos.session_memory.clear()
            print("OK")
            continue

        ctx = Context(
            message=user_in,
            online=(MODE == "online"),
            confidence=0.9,
            user_is_child=False,
            lumos_id=lumos_id,
            unlocked=True
        )

        out = lumos.respond(ctx)
        if out:
            print(f"Lumos: {out}")

        if os.getenv("LUMOS_DEBUG", "0") == "1":
            snap = perm.snapshot()
            print(f"[PERM] {snap}")


if __name__ == "__main__":
    main()
