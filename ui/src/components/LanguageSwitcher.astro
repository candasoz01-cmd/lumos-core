---
/** TR / EN header control — wired by src/i18n/runtime.ts */
---

<div class="lumos-lang-switch" role="group" aria-label="" data-i18n-aria-label="lang.switchLabel">
  <button type="button" class="lumos-lang-btn" data-set-locale="tr" data-i18n="lang.tr" aria-pressed="true">
    TR
  </button>
  <button type="button" class="lumos-lang-btn" data-set-locale="en" data-i18n="lang.en" aria-pressed="false">
    EN
  </button>
</div>

<style>
  .lumos-lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.12rem;
    border-radius: 999px;
    border: 1px solid var(--lumos-border);
    background: var(--lumos-surface);
    box-shadow: var(--panel-edge-inset, inset 0 1px 0 rgba(255, 255, 255, 0.04));
  }
  .lumos-lang-btn {
    min-width: 2.1rem;
    padding: 0.28rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--lumos-text-soft);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .lumos-lang-btn:hover,
  .lumos-lang-btn:focus-visible {
    color: var(--lumos-text);
    border-color: var(--lumos-teal-28);
    background: rgb(var(--lumos-land-teal) / 0.08);
  }
  .lumos-lang-btn--active,
  .lumos-lang-btn[aria-pressed="true"] {
    color: #0a0e14;
    background: var(--lumos-accent-primary);
    border-color: rgb(var(--lumos-land-teal) / 0.55);
    box-shadow: 0 1px 4px rgb(var(--lumos-land-teal) / 0.2);
  }
  .lumos-lang-btn:focus-visible {
    outline: 2px solid var(--lumos-teal-38);
    outline-offset: 2px;
  }
</style>
