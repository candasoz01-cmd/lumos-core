      const RESOURCE_MODE_ADVISOR_LAYER = "quantum";
      const RESOURCE_MODE_ADVISOR_POLL_MS = 60000;
      const RESOURCE_MODE_ADVISOR_FETCH_BACKOFF_INITIAL_MS = 15000;
      const RESOURCE_MODE_ADVISOR_FETCH_BACKOFF_MAX_MS = 300000;
      let resourceModeAdvisorDismissed = false;
      /** @type {null | Record<string, unknown>} */
      let resourceModeAdvisorProposal = null;
      let resourceModeAdvisorPollTimer = null;
      let resourceModeAdvisorCardVisible = false;
      let resourceModeAdvisorLastHash = "";
      let resourceModeAdvisorRefreshInFlight = false;
      let resourceModeAdvisorLastFetchAt = 0;
      let resourceModeAdvisorFetchBackoffMs = 0;

      function resourceModeAdvisorModeLabel(mode) {
        const key = String(mode || "").trim().toLowerCase();
        const label = panelT(`panel.modules.resourceModeAdvisor.modes.${key}`);
        if (label && !label.startsWith("panel.modules.resourceModeAdvisor")) return label;
        return String(mode || "—");
      }

      function resourceModeAdvisorModeHint(mode) {
        const key = String(mode || "").trim().toLowerCase();
        const hint = panelT(`panel.modules.resourceModeAdvisor.hints.${key}`);
        if (hint && !hint.startsWith("panel.modules.resourceModeAdvisor")) return hint;
        return panelT("panel.modules.resourceModeAdvisor.hints.passive");
      }

      function resourceModeAdvisorLayerLabel(layer) {
        const key = String(layer || "").trim().toLowerCase();
        const label = panelT(`panel.modules.resourceModeAdvisor.layers.${key}`);
        if (label && !label.startsWith("panel.modules.resourceModeAdvisor")) return label;
        if (!key) return "—";
        return key.charAt(0).toUpperCase() + key.slice(1);
      }

      function applyResourceModeAdvisorLayerDot(layer) {
        const dot = document.getElementById("panel-resource-mode-advisor-layer-dot");
        if (!dot) return;
        const key = String(layer || "").trim().toLowerCase();
        dot.className = "panel-resource-mode-advisor__layer-dot";
        if (key === "quantum") {
          dot.classList.add("panel-resource-mode-advisor__layer-dot--quantum");
        } else {
          dot.classList.add("panel-resource-mode-advisor__layer-dot--default");
        }
      }

      function canShowResourceModeAdvisorCard() {
        if (resourceModeAdvisorDismissed) return false;
        if (getPanelUserMode() === "offline") return false;
        const tasksReachable =
          !!resolveGorevlerTasksApiBase() && !shouldSkipGorevlerTasksApi();
        const badge = document.getElementById("panel-conn-badge");
        const bridgeOk = badge && badge.getAttribute("data-state") === "ok";
        if (getPanelUserMode() === "limited") {
          return tasksReachable || bridgeOk;
        }
        return tasksReachable || bridgeOk;
      }

      async function fetchResourceModeProposal() {
        const base = resolveGorevlerTasksApiBase();
        if (!base || shouldSkipGorevlerTasksApi()) return { ok: false };
        try {
          const r = await fetch(
            `${base}/resource-mode/propose?layer=${encodeURIComponent(RESOURCE_MODE_ADVISOR_LAYER)}`,
            { headers: { Accept: "application/json" } },
          );
          if (!r.ok) return { ok: false };
          const data = await r.json();
          if (!data || data.ok !== true || !data.proposal) return { ok: false };
          return data;
        } catch {
          return { ok: false };
        }
      }

      function shouldDisplayResourceModeCard(data) {
        if (!data || data.show_card !== true) return false;
        const proposal = data.proposal;
        if (!proposal || proposal.never_auto !== true) return false;
        const current = proposal.current_mode;
        const proposed = proposal.proposed_mode;
        if (!proposed || current === proposed) return false;
        return true;
      }

      function resourceModeProposalDisplayHash(data) {
        if (!data || !shouldDisplayResourceModeCard(data)) return "";
        const proposal = data.proposal;
        if (!proposal || typeof proposal !== "object") return "";
        return [
          String(proposal.layer || RESOURCE_MODE_ADVISOR_LAYER),
          String(proposal.current_mode || ""),
          String(proposal.proposed_mode || proposal.recommended_mode || ""),
          String(proposal.reason || "").trim(),
          String(data.show_card === true),
        ].join("\u0001");
      }

      function bumpResourceModeAdvisorFetchBackoff() {
        if (resourceModeAdvisorFetchBackoffMs <= 0) {
          resourceModeAdvisorFetchBackoffMs = RESOURCE_MODE_ADVISOR_FETCH_BACKOFF_INITIAL_MS;
          return;
        }
        resourceModeAdvisorFetchBackoffMs = Math.min(
          resourceModeAdvisorFetchBackoffMs * 2,
          RESOURCE_MODE_ADVISOR_FETCH_BACKOFF_MAX_MS,
        );
      }

      function resetResourceModeAdvisorFetchBackoff() {
        resourceModeAdvisorFetchBackoffMs = 0;
      }

      function shouldDeferResourceModeAdvisorFetch() {
        if (resourceModeAdvisorFetchBackoffMs <= 0) return false;
        return Date.now() - resourceModeAdvisorLastFetchAt < resourceModeAdvisorFetchBackoffMs;
      }

      function paintResourceModeAdvisorCard(proposal, displayHash, forceRepaint) {
        const card = document.getElementById("panel-resource-mode-advisor");
        const layerEl = document.getElementById("panel-resource-mode-advisor-layer");
        const statusEl = document.getElementById("panel-resource-mode-advisor-status");
        const reasonEl = document.getElementById("panel-resource-mode-advisor-reason");
        const hintEl = document.getElementById("panel-resource-mode-advisor-hint");
        if (!card || !layerEl || !statusEl || !reasonEl || !hintEl || !proposal) return;
        const hash = String(displayHash || "");
        if (!forceRepaint && resourceModeAdvisorCardVisible && hash && hash === resourceModeAdvisorLastHash) {
          return;
        }
        const layerKey = String(proposal.layer || RESOURCE_MODE_ADVISOR_LAYER);
        layerEl.textContent = resourceModeAdvisorLayerLabel(layerKey);
        applyResourceModeAdvisorLayerDot(layerKey);
        const proposedMode = proposal.proposed_mode || proposal.recommended_mode || "passive";
        statusEl.textContent = resourceModeAdvisorModeLabel(proposedMode);
        const reason = String(proposal.reason || "").trim();
        reasonEl.textContent = reason || panelT("panel.modules.resourceModeAdvisor.reasonFallback");
        hintEl.textContent = resourceModeAdvisorModeHint(proposedMode);
        resourceModeAdvisorLastHash = hash;
        if (card.hidden) card.hidden = false;
        resourceModeAdvisorCardVisible = true;
      }

      function hideResourceModeAdvisorCard() {
        const card = document.getElementById("panel-resource-mode-advisor");
        if (!card || (!resourceModeAdvisorCardVisible && card.hidden)) return;
        if (!card.hidden) card.hidden = true;
        resourceModeAdvisorCardVisible = false;
        resourceModeAdvisorLastHash = "";
      }

      function setResourceModeAdvisorBusy(busy) {
        const acceptBtn = document.getElementById("panel-resource-mode-advisor-accept");
        const rejectBtn = document.getElementById("panel-resource-mode-advisor-reject");
        if (acceptBtn instanceof HTMLButtonElement) acceptBtn.disabled = !!busy;
        if (rejectBtn instanceof HTMLButtonElement) rejectBtn.disabled = !!busy;
      }

      async function applyResourceModeDecision(userApproved) {
        const proposal = resourceModeAdvisorProposal;
        const base = resolveGorevlerTasksApiBase();
        if (!proposal || !base || shouldSkipGorevlerTasksApi()) return;
        setResourceModeAdvisorBusy(true);
        try {
          const r = await fetch(`${base}/resource-mode/apply`, {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({
              layer: proposal.layer || RESOURCE_MODE_ADVISOR_LAYER,
              mode: proposal.proposed_mode,
              user_approved: userApproved === true,
            }),
          });
          if (!r.ok) return;
          const data = await r.json();
          if (!data) return;
          if (userApproved === true && data.ok !== true) return;
        } catch {
          return;
        } finally {
          setResourceModeAdvisorBusy(false);
        }
        resourceModeAdvisorDismissed = true;
        resourceModeAdvisorProposal = null;
        hideResourceModeAdvisorCard();
      }

      async function refreshResourceModeAdvisorPanel() {
        if (resourceModeAdvisorDismissed) {
          hideResourceModeAdvisorCard();
          return;
        }
        if (!canShowResourceModeAdvisorCard()) {
          hideResourceModeAdvisorCard();
          return;
        }
        if (shouldDeferResourceModeAdvisorFetch()) return;
        if (resourceModeAdvisorRefreshInFlight) return;
        resourceModeAdvisorRefreshInFlight = true;
        resourceModeAdvisorLastFetchAt = Date.now();
        try {
          const data = await fetchResourceModeProposal();
          if (!shouldDisplayResourceModeCard(data)) {
            bumpResourceModeAdvisorFetchBackoff();
            if (resourceModeAdvisorCardVisible) {
              resourceModeAdvisorProposal = null;
              hideResourceModeAdvisorCard();
            }
            return;
          }
          resetResourceModeAdvisorFetchBackoff();
          const displayHash = resourceModeProposalDisplayHash(data);
          resourceModeAdvisorProposal = data.proposal;
          paintResourceModeAdvisorCard(data.proposal, displayHash);
        } finally {
          resourceModeAdvisorRefreshInFlight = false;
        }
      }

      function refreshPanelResourceModeAdvisorI18n() {
        if (resourceModeAdvisorProposal && resourceModeAdvisorCardVisible) {
          paintResourceModeAdvisorCard(
            resourceModeAdvisorProposal,
            resourceModeAdvisorLastHash,
            true,
          );
        }
      }

      function wireResourceModeAdvisorControls() {
        const acceptBtn = document.getElementById("panel-resource-mode-advisor-accept");
        const rejectBtn = document.getElementById("panel-resource-mode-advisor-reject");
        if (acceptBtn && acceptBtn.dataset.oraaWired !== "1") {
          acceptBtn.dataset.oraaWired = "1";
          acceptBtn.addEventListener("click", () => {
            applyResourceModeDecision(true);
          });
        }
        if (rejectBtn && rejectBtn.dataset.oraaWired !== "1") {
          rejectBtn.dataset.oraaWired = "1";
          rejectBtn.addEventListener("click", () => {
            applyResourceModeDecision(false);
          });
        }
      }

      function scheduleResourceModeAdvisorPoll() {
        if (resourceModeAdvisorPollTimer != null) return;
        resourceModeAdvisorPollTimer = window.setInterval(() => {
          refreshResourceModeAdvisorPanel();
        }, RESOURCE_MODE_ADVISOR_POLL_MS);
      }

      async function refreshGorevlerEvidenceStrip() {
        const stripEl = document.getElementById("gorevler-evidence-strip");
        const summaryEl = document.getElementById("gorevler-evidence-summary");
        const continueBtn = document.getElementById("gorevler-evidence-continue");
        const emptyEl = document.getElementById("gorevler-evidence-empty");
        if (!stripEl || !summaryEl || !continueBtn || !emptyEl) return;

        const fetched = await fetchEvidenceRecent();
        if (!fetched.ok) {
          panelEvidenceLatestGroup = null;
          stripEl.hidden = true;
          emptyEl.hidden = false;
          emptyEl.textContent = panelT("panel.modules.tasks.empty.evidenceUnreachable");
          continueBtn.hidden = true;
          return;
        }

        const groups = groupEvidenceEventsForUi(fetched.events);
        const latest = pickLatestEvidenceGroup(groups);
        if (!latest) {
          panelEvidenceLatestGroup = null;
          stripEl.hidden = true;
          emptyEl.hidden = false;
          emptyEl.textContent = panelT("panel.modules.tasks.empty.evidence");
          continueBtn.hidden = true;
          return;
        }

        panelEvidenceLatestGroup = latest;
