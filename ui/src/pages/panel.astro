      function wirePanelUserMode() {
        const inputs = document.querySelectorAll('input[name="panel-user-mode"]');
        const badge = document.getElementById("panel-user-mode-badge");
        const menu = document.getElementById("panel-user-mode-menu");
        const menuItems = menu
          ? Array.from(menu.querySelectorAll("[data-mode]")).filter(
              (el) => el instanceof HTMLButtonElement,
            )
          : [];

        function closeHeaderModeMenu() {
          if (!menu || !badge) return;
          menu.hidden = true;
          badge.setAttribute("aria-expanded", "false");
          badge.classList.remove("panel-user-mode-badge--open");
        }

        function openHeaderModeMenu() {
          if (!menu || !badge) return;
          menu.hidden = false;
          badge.setAttribute("aria-expanded", "true");
          badge.classList.add("panel-user-mode-badge--open");
          const active =
            menu.querySelector('[aria-checked="true"]') ||
            menu.querySelector("[data-mode]");
          if (active instanceof HTMLElement) active.focus();
        }

        function toggleHeaderModeMenu() {
          if (!menu) return;
          if (menu.hidden) openHeaderModeMenu();
          else closeHeaderModeMenu();
        }

        const initial = applyPanelUserMode(getPanelUserMode());

        inputs.forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          input.addEventListener("change", () => {
            if (!input.checked) return;
            applyPanelUserMode(input.value);
          });
        });

        badge?.addEventListener("click", (e) => {
          e.stopPropagation();
          toggleHeaderModeMenu();
        });

        menuItems.forEach((item) => {
          item.addEventListener("click", (e) => {
            e.stopPropagation();
            const mode = item.getAttribute("data-mode");
            if (mode) applyPanelUserMode(mode);
            closeHeaderModeMenu();
            badge?.focus();
          });
        });

        menu?.addEventListener("keydown", (e) => {
          if (menu.hidden || !menuItems.length) return;
          const focusedIdx = menuItems.findIndex((item) => item === document.activeElement);
          const idx = focusedIdx >= 0 ? focusedIdx : 0;
          if (e.key === "ArrowDown") {
            e.preventDefault();
            menuItems[(idx + 1) % menuItems.length]?.focus();
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            menuItems[(idx - 1 + menuItems.length) % menuItems.length]?.focus();
          } else if (e.key === "Escape") {
            e.preventDefault();
            closeHeaderModeMenu();
            badge?.focus();
          } else if (e.key === "Enter" || e.key === " ") {
            const focused =
              document.activeElement instanceof HTMLButtonElement &&
              menu.contains(document.activeElement)
                ? document.activeElement
                : null;
            if (focused) {
              e.preventDefault();
              const mode = focused.getAttribute("data-mode");
              if (mode) applyPanelUserMode(mode);
              closeHeaderModeMenu();
              badge?.focus();
            }
          }
        });

        document.addEventListener("click", (e) => {
          if (!menu || menu.hidden) return;
          const t = e.target;
          if (!(t instanceof Node)) return;
          if (badge?.contains(t) || menu.contains(t)) return;
          closeHeaderModeMenu();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key !== "Escape" || !menu || menu.hidden) return;
          closeHeaderModeMenu();
          badge?.focus();
        });

        return initial;
      }

      function formatBytesShort(n) {
        const v = Number(n);
        if (!Number.isFinite(v) || v <= 0) return "—";
        if (v < 1024) return v + " B";
        if (v < 1024 * 1024) return (v / 1024).toFixed(1) + " KB";
        return (v / (1024 * 1024)).toFixed(2) + " MB";
      }

