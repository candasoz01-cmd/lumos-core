      async function probeBridgeHealthOnce(url) {
        try {
          const r = await fetch(url, {
            method: "GET",
            cache: "no-store",
            mode: "cors",
            credentials: "omit",
          });
          const text = await r.text();
          if (!r.ok) {
            return { ok: false, detail: "HTTP " + r.status, url };
          }
          if (!text || !String(text).trim()) {
            return { ok: false, detail: "Boş yanıt", url };
          }
          try {
            const data = JSON.parse(text);
            if (data === null || typeof data !== "object" || Array.isArray(data)) {
              return { ok: false, detail: "Geçersiz JSON gövdesi", url };
            }
            if (String(data.status || "").toLowerCase() === "ok") {
              return { ok: true, detail: "status=ok", url };
            }
            if (data.ok === true) {
              return { ok: true, detail: "ok=true", url };
            }
            return { ok: false, detail: "Health alanları tanınmadı", url };
          } catch {
            return { ok: false, detail: "JSON ayrıştırılamadı", url };
          }
        } catch {
          return { ok: false, detail: "Ağ veya CORS", url };
        }
      }

      void (async function checkBridgeHealth() {
        setPanelConnBadge("pending");
        bridgeHealthPhase = "trying";
        bridgeHealthDebugTail = "";
        syncBridgeHealthLine();
        paintSistemDurumuPanel();
        const candidates = [
          HEALTH_URL,
          BRIDGE_BASE_URL + "/health",
          BRIDGE_BASE_URL + "/",
        ];
        const seen = new Set();
        let last = /** @type {{ ok: boolean, detail: string, url: string } | null} */ (null);
        try {
          let ok = false;
          for (let i = 0; i < candidates.length; i++) {
            const u = candidates[i];
            if (!u || seen.has(u)) continue;
            seen.add(u);
            const res = await probeBridgeHealthOnce(u);
            last = res;
            if (res.ok) {
              ok = true;
              bridgeHealthPhase = "ok";
              bridgeHealthDebugTail = PANEL_DEBUG ? res.url : "";
              syncBridgeHealthLine();
              break;
            }
          }
          setPanelConnBadge(ok ? "ok" : "bad");
          if (!ok && last) {
            bridgeHealthPhase = "unreachable";
            bridgeHealthDebugTail = PANEL_DEBUG
              ? "erişilemedi (" + last.detail + ")"
              : "";
            syncBridgeHealthLine();
          } else if (!ok) {
            bridgeHealthPhase = "unreachable";
            bridgeHealthDebugTail = PANEL_DEBUG ? "uygun URL yok" : "";
            syncBridgeHealthLine();
          }
        } catch {
          setPanelConnBadge("bad");
          bridgeHealthPhase = "unreachable";
          bridgeHealthDebugTail = PANEL_DEBUG
            ? "istisna (köprü kapalı olabilir)"
            : "";
          syncBridgeHealthLine();
        }
        paintSistemDurumuPanel();
      })();

      function wireMedyaOutbox() {
        const btn = document.getElementById("medya-outbox-refresh");
        const hint = document.getElementById("medya-outbox-hint");
        const pre = document.getElementById("medya-outbox-pre");
        if (!btn || !hint || !pre) return;

        let medyaOutboxHintRefresh = null;

        function paintMedyaOutboxHintFromResolver() {
          if (!medyaOutboxHintRefresh) return;
          hint.textContent = panelUserVisibleText(medyaOutboxHintRefresh());
          hint.hidden = false;
        }

        function setMedyaOutboxHint(resolver) {
          medyaOutboxHintRefresh =
            typeof resolver === "function" ? resolver : () => String(resolver ?? "");
          paintMedyaOutboxHintFromResolver();
        }

        function clearMedyaOutboxHint() {
          medyaOutboxHintRefresh = null;
          hint.hidden = true;
          hint.textContent = "";
        }

        window.refreshMedyaOutboxHintI18n = () => {
          if (hint.hidden || !medyaOutboxHintRefresh) return;
          paintMedyaOutboxHintFromResolver();
        };

        async function refresh() {
          clearMedyaOutboxHint();
          btn.disabled = true;
          try {
            const r = await fetch(LAST_RESULT_BRIDGE_URL, {
              method: "GET",
              cache: "no-store",
            });
            const text = await r.text();
            if (taskBridgeBlockedResponse(r.status)) {
              const bridgeHint = bridgeBlockedUserHint();
              if (bridgeHint) {
                setMedyaOutboxHint(() => panelUserVisibleText(bridgeHint));
              }
              pre.hidden = true;
              return;
            }
            if (!r.ok) {
              const outboxErrCtx = {
                httpStatus: r.status,
                upstreamText: text,
              };
              setMedyaOutboxHint(() => panelOutboxFailureUserMessage(outboxErrCtx));
              pre.hidden = true;
              return;
            }
            let pretty = String(text || "").trim();
            try {
              const j = JSON.parse(pretty);
              pretty = JSON.stringify(j, null, 2);
            } catch {
              /* ham metin */
            }
            if (pretty.length > 5000) pretty = pretty.slice(0, 5000) + "\n…";
            pre.textContent = panelUserVisibleText(pretty || "—");
            pre.hidden = false;
          } catch {
            setMedyaOutboxHint(() =>
              panelDebugText(
                "İstek başarısız (ağ, CORS veya köprü kapalı). Yerelde `./scripts/bridge_start.sh` ile deneyin.",
                panelT("panel.modules.media.outboxFetchFailed"),
              ),
            );
            pre.hidden = true;
          } finally {
            btn.disabled = false;
          }
        }

        btn.addEventListener("click", () => {
          void refresh();
        });
      }

      function wirePanelPreSendShare(cfg) {
        const reviewBtn = document.getElementById(cfg.reviewId);
        const sendBtn = document.getElementById(cfg.sendId);
        const summaryEl = document.getElementById(cfg.summaryId);
        const hintEl = document.getElementById(cfg.hintId);
        const targetEl = document.getElementById(cfg.targetId);
        const contentEl = document.getElementById(cfg.contentId);
        const attachmentEl = cfg.attachmentId ? document.getElementById(cfg.attachmentId) : null;
        if (!reviewBtn || !sendBtn || !summaryEl || !targetEl || !contentEl) return;

        const demoOnly = cfg.demoOnly !== false;
        function demoIdleHint() {
          return cfg.demoIdleHint || panelT("panel.common.demo.idleHint");
        }

        function demoReviewHint() {
          return cfg.demoReviewHint || panelT("panel.common.demo.reviewHint");
        }

        function demoMessage() {
          return cfg.demoMsgKey
            ? panelT(cfg.demoMsgKey)
            : cfg.demoMsg || panelT("panel.common.demo.defaultMsg");
        }

        function dataTypeLabel() {
          return cfg.dataTypeKey
            ? panelT(cfg.dataTypeKey)
            : cfg.dataType || panelT("panel.common.demo.summaryDataType");
        }

        function keepSendDisabled() {
          sendBtn.disabled = true;
          if (demoOnly) sendBtn.setAttribute("aria-disabled", "true");
        }

        function resetApproval() {
          keepSendDisabled();
          summaryEl.hidden = true;
          if (hintEl && demoOnly) {
            hintEl.hidden = false;
            hintEl.textContent = demoIdleHint();
          }
        }

        function targetLabel() {
          if (targetEl.tagName === "SELECT") {
            const opt = targetEl.options[targetEl.selectedIndex];
            return opt ? String(opt.textContent || "").trim() : String(targetEl.value || "—");
          }
          return String(targetEl.value || "—").trim() || "—";
        }

        function attachmentCount() {
          if (!attachmentEl) return 0;
          const n = Number(attachmentEl.value);
          return Number.isFinite(n) && n >= 0 ? n : 0;
        }

        function contentPreview() {
          const t = String(contentEl.value || "").trim();
          if (!t) return "—";
          return t.length > 120 ? t.slice(0, 120) + "…" : t;
        }

        function flowKindForTarget() {
          const v = String(targetEl.value || "").toLowerCase();
          if (v.indexOf("yerel") >= 0) return "local";
          return cfg.defaultFlow || "external";
        }

        [targetEl, contentEl, attachmentEl].filter(Boolean).forEach((el) => {
          el.addEventListener("input", resetApproval);
          el.addEventListener("change", resetApproval);
        });

        if (hintEl && demoOnly) {
          hintEl.hidden = false;
          hintEl.textContent = demoIdleHint();
        }

        reviewBtn.addEventListener("click", () => {
          const summary =
            dataFlowBadge(flowKindForTarget()) +
            "\n" +
            panelT("panel.common.demo.summaryTarget") +
            targetLabel() +
            "\n" +
            panelT("panel.common.demo.summaryContentPreview") +
            contentPreview() +
            "\n" +
            panelT("panel.common.demo.summaryAttachmentCount") +
            attachmentCount() +
            "\n" +
            panelT("panel.common.demo.summaryDataType") +
            dataTypeLabel() +
            (demoOnly ? "\n\n" + panelT("panel.common.demo.summaryFooter") : "");
          summaryEl.textContent = summary;
          summaryEl.hidden = false;
          keepSendDisabled();
          if (hintEl) {
            hintEl.hidden = false;
            hintEl.textContent = demoOnly
              ? demoReviewHint()
              : panelT("panel.common.demo.approvedHint");
          }
        });

        sendBtn.addEventListener("click", () => {
          if (demoOnly) return;
          if (hintEl) {
            hintEl.hidden = false;
            hintEl.textContent = demoMessage();
          }
          resetApproval();
          summaryEl.hidden = true;
        });

        keepSendDisabled();

        window.addEventListener("lumos:localechange", () => {
          resetApproval();
        });
      }

      wirePanelPreSendShare({
        reviewId: "medya-share-review",
        sendId: "medya-share-send",
        summaryId: "medya-share-summary",
        hintId: "medya-share-hint",
        targetId: "medya-share-target",
        contentId: "medya-share-content",
        dataTypeKey: "panel.modules.media.dataType",
        demoMsgKey: "panel.common.demo.medyaMsg",
      });
      wirePanelPreSendShare({
        reviewId: "sosyal-share-review",
        sendId: "sosyal-share-send",
        summaryId: "sosyal-share-summary",
        hintId: "sosyal-share-hint",
        targetId: "sosyal-share-target",
        contentId: "sosyal-share-content",
        dataTypeKey: "panel.modules.social.dataType",
        demoMsgKey: "panel.common.demo.sosyalMsg",
      });
      wirePanelPreSendShare({
        reviewId: "posta-share-review",
        sendId: "posta-share-send",
        summaryId: "posta-share-summary",
        hintId: "posta-share-hint",
        targetId: "posta-share-target",
        contentId: "posta-share-content",
        attachmentId: "posta-share-attachments",
        dataTypeKey: "panel.modules.mail.dataType",
        demoMsgKey: "panel.common.demo.postaMsg",
      });

      wireMedyaOutbox();

      function refreshPanelI18n() {
        refreshPanelShellI18n();
        refreshPanelChatI18n();
        refreshPanelFilesI18n();
        refreshPanelGorevlerI18n();
        refreshPanelCapabilitiesI18n();
        refreshPanelQuantumReadinessI18n();
        refreshPanelResourceModeAdvisorI18n();
        if (typeof window.refreshMedyaOutboxHintI18n === "function") {
          window.refreshMedyaOutboxHintI18n();
        }
        paintSistemDurumuPanel();
      }

      window.addEventListener("lumos:localechange", refreshPanelI18n);
      window.addEventListener("load", refreshPanelI18n, { once: true });
    </script>
    <I18nInit />
  </body>
