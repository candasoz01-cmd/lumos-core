---
/** Canlı köprü: ana sayfa ile aynı sabit adres. */
const CHAT_URL = "https://lumos-core-1.onrender.com/chat";
const kandoToken = import.meta.env.PUBLIC_KANDO_TOKEN || "test123";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lumos Panel — Çalışma alanı</title>
    <style>
      :root {
        --lumos-bg: #0b1020;
        --lumos-surface: rgba(9, 11, 18, 0.97);
        --lumos-border: rgba(184, 148, 96, 0.22);
        --lumos-gold: #eccf93;
        --lumos-gold-soft: rgba(236, 207, 147, 0.55);
        --lumos-frame: rgba(148, 112, 68, 0.48);
        --lumos-frame-inner: rgba(98, 72, 44, 0.32);
        --lumos-teal: rgba(72, 188, 184, 0.22);
        --lumos-teal-deep: rgba(32, 88, 86, 0.38);
        --lumos-teal-glow: rgba(32, 88, 86, 0.06);
        --lumos-text: #e4e7ef;
        --lumos-muted: #9aa4b5;
        --lumos-input-bg: #101a24;
        --lumos-accent: #2a4a5a;
        --lumos-accent-deep: #1e3544;
        --lumos-user-bubble: rgba(42, 63, 109, 0.45);
        --lumos-lumos-bubble: rgba(0, 0, 0, 0.28);
        --lumos-error: #f0b4b4;
      }
      * {
        box-sizing: border-box;
      }
      html {
        height: 100%;
      }
      body {
        margin: 0;
        height: 100vh;
        height: 100dvh;
        max-height: 100vh;
        max-height: 100dvh;
        overflow: hidden;
        background-color: var(--lumos-bg);
        background-image:
          radial-gradient(125% 100% at 0% 0%, rgba(32, 88, 86, 0.14) 0%, transparent 42%),
          radial-gradient(90% 70% at 100% 8%, rgba(72, 188, 184, 0.06) 0%, transparent 48%),
          radial-gradient(80% 55% at 50% 100%, rgba(20, 48, 52, 0.2) 0%, transparent 55%),
          linear-gradient(168deg, #0a0c12 0%, #0b1020 38%, #090b10 100%);
        color: var(--lumos-text);
        font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, sans-serif;
        line-height: 1.55;
      }
      .panel-shell {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        max-height: 100%;
      }
      .panel-header {
        flex-shrink: 0;
        position: relative;
        padding: clamp(0.95rem, 2.2vw, 1.25rem) clamp(1rem, 3vw, 1.5rem) clamp(1rem, 2.2vw, 1.2rem);
        border-bottom: none;
        background: linear-gradient(
          168deg,
          rgba(10, 12, 18, 0.99) 0%,
          rgba(14, 18, 24, 0.96) 42%,
          rgba(11, 10, 14, 0.97) 100%
        );
        box-shadow:
          inset 0 -1px 0 rgba(184, 148, 96, 0.22),
          inset 0 -3px 0 rgba(32, 88, 86, 0.12),
          inset 0 1px 0 rgba(72, 188, 184, 0.06);
      }
      .panel-header h1 {
        margin: 0;
        font-size: clamp(1.12rem, 2.4vw, 1.32rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        color: #eccf93;
        line-height: 1.2;
      }
      .panel-header p {
        margin: 0.42rem 0 0;
        font-size: 0.88rem;
        letter-spacing: 0.01em;
        color: rgba(154, 172, 180, 0.95);
      }
      .panel-body {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
      }
      .panel-nav {
        flex: 0 0 clamp(10rem, 22vw, 12.75rem);
        align-self: stretch;
        min-height: 0;
        margin: 0.5rem 0 0.5rem 0.35rem;
        padding: 0.55rem 0.35rem 0.75rem 0.15rem;
        border-radius: 0 14px 14px 0;
        border: 1px solid rgba(184, 148, 96, 0.2);
        border-left: 1px solid rgba(32, 88, 86, 0.14);
        background: linear-gradient(
          168deg,
          rgba(12, 16, 22, 0.94) 0%,
          rgba(8, 14, 20, 0.9) 48%,
          rgba(10, 12, 18, 0.95) 100%
        );
        box-shadow:
          inset 0 1px 0 rgba(200, 165, 110, 0.07),
          inset 1px 0 0 rgba(72, 188, 184, 0.05),
          4px 0 22px rgba(0, 0, 0, 0.22);
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: rgba(184, 148, 96, 0.35) rgba(0, 0, 0, 0.2);
      }
      .panel-nav::-webkit-scrollbar {
        width: 7px;
      }
      .panel-nav::-webkit-scrollbar-track {
        margin: 6px 0;
        background: rgba(0, 0, 0, 0.18);
        border-radius: 999px;
      }
      .panel-nav::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, rgba(200, 170, 120, 0.45) 0%, rgba(148, 120, 80, 0.35) 100%);
        border-radius: 999px;
        border: 2px solid transparent;
        background-clip: padding-box;
      }
      .panel-nav::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, rgba(220, 190, 130, 0.55) 0%, rgba(160, 130, 90, 0.45) 100%);
        background-clip: padding-box;
      }
      .panel-nav-group {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin-bottom: 0.5rem;
      }
      .panel-nav-group:last-child {
        margin-bottom: 0;
      }
      .panel-nav-group--collapsible.panel-nav-group:first-child {
        margin-top: 0;
      }
      .panel-nav-group-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.45rem;
        width: calc(100% - 0.35rem);
        margin: 0.35rem 0 0.2rem 0.35rem;
        padding: 0.45rem 0.65rem 0.45rem 0.55rem;
        border: 1px solid rgba(72, 188, 184, 0.08);
        border-radius: 0 9px 9px 0;
        background: rgba(255, 255, 255, 0.035);
        color: rgba(150, 175, 175, 0.9);
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-align: left;
        cursor: pointer;
        transition:
          background 0.15s ease,
          color 0.15s ease,
          border-color 0.15s ease;
      }
      .panel-nav-group-toggle:hover {
        background: rgba(72, 188, 184, 0.07);
        border-color: rgba(184, 148, 96, 0.15);
        color: #d8e4e4;
      }
      .panel-nav-group-toggle:focus-visible {
        outline: none;
        box-shadow: 0 0 0 1px rgba(184, 148, 96, 0.38);
      }
      .panel-nav-group--collapsible:first-child > .panel-nav-group-toggle {
        margin-top: 0;
      }
      .panel-nav-chevron {
        flex-shrink: 0;
        display: grid;
        place-items: center;
        width: 1rem;
        height: 1rem;
        opacity: 0.72;
      }
      .panel-nav-chevron::after {
        content: "";
        width: 0.32rem;
        height: 0.32rem;
        margin-top: -0.06rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: rotate(45deg);
        transition: transform 0.18s ease;
      }
      .panel-nav-group-toggle[aria-expanded="false"] .panel-nav-chevron::after {
        transform: rotate(-45deg);
        margin-top: 0;
      }
      .panel-nav-group-items {
        display: flex;
        flex-direction: column;
        gap: 0;
      }
      .panel-nav-group-toggle[aria-expanded="false"] + .panel-nav-group-items {
        display: none;
      }
      .lumos-soon-badge {
        display: inline-block;
        flex-shrink: 0;
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: rgba(220, 198, 150, 0.92);
        background: linear-gradient(
          165deg,
          rgba(28, 52, 52, 0.45) 0%,
          rgba(42, 36, 24, 0.38) 100%
        );
        border: 1px solid rgba(184, 148, 96, 0.28);
        padding: 0.14rem 0.4rem;
        border-radius: 5px;
        line-height: 1.25;
        box-shadow: inset 0 1px 0 rgba(200, 175, 120, 0.08);
      }
      .panel-nav button[data-module] {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.35rem;
        width: calc(100% - 0.35rem);
        margin: 0.12rem 0 0.12rem 0.35rem;
        padding: 0.58rem 0.75rem 0.58rem 0.95rem;
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.025);
        color: #b4bccf;
        font-size: 0.86rem;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
        border-left: 3px solid transparent;
        border-radius: 0 10px 10px 0;
        transition:
          background 0.15s ease,
          color 0.15s ease,
          border-color 0.15s ease,
          box-shadow 0.15s ease;
      }
      .panel-nav-label {
        min-width: 0;
      }
      .panel-nav button[data-module]:hover {
        background: rgba(72, 188, 184, 0.06);
        border-color: rgba(72, 188, 184, 0.12);
        color: #e8ecf4;
      }
      .panel-nav button[data-module][aria-current="false"] {
        opacity: 0.92;
      }
      .panel-nav button[data-module][aria-current="true"] {
        color: #f6ebd4;
        font-weight: 600;
        border-left-color: rgba(236, 207, 147, 0.95);
        border-color: rgba(184, 148, 96, 0.14);
        background: linear-gradient(
          90deg,
          rgba(236, 207, 147, 0.16) 0%,
          rgba(32, 88, 86, 0.08) 42%,
          rgba(255, 255, 255, 0.02) 100%
        );
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.06),
          inset 0 0 0 1px rgba(184, 148, 96, 0.08);
      }
      .panel-main {
        flex: 1;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        padding: clamp(0.85rem, 2vw, 1.35rem);
        display: flex;
        flex-direction: column;
        background:
          radial-gradient(120% 85% at 8% 0%, rgba(32, 88, 86, 0.1) 0%, transparent 52%),
          radial-gradient(100% 70% at 100% 15%, rgba(72, 188, 184, 0.05) 0%, transparent 50%),
          radial-gradient(90% 60% at 100% 20%, rgba(130, 96, 56, 0.07) 0%, transparent 50%);
      }
      .module-panel {
        display: none;
        flex: 1;
        flex-direction: column;
        min-height: 0;
      }
      .module-panel[data-active="true"] {
        display: flex;
      }
      .module-panel:not(#panel-sohbet)[data-active="true"] {
        overflow-y: auto;
        min-height: 0;
      }
      .module-panel h2 {
        margin: 0 0 0.75rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: #e8d4b4;
        letter-spacing: -0.01em;
      }
      .module-panel h2.module-title-row {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.45rem 0.55rem;
      }
      .module-panel h2.module-title-row .lumos-soon-badge {
        font-size: 0.52rem;
        padding: 0.08rem 0.32rem;
        opacity: 0.92;
      }
      .placeholder-block {
        padding: 1rem 1.05rem;
        border-radius: 14px;
        border: 1px solid rgba(184, 148, 96, 0.22);
        background: linear-gradient(
          168deg,
          rgba(9, 11, 18, 0.97) 0%,
          rgba(11, 14, 20, 0.94) 48%,
          rgba(10, 12, 18, 0.96) 100%
        );
        box-shadow:
          inset 0 1px 0 rgba(200, 165, 110, 0.06),
          inset 0 0 0 1px rgba(32, 88, 86, 0.06),
          0 4px 18px rgba(0, 0, 0, 0.28);
        color: #c9ced9;
        font-size: 0.86rem;
        max-width: 32rem;
      }
      .placeholder-block p {
        margin: 0 0 0.65rem;
      }
      .placeholder-block p:last-child {
        margin-bottom: 0;
      }
      #panel-sohbet {
        gap: 0;
      }
      .chat-panel-top {
        flex-shrink: 0;
        margin-bottom: 0.65rem;
        padding-bottom: 0.55rem;
        border-bottom: 1px solid rgba(184, 148, 96, 0.16);
        box-shadow: 0 1px 0 rgba(32, 88, 86, 0.08);
      }
      .chat-panel-top h2 {
        margin: 0 0 0.28rem;
        color: #eccf93;
      }
      .chat-panel-status {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.45;
        color: rgba(154, 172, 180, 0.95);
      }
      /** Sohbet: (1) üst başlık+durum, (2) yalnızca kaydırılan geçmiş, (3) altta sabit compose — birbirine yapışmaz. */
      .chat-workspace {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        gap: 0.75rem;
      }
      .chat-history-shell {
        flex: 1;
        min-height: 10rem;
        min-width: 0;
        display: flex;
        flex-direction: column;
        border-radius: 14px;
        border: 1px solid rgba(148, 112, 68, 0.42);
        background: linear-gradient(
          165deg,
          rgba(10, 12, 18, 0.96) 0%,
          rgba(12, 16, 22, 0.92) 45%,
          rgba(9, 11, 16, 0.96) 100%
        );
        box-shadow:
          inset 0 1px 0 rgba(188, 148, 92, 0.1),
          inset 0 0 0 1px rgba(32, 88, 86, 0.05),
          0 0 0 1px rgba(72, 60, 48, 0.22),
          0 10px 32px rgba(0, 0, 0, 0.38);
        overflow: hidden;
      }
      .chat-thread {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1rem 1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(184, 148, 96, 0.35) rgba(0, 0, 0, 0.2);
      }
      .chat-thread::-webkit-scrollbar {
        width: 7px;
      }
      .chat-thread::-webkit-scrollbar-track {
        margin: 6px 0;
        background: rgba(0, 0, 0, 0.18);
        border-radius: 999px;
      }
      .chat-thread::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, rgba(200, 170, 120, 0.45) 0%, rgba(148, 120, 80, 0.35) 100%);
        border-radius: 999px;
        border: 2px solid transparent;
        background-clip: padding-box;
      }
      .chat-thread::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, rgba(220, 190, 130, 0.55) 0%, rgba(160, 130, 90, 0.45) 100%);
        background-clip: padding-box;
      }
      .chat-turn {
        display: flex;
        width: 100%;
        min-width: 0;
        flex-shrink: 0;
        justify-content: flex-start;
      }
      .chat-turn--user {
        justify-content: flex-end;
      }
      .chat-turn--lumos,
      .chat-turn--error {
        justify-content: flex-start;
      }
      .chat-msg {
        display: flex;
        flex-direction: column;
        min-width: 0;
        max-width: 100%;
        padding: 0.55rem 0.78rem 0.65rem;
        border-radius: 14px;
        white-space: pre-wrap;
        word-break: break-word;
        overflow-wrap: anywhere;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.22);
      }
      .chat-msg--user {
        max-width: min(100%, 22rem, 82%);
        margin-left: clamp(1.5rem, 8vw, 3.5rem);
        padding: 0.62rem 0.82rem 0.72rem;
        background: linear-gradient(
          165deg,
          rgba(36, 62, 88, 0.62) 0%,
          rgba(28, 48, 72, 0.78) 100%
        );
        border: 1px solid rgba(100, 150, 165, 0.28);
        border-radius: 14px 14px 5px 14px;
        color: #f4f7ff;
        box-shadow:
          0 2px 12px rgba(0, 0, 0, 0.22),
          0 0 0 1px rgba(72, 188, 184, 0.06);
      }
      .chat-msg--lumos {
        max-width: min(100%, 46rem, 94%);
        margin-right: clamp(0.75rem, 5vw, 2.5rem);
        padding: 0.65rem 0.92rem 0.78rem;
        background: linear-gradient(
          168deg,
          rgba(18, 22, 34, 0.95) 0%,
          rgba(14, 16, 26, 0.92) 50%,
          rgba(12, 14, 22, 0.96) 100%
        );
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 14px 14px 14px 5px;
        color: #e2e8f5;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.22), 0 0 0 1px rgba(255, 255, 255, 0.03);
      }
      .chat-msg--error {
        max-width: min(100%, 40rem, 92%);
        margin-right: clamp(0.75rem, 5vw, 2.25rem);
        border: 1px solid rgba(240, 180, 180, 0.32);
        color: #ffd6d6;
        background: linear-gradient(165deg, rgba(48, 22, 28, 0.55) 0%, rgba(32, 16, 20, 0.65) 100%);
        border-radius: 14px 14px 14px 5px;
      }
      .chat-msg-role {
        display: block;
        font-size: 0.62rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        margin-bottom: 0.35rem;
        opacity: 0.88;
      }
      .chat-msg--user .chat-msg-role {
        color: rgba(200, 215, 255, 0.75);
        text-align: right;
      }
      .chat-msg--lumos .chat-msg-role {
        color: rgba(236, 207, 147, 0.85);
        text-align: left;
      }
      .chat-msg--error .chat-msg-role {
        color: rgba(255, 200, 200, 0.75);
      }
      .chat-msg-body {
        font-size: 0.9rem;
        line-height: 1.68;
        letter-spacing: -0.01em;
      }
      .chat-msg--lumos .chat-msg-body {
        white-space: pre-wrap;
        line-height: 1.75;
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .chat-msg--lumos .chat-msg-body strong {
        font-weight: 700;
        color: #f0e8d8;
      }
      .chat-compose-stack {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
      }
      .chat-compose-bar {
        flex-shrink: 0;
        padding: 0.75rem 0.9rem 0.85rem;
        border-radius: 14px;
        border: 1px solid rgba(148, 112, 68, 0.38);
        background: linear-gradient(
          180deg,
          rgba(12, 16, 22, 0.96) 0%,
          rgba(8, 12, 18, 0.93) 100%
        );
        box-shadow:
          inset 0 1px 0 rgba(200, 165, 110, 0.07),
          inset 0 0 0 1px rgba(32, 88, 86, 0.05),
          0 4px 20px rgba(0, 0, 0, 0.3);
      }
      .chat-compose {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.6rem;
        align-items: stretch;
        max-width: 100%;
      }
      @media (max-width: 479.98px) {
        .chat-compose {
          flex-wrap: wrap;
        }
        .chat-compose button {
          width: 100%;
        }
      }
      .chat-compose textarea {
        flex: 1;
        min-width: 0;
        min-height: 2.65rem;
        max-height: 9rem;
        padding: 0.58rem 0.72rem;
        border-radius: 10px;
        border: 1px solid rgba(72, 188, 184, 0.14);
        background: linear-gradient(180deg, rgba(14, 22, 30, 0.98) 0%, rgba(12, 18, 28, 0.95) 100%);
        color: #f2f2f2;
        font-size: 0.88rem;
        font-family: inherit;
        line-height: 1.5;
        resize: vertical;
        box-shadow: inset 0 1px 0 rgba(200, 175, 120, 0.04);
      }
      .chat-compose textarea:focus {
        outline: none;
        border-color: rgba(184, 148, 96, 0.42);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.05),
          0 0 0 1px rgba(32, 88, 86, 0.18);
      }
      .chat-compose button {
        flex: 0 0 auto;
        align-self: stretch;
        min-width: 10.5rem;
        min-height: 2.65rem;
        padding: 0 1.1rem;
        border-radius: 10px;
        border: 1px solid rgba(72, 188, 184, 0.12);
        background: linear-gradient(180deg, #2e4f62 0%, var(--lumos-accent) 45%, var(--lumos-accent-deep) 100%);
        color: #fff;
        font-size: 0.86rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        cursor: pointer;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.28);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .chat-compose button:hover:not(:disabled) {
        filter: brightness(1.06);
      }
      .chat-compose button:disabled {
        opacity: 0.62;
        cursor: not-allowed;
        filter: none;
      }
      .lumos-security-note {
        margin: 0;
        align-self: flex-start;
        max-width: 100%;
        padding: 0.42rem 0.72rem;
        border-radius: 9px;
        font-size: 0.68rem;
        line-height: 1.45;
        letter-spacing: 0.03em;
        color: rgba(190, 200, 198, 0.95);
        background: linear-gradient(
          165deg,
          rgba(18, 32, 34, 0.55) 0%,
          rgba(12, 14, 22, 0.82) 100%
        );
        border: 1px solid rgba(184, 148, 96, 0.22);
        box-shadow: inset 0 1px 0 rgba(72, 188, 184, 0.06);
      }
      @media (max-width: 639.98px) {
        .panel-body {
          flex-direction: column;
          min-height: 0;
        }
        .panel-nav {
          flex: 0 0 auto;
          align-self: stretch;
          max-height: min(44vh, 15rem);
          display: flex;
          flex-direction: column;
          flex-wrap: nowrap;
          gap: 0.15rem;
          padding: 0.45rem 0.5rem 0.5rem;
          border-right: none;
          border-bottom: 1px solid rgba(255, 255, 255, 0.08);
          overflow-y: auto;
          overflow-x: hidden;
          overscroll-behavior: contain;
        }
        .panel-nav-group--collapsible {
          flex-direction: row;
          flex-wrap: wrap;
          align-items: center;
          align-content: flex-start;
          margin-bottom: 0.35rem;
          gap: 0.2rem;
        }
        .panel-nav-group-toggle {
          flex: 1 0 100%;
          width: auto;
          margin: 0.2rem 0.35rem 0.1rem;
        }
        .panel-nav-group-items {
          flex: 1 0 100%;
          flex-direction: row;
          flex-wrap: wrap;
          align-content: flex-start;
          gap: 0.2rem;
        }
        .panel-nav button[data-module] {
          flex: 1 1 auto;
          min-width: calc(33.333% - 0.35rem);
          width: auto;
          margin: 0.1rem;
          border-left: none;
          border-bottom: 2px solid transparent;
          border-radius: 10px;
          justify-content: center;
          padding: 0.4rem 0.45rem;
        }
        .panel-nav button[data-module][aria-current="true"] {
          border-left-color: transparent;
          border-bottom-color: rgba(236, 207, 147, 0.75);
          background: linear-gradient(
            180deg,
            rgba(236, 207, 147, 0.12) 0%,
            rgba(236, 207, 147, 0.04) 100%
          );
        }
        .panel-main {
          flex: 1;
          min-height: 0;
        }
      }
    </style>
  </head>
  <body>
