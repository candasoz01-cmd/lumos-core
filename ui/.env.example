# Astro panel — yerel geliştirme ortam değişkenleri
# Kullanım: bu dosyayı kopyalayıp `ui/.env.local` olarak kaydedin (`npm run dev` buradan okur).
# Sunucu tarafı secret'lar (KANDO_BRIDGE_SECRET, OPENAI_API_KEY vb.) buraya yazılmaz.

# Köprü sohbet uç noktası (8765 — bkz. docs/local-kando-dev-runbook.md)
PUBLIC_LUMOS_CHAT_URL=http://127.0.0.1:8765/chat

# Panel durum rozeti / backend "Sistem Durumu" (GET); tanımsızsa CHAT_URL'den türetilir
PUBLIC_LUMOS_PANEL_STATUS_URL=http://127.0.0.1:8765/status

PUBLIC_LUMOS_PANEL_UPLOAD_URL=http://127.0.0.1:8765/upload
PUBLIC_LUMOS_PANEL_HEALTH_URL=http://127.0.0.1:8765/health

# Panel görev sunucusu (varsayılan port 8766 — panel_tasks_server.py)
PUBLIC_LUMOS_PANEL_TASKS_URL=http://127.0.0.1:8766

# Yerel dev placeholder only — production secret değildir; KANDO_BRIDGE_SECRET ile aynı olmalı
PUBLIC_KANDO_TOKEN=test123
