---
import GlobalMay19Corner from "../components/GlobalMay19Corner.astro";

/**
 * POST /chat tam URL (örn. `https://host/chat`).
 * GET /status: aynı origin’de `.../status` — `PUBLIC_LUMOS_PANEL_STATUS_URL` ile ayrı host verilmezse CHAT_URL’den türetilir.
 */
const CHAT_URL = import.meta.env.PUBLIC_LUMOS_CHAT_URL || "https://lumos-core-1.onrender.com/chat";
const kandoToken = import.meta.env.PUBLIC_KANDO_TOKEN || "test123";
const UPLOAD_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_UPLOAD_URL ||
  String(CHAT_URL).replace(/\/chat\/?$/i, "") + "/panel/upload";
/** Köprü tabanı: upload ile aynı origin (CHAT farklı host olsa bile rozet yerel bridge’e baksın). */
const BRIDGE_BASE_URL = String(UPLOAD_URL).replace(/\/panel\/upload\/?$/i, "");
/** Rozet: önce açık health URL; yoksa BRIDGE_BASE + /health (PUBLIC_LUMOS_PANEL_HEALTH_URL ve BRIDGE_HEALTH_URL birlikte desteklenir). */
const HEALTH_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_HEALTH_URL ||
  import.meta.env.PUBLIC_LUMOS_BRIDGE_HEALTH_URL ||
  BRIDGE_BASE_URL + "/health";
/** Backend "Sistem Durumu" (GET): varsayılan olarak CHAT_URL’deki `/chat` → `/status` ile aynı host. */
const STATUS_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_STATUS_URL ||
  String(CHAT_URL).replace(/\/chat\/?$/i, "") + "/status";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover, user-scalable=no"
    />
    <title>Lumos Panel — Çalışma alanı</title>
    <style>
      :root {
        /** Ana kömür çizgisi: #050505 → #080808 → #0b0b0b */
        --lumos-bg: #050505;
        --lumos-surface: rgba(11, 11, 11, 0.98);
        /** Çok koyu bronz çizgi — renk yayılımı az */
        --lumos-border: rgba(115, 95, 68, 0.22);
        /** Kart çerçevesi: saç teli, koyu zeminde biraz daha okunur */
        --lumos-card-border: rgba(132, 112, 86, 0.38);
        --lumos-card-inset: rgba(255, 255, 255, 0.042);
        --lumos-gold: #e8c98c;
        /** Elektrik mavisi — landing ile ortak isim; panel kromu şimdilik kullanmıyor */
        --lumos-accent-blue: #0ea5e9;
        --lumos-text: #eceae6;
        --lumos-text-soft: rgba(236, 234, 230, 0.72);
        --lumos-muted: #928f89;
        --lumos-input-bg: #050505;
        /** Panel bölgeleri — nötr siyah/kömür (petrol yok) */
        --lumos-sidebar-bg: #000000;
        --lumos-main-bg: #080808;
        --lumos-chat-head-bg: #080808;
        --lumos-chat-history-bg: #0b0b0b;
        --lumos-compose-bg: #080808;
        --lumos-chat-input-bg: #050505;
        /** Turkuaz yalnızca Bağlı rozeti (çok düşük doz) */
        --lumos-tq-badge-inset: rgba(95, 185, 170, 0.1);
        --lumos-tq-badge-glow: rgba(55, 145, 132, 0.07);
        --lumos-btn-a: #141312;
        --lumos-btn-b: #080808;
        --lumos-user-bubble: rgba(12, 12, 12, 0.92);
        --lumos-lumos-bubble: rgba(0, 0, 0, 0.4);
        --lumos-error: #f0b4b4;
        /** Operasyon paneli — yüzey / köşe / gölge (tek ritim) */
        --panel-radius: 10px;
        --panel-radius-lg: 12px;
        --panel-strip-bg: linear-gradient(180deg, #070707 0%, #050505 100%);
        --panel-surface-raised: rgba(12, 12, 12, 0.92);
        --panel-edge-inset: inset 0 1px 0 rgba(255, 255, 255, 0.03);
        --panel-shadow-ambient: 0 1px 3px rgba(0, 0, 0, 0.35);
      }
      * {
        box-sizing: border-box;
      }
      html {
        height: 100%;
      }
      body {
        margin: 0;
        height: 100vh;
        height: 100dvh;
        max-height: 100vh;
        max-height: 100dvh;
        overflow: hidden;
        overflow-x: hidden;
        background: var(--lumos-bg);
        color: var(--lumos-text);
        font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, sans-serif;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      .panel-shell {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        max-height: 100%;
        width: 100%;
        max-width: 100%;
        min-width: 0;
      }
      .panel-header {
        flex-shrink: 0;
        padding: clamp(0.85rem, 2vw, 1.15rem) clamp(1rem, 3vw, 1.5rem);
        border-bottom: 1px solid var(--lumos-border);
        background: var(--panel-strip-bg);
      }
      .panel-header-title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        column-gap: 0.65rem;
        row-gap: 0.45rem;
      }
      .panel-header-brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        min-width: 0;
        flex: 1 1 12rem;
      }
      .panel-conn-badge {
        flex: 0 0 auto;
        margin-left: auto;
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        padding: 0.2rem 0.48rem;
        border-radius: 999px;
        line-height: 1.25;
        border: 1px solid rgba(255, 255, 255, 0.12);
        white-space: nowrap;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
      }
      .panel-conn-badge[data-state="pending"] {
        color: rgba(200, 188, 160, 0.95);
        background: rgba(90, 72, 44, 0.28);
        border-color: rgba(184, 148, 96, 0.35);
      }
      .panel-conn-badge[data-state="ok"] {
        color: rgba(200, 238, 226, 0.94);
        background: #0a0a0a;
        border-color: rgba(145, 118, 82, 0.38);
        box-shadow: inset 0 1px 0 var(--lumos-tq-badge-inset);
      }
      .panel-conn-badge[data-state="bad"] {
        color: rgba(240, 195, 195, 0.96);
        background: rgba(92, 42, 42, 0.32);
        border-color: rgba(200, 120, 110, 0.38);
      }
      .panel-health-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 0.35rem 0.6rem;
        margin-top: 0;
        margin-left: auto;
        flex: 0 1 auto;
        max-width: 100%;
      }
      .panel-health-detail {
        font-size: 0.62rem;
        font-weight: 500;
        color: var(--lumos-muted);
        line-height: 1.35;
        max-width: min(100%, 28rem);
        text-align: right;
        word-break: break-word;
      }
      .gorevler-task-bridge {
        margin: 0;
        margin-top: 0.12rem;
        font-size: 0.72rem;
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: 0.01em;
        color: rgba(198, 194, 186, 0.78);
      }
      .medya-outbox-wrap {
        margin: 0.75rem 0 1.25rem;
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--lumos-card-border);
        border-radius: var(--panel-radius-lg);
        background: var(--lumos-surface);
        box-shadow: var(--panel-edge-inset);
      }
      .medya-outbox-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.45rem;
      }
      .medya-outbox-refresh {
        font: inherit;
        font-size: 0.78rem;
        padding: 0.35rem 0.65rem;
        border-radius: 8px;
        border: 1px solid rgba(115, 95, 68, 0.35);
        background: var(--lumos-btn-a);
        color: var(--lumos-text);
        cursor: pointer;
      }
      .medya-outbox-refresh:hover {
        border-color: rgba(212, 182, 128, 0.45);
      }
      .medya-outbox-refresh:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }
      .medya-outbox-pre {
        margin: 0.5rem 0 0;
        padding: 0.5rem 0.55rem;
        max-height: 12rem;
        overflow: auto;
        font-size: 0.68rem;
        line-height: 1.45;
        white-space: pre-wrap;
        word-break: break-word;
        background: var(--lumos-main-bg);
        border: 1px solid rgba(115, 95, 68, 0.18);
        border-radius: 8px;
        color: var(--lumos-muted);
      }
      @media (max-width: 520px) {
        .panel-conn-badge {
          margin-left: 0;
          flex-basis: auto;
          width: auto;
          max-width: 100%;
          align-self: flex-start;
        }
        .panel-header-title-row {
          align-items: flex-start;
        }
        /* Rozet, işaret + başlık satırının altında hizalı */
        .panel-header-brand {
          flex: 1 1 100%;
        }
        .panel-conn-badge {
          margin-left: calc(1.42rem + 0.42rem);
        }
        .panel-health-row {
          justify-content: flex-start;
          margin-left: 0;
          width: 100%;
          flex-basis: 100%;
        }
        .panel-health-detail {
          text-align: left;
        }
      }
      .lumos-mark {
        position: relative;
        width: clamp(1.75rem, 4.2vw, 2.125rem);
        height: clamp(1.75rem, 4.2vw, 2.125rem);
        flex-shrink: 0;
        border-radius: 50%;
        background:
          radial-gradient(circle at 32% 22%, rgba(255, 248, 238, 0.14) 0%, transparent 40%),
          linear-gradient(155deg, #141312 0%, #0c0c0c 42%, #050505 100%);
        border: 2px solid rgba(212, 182, 128, 0.62);
        box-shadow:
          inset 0 0 0 1px rgba(0, 0, 0, 0.55),
          inset 0 1px 0 rgba(255, 255, 255, 0.05),
          inset 0 -1px 4px rgba(0, 0, 0, 0.35);
      }
      .lumos-mark::before {
        content: "";
        position: absolute;
        inset: 4px;
        border-radius: 50%;
        box-sizing: border-box;
        border: 1px solid rgba(236, 207, 147, 0.28);
        background: rgba(8, 8, 8, 0.55);
        pointer-events: none;
      }
      .lumos-mark::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 0.48rem;
        height: 0.62rem;
        margin: -0.34rem 0 0 -0.22rem;
        box-sizing: border-box;
        border-left: 2.5px solid rgba(244, 226, 188, 0.88);
        border-bottom: 2.5px solid rgba(220, 188, 130, 0.82);
        border-radius: 0 0 0 2px;
        filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.35));
        pointer-events: none;
      }
      .panel-header-brand h1 {
        margin: 0;
        font-size: clamp(1rem, 2vw, 1.2rem);
        font-weight: 600;
        letter-spacing: -0.018em;
        color: #e8d4b4;
      }
      /**
       * Masaüstü: sol sütunda üstte Çalışma, altta Lumos çekirdeği; sağda `main` iki satırı kaplar.
       * Mobil: aynı üç çocuk `grid-template-areas` ile Çalışma → içerik → Lumos (Safari’de `display: contents` gerekmez).
       */
      .panel-body {
        display: grid;
        flex: 1;
        min-height: 0;
        min-width: 0;
        overflow: hidden;
        grid-template-columns: clamp(10rem, 22vw, 12.75rem) minmax(0, 1fr);
        grid-template-rows: auto minmax(0, 1fr);
        grid-template-areas:
          "nav-primary main"
          "nav-lumos main";
      }
      .panel-nav__primary {
        grid-area: nav-primary;
        align-self: stretch;
        min-height: 0;
        padding: 0.65rem 0.4rem 0.45rem 0;
        border-right: 1px solid rgba(115, 95, 68, 0.18);
        border-bottom: 1px solid rgba(115, 95, 68, 0.12);
        background: var(--lumos-sidebar-bg);
        overflow-x: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: rgba(148, 118, 78, 0.45) rgba(8, 8, 8, 0.9);
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .panel-nav__lumos {
        grid-area: nav-lumos;
        align-self: stretch;
        min-height: 0;
        padding: 0.45rem 0.4rem 0.85rem 0;
        border-right: 1px solid rgba(115, 95, 68, 0.18);
        background: var(--lumos-sidebar-bg);
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: rgba(148, 118, 78, 0.45) rgba(8, 8, 8, 0.9);
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .panel-nav__primary::-webkit-scrollbar,
      .panel-nav__lumos::-webkit-scrollbar {
        width: 4px;
      }
      .panel-nav__primary::-webkit-scrollbar-track,
      .panel-nav__lumos::-webkit-scrollbar-track {
        margin: 4px 0;
        background: rgba(5, 5, 5, 0.95);
        border-radius: 999px;
      }
      .panel-nav__primary::-webkit-scrollbar-thumb,
      .panel-nav__lumos::-webkit-scrollbar-thumb {
        background: rgba(115, 95, 68, 0.4);
        border-radius: 999px;
        border: 1px solid rgba(0, 0, 0, 0.35);
        background-clip: padding-box;
      }
      .panel-nav__primary::-webkit-scrollbar-thumb:hover,
      .panel-nav__lumos::-webkit-scrollbar-thumb:hover {
        background: rgba(145, 118, 82, 0.46);
        background-clip: padding-box;
      }
      .panel-nav-sig {
        margin: 0.15rem 0.35rem 0.45rem 0.45rem;
        padding: 0;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(132, 128, 120, 0.52);
      }
      .panel-nav-sig span {
        color: rgba(200, 185, 150, 0.42);
        letter-spacing: 0.12em;
      }
      .panel-nav-group {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin-bottom: 0.5rem;
      }
      .panel-nav-group:last-child {
        margin-bottom: 0;
      }
      .panel-nav-collapsible {
        margin-bottom: 0.5rem;
      }
      .panel-nav-collapsible:last-child {
        margin-bottom: 0;
      }
      .panel-nav-group-toggle {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.4rem;
        width: calc(100% - 0.35rem);
        margin: 0.4rem 0 0.18rem 0.35rem;
        padding: 0.35rem 0.45rem 0.35rem 0.2rem;
        border: none;
        border-radius: 8px;
        background: transparent;
        cursor: pointer;
        font: inherit;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-align: left;
        color: rgba(136, 132, 126, 0.82);
        transition:
          background 0.15s ease,
          color 0.15s ease;
      }
      .panel-nav-collapsible:first-child > .panel-nav-group-toggle {
        margin-top: 0;
      }
      .panel-nav-group-toggle:hover {
        background: rgba(255, 255, 255, 0.035);
        color: rgba(228, 218, 198, 0.88);
        box-shadow: inset 0 0 0 1px rgba(145, 118, 82, 0.14);
      }
      .panel-nav-group-toggle:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px rgba(184, 148, 96, 0.35);
      }
      .panel-nav-group-toggle-label {
        min-width: 0;
      }
      .panel-nav-group-items {
        display: flex;
        flex-direction: column;
        gap: 0;
      }
      /** display:flex üstünde [hidden] görünür kalmasın; gerçek aç/kapa */
      .panel-nav-group-items[hidden] {
        display: none !important;
      }
      .lumos-soon-badge {
        display: inline-block;
        flex-shrink: 0;
        font-size: 0.56rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(200, 178, 132, 0.78);
        background: rgba(90, 72, 44, 0.22);
        border: 1px solid rgba(184, 148, 96, 0.2);
        padding: 0.1rem 0.34rem;
        border-radius: 4px;
        line-height: 1.2;
      }
      .panel-nav__primary button[data-module],
      .panel-nav__lumos button[data-module] {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.35rem;
        width: calc(100% - 0.35rem);
        margin: 0.12rem 0 0.12rem 0.35rem;
        padding: 0.58rem 0.75rem 0.58rem 0.95rem;
        border: none;
        background: rgba(255, 255, 255, 0.02);
        color: #c8c2b8;
        font-size: 0.86rem;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
        border-left: 3px solid transparent;
        border-radius: 0 10px 10px 0;
        transition:
          background 0.15s ease,
          color 0.15s ease,
          border-color 0.15s ease;
      }
      .panel-nav-label {
        min-width: 0;
      }
      .panel-nav__primary button[data-module]:hover,
      .panel-nav__lumos button[data-module]:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #f2ebe6;
        box-shadow: none;
      }
      .panel-nav__primary button[data-module][aria-current="false"],
      .panel-nav__lumos button[data-module][aria-current="false"] {
        opacity: 0.92;
      }
      .panel-nav__primary button[data-module][aria-current="true"],
      .panel-nav__lumos button[data-module][aria-current="true"] {
        color: #f0e4c4;
        font-weight: 600;
        border-left-color: rgba(236, 207, 147, 0.88);
        background: #0b0b0b;
        box-shadow: none;
      }
      .panel-main {
        grid-area: main;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        overflow-x: hidden;
        padding: clamp(0.75rem, 1.8vw, 1.25rem) clamp(0.85rem, 2vw, 1.35rem);
        display: flex;
        flex-direction: column;
        gap: 0;
        background: var(--lumos-main-bg);
      }
      .module-panel {
        display: none;
        flex: 1;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
        max-width: 100%;
      }
      .module-panel[data-active="true"] {
        display: flex;
      }
      .module-panel:not(#panel-sohbet)[data-active="true"] {
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 0;
        padding: clamp(0.65rem, 1.6vw, 1rem);
        border: 1px solid var(--lumos-border);
        border-radius: var(--panel-radius-lg);
        background: var(--panel-surface-raised);
      }
      .module-panel h2 {
        margin: 0 0 0.75rem;
        font-size: 0.94rem;
        font-weight: 600;
        color: #eae8e4;
        letter-spacing: -0.012em;
        line-height: 1.35;
      }
      .module-panel:not(#panel-sohbet) > h2 {
        margin: 0 0 0.85rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(115, 95, 68, 0.14);
      }
      .module-panel h2.module-title-row {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.45rem 0.55rem;
      }
      .module-panel h2.module-title-row .lumos-soon-badge {
        font-size: 0.52rem;
        padding: 0.08rem 0.32rem;
        opacity: 0.92;
      }
      .placeholder-block {
        padding: 1rem 1.05rem;
        border-radius: var(--panel-radius-lg);
        border: 1px solid var(--lumos-card-border);
        background: #0b0b0b;
        box-shadow: var(--panel-edge-inset);
        color: var(--lumos-muted);
        font-size: 0.86rem;
        max-width: 32rem;
      }
      .placeholder-block p {
        margin: 0 0 0.65rem;
      }
      .placeholder-block p:last-child {
        margin-bottom: 0;
      }
      /** Panel modül sekmeleri: boş kalmayan sade durum kartı */
      .panel-module-state {
        max-width: 36rem;
        padding: 1rem 1.15rem 1.05rem;
        border-radius: var(--panel-radius-lg);
        border: 1px solid var(--lumos-card-border);
        background: #0b0b0b;
        box-shadow: var(--panel-edge-inset);
        transition: border-color 0.14s ease;
      }
      .panel-module-state:hover {
        border-color: rgba(184, 158, 118, 0.46);
      }
      .module-panel .panel-module-state > h2 {
        margin: 0 0 0.55rem;
      }
      .panel-module-state__desc {
        margin: 0 0 0.85rem;
        font-size: 0.88rem;
        line-height: 1.55;
        color: var(--lumos-muted);
      }
      .panel-module-state__status {
        margin: 0 0 0.75rem;
        font-size: 0.84rem;
        line-height: 1.5;
        color: var(--lumos-text);
      }
      .panel-module-state__status-label {
        color: var(--lumos-muted);
        margin-right: 0.35rem;
      }
      .panel-module-state__badge {
        display: inline-block;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.18rem 0.42rem;
        border-radius: 4px;
        line-height: 1.2;
        border: 1px solid rgba(255, 255, 255, 0.12);
        vertical-align: middle;
      }
      .panel-module-state__badge--hazirlaniyor {
        color: rgba(200, 188, 160, 0.92);
        background: rgba(90, 72, 44, 0.22);
        border-color: rgba(184, 148, 96, 0.28);
      }
      .panel-module-state__badge--tasarim {
        color: rgba(236, 210, 175, 0.95);
        background: rgba(110, 72, 48, 0.28);
        border-color: rgba(200, 140, 100, 0.35);
      }
      .panel-module-state__badge--yakinda {
        color: rgba(216, 204, 178, 0.92);
        background: rgba(28, 26, 22, 0.62);
        border-color: rgba(212, 182, 128, 0.28);
      }
      .panel-module-state__note {
        margin: 0;
        padding-top: 0.65rem;
        border-top: 1px solid rgba(212, 182, 128, 0.12);
        font-size: 0.78rem;
        line-height: 1.45;
