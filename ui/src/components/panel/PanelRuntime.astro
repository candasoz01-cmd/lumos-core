          if (!(item instanceof HTMLElement)) return;
          const action = item.getAttribute("data-attach-action");
          closePanelAttachMenu({ returnFocus: false });
          if (action === "file") {
            switchPanelModule("dosyalar");
            const dosyaInput = document.getElementById("dosyalar-file-input");
            const dosyaHint = document.getElementById("dosyalar-hint");
            if (dosyaHint) {
              dosyaHint.textContent = panelT("panel.modules.files.hints.attachNavigate");
              dosyaHint.hidden = false;
            }
            if (dosyaInput instanceof HTMLInputElement) {
              window.setTimeout(() => {
                try {
                  dosyaInput.click();
                } catch {
                  /* tarayıcı engeli */
                }
              }, 120);
            } else {
              setCameraHintKey("panel.modules.chat.compose.cameraHints.fileUploadPreparing");
            }
            return;
          }
          if (action === "photo") {
            triggerPanelCameraPhotoInput("photo");
            return;
          }
          if (action === "camera") {
            triggerPanelCameraPhotoInput("camera");
            return;
          }
          if (action === "clipboard") {
            clipboardBtn?.click();
            return;
          }
          if (action === "audio") {
            attachAudioInput?.click();
            return;
          }
          if (action === "record") {
            if (!isAudioRecordSupported()) {
              setAudioRecordHintKey("panel.modules.chat.compose.record.unsupported");
              return;
            }
            startPanelAudioRecording();
          }
        });

        document.addEventListener("click", (e) => {
          if (!attachMenu || attachMenu.hidden) return;
          const t = e.target;
          if (!(t instanceof Node)) return;
          if (attachToggle?.contains(t) || attachMenu.contains(t)) return;
          closePanelAttachMenu();
        });

        document.addEventListener("focusin", (e) => {
          if (!attachMenu || attachMenu.hidden) return;
          const t = e.target;
          if (!(t instanceof Node)) return;
          if (attachToggle?.contains(t) || attachMenu.contains(t)) return;
          const items = focusableAttachMenuItems();
          if (items.length) items[0].focus();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key !== "Escape" || !attachMenu || attachMenu.hidden) return;
          e.preventDefault();
          closePanelAttachMenu();
        });

        attachAudioInput?.addEventListener("change", () => {
          const f = attachAudioInput.files && attachAudioInput.files[0];
          attachAudioInput.value = "";
          setSendHint("");
          setCameraHintKey("");
          if (!f) return;
          if (!/^audio\//.test(f.type || "")) {
            setSendHint(() => panelT("panel.modules.chat.compose.hints.audioOnly"));
            return;
          }
          const photoFile =
            cameraPhotoInput && cameraPhotoInput.files && cameraPhotoInput.files[0]
              ? cameraPhotoInput.files[0]
              : null;
          const hasPhoto = !!(photoFile && /^image\//.test(photoFile.type));
          const hasPendingRecord = !!(audioRecordBlob && audioRecordBlob.size >= 512);
          if (hasPhoto || hasPendingRecord || isAudioRecording) {
            setSendHint(() => panelT("panel.modules.chat.compose.hints.pickOneAttachment"));
            return;
          }
          let audioBubbleUrl = null;
          try {
            audioBubbleUrl = URL.createObjectURL(f);
            audioBubbleObjectUrls.add(audioBubbleUrl);
          } catch {
            setSendHint(() => panelT("panel.modules.chat.compose.hints.audioReadFailed"));
            return;
          }
          appendUserComposeBubble(panelT("panel.modules.chat.compose.audioFileAttached"), null, audioBubbleUrl, {
            name: f.name,
            type: f.type,
            size: f.size,
          }, f);
          if (!shouldAttemptRemoteChat()) {
            const audioReply = panelComposeAudioReply(
              isOfflineUserMode() ? "offline" : "limited",
            );
            appendBubble("lumos", audioReply, panelComposeAudioReplyMeta(getPanelUserMode()));
            setSendHint(() =>
              panelComposeAudioHint(isOfflineUserMode() ? "offline" : "limited"),
            );
          } else {
            appendBubble("lumos", panelT("panel.modules.chat.compose.hints.fullAudioReply"), {
              i18nKey: "panel.modules.chat.compose.hints.fullAudioReply",
            });
            setSendHint(() => panelT("panel.modules.chat.compose.hints.fullAudioHint"));
          }
          input.blur();
          resetPanelHorizontalScrollAfterInputBlur();
        });

        cameraBtn?.addEventListener("click", () => {
          closePanelAttachMenu();
          triggerPanelCameraPhotoInput("camera");
        });

        cameraPhotoInput?.addEventListener("change", () => {
          const f = cameraPhotoInput.files && cameraPhotoInput.files[0];
          if (!f) return;
          bindCameraPhotoFromFile(f);
        });
      }

      function wireGorevlerPrototype() {
        const listEl = document.getElementById("gorevler-list");
        const listEmptyEl = document.getElementById("gorevler-list-empty");
        const titleInput = document.getElementById("gorevler-title-input");
        const prioritySel = document.getElementById("gorevler-priority");
        const statusSel = document.getElementById("gorevler-status");
        const addBtn = document.getElementById("gorevler-add");
        const hintEl = document.getElementById("gorevler-hint");
        const detailEl = document.getElementById("gorevler-detail");
        const detailTitleEl = document.getElementById("gorevler-detail-title");
        const detailTaskDl = document.getElementById("gorevler-detail-task-dl");
        const detailBridgeDl = document.getElementById("gorevler-detail-bridge-dl");
        const detailCloseBtn = document.getElementById("gorevler-detail-close");
        const detailBridgeBtn = document.getElementById("gorevler-detail-bridge");
        const detailBridgeNote = document.getElementById("gorevler-detail-bridge-note");
        const detailCompleteBtn = document.getElementById("gorevler-detail-complete");
        const detailDeleteBtn = document.getElementById("gorevler-detail-delete");
        const restoreLastBtn = document.getElementById("gorevler-restore-last");
        const clearTestBtn = document.getElementById("gorevler-clear-test");
        const planInlineEl = document.getElementById("gorevler-plan-inline");
        const planInlineTitleEl = document.getElementById("gorevler-plan-inline-title");
        const planInlineDl = document.getElementById("gorevler-plan-inline-dl");
        const planInlineStatusEl = document.getElementById("gorevler-plan-inline-status");
        const planInlineConfirmBtn = document.getElementById("gorevler-plan-inline-confirm");
        const planInlineDismissBtn = document.getElementById("gorevler-plan-inline-dismiss");
        const planInlineLowRiskNoteEl = document.getElementById("gorevler-plan-inline-low-risk-note");
        const planInlineActionsEl =
          planInlineEl && planInlineEl.querySelector(".gorevler-plan-actions");
        const detailPlanSection = document.getElementById("gorevler-detail-plan-section");
        const detailPlanSecTitleEl = document.getElementById("gorevler-detail-sec-plan");
        const detailPlanDl = document.getElementById("gorevler-detail-plan-dl");
        const detailPlanStatusEl = document.getElementById("gorevler-detail-plan-status");
        const detailPlanConfirmBtn = document.getElementById("gorevler-detail-plan-confirm");
        const detailPlanDismissBtn = document.getElementById("gorevler-detail-plan-dismiss");
        const detailPlanLowRiskNoteEl = document.getElementById("gorevler-detail-plan-low-risk-note");
        const detailPlanActionsEl =
          detailPlanSection && detailPlanSection.querySelector(".gorevler-plan-actions");
        const planInlineTeshisEl = document.getElementById("gorevler-plan-inline-teshis");
        const detailPlanTeshisEl = document.getElementById("gorevler-detail-plan-teshis");
        const evidenceContinueBtn = document.getElementById("gorevler-evidence-continue");
        const gorevlerPanelEl = document.getElementById("panel-gorevler");
        if (
          !listEl ||
          !titleInput ||
          !prioritySel ||
          !statusSel ||
          !addBtn ||
          !hintEl ||
          !detailEl ||
          !detailTitleEl ||
          !detailTaskDl ||
          !detailBridgeDl ||
          !detailCloseBtn ||
          !clearTestBtn
        ) {
          console.warn("[Lumos panel görev] wireGorevlerPrototype erken çıkış — görev listesi bağlanmadı.", {
            listEl: !!listEl,
            titleInput: !!titleInput,
            prioritySel: !!prioritySel,
            statusSel: !!statusSel,
            addBtn: !!addBtn,
            hintEl: !!hintEl,
            detailEl: !!detailEl,
            detailTitleEl: !!detailTitleEl,
            detailTaskDl: !!detailTaskDl,
            detailBridgeDl: !!detailBridgeDl,
            detailCloseBtn: !!detailCloseBtn,
            clearTestBtn: !!clearTestBtn,
          });
          return;
        }

        let gorevlerUseDialog =
          typeof detailEl.showModal === "function" && typeof detailEl.close === "function";
        if (!gorevlerUseDialog) {
          detailEl.classList.add("gorevler-detail--fallback");
          detailEl.hidden = true;
        } else {
          detailEl.addEventListener("close", () => {
            if (
              detailTaskDl.childElementCount > 0 ||
              detailBridgeDl.childElementCount > 0 ||
              (detailPlanDl && detailPlanDl.childElementCount > 0)
            ) {
              syncGorevlerDetailUiClosed(false);
            }
          });
          detailEl.addEventListener("cancel", (ev) => {
            ev.preventDefault();
            closeGorevlerDetail(true);
          });
        }

        let gorevlerEscapeHandler = null;
        let lastGorevlerOpenedIndex = -1;
        let lastGorevlerDeletedId = "";
        let lastGorevlerDeletedLocalRow = null;
        let lastGorevlerPlanIndex = -1;
        let gorevlerListFilter = "all";

        function syncGorevlerListEmptyState(visibleCount) {
          if (!listEmptyEl) return;
          if (visibleCount > 0) {
            listEmptyEl.hidden = true;
            listEmptyEl.textContent = "";
            return;
          }
          listEmptyEl.textContent =
            panelGorevlerTasks.length > 0
              ? panelT("panel.modules.tasks.empty.listFilter")
              : panelT("panel.modules.tasks.empty.listDefault");
          listEmptyEl.hidden = false;
        }

        function gorevlerTaskPassesListFilter(t) {
          const st = t && t.status != null ? String(t.status).trim() : "";
          if (gorevlerListFilter === "pending") return st !== "tamamlandi";
          if (gorevlerListFilter === "done") return st === "tamamlandi";
          return true;
        }

        function syncGorevlerListFilterUi() {
          document.querySelectorAll("[data-gorevler-filter]").forEach((btn) => {
            const v = btn.getAttribute("data-gorevler-filter");
            const active = v === gorevlerListFilter;
            btn.classList.toggle("is-active", active);
            btn.setAttribute("aria-pressed", active ? "true" : "false");
          });
        }

        function syncGorevlerDetailUiClosed(restoreFocus) {
          detailTaskDl.replaceChildren();
          detailBridgeDl.replaceChildren();
          if (detailPlanDl) detailPlanDl.replaceChildren();
          if (detailPlanSection) detailPlanSection.hidden = true;
          if (detailPlanStatusEl) {
            detailPlanStatusEl.hidden = true;
            detailPlanStatusEl.textContent = "";
          }
          detailTitleEl.textContent = panelT("panel.modules.tasks.detail.title");
          if (detailBridgeBtn) detailBridgeBtn.hidden = true;
          if (detailCompleteBtn) detailCompleteBtn.hidden = true;
          if (detailDeleteBtn) detailDeleteBtn.hidden = true;
          listEl.querySelectorAll(".gorevler-task-card").forEach((node) => {
            node.setAttribute("aria-expanded", "false");
          });
          if (gorevlerEscapeHandler) {
            document.removeEventListener("keydown", gorevlerEscapeHandler);
            gorevlerEscapeHandler = null;
          }
          if (restoreFocus && lastGorevlerOpenedIndex >= 0) {
            const li = listEl.querySelector(
              '[data-task-index="' + String(lastGorevlerOpenedIndex) + '"]',
            );
            if (li && typeof li.focus === "function") li.focus({ preventScroll: true });
          }
          lastGorevlerOpenedIndex = -1;
        }

        function closeGorevlerDetail(restoreFocus) {
          syncGorevlerDetailUiClosed(restoreFocus);
          if (gorevlerUseDialog) {
            if (detailEl.open) detailEl.close();
          } else {
            detailEl.hidden = true;
          }
        }

        function formatTrDateTime(iso) {
          const s = String(iso || "").trim();
          if (!s) return "—";
          const d = new Date(s);
          if (Number.isNaN(d.getTime())) return "—";
          try {
            return d.toLocaleString(panelLocaleTag(), { dateStyle: "short", timeStyle: "medium" });
          } catch {
            return s;
          }
        }

        /** Köprü JSON alanları (detay + kalıcılık). */
        function bridgeFieldsFromJson(data) {
          const empty = {
            route: null,
            source: null,
            accepted: null,
            result_file: null,
            execution_file: null,
          };
          if (!data || typeof data !== "object") return empty;
          const d = /** @type {Record<string, unknown>} */ (data);
          const routeRaw = d.route != null ? String(d.route).trim() : "";
          const route = routeRaw ? routeRaw : null;
          const sourceRaw = d.source != null ? String(d.source).trim() : "";
          const source = sourceRaw ? sourceRaw : null;
          let accepted = null;
          if (d.accepted === true || d.accepted === false) accepted = d.accepted;
          const rfRaw =
            d.result_file != null
              ? String(d.result_file).trim()
              : d.resultFile != null
                ? String(d.resultFile).trim()
                : "";
          const result_file = rfRaw ? rfRaw : null;
          const efRaw =
            d.execution_file != null
              ? String(d.execution_file).trim()
              : d.executionFile != null
                ? String(d.executionFile).trim()
                : "";
          const execution_file = efRaw ? efRaw : null;
          return { route, source, accepted, result_file, execution_file };
        }

        function assignTaskBridgeLast(taskRef, data, acceptedOverride) {
          const ts = new Date().toISOString();
          const f = bridgeFieldsFromJson(data);
          const snap = { ...f, lastBridgeAt: ts };
          if (acceptedOverride === true || acceptedOverride === false) snap.accepted = acceptedOverride;
          const sane = sanitizeBridgeLast(snap) || { lastBridgeAt: ts };
          taskRef.bridgeLast = sane;
          persistPanelGorevlerTasks();
        }

        function lumosOutboxPathBasename(p) {
          const s = p != null ? String(p).trim() : "";
          if (!s) return "";
          const parts = s.replace(/\\/g, "/").split("/");
          return parts[parts.length - 1] || s;
        }

        function appendDetailRow(dl, label, value) {
          const dt = document.createElement("dt");
          dt.textContent = label;
          const dd = document.createElement("dd");
          const raw = value != null && String(value).trim() ? String(value).trim() : "—";
          dd.textContent = panelUserVisibleText(raw);
          dl.appendChild(dt);
          dl.appendChild(dd);
        }

        function normalizeGorevlerPlanRiskToken(risk) {
          return String(risk != null ? risk : "")
            .trim()
            .toLocaleLowerCase("tr-TR")
            .replace(/ş/g, "s")
            .replace(/ı/g, "i")
            .replace(/ü/g, "u")
            .replace(/ö/g, "o")
            .replace(/ç/g, "c")
            .replace(/ğ/g, "g");
        }

        function isGorevlerPlanLowRisk(plan) {
          const p = sanitizeGorevlerTaskPlan(plan);
          if (!p) return false;
          const r = normalizeGorevlerPlanRiskToken(p.risk);
          return r === "dusuk" || r === "low";
        }

        function applyVisibilityForPlanRisk(plan) {
          const low = isGorevlerPlanLowRisk(plan);
          if (planInlineActionsEl) planInlineActionsEl.hidden = low;
          if (planInlineConfirmBtn) planInlineConfirmBtn.hidden = low;
          if (planInlineDismissBtn) planInlineDismissBtn.hidden = low;
          if (planInlineLowRiskNoteEl) planInlineLowRiskNoteEl.hidden = true;
          if (detailPlanActionsEl) detailPlanActionsEl.hidden = low;
          if (detailPlanConfirmBtn) detailPlanConfirmBtn.hidden = low;
          if (detailPlanDismissBtn) detailPlanDismissBtn.hidden = low;
          if (detailPlanLowRiskNoteEl) detailPlanLowRiskNoteEl.hidden = true;
        }

        const GOREVLER_TESHIS_LABEL_KEYS = [
          "panel.modules.tasks.plan.teshis.ozet",
          "panel.modules.tasks.plan.teshis.alan",
          "panel.modules.tasks.plan.teshis.not",
          "panel.modules.tasks.plan.teshis.sirada",
          "panel.modules.tasks.plan.teshis.risk",
          "panel.modules.tasks.plan.teshis.onay",
        ];

        function gorevlerTeshisLabels() {
          return GOREVLER_TESHIS_LABEL_KEYS.map((key) => panelT(key));
        }

        function gorevlerPlanNotDisplay(_plan) {
          return panelT("panel.modules.tasks.plan.notPending");
        }

        function gorevlerPlanAlanDisplay(plan) {
          const p = sanitizeGorevlerTaskPlan(plan);
          const raw = p && p.onerilenAlan ? String(p.onerilenAlan).trim() : "";
          if (!raw || raw === "gorevler" || /^görevler(\s+sekmesi)?$/i.test(raw)) {
            return panelT("panel.modules.tasks.plan.alanGorevler");
          }
          if (raw === "dosyalar" || /^dosyalar(\s+sekmesi)?$/i.test(raw)) {
            return panelT("panel.modules.tasks.plan.alanDosyalar");
          }
          if (raw === "transmission" || /^köprü(\s+sekmesi)?$/i.test(raw) || /^iletim(\s+sekmesi)?$/i.test(raw)) {
            return panelT("panel.modules.tasks.plan.alanIletim");
          }
          if (raw === "panel" || /^panel(\s+sekmesi)?$/i.test(raw)) {
            return panelT("panel.modules.tasks.plan.alanPanel");
          }
          return raw.replace(/\s+sekmesi$/i, "");
        }

        function updateGorevlerPlanCardTitles(_plan) {
          const title = panelT("panel.modules.tasks.detail.planTitle");
          if (planInlineTitleEl) planInlineTitleEl.textContent = title;
          if (detailPlanSecTitleEl) detailPlanSecTitleEl.textContent = title;
        }

        function buildGorevlerMediumHighRiskTeshisLines(_title, plan) {
          const p = sanitizeGorevlerTaskPlan(plan);
          const tespit =
            p && p.tur
              ? gorevlerPlanTurDisplay(p.tur) + "."
              : panelT("panel.modules.tasks.plan.defaultTespit");
          const cozum =
            p && p.sonrakiAdim
              ? gorevlerPlanSonrakiAdimDisplay(p.sonrakiAdim)
              : panelT("panel.modules.tasks.plan.defaultCozum");
          const onay =
            p && p.onayDurumu && String(p.onayDurumu).trim()
              ? String(p.onayDurumu).trim()
              : panelT("panel.modules.tasks.plan.defaultOnay");
          return [
            tespit,
            gorevlerPlanAlanDisplay(p),
            gorevlerPlanNotDisplay(p),
            cozum,
            p && p.risk ? gorevlerPlanRiskDisplay(p.risk) : panelT("panel.modules.tasks.plan.defaultRiskOrta"),
            onay,
          ];
        }

        function clearGorevlerTeshisEl(el) {
          if (!el) return;
          el.hidden = true;
          el.replaceChildren();
        }

        function appendGorevlerTeshisCompactLine(container, label, value) {
          const p = document.createElement("p");
          p.className = "gorevler-plan-teshis-compact__line";
          const strong = document.createElement("strong");
          strong.textContent = label + ": ";
          p.appendChild(strong);
          p.appendChild(document.createTextNode(value != null ? String(value) : "—"));
          container.appendChild(p);
        }

        function gorevlerPlanTitleForIndex(taskIndex) {
          if (taskIndex >= 0 && panelGorevlerTasks[taskIndex]) {
            const t = panelGorevlerTasks[taskIndex];
            return t.title != null ? String(t.title).trim() : "";
          }
          return titleInput && titleInput.value != null ? String(titleInput.value).trim() : "";
        }

        function renderGorevlerPlanTeshis(el, title, plan) {
          if (!el) return;
          if (isGorevlerPlanLowRisk(plan)) {
            clearGorevlerTeshisEl(el);
            return;
          }
          const lines = buildGorevlerMediumHighRiskTeshisLines(title, plan);
          const labels = gorevlerTeshisLabels();
          el.replaceChildren();
          for (let i = 0; i < labels.length; i++) {
            appendGorevlerTeshisCompactLine(el, labels[i], lines[i]);
          }
          el.hidden = false;
        }

        function fillGorevlerPlanDl(dl, plan) {
          if (!dl) return;
          dl.replaceChildren();
          const p = sanitizeGorevlerTaskPlan(plan);
          if (!p) return;
          const low = isGorevlerPlanLowRisk(p);
          if (low) {
            appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlStatus"), panelT("panel.modules.tasks.plan.lowRiskStatus"));
            appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlRisk"), gorevlerPlanRiskDisplay(p.risk));
            appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlAlan"), gorevlerPlanAlanDisplay(p));
            appendDetailRow(
              dl,
              panelT("panel.modules.tasks.plan.dlSonrakiAdim"),
              panelT("panel.modules.tasks.plan.lowRiskSonraki"),
            );
            appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlNot"), panelT("panel.modules.tasks.plan.lowRiskNot"));
            return;
          }
          const durum =
            p.onayDurumu && String(p.onayDurumu).trim()
              ? String(p.onayDurumu).trim()
              : panelT("panel.modules.tasks.plan.pendingApproval");
          appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlTur"), gorevlerPlanTurDisplay(p.tur));
          appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlRisk"), gorevlerPlanRiskDisplay(p.risk));
          appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlAlan"), gorevlerPlanAlanDisplay(p));
          appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlSirada"), gorevlerPlanSonrakiAdimDisplay(p.sonrakiAdim));
          appendDetailRow(dl, panelT("panel.modules.tasks.plan.dlNot"), gorevlerPlanNotDisplay(p));
        }

        function renderGorevlerPlanStatusEl(statusEl, plan) {
          if (!statusEl) return;
          const p = sanitizeGorevlerTaskPlan(plan);
          const od = p && p.onayDurumu != null ? String(p.onayDurumu).trim() : "";
          if (od) {
            statusEl.textContent = od;
            statusEl.hidden = false;
          } else {
            statusEl.textContent = "";
            statusEl.hidden = true;
          }
        }

        function hideGorevlerPlanInline() {
          lastGorevlerPlanIndex = -1;
          if (!planInlineEl) return;
          planInlineEl.hidden = true;
          if (planInlineDl) planInlineDl.replaceChildren();
          if (planInlineStatusEl) {
            planInlineStatusEl.hidden = true;
            planInlineStatusEl.textContent = "";
          }
          if (planInlineLowRiskNoteEl) planInlineLowRiskNoteEl.hidden = true;
          if (planInlineActionsEl) planInlineActionsEl.hidden = false;
          if (planInlineConfirmBtn) planInlineConfirmBtn.hidden = false;
          if (planInlineDismissBtn) planInlineDismissBtn.hidden = false;
          clearGorevlerTeshisEl(planInlineTeshisEl);
        }

        function showGorevlerPlanInline(plan, taskIndex) {
          if (!planInlineEl || !planInlineDl) return;
          const p = sanitizeGorevlerTaskPlan(plan);
          if (!p || !p.active) {
            hideGorevlerPlanInline();
            return;
          }
          lastGorevlerPlanIndex = taskIndex;
          updateGorevlerPlanCardTitles(p);
          fillGorevlerPlanDl(planInlineDl, p);
          renderGorevlerPlanStatusEl(planInlineStatusEl, p);
          applyVisibilityForPlanRisk(p);
          planInlineEl.hidden = false;
          if (planInlineConfirmBtn) {
            planInlineConfirmBtn.disabled = !!(p.onayDurumu && String(p.onayDurumu).trim());
          }
          renderGorevlerPlanTeshis(
            planInlineTeshisEl,
            gorevlerPlanTitleForIndex(taskIndex),
            p,
          );
        }

        function syncGorevlerDetailPlanSection(t, taskIndex) {
          if (!detailPlanSection || !detailPlanDl) return;
          const p = sanitizeGorevlerTaskPlan(t && t.taskPlan);
          if (!p || !p.active) {
            detailPlanSection.hidden = true;
            detailPlanDl.replaceChildren();
            if (detailPlanStatusEl) {
              detailPlanStatusEl.hidden = true;
              detailPlanStatusEl.textContent = "";
            }
            if (detailPlanLowRiskNoteEl) detailPlanLowRiskNoteEl.hidden = true;
            if (detailPlanActionsEl) detailPlanActionsEl.hidden = false;
            if (detailPlanConfirmBtn) detailPlanConfirmBtn.hidden = false;
            if (detailPlanDismissBtn) detailPlanDismissBtn.hidden = false;
            clearGorevlerTeshisEl(detailPlanTeshisEl);
            return;
          }
          lastGorevlerPlanIndex = taskIndex;
          detailPlanSection.hidden = false;
          updateGorevlerPlanCardTitles(p);
          fillGorevlerPlanDl(detailPlanDl, p);
          renderGorevlerPlanStatusEl(detailPlanStatusEl, p);
          applyVisibilityForPlanRisk(p);
          if (detailPlanConfirmBtn) {
            detailPlanConfirmBtn.disabled = !!(p.onayDurumu && String(p.onayDurumu).trim());
          }
          renderGorevlerPlanTeshis(
            detailPlanTeshisEl,
            t && t.title != null ? String(t.title).trim() : "",
            p,
          );
        }

        /** Plan onayı: köprü çalıştırmaz; yalnızca «Onay kaydedildi» yazar. */
        function confirmGorevlerTaskPlan(taskIndex) {
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          const p = sanitizeGorevlerTaskPlan(t.taskPlan);
          if (!p || !p.active) return;
          p.onayDurumu = panelT("panel.modules.tasks.plan.approvalSaved");
          t.taskPlan = p;
          persistPanelGorevlerTasks();
          render();
          if (lastGorevlerOpenedIndex === taskIndex) openGorevlerDetail(taskIndex);
          else if (lastGorevlerPlanIndex === taskIndex) showGorevlerPlanInline(p, taskIndex);
        }

        function dismissGorevlerTaskPlan(taskIndex) {
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          const p = sanitizeGorevlerTaskPlan(t.taskPlan);
          if (!p) return;
          p.active = false;
          t.taskPlan = p;
          persistPanelGorevlerTasks();
          hideGorevlerPlanInline();
          render();
          if (lastGorevlerOpenedIndex === taskIndex) openGorevlerDetail(taskIndex);
        }

        function openGorevlerDetail(taskIndex) {
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          lastGorevlerOpenedIndex = taskIndex;
          const bl = t.bridgeLast && typeof t.bridgeLast === "object" ? t.bridgeLast : null;
          detailTitleEl.textContent = t.title != null ? String(t.title).trim() || "—" : "—";
          detailTaskDl.replaceChildren();
          detailBridgeDl.replaceChildren();

          const statusTxt = gorevlerStatusLabel(t.status);
          const priorityTxt = gorevlerPriorityLabel(t.priority);
          const whenRaw = t.when != null ? String(t.when).trim() : "";
          const whenTxt = whenRaw ? whenRaw : "—";

          appendDetailRow(detailTaskDl, panelT("panel.modules.tasks.detail.dlStatus"), statusTxt);
          appendDetailRow(detailTaskDl, panelT("panel.modules.tasks.detail.dlPriority"), priorityTxt);
          appendDetailRow(detailTaskDl, panelT("panel.modules.tasks.detail.dlDate"), whenTxt);

          let route = "—";
          let source = "—";
          let acceptedTxt = "—";
          let resultFile = "—";
          let execFile = "—";
          let lastOp = "—";

          if (bl) {
            lastOp = formatTrDateTime(bl.lastBridgeAt);
            if (bl.route != null && String(bl.route).trim()) route = String(bl.route).trim();
            if (bl.source != null && String(bl.source).trim()) source = String(bl.source).trim();
            if (bl.accepted === true) acceptedTxt = panelT("panel.modules.tasks.detail.yes");
            else if (bl.accepted === false) acceptedTxt = panelT("panel.modules.tasks.detail.no");
            if (bl.result_file) {
              const raw = String(bl.result_file).trim();
              const bn = lumosOutboxPathBasename(raw);
              resultFile = bn || raw;
            }
            if (bl.execution_file) {
              const raw = String(bl.execution_file).trim();
              const bn = lumosOutboxPathBasename(raw);
              execFile = bn || raw;
            }
          }

          if (PANEL_DEBUG) {
            appendDetailRow(detailBridgeDl, panelT("panel.modules.tasks.detail.dlRoute"), route);
            appendDetailRow(detailBridgeDl, panelT("panel.modules.tasks.detail.dlSource"), source);
          }
          appendDetailRow(detailBridgeDl, panelT("panel.modules.tasks.detail.dlAccepted"), acceptedTxt);
          appendDetailRow(detailBridgeDl, panelT("panel.modules.tasks.detail.dlResultFile"), resultFile);
          appendDetailRow(detailBridgeDl, panelT("panel.modules.tasks.detail.dlExecFile"), execFile);
          appendDetailRow(detailBridgeDl, panelT("panel.modules.tasks.detail.dlBridgeTime"), lastOp);

          syncGorevlerDetailPlanSection(t, taskIndex);

          const hasId = !!(t.id && String(t.id).trim());
          const titleOk = !!(t.title && String(t.title).trim());
          const canComplete = hasId || titleOk;
          const bridgeRelayEligible = titleOk && t.status !== "tamamlandi";
          if (detailBridgeBtn) {
            detailBridgeBtn.hidden = bridgeOpsBlocked() || !bridgeRelayEligible;
          }
          if (detailBridgeNote) {
            detailBridgeNote.hidden = !(bridgeOpsBlocked() && bridgeRelayEligible);
          }
          if (detailCompleteBtn) {
            detailCompleteBtn.hidden = !canComplete || t.status === "tamamlandi";
          }
          if (detailDeleteBtn) {
            detailDeleteBtn.hidden = !canComplete;
          }

          if (gorevlerUseDialog) {
            try {
              if (!detailEl.open) detailEl.showModal();
            } catch (_) {
              gorevlerUseDialog = false;
              detailEl.classList.add("gorevler-detail--fallback");
            }
          }
          if (!gorevlerUseDialog) {
            detailEl.hidden = false;
            if (!gorevlerEscapeHandler) {
              gorevlerEscapeHandler = (ev) => {
                if (ev.key !== "Escape" || detailEl.hidden) return;
                ev.preventDefault();
                closeGorevlerDetail(true);
              };
              document.addEventListener("keydown", gorevlerEscapeHandler);
            }
          }
          if (typeof detailEl.focus === "function") detailEl.focus({ preventScroll: true });
        }

        /**
         * Görev kartı iletim özeti: geçerli zaman damgası varsa “Son iletim”, aksi halde “Henüz iletilmedi”.
         * Detay paneli ham `bridgeLast` ile doldurulmaya devam eder.
         * @param {Record<string, unknown> | null} blRow
         */
        function formatGorevlerTaskBridgeLine(blRow) {
          const blSumm = sanitizeBridgeLast(blRow);
          const iso =
            blSumm && blSumm.lastBridgeAt != null ? String(blSumm.lastBridgeAt).trim() : "";
          const isoOk = iso && !Number.isNaN(Date.parse(iso));
          if (blSumm && isoOk) {
            const whenBridge = formatTrDateTime(blSumm.lastBridgeAt);
            if (PANEL_DEBUG) {
              const routeBit =
                blSumm.route != null && String(blSumm.route).trim()
                  ? " · " + truncateGorevlerField(String(blSumm.route).trim()).slice(0, 56)
                  : "";
              return (
                panelT("panel.modules.tasks.detail.bridgeLastPrefix") +
                whenBridge +
                panelUserVisibleText(routeBit)
              );
            }
            let statusBit = "";
            if (blSumm.accepted === true) statusBit = panelT("panel.modules.tasks.detail.bridgeSentSuffix");
            else if (blSumm.accepted === false) {
              statusBit = panelT("panel.modules.tasks.detail.bridgeFailedSuffix");
            }
            return panelT("panel.modules.tasks.detail.bridgeLastPrefix") + whenBridge + statusBit;
          }
          return panelT("panel.modules.tasks.detail.bridgeNotYet");
        }

        function gorevlerTaskBadgeSlug(v) {
          const s = v != null ? String(v).trim().toLowerCase() : "";
          const slug = s.replace(/_/g, "-").replace(/[^a-z0-9-]/g, "") || "unknown";
          return slug;
        }

        function render() {
          closeGorevlerDetail(false);
          listEl.replaceChildren();
          let visibleCount = 0;
          for (let i = 0; i < panelGorevlerTasks.length; i++) {
            const t = panelGorevlerTasks[i];
            if (!gorevlerTaskPassesListFilter(t)) continue;
            visibleCount += 1;
            const li = document.createElement("li");
            li.className = "gorevler-task-card";
            li.tabIndex = 0;
            li.setAttribute("role", "button");
            li.setAttribute("data-task-index", String(i));
            li.setAttribute("aria-expanded", "false");
            li.setAttribute("aria-controls", "gorevler-detail");
            li.setAttribute(
              "aria-label",
              panelT("panel.modules.tasks.list.cardAriaPrefix") +
                ": " +
                t.title +
                "; " +
                panelT("panel.modules.tasks.list.cardAriaSuffix"),
            );

            const main = document.createElement("div");
            main.className = "gorevler-task-main";

            const titleEl = document.createElement("div");
            titleEl.className = "gorevler-task-title";
            titleEl.textContent = t.title != null ? String(t.title).trim() : "";
            main.appendChild(titleEl);

            const metaEl = document.createElement("div");
            metaEl.className = "gorevler-task-meta";
            const statusLabel = gorevlerStatusLabel(t.status);
            const priorityLabel = gorevlerPriorityLabel(t.priority);
            metaEl.textContent =
              panelT("panel.modules.tasks.list.metaStatus") +
              ": " +
              statusLabel +
              " · " +
              panelT("panel.modules.tasks.list.metaPriority") +
              ": " +
              priorityLabel;
            main.appendChild(metaEl);

            const whenEl = document.createElement("div");
            whenEl.className = "gorevler-task-when";
            const whenText = t.when != null ? String(t.when).trim() : "";
            whenEl.textContent = whenText || "\u00a0";
            if (!whenText) {
              whenEl.setAttribute("data-gorevler-when-empty", "");
              whenEl.setAttribute("aria-hidden", "true");
            }
            main.appendChild(whenEl);

            const blRow = t.bridgeLast && typeof t.bridgeLast === "object" ? t.bridgeLast : null;
            const bridgeEl = document.createElement("div");
            bridgeEl.className = "gorevler-task-bridge";
            bridgeEl.textContent = formatGorevlerTaskBridgeLine(blRow);
            main.appendChild(bridgeEl);

            const planSummary = formatGorevlerPlanListSummary(t.taskPlan);
            if (planSummary) {
              const planEl = document.createElement("div");
              planEl.className = "gorevler-task-plan";
              planEl.textContent = planSummary;
              main.appendChild(planEl);
            }

            if (sanitizeBridgeLast(blRow)) {
              li.classList.add("gorevler-task-card--has-bridge");
            }

            li.appendChild(main);
            listEl.appendChild(li);
          }
          syncGorevlerListEmptyState(visibleCount);
        }

        let gorevlerHintRefresh = null;

        function paintGorevlerHintFromResolver() {
          if (!gorevlerHintRefresh) return;
          const s = panelUserVisibleText(gorevlerHintRefresh());
          hintEl.textContent = s;
          hintEl.hidden = false;
          hintEl.style.whiteSpace = s.indexOf("\n") >= 0 ? "pre-line" : "";
        }

        function setGorevlerHint(resolver) {
          gorevlerHintRefresh = typeof resolver === "function" ? resolver : () => String(resolver ?? "");
          paintGorevlerHintFromResolver();
        }

        function refreshGorevlerVisibleHintI18n() {
          if (hintEl.hidden || !gorevlerHintRefresh) return;
          paintGorevlerHintFromResolver();
        }

        function hideHint() {
          gorevlerHintRefresh = null;
          hintEl.hidden = true;
          hintEl.textContent = "";
          hintEl.style.whiteSpace = "";
        }

        /**
         * POST /task 200 ve accepted !== false: ham JSON yerine kısa özet (üst hint).
         * @param {Record<string, unknown>} data
         */
        function buildTaskBridgeSuccessReadableHint(data) {
          if (data.accepted === false) {
            return panelT("panel.modules.tasks.hints.bridgeFailed");
          }
          if (data.accepted === true) return panelT("panel.modules.tasks.hints.bridgeSent");
          if (data.ok === true) return panelT("panel.modules.tasks.hints.bridgeAccepted");
          return panelT("panel.modules.tasks.hints.bridgeAccepted");
        }

        /**
         * Görevler: POST /tasks → .lumos/tasks.json; isteğe bağlı POST /tasks/complete;
         * ardından yerel plan kartı (görev eklerken köprü yok).
         */
        function finishAddTaskLocal(title, priority, status) {
          const taskRef = pushGorevlerTaskLocalRow(title, priority, status);
          enqueueEvidencePendingOp("create", title, "title");
          titleInput.value = "";
          const savedPlan = taskRef.taskPlan;
          const savedIdx = panelGorevlerTasks.indexOf(taskRef);
          if (savedPlan && savedIdx >= 0) showGorevlerPlanInline(savedPlan, savedIdx);
          setGorevlerHint(() => panelT("panel.modules.tasks.hints.savedLocal"));
          return taskRef;
        }

        async function addTask() {
          const title = titleInput.value.trim();
          if (!title) {
            setGorevlerHint(() => panelT("panel.modules.tasks.hints.titleEmpty"));
            titleInput.focus();
            return;
          }
          hideHint();

          const priority = prioritySel.value;
          const status = statusSel.value;

          if (shouldSkipGorevlerTasksApi()) {
            finishAddTaskLocal(title, priority, status);
            return;
          }

          let createRes;
          let apiUnreachable = false;
          try {
            createRes = await tasksApiPost("/tasks", { title });
          } catch {
            apiUnreachable = true;
          }
          if (
            apiUnreachable ||
            !createRes ||
            !createRes.ok ||
            !createRes.data ||
            !createRes.data.ok
          ) {
            if (shouldFallbackGorevlerTasksLocal(apiUnreachable)) {
              finishAddTaskLocal(title, priority, status);
              return;
            }
            const err =
              createRes &&
              createRes.data &&
              createRes.data.error != null
                ? String(createRes.data.error)
                : panelDebugText(
                    "create_failed (" + (createRes ? createRes.status : "?") + ")",
                    "create_failed",
                  );
            const prodErrCtx = {
              rawError: err,
              httpStatus: createRes ? createRes.status : null,
              apiUnreachable,
            };
            setGorevlerHint(() => panelProdErrorUserMessage(prodErrCtx));
            return;
          }

          const taskId =
            createRes.data.task && createRes.data.task.id != null
              ? String(createRes.data.task.id).trim()
              : "";
          if (status === "tamamlandi" && taskId) {
            await tasksApiPost("/tasks/complete", { ref: taskId });
          }

          const refreshed = await refreshPanelGorevlerFromTasksApi();
          if (!refreshed && createRes.data.task) {
            const row = engineTaskToPanelRow(createRes.data.task);
            if (row) {
              if (priority) row.priority = priority;
              if (status === "onay_bekliyor") row.status = "onay_bekliyor";
              else if (status === "tamamlandi") row.status = "tamamlandi";
              panelGorevlerTasks.push(row);
              persistPanelGorevlerTasks();
              render();
            }
          }

          const taskRef = findPanelGorevlerRow(taskId, title);
          if (taskRef) {
            if (priority) taskRef.priority = priority;
            if (status === "onay_bekliyor") taskRef.status = "onay_bekliyor";
            persistPanelGorevlerTasks();
            render();
          }

          titleInput.value = "";

          if (!taskRef) {
            hideHint();
            return;
          }

          const savedPlan = attachGorevlerTaskPlan(taskRef, title);
          render();
          const savedIdx = panelGorevlerTasks.indexOf(taskRef);
          if (savedPlan && savedIdx >= 0) showGorevlerPlanInline(savedPlan, savedIdx);

          setGorevlerHint(() => panelT("panel.modules.tasks.hints.savedWithPlan"));
        }

        async function sendBridgeOpenGorevlerTask() {
          const taskIndex = lastGorevlerOpenedIndex;
          if (taskIndex < 0) return;
          const t = panelGorevlerTasks[taskIndex];
          if (!t) return;
          const title = t.title != null ? String(t.title).trim() : "";
          if (!title || t.status === "tamamlandi") return;

          hideHint();
          const priority =
            t.priority != null && String(t.priority).trim()
              ? String(t.priority).trim()
              : prioritySel.value;
          const status =
            t.status != null && String(t.status).trim() ? String(t.status).trim() : "bekliyor";

          if (detailBridgeBtn) {
            detailBridgeBtn.disabled = true;
            detailBridgeBtn.setAttribute("aria-busy", "true");
          }

          try {
            const r = await fetch(TASK_BRIDGE_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                goal: title,
                source: "panel_gorevler",
                priority,
                status,
              }),
            });

            let data = null;
            try {
              data = await r.json();
            } catch {
              data = null;
            }

            if (taskBridgeBlockedResponse(r.status)) {
              const bridgeHint = bridgeBlockedUserHint();
              if (bridgeHint) setGorevlerHint(() => bridgeHint);
              return;
            }
            if (r.status === 401) {
              setGorevlerHint(() => panelT("panel.modules.chat.errors.unauthorized"));
              return;
            }
            if (!r.ok) {
              setGorevlerHint(() =>
                panelDebugText(
                  "Köprüye gönderilemedi (HTTP " +
                    r.status +
                    ")." +
                    (data && (data.error || data.message)
                      ? " " + String(data.error || data.message).trim().slice(0, 80)
                      : ""),
                  panelT("panel.modules.tasks.hints.bridgeFailed"),
                ),
              );
              return;
            }

            assignTaskBridgeLast(t, data);
            render();
            openGorevlerDetail(taskIndex);
            setGorevlerHint(() => buildTaskBridgeSuccessReadableHint(data));
          } catch {
            setGorevlerHint(() => panelT("panel.modules.tasks.hints.bridgeFailed"));
          } finally {
            if (detailBridgeBtn) {
              detailBridgeBtn.disabled = false;
              detailBridgeBtn.removeAttribute("aria-busy");
            }
          }
        }

        function completeGorevlerTaskLocal(t) {
          t.status = "tamamlandi";
          persistPanelGorevlerTasks();
          render();
          const er = evidenceRefFromGorevlerRow(t);
          if (er.ref) enqueueEvidencePendingOp("complete", er.ref, er.refKind);
        }

        async function completeOpenGorevlerTask() {
          const t = panelGorevlerTasks[lastGorevlerOpenedIndex];
          if (!t) return;
          const ref = t.id ? String(t.id).trim() : String(t.title || "").trim();
          if (!ref) return;
          hideHint();
          if (shouldSkipGorevlerTasksApi()) {
            completeGorevlerTaskLocal(t);
            closeGorevlerDetail(true);
            hideHint();
            return;
          }
          let res;
          let apiUnreachable = false;
          try {
            res = await tasksApiPost("/tasks/complete", { ref });
          } catch {
            apiUnreachable = true;
          }
          if (apiUnreachable || !res || !res.ok || !res.data || !res.data.ok) {
            if (shouldFallbackGorevlerTasksLocal(apiUnreachable)) {
              completeGorevlerTaskLocal(t);
              closeGorevlerDetail(true);
              hideHint();
              return;
            }
            const err =
              res && res.data && res.data.error != null ? String(res.data.error) : "complete_failed";
            const completeErrCtx = {
              rawError: err,
              httpStatus: res ? res.status : null,
              apiUnreachable,
            };
            setGorevlerHint(() => panelProdErrorUserMessage(completeErrCtx));
            return;
          }
          await refreshPanelGorevlerFromTasksApi();
          closeGorevlerDetail(true);
          hideHint();
        }

        function gorevlerTitleMatchesRef(ref, title) {
          const r = String(ref || "")
            .trim()
            .toLocaleLowerCase("tr-TR")
            .replace(/\s+/g, " ");
          const t = String(title || "")
            .trim()
            .toLocaleLowerCase("tr-TR")
            .replace(/\s+/g, " ");
          if (!r || !t) return false;
          if (t === r) return true;
          if (t.replace(/-/g, " ") === r.replace(/-/g, " ")) return true;
          if (t.replace(/\s+/g, "-") === r.replace(/\s+/g, "-")) return true;
          return false;
        }

        function findGorevlerTaskIndexByRef(ref) {
          const r = String(ref || "").trim();
          if (!r) return -1;
          for (let i = panelGorevlerTasks.length - 1; i >= 0; i--) {
            const row = panelGorevlerTasks[i];
            if (!row) continue;
            const id = row.id ? String(row.id).trim() : "";
            if (id && id === r) return i;
            const title = row.title ? String(row.title).trim() : "";
            if (title && gorevlerTitleMatchesRef(r, title)) return i;
          }
          return -1;
        }

        panelEvidenceOpenTaskDetail = function (taskId) {
          const idx = findGorevlerTaskIndexByRef(taskId);
          if (idx >= 0) openGorevlerDetail(idx);
        };

        if (evidenceContinueBtn) {
          evidenceContinueBtn.addEventListener("click", () => {
            if (panelEvidenceLatestGroup) evidenceContinueFromGroup(panelEvidenceLatestGroup);
          });
        }

        if (gorevlerPanelEl && typeof MutationObserver !== "undefined") {
          const evidenceObs = new MutationObserver(() => {
            if (
              gorevlerPanelEl.getAttribute("data-active") === "true" &&
              typeof panelEvidenceRefreshStrip === "function"
            ) {
              panelEvidenceRefreshStrip();
            }
          });
          evidenceObs.observe(gorevlerPanelEl, { attributes: true, attributeFilter: ["data-active"] });
        }

        if (typeof panelEvidenceRefreshStrip === "function") panelEvidenceRefreshStrip();

        function removeGorevlerTaskLocalByRef(ref) {
          const idx = findGorevlerTaskIndexByRef(ref);
          if (idx < 0) return false;
          panelGorevlerTasks.splice(idx, 1);
          persistPanelGorevlerTasks();
          return true;
        }

        function removeGorevlerTaskLocalById(deletedId) {
          const id = String(deletedId || "").trim();
          if (!id) return false;
          return removeGorevlerTaskLocalByRef(id);
        }

        function buildGorevlerNotFoundMessage(ref) {
          const r = String(ref || "").trim();
          return panelT("panel.modules.chat.gorev.notFound").replace("{ref}", r);
        }

        function buildGorevDeleteSuccessMessage(titleOrRef) {
          const t = String(titleOrRef || "").trim();
          return (
            panelT("panel.modules.chat.gorev.deleted").replace("{title}", t) +
            panelGorevDeleteRestoreHint()
          );
        }

        function refreshPanelEvidenceStripIfReady() {
          if (typeof panelEvidenceRefreshStrip === "function") panelEvidenceRefreshStrip();
        }

        function gorevlerLastDeletedDisplayTitle() {
          const row = lastGorevlerDeletedLocalRow;
          if (row && row.title) return String(row.title).trim();
          const id = String(lastGorevlerDeletedId || "").trim();
          return id || "görev";
        }

        function gorevlerLastDeletedMatchesRef(ref) {
          const r = String(ref || "").trim();
          if (!lastGorevlerDeletedId && !lastGorevlerDeletedLocalRow) return false;
          if (!r) return true;
          const deletedId = String(lastGorevlerDeletedId || "").trim();
          if (deletedId && deletedId === r) return true;
          const row = lastGorevlerDeletedLocalRow;
          if (row) {
            const id = row.id ? String(row.id).trim() : "";
            if (id && id === r) return true;
            const title = row.title ? String(row.title).trim() : "";
            if (title && gorevlerTitleMatchesRef(r, title)) return true;
          }
          if (deletedId && !String(deletedId).startsWith("tsk_")) {
            if (gorevlerTitleMatchesRef(r, deletedId)) return true;
          }
          return false;
        }

        function gorevlerRestoreVerifyRef() {
          const row = lastGorevlerDeletedLocalRow;
          if (row) {
            const id = row.id ? String(row.id).trim() : "";
            if (id) return id;
            if (row.title) return String(row.title).trim();
          }
          return String(lastGorevlerDeletedId || "").trim();
        }

        function gorevlerTaskPresentInList(ref) {
          const r = String(ref || "").trim();
          if (!r) return false;
          return findGorevlerTaskIndexByRef(r) >= 0;
        }

        function finishDeleteGorevlerTaskLocal(t, ref) {
          const deletedKey = t.id ? String(t.id).trim() : String(ref || t.title || "").trim();
          lastGorevlerDeletedId = deletedKey;
          lastGorevlerDeletedLocalRow = { ...t };
          if (restoreLastBtn) restoreLastBtn.hidden = false;
          const er = evidenceRefFromGorevlerRow(t);
          const deleteRef = er.ref || sanitizeEvidenceQueueRef(ref || t.title);
          if (deleteRef) enqueueEvidencePendingOp("delete", deleteRef, er.refKind);
          removeGorevlerTaskLocalByRef(deletedKey);
          closeGorevlerDetail(true);
          render();
          setGorevlerHint(() => panelT("panel.modules.tasks.hints.deleted"));
          refreshPanelEvidenceStripIfReady();
        }

        async function deleteGorevlerTaskFromChat(ref) {
          const r = String(ref || "").trim();
          if (!r) return panelT("panel.modules.chat.gorev.deleteMissingRef");
          if (
            !confirm(
              panelT("panel.modules.chat.gorev.deleteConfirm").replace("{ref}", r),
            )
          ) {
            return panelT("panel.modules.chat.gorev.deleteCancelled");
          }
          hideHint();
          const idx = findGorevlerTaskIndexByRef(r);
          const t = idx >= 0 ? panelGorevlerTasks[idx] : null;
          const detailIdxToClose = idx >= 0 && lastGorevlerOpenedIndex === idx ? idx : -1;
          if (shouldSkipGorevlerTasksApi()) {
            if (!t) return buildGorevlerNotFoundMessage(r);
            finishDeleteGorevlerTaskLocal(t, r);
            return buildGorevDeleteSuccessMessage(String(t.title || r).trim());
          }
          let res;
          let apiUnreachable = false;
          try {
            res = await tasksApiPost("/tasks/delete", { ref: r });
          } catch {
            apiUnreachable = true;
          }
          if (res && (res.status === 404 || (res.data && res.data.error === "not_found"))) {
            return buildGorevlerNotFoundMessage(r);
          }
          if (apiUnreachable || !res || !res.ok || !res.data || !res.data.ok) {
            if (shouldFallbackGorevlerTasksLocal(apiUnreachable)) {
              if (!t) return buildGorevlerNotFoundMessage(r);
              finishDeleteGorevlerTaskLocal(t, r);
              return buildGorevDeleteSuccessMessage(String(t.title || r).trim());
            }
            const err =
              res && res.data && res.data.error != null ? String(res.data.error) : "delete_failed";
            return panelT("panel.modules.chat.gorev.deleteFailed").replace("{error}", err);
          }
          const deletedId = t && t.id ? String(t.id).trim() : r;
          lastGorevlerDeletedId = deletedId;
          lastGorevlerDeletedLocalRow = null;
          if (restoreLastBtn) restoreLastBtn.hidden = false;
          const refreshed = await refreshPanelGorevlerFromTasksApi();
          if (!refreshed) removeGorevlerTaskLocalByRef(r);
          if (detailIdxToClose >= 0) closeGorevlerDetail(true);
          if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
          refreshPanelEvidenceStripIfReady();
          const title = t && t.title ? String(t.title).trim() : r;
          return buildGorevDeleteSuccessMessage(title);
        }

        async function deleteOpenGorevlerTask() {
          const t = panelGorevlerTasks[lastGorevlerOpenedIndex];
          if (!t) return;
          const ref = t.id ? String(t.id).trim() : String(t.title || "").trim();
          if (!ref) return;
          if (!confirm(panelT("panel.modules.tasks.confirm.deleteOpen"))) return;
          hideHint();
          if (shouldSkipGorevlerTasksApi()) {
            finishDeleteGorevlerTaskLocal(t, ref);
            return;
          }
          let res;
          let apiUnreachable = false;
          try {
            res = await tasksApiPost("/tasks/delete", { ref });
          } catch {
            apiUnreachable = true;
          }
          if (apiUnreachable || !res || !res.ok || !res.data || !res.data.ok) {
            if (shouldFallbackGorevlerTasksLocal(apiUnreachable)) {
              finishDeleteGorevlerTaskLocal(t, ref);
              return;
            }
            const err =
              res && res.data && res.data.error != null ? String(res.data.error) : "delete_failed";
            const completeErrCtx = {
              rawError: err,
              httpStatus: res ? res.status : null,
