---
import GlobalMay19Corner from "../components/GlobalMay19Corner.astro";

const GITHUB_REPO_URL = "https://github.com/candasoz01-cmd/lumos-core";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Lumos by We Lock AI</title>
    <meta
      name="description"
      content="We Lock AI çatısı altındaki Lumos: tek panelde çoklu akışı bir araya getiren, kararı kullanıcıda tutan yapay zekâ kontrol ve asistan katmanı."
    />
    <link rel="canonical" href="https://welockai.com/" />
    <meta property="og:title" content="Lumos by We Lock AI" />
    <meta
      property="og:description"
      content="Lumos, We Lock AI çatısı altında geliştirilen insan merkezli yapay zekâ kontrol katmanıdır."
    />
    <meta property="og:url" content="https://welockai.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content="https://welockai.com/lumos-world-map.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <link rel="icon" href="/lumos-tree-logo.png" type="image/png" sizes="any" />
    <link rel="apple-touch-icon" href="/lumos-tree-logo.png" type="image/png" />
    <link rel="stylesheet" href="/styles/lumos-tokens.css" />
    <style>
      /**
       * Landing: Lumos-son hero havası — çok koyu lacivert/siyah zemin, elektrik cyan-mavi,
       * kontrollü sıcak altın ikincil. `--lumos-land-teal` adı panel uyumu için; değerler cyan-mavi kanalı.
       */
      :root {
        --lumos-land-teal: 56 206 255;
        --lumos-land-teal-deep: 8 52 108;
        --lumos-land-warm: 186 148 88;
        --lumos-land-warm-deep: 128 96 54;
        /** Harita / hero ile aynı zemin */
        --lumos-map-canvas: #020511;
        --lumos-land-page: #030714;
        --lumos-land-title: #e9eef5;
        --lumos-text-muted: #aeb6c8;
        --lumos-text-body: #d4dae8;
        --lumos-text-sep: rgb(138 152 172 / 0.42);
        --lumos-heading-warm: #d6ccb8;
        --lumos-interactive-fg: rgb(var(--lumos-land-teal) / 0.92);
        --lumos-interactive-fg-hover: #b8f0ff;

        --lumos-accent-blue: rgb(130 206 255 / 0.92);
        --lumos-accent-blue-soft: rgb(var(--lumos-land-teal) / 0.34);
        --lumos-accent-blue-bright: #a8e9ff;
        --lumos-accent-gold: #c6a66a;

        --lumos-vizyon-card-bg: rgba(4, 8, 18, 0.96);
        --lumos-vizyon-card-border: rgb(var(--lumos-land-teal) / 0.2);
        --lumos-vizyon-card-border-gold: rgb(var(--lumos-land-warm) / 0.16);
        --lumos-vizyon-eyebrow: rgb(152 174 200 / 0.78);
      }
      html {
        scroll-behavior: smooth;
      }
      body.lumos-landing {
        margin: 0;
        min-height: 100vh;
        background-color: var(--lumos-land-page);
        background-image:
          radial-gradient(ellipse 130% 88% at 50% -6%, rgb(12 40 88 / 0.48), transparent 54%),
          radial-gradient(ellipse 88% 52% at 94% 38%, rgb(var(--lumos-land-teal) / 0.06), transparent 46%),
          radial-gradient(ellipse 72% 48% at 10% 72%, rgb(var(--lumos-land-warm) / 0.028), transparent 50%),
          linear-gradient(178deg, #010308 0%, #061022 44%, #030714 100%);
        background-attachment: fixed;
        color: var(--lumos-land-title);
        font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, sans-serif;
        line-height: 1.6;
      }
      .lumos-site-nav {
        margin: 0 0 clamp(0.65rem, 1.8vw, 1rem);
        padding-bottom: clamp(0.5rem, 1.3vw, 0.72rem);
        border-bottom: 1px solid rgb(var(--lumos-land-teal) / 0.38);
        box-shadow: 0 1px 0 rgb(var(--lumos-land-warm-deep) / 0.14);
      }
      .lumos-site-nav__bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.45rem 0.65rem;
        flex-wrap: wrap;
      }
      .lumos-site-nav__brand-left {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        margin-right: auto;
        padding-left: 0.05rem;
        overflow: visible;
        align-self: flex-start;
        padding-top: 0.12rem;
      }
      .lumos-site-nav__corner {
        flex: 0 0 auto;
        padding-left: 0.35rem;
        padding-right: max(0.15rem, env(safe-area-inset-right, 0px));
      }
      .lumos-site-nav__list {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        flex: 1 1 auto;
        min-width: 0;
        gap: 0.25rem 0.65rem;
        margin: 0;
        padding: 0 0 2px;
        list-style: none;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: rgb(var(--lumos-land-teal) / 0.38) transparent;
      }
      .lumos-site-nav__list::-webkit-scrollbar {
        height: 4px;
      }
      .lumos-site-nav__list::-webkit-scrollbar-thumb {
        background: rgb(var(--lumos-land-teal) / 0.4);
        border-radius: 4px;
      }
      .lumos-site-nav__link {
        display: inline-block;
        flex-shrink: 0;
        padding: 0.32rem 0.48rem;
        font-size: clamp(0.7rem, 2.35vw, 0.85rem);
        font-weight: 600;
        letter-spacing: 0.02em;
        color: rgb(var(--lumos-land-teal) / 0.88);
        text-decoration: none;
        white-space: nowrap;
        border-radius: 8px;
        border: 1px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }
      .lumos-site-nav__link:hover,
      .lumos-site-nav__link:focus-visible {
        color: var(--lumos-accent-blue-bright);
        border-color: rgb(var(--lumos-land-teal) / 0.38);
        background: rgba(8, 14, 28, 0.58);
      }
      .lumos-site-nav__link:focus-visible {
        outline: 2px solid rgb(var(--lumos-land-teal) / 0.45);
        outline-offset: 2px;
      }
      .lumos-site-nav__link--accent {
        color: rgb(var(--lumos-land-warm) / 0.88);
      }
      .lumos-site-nav__link--accent:hover,
      .lumos-site-nav__link--accent:focus-visible {
        color: rgb(var(--lumos-land-warm) / 0.98);
        border-color: rgb(var(--lumos-land-warm-deep) / 0.38);
        background: rgba(12, 10, 8, 0.5);
      }
      .lumos-site-nav__brand-left .lumos-site-nav__logo {
        margin-right: 0;
      }
      .lumos-site-nav__logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        padding: 0.35rem;
        overflow: visible;
        border-radius: 10px;
        border: 1px solid transparent;
        text-decoration: none;
        transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
      }
      .lumos-site-nav__logo:hover,
      .lumos-site-nav__logo:focus-visible {
        border-color: rgb(var(--lumos-land-teal) / 0.35);
        background: rgba(8, 14, 28, 0.48);
        box-shadow: 0 0 0 1px rgb(var(--lumos-land-warm-deep) / 0.1);
      }
      .lumos-site-nav__logo:focus-visible {
        outline: 2px solid rgb(var(--lumos-land-teal) / 0.45);
        outline-offset: 2px;
      }
      /** Lumos site logosu: raster ağaç işareti (lumos-tree-logo.png); hafif derinlik */
      .lumos-logo-mark {
        display: block;
        box-sizing: border-box;
        flex-shrink: 0;
        object-fit: contain;
        object-position: center center;
        filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.45));
      }
      .lumos-site-nav__logo .lumos-logo-mark {
        width: 1.65rem;
        height: 1.65rem;
        max-width: none;
        max-height: none;
      }
      .lumos-hero-title-lockup {
        display: flex;
        align-items: center;
        gap: clamp(0.45rem, 1.6vw, 0.65rem);
        margin: 0 0 0.45rem;
      }
      .lumos-hero-title-lockup .lumos-hero-title-mark {
        width: clamp(2rem, 5.5vw, 2.75rem);
        height: clamp(2rem, 5.5vw, 2.75rem);
        margin-top: 0.12em;
        flex-shrink: 0;
      }
      .lumos-hero-title-lockup .lumos-hero-title-page {
        margin: 0;
      }
      .lumos-hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem 0.75rem;
        margin: 0.35rem 0 0;
      }
      .lumos-hero-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.52rem 1.05rem;
        border-radius: 10px;
        font-size: clamp(0.84rem, 2vw, 0.92rem);
        font-weight: 600;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease, transform 0.2s ease;
      }
      .lumos-hero-btn--primary {
        border: 1px solid rgb(var(--lumos-land-teal) / 0.48);
        background: linear-gradient(165deg, rgba(18, 28, 42, 0.95) 0%, rgba(14, 18, 30, 0.92) 100%);
        color: var(--lumos-interactive-fg);
      }
      .lumos-hero-btn--primary:hover,
      .lumos-hero-btn--primary:focus-visible {
        border-color: rgb(var(--lumos-land-teal) / 0.68);
        color: var(--lumos-interactive-fg-hover);
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.35), 0 0 0 1px rgb(var(--lumos-land-teal) / 0.12);
        transform: translateY(-1px);
      }
      .lumos-hero-btn--ghost {
        border: 1px solid rgb(var(--lumos-land-teal) / 0.32);
        background: rgba(8, 14, 26, 0.62);
        color: rgb(var(--lumos-land-teal) / 0.88);
      }
      .lumos-hero-btn--ghost:hover,
      .lumos-hero-btn--ghost:focus-visible {
        border-color: rgb(var(--lumos-land-teal) / 0.52);
        color: var(--lumos-interactive-fg-hover);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28), 0 0 0 1px rgb(var(--lumos-land-warm-deep) / 0.12);
        transform: translateY(-1px);
      }
      .lumos-hero-btn:focus-visible {
        outline: 2px solid rgb(var(--lumos-land-teal) / 0.5);
        outline-offset: 3px;
      }
      #modules,
      #dunya-hero,
      #dunya-vizyon {
        scroll-margin-top: 1.25rem;
      }
      /** Giriş: geniş Lumos kartı — sol metin, sağda düşük baskınlıkta dekoratif görsel */
      #giris.lumos-section {
        position: relative;
        isolation: isolate;
        padding-bottom: clamp(1.5rem, 3.5vw, 2.25rem);
      }
      #giris.lumos-section::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.5;
        background:
          repeating-linear-gradient(90deg, rgb(var(--lumos-land-teal) / 0.028) 0 1px, transparent 1px 72px),
          repeating-linear-gradient(0deg, rgb(var(--lumos-land-teal) / 0.022) 0 1px, transparent 1px 72px),
          radial-gradient(ellipse 52% 44% at 59% 32%, rgb(var(--lumos-land-teal-deep) / 0.16), transparent 62%),
          radial-gradient(ellipse 95% 55% at 48% 38%, rgb(var(--lumos-land-teal-deep) / 0.09), transparent 58%),
          radial-gradient(ellipse 70% 45% at 82% 72%, rgb(var(--lumos-land-warm) / 0.032), transparent 52%),
          radial-gradient(circle at 18% 62%, rgb(var(--lumos-land-teal) / 0.045), transparent 42%);
      }
      #giris.lumos-section > * {
        position: relative;
        z-index: 1;
      }
      #giris.lumos-section--tight-top {
        padding-top: clamp(0.8rem, 2vw, 1.15rem);
      }
      .lumos-hero-row {
        display: flex;
        align-items: stretch;
        flex: 1 1 auto;
        width: 100%;
        min-height: 0;
      }
      .lumos-hero-dna {
        flex: 0 0 13px;
        width: 13px;
        min-width: 13px;
        position: relative;
        pointer-events: none;
        opacity: 1;
      }
      .lumos-hero-dna svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      .lumos-hero-imgwrap {
        flex: 1 1 auto;
        min-width: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.1rem, 2.8vw, 1.75rem);
        align-items: start;
      }
      .lumos-hero-brand {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0;
        border-radius: 12px;
        padding: clamp(1.5rem, 3.6vw, 2.65rem) clamp(1rem, 3vw, 2.1rem);
        min-height: clamp(360px, 50vh, 620px);
        min-height: clamp(360px, 50svh, 620px);
        overflow: hidden;
        background:
          radial-gradient(ellipse 55% 48% at 58% 36%, rgb(var(--lumos-land-teal-deep) / 0.16), transparent 58%),
          radial-gradient(circle at 12% 18%, rgb(var(--lumos-land-teal-deep) / 0.2), transparent 42%),
          radial-gradient(circle at 85% 78%, rgb(var(--lumos-land-warm) / 0.06), transparent 44%),
          linear-gradient(165deg, #020510 0%, #081428 38%, #04060e 100%);
        border: 1px solid rgb(var(--lumos-land-teal) / 0.34);
        box-shadow:
          inset 0 1px 0 rgb(var(--lumos-land-warm) / 0.05),
          0 0 0 1px rgb(var(--lumos-land-teal-deep) / 0.35),
          0 10px 36px rgba(0, 0, 0, 0.58),
          0 0 32px rgb(var(--lumos-land-teal-deep) / 0.18),
          0 0 52px rgb(var(--lumos-land-teal) / 0.1);
      }
      .lumos-hero-copy {
        max-width: min(56rem, 100%);
        flex: 1 1 auto;
        min-width: 0;
      }
      .lumos-hero-eyebrow {
        margin: 0 0 0.55rem;
        font-size: clamp(0.68rem, 1.55vw, 0.78rem);
        font-weight: 650;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgb(196 214 232 / 0.88);
      }
      .lumos-hero-title-page {
        margin: 0;
        font-size: clamp(2.35rem, 7vw, 3.85rem);
        line-height: 1.04;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--lumos-land-title);
        text-shadow:
          0 0 26px rgb(var(--lumos-land-teal) / 0.14),
          0 1px 0 rgb(255 255 255 / 0.14);
      }
      .lumos-hero-title-page--manifesto {
        max-width: min(38rem, 100%);
        font-size: clamp(1.42rem, 3.55vw, 2.28rem);
        line-height: 1.12;
        letter-spacing: -0.025em;
      }
      @supports ((-webkit-background-clip: text) or (background-clip: text)) {
        .lumos-hero-title-page {
          color: transparent;
          background-image: linear-gradient(
            168deg,
            #f7f9fc 0%,
            #e4ecf6 28%,
            #9eb4d4 64%,
            #d2deed 100%
          );
          -webkit-background-clip: text;
          background-clip: text;
          text-shadow: none;
        }
      }
      .lumos-hero-subtitle {
        margin: 0 0 1.05rem;
        max-width: 42ch;
        font-size: clamp(1.05rem, 2.65vw, 1.42rem);
        line-height: 1.42;
        font-weight: 600;
        color: var(--lumos-text-body);
      }
      .lumos-hero-lead {
        margin: 0 0 1.35rem;
        max-width: 52ch;
        font-size: clamp(0.95rem, 2vw, 1.08rem);
        line-height: 1.62;
        color: var(--lumos-text-muted);
      }
      .lumos-hero-pillar {
        margin: 0 0 1.15rem;
        max-width: 48ch;
        font-size: clamp(0.92rem, 1.85vw, 1.02rem);
        line-height: 1.55;
        font-weight: 650;
        letter-spacing: 0.06em;
        color: rgb(var(--lumos-land-teal) / 0.88);
        overflow-wrap: break-word;
      }
      /** Sağ: dünya haritası hero (lumos-world-map.jpg) */
      @media (min-width: 768px) {
        .lumos-hero-imgwrap {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(220px, 40vw);
          align-items: center;
          gap: clamp(1.35rem, 3vw, 2.5rem);
        }
        .lumos-hero-pillar {
          max-width: none;
          white-space: nowrap;
          font-size: clamp(0.78rem, 1.35vw, 0.96rem);
          letter-spacing: 0.04em;
        }
      }
      @media (min-width: 1024px) {
        .lumos-hero-imgwrap {
          grid-template-columns: minmax(0, 1.02fr) minmax(260px, min(42vw, 460px));
          gap: clamp(1.5rem, 3.2vw, 2.75rem);
        }
      }
      @media (min-width: 1200px) {
        .lumos-hero-imgwrap {
          grid-template-columns: minmax(0, 1fr) minmax(300px, min(44vw, 480px));
        }
      }
      .lumos-hero-visual {
        position: relative;
        width: 100%;
        max-width: min(100%, 28rem);
        margin-left: auto;
        margin-right: auto;
        overflow: visible;
        pointer-events: none;
      }
      .lumos-hero-visual::before {
        content: "";
        position: absolute;
        inset: -5% -3% -3% -3%;
        border-radius: 50%;
        border: 1px solid rgb(var(--lumos-land-teal) / 0.18);
        box-shadow:
          0 0 0 1px rgb(var(--lumos-land-teal-deep) / 0.08),
          0 0 24px rgb(var(--lumos-land-teal-deep) / 0.06);
        opacity: 0.65;
        transform: rotate(-10deg);
        pointer-events: none;
        z-index: 0;
      }
      .lumos-hero-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 18px;
        background:
          radial-gradient(ellipse 70% 58% at 52% 38%, rgb(var(--lumos-land-teal) / 0.06), transparent 62%),
          radial-gradient(ellipse 55% 48% at 70% 72%, rgb(var(--lumos-land-warm) / 0.032), transparent 58%);
        mix-blend-mode: screen;
        opacity: 0.28;
        pointer-events: none;
        z-index: 2;
      }
      .lumos-hero-visual picture {
        display: block;
        position: relative;
        z-index: 1;
        width: 100%;
        aspect-ratio: 3 / 2;
        max-height: min(52vh, 520px);
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgb(var(--lumos-land-teal) / 0.28);
        box-shadow:
          inset 0 0 0 1px rgb(var(--lumos-land-teal-deep) / 0.14),
          0 12px 40px rgba(0, 0, 0, 0.45),
          0 0 32px rgb(var(--lumos-land-teal-deep) / 0.1);
        background: var(--lumos-map-canvas);
      }
      .lumos-hero-visual__img {
        display: block;
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center center;
        opacity: 1;
        border-radius: 0;
        filter: saturate(1.05) contrast(1.04);
        -webkit-mask-image: none;
        mask-image: none;
      }
      @media (min-width: 768px) {
        .lumos-hero-visual {
          max-width: none;
          width: 100%;
          margin: 0;
          justify-self: end;
        }
        .lumos-hero-visual picture {
          aspect-ratio: 3 / 2;
          max-height: min(58vh, 560px);
        }
      }
      @media (max-width: 767.98px) {
        .lumos-hero-visual {
          order: 2;
          width: 100%;
          max-width: min(26rem, 100%);
          margin-left: auto;
          margin-right: auto;
          overflow: hidden;
        }
        .lumos-hero-visual picture {
          max-height: min(72vw, 22rem);
        }
      }
      @media (max-width: 479.98px) {
        .lumos-hero-visual {
          max-width: min(100%, 24rem);
        }
      }
      @media (max-width: 559.98px) {
        .lumos-hero-dna {
          display: none;
        }
        #giris.lumos-section {
          padding-bottom: clamp(1.15rem, 3.2vw, 1.85rem);
        }
      }
      .lumos-dunya-hero {
        position: relative;
        isolation: isolate;
        padding-top: clamp(0.5rem, 1.5vw, 0.85rem);
        padding-bottom: clamp(1.15rem, 2.8vw, 1.85rem);
      }
      .lumos-dunya-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.4;
        background:
          radial-gradient(ellipse 72% 58% at 58% 36%, rgb(var(--lumos-land-teal-deep) / 0.12), transparent 58%),
          repeating-linear-gradient(90deg, rgb(var(--lumos-land-teal) / 0.022) 0 1px, transparent 1px 56px),
          repeating-linear-gradient(0deg, rgb(var(--lumos-land-teal) / 0.018) 0 1px, transparent 1px 56px);
      }
      .lumos-dunya-hero > * {
        position: relative;
        z-index: 1;
      }
      .lumos-dunya-hero__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.15rem, 2.8vw, 1.85rem);
        align-items: center;
      }
      @media (min-width: 880px) {
        .lumos-dunya-hero__grid {
          grid-template-columns: minmax(0, 1.05fr) minmax(220px, 0.95fr);
          gap: clamp(1.35rem, 3.2vw, 2.5rem);
        }
      }
      .lumos-dunya-hero h2 {
        margin: 0 0 0.6rem;
