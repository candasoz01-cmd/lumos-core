      function buildPhotoTechBlock(o) {
        const lines = [];
        if (o.requestUrl != null && String(o.requestUrl).trim()) {
          lines.push("İstek URL: " + String(o.requestUrl).trim());
        }
        lines.push("HTTP: " + String(o.httpStatus != null ? o.httpStatus : "—"));
        lines.push("Fotoğraf backend'e ulaştı: " + (o.reachedBackend ? "evet" : "hayır"));
        lines.push("imageData gönderildi: " + (o.imageDataSent ? "evet" : "hayır"));
        lines.push("Vision (istemci tahmini): " + (o.visionTriedGuess ? "evet" : "hayır"));
        if (o.networkError) lines.push("Ağ/CORS (istemci): evet");
        let fb = "—";
        if (o.fallbackExact) fb = REPLY_PHOTO_NO_VISION_TR;
        else if (o.fallbackRegex) fb = "Türkçe fallback metni (regex eşleşmesi)";
        else if (o.extraReason) fb = o.extraReason;
        lines.push("Fallback nedeni: " + fb);
        if (o.extraReason && String(o.extraReason).trim() && (o.fallbackExact || o.fallbackRegex)) {
          lines.push("Ek not: " + String(o.extraReason).trim());
        }
        if (o.replyPreview) lines.push("Yanıt özeti: " + o.replyPreview);
        return lines.join("\n");
      }

