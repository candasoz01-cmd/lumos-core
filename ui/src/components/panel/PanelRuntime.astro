      function prefillPanelChatFromEvidence(titlePreview) {
        const chatInput = document.getElementById("panel-msg");
        if (!(chatInput instanceof HTMLTextAreaElement)) return false;
        const text = String(titlePreview || "").trim();
        if (!text) return false;
        chatInput.value = text;
        chatInput.dispatchEvent(new Event("input", { bubbles: true }));
        try {
          chatInput.focus({ preventScroll: true });
        } catch {
          chatInput.focus();
        }
        try {
          chatInput.scrollIntoView({ behavior: "smooth", block: "center" });
        } catch {
          chatInput.scrollIntoView();
        }
        return true;
      }

