      function setPanelConnBadge(state) {
        const badge = document.getElementById("panel-conn-badge");
        if (!badge) return;
        const prevState = badge.getAttribute("data-state") || "pending";
        const nextState = String(state || "pending");
        const prevBridgeOk = prevState === "ok";
        const nextBridgeOk = nextState === "ok";
        const label = panelConnBadgeLabel(nextState);
        const showSetup = nextState === "bad" || nextState === "limited";
        if (
          prevState === nextState &&
          badge.textContent === label &&
          badge.getAttribute("data-setup-link") === (showSetup ? "1" : "0")
        ) {
          return;
        }
        badge.setAttribute("data-state", nextState);
        badge.textContent = label;
        badge.setAttribute("data-setup-link", showSetup ? "1" : "0");
        if (showSetup) {
          badge.setAttribute("tabindex", "0");
          badge.setAttribute(
            "title",
            panelT("panel.shell.conn.setupHint") + " — " + panelT("panel.shell.conn.title"),
          );
        } else {
          badge.removeAttribute("tabindex");
          badge.setAttribute("title", panelT("panel.shell.conn.title"));
        }
        paintPanelInfraStatusSkeleton();
        if (prevBridgeOk !== nextBridgeOk) {
          refreshResourceModeAdvisorPanel();
