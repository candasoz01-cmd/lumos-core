              Bu sekme, Lumos’un farklı dillere, bölgelere ve erişilebilirlik ihtiyaçlarına daha duyarlı; tek bir kültüre kapanmayan
              ve ölçülü bir küresel kullanım tasarımını özetler.
            </p>
            <ul class="medya-card-list">
              <li class="medya-card">
                <h3>Dil, Bölge ve Erişilebilirlik</h3>
                <p>
                  Arayüz ve içerik sunumunda dil seçimi, yerel biçimler ve erişilebilirlik seçenekleri daha görünür tutulmayı hedefler.
                </p>
              </li>
              <li class="medya-card">
                <h3>Kullanım Biçimlerine Uyum</h3>
                <p>
                  Farklı cihaz, bağlantı ve çalışma ortamlarında deneyimin aşırıya kaçmadan uyarlanması amaçlanır.
                </p>
              </li>
              <li class="medya-card">
                <h3>Yerelleştirme</h3>
                <p>
                  Metin ve tarih gibi öğeler yerel normlara göre düzenlenebilir; çeviri ve bağlam hatalarında şeffaflık korunur.
                </p>
              </li>
              <li class="medya-card">
                <h3>Küresel ve Çoğul Yaklaşım</h3>
                <p>
                  Tek bir merkezin bakış açısına kilitlenmeden, çeşitli kullanıcıların ihtiyaçlarına saygılı bir çerçeve hedeflenir.
                </p>
              </li>
              <li class="medya-card">
                <h3>İnsan Odaklı Teknoloji</h3>
                <p>
                  Lumos, teknolojiyi insanın yerine koymak yerine; karar ve mahremiyet sınırını kullanıcıda tutmayı önceleyen bir çizgiyi
                  benimsemeyi hedefler.
                </p>
              </li>
            </ul>
          </section>

          <section
            id="panel-ayarlar"
            class="module-panel"
            data-module-panel="ayarlar"
            data-active="false"
            aria-labelledby="panel-ayarlar-title"
          >
            <h2 id="panel-ayarlar-title">Ayarlar</h2>
            <p class="medya-intro">
              Bu sekme, kullanıcı tercihlerinin, bağlantı ve izin sınırlarının ve varsayılan davranışların kullanıcı kontrolünde ve
              görünür kalması için tasarlanan yaklaşımı özetler.
            </p>
            <ul class="medya-card-list">
              <li class="medya-card">
                <h3>Kullanıcı Tercihleri</h3>
                <p>
                  Dil, tema, bildirim yoğunluğu gibi seçenekler anlaşılır gruplarda sunulmayı hedefler.
                </p>
              </li>
              <li class="medya-card">
                <h3>Sınırlar ve İzinler</h3>
                <p>
                  Hangi özelliğin hangi izne bağlı olduğu kısa özetlerle gösterilir; kapalı tutulan izinler sessizce açılmaz.
                </p>
              </li>
              <li class="medya-card">
                <h3>Bağlantı Ayarları</h3>
                <p>
                  Harici servis ve hesap bağlantıları tek yerden görülebilir; gerektiğinde kesme ve yeniden bağlanma kullanıcıdadır.
                </p>
              </li>
              <li class="medya-card">
                <h3>Görünürlük ve Güvenlik Tercihleri</h3>
                <p>
                  Paylaşım, günlük veya veri saklama ile ilgili seçenekler birbirinden ayrılır; her biri net bir açıklamayla sunulur.
                </p>
              </li>
              <li class="medya-card">
                <h3>Varsayılanlar ve Kontrol</h3>
                <p>
                  Öntanımlı davranışlar kabul edilmeden önce kullanıcıya gösterilir; değişiklikler geri alınabilir biçimde tutulmayı
                  hedefler.
                </p>
              </li>
            </ul>
          </section>
        </main>
      </div>
    </div>
    <script define:vars={{ CHAT_URL, kandoToken }}>
      function wirePanel() {
        const nav = document.querySelector(".panel-nav");
        const panels = document.querySelectorAll("[data-module-panel]");
        const sendBtn = document.getElementById("panel-send");
        const input = document.getElementById("panel-msg");
        const thread = document.getElementById("chat-thread");
        if (!nav || !sendBtn || !input || !thread) return;

        function expandNavGroupIfActiveHidden() {
          const active = nav.querySelector('button[data-module][aria-current="true"]');
          if (!active) return;
          const items = active.closest(".panel-nav-group-items");
          if (!items || !items.hasAttribute("hidden")) return;
          items.removeAttribute("hidden");
          const collapsible = items.closest(".panel-nav-collapsible");
          const toggle = collapsible?.querySelector(".panel-nav-group-toggle");
          if (toggle) toggle.setAttribute("aria-expanded", "true");
        }
        expandNavGroupIfActiveHidden();

        nav.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLElement)) return;
          const groupToggle = t.closest(".panel-nav-group-toggle");
          if (groupToggle) {
            const expanded = groupToggle.getAttribute("aria-expanded") === "true";
            const next = !expanded;
            groupToggle.setAttribute("aria-expanded", next ? "true" : "false");
            const cid = groupToggle.getAttribute("aria-controls");
            const panel = cid ? document.getElementById(cid) : null;
            if (panel) {
              if (next) panel.removeAttribute("hidden");
              else panel.setAttribute("hidden", "");
            }
            return;
          }
          const btn = t.closest("button[data-module]");
          if (!btn) return;
          const id = btn.getAttribute("data-module");
          if (!id) return;
          nav.querySelectorAll("button[data-module]").forEach((b) => {
            b.setAttribute("aria-current", b === btn ? "true" : "false");
          });
          panels.forEach((p) => {
            p.setAttribute("data-active", p.getAttribute("data-module-panel") === id ? "true" : "false");
          });
        });

        const sendLabel = "Gönder";
        const loadingLabel = "Gönderiliyor…";
        const CHAT_HISTORY_LIMIT = 12;
        let sending = false;

        function escapeHtml(s) {
          return String(s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        function formatAssistantHtml(raw) {
          let s = escapeHtml(String(raw));
          s = s.replace(/\*\*([\s\S]+?)\*\*/g, "<strong>$1</strong>");
          s = s.replace(/\*\*/g, "");
          s = s.replace(/\n/g, "<br />");
          return s;
        }

        /** Lumos gövdesinden (strong, br) backend geçmişi için düz metin üretir. */
        function lumosBodyToPlainText(root) {
          const out = [];
          function walk(n) {
            if (n.nodeType === Node.TEXT_NODE) out.push(n.textContent);
            else if (n.nodeType === Node.ELEMENT_NODE) {
              const el = /** @type {Element} */ (n);
              if (el.tagName === "BR") out.push("\n");
              else el.childNodes.forEach(walk);
            }
          }
          walk(root);
          return out.join("").trim();
        }

        /** Mevcut iplikten (yeni kullanıcı mesajı eklenmeden önce) son N mesajı role/content olarak döner. */
        function collectThreadHistory(threadEl) {
          const nodes = threadEl.querySelectorAll(".chat-msg");
          const items = [];
          for (const wrap of nodes) {
            let role;
            if (wrap.classList.contains("chat-msg--user")) role = "user";
            else if (wrap.classList.contains("chat-msg--lumos")) role = "assistant";
            else continue;
            const body = wrap.querySelector(".chat-msg-body");
            let text = "";
            if (role === "assistant" && body) {
              text = lumosBodyToPlainText(body);
            } else if (body && body.textContent) {
              text = body.textContent.trim();
            }
            if (!text) continue;
            items.push({ role, content: text });
          }
          if (items.length <= CHAT_HISTORY_LIMIT) return items;
          return items.slice(-CHAT_HISTORY_LIMIT);
        }

        function appendBubble(kind, text) {
          const turn = document.createElement("div");
          turn.className =
            "chat-turn " +
            (kind === "user" ? "chat-turn--user" : kind === "error" ? "chat-turn--error" : "chat-turn--lumos");

          const wrap = document.createElement("div");
          wrap.className =
            "chat-msg " +
            (kind === "user" ? "chat-msg--user" : kind === "error" ? "chat-msg--error" : "chat-msg--lumos");
          const role = document.createElement("span");
          role.className = "chat-msg-role";
          role.textContent = kind === "user" ? "Sen" : kind === "error" ? "Uyarı" : "Lumos";
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          if (kind === "lumos") {
            body.innerHTML = formatAssistantHtml(text);
          } else {
            body.textContent = text;
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        async function runSend() {
          const message = input.value.trim();
          if (!message || sending) return;

          sending = true;
          sendBtn.disabled = true;
          sendBtn.setAttribute("aria-busy", "true");
          sendBtn.textContent = loadingLabel;
          const history = collectThreadHistory(thread);
          appendBubble("user", message);

          try {
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify({ message, history }),
            });
            const text = await r.text();

            if (!r.ok) {
              console.warn("[Lumos panel chat] HTTP error", r.status);
              appendBubble(
                "error",
                "Sunucu şu anda yanıtı işleyemedi. Biraz sonra tekrar deneyebilirsin."
              );
            } else {
              const INVALID_FORMAT_MSG =
                "Sunucu yanıtı beklenen formatta değil. Biraz sonra tekrar deneyebilirsin.";
              const EMPTY_REPLY_MSG =
                "Bu sefer boş bir yanıt geldi. Sorunu biraz açıp yeniden deneyebilirsin.";

              let data = null;
              let parsed = false;
              if (text && text.trim()) {
                try {
                  data = JSON.parse(text);
                  parsed = true;
                } catch {
                  appendBubble("error", INVALID_FORMAT_MSG);
                }
              } else {
                appendBubble("error", INVALID_FORMAT_MSG);
              }

              if (parsed) {
                const isPlainObject =
                  data !== null && typeof data === "object" && !Array.isArray(data);
                const hasChatBodyKey =
                  isPlainObject &&
                  ("reply" in data || "content" in data || "message" in data);
                if (!isPlainObject || !hasChatBodyKey) {
                  appendBubble("error", INVALID_FORMAT_MSG);
                } else {
                  const raw = data.reply ?? data.content ?? data.message;
                  const replyBody = raw == null ? "" : String(raw);
                  if (replyBody.trim()) {
                    appendBubble("lumos", replyBody);
                    input.value = "";
                  } else {
                    appendBubble("lumos", EMPTY_REPLY_MSG);
                  }
                }
              }
            }
          } catch {
            appendBubble(
              "error",
              "Sunucuya ulaşılamadı. Bağlantıyı veya servis durumunu kontrol edip tekrar deneyebilirsin."
            );
          } finally {
            sending = false;
            sendBtn.disabled = false;
            sendBtn.removeAttribute("aria-busy");
            sendBtn.textContent = sendLabel;
          }
        }

        sendBtn.addEventListener("click", () => {
          void runSend();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter" || e.shiftKey) return;
          e.preventDefault();
          void runSend();
        });
      }

      function wireGorevlerPrototype() {
        const listEl = document.getElementById("gorevler-list");
        const titleInput = document.getElementById("gorevler-title-input");
        const prioritySel = document.getElementById("gorevler-priority");
        const statusSel = document.getElementById("gorevler-status");
        const addBtn = document.getElementById("gorevler-add");
        const hintEl = document.getElementById("gorevler-hint");
        if (!listEl || !titleInput || !prioritySel || !statusSel || !addBtn || !hintEl) return;

        const tasks = [
          { title: "Panel API durumunu kontrol et", priority: "orta", status: "onay_bekliyor" },
          { title: "Güvenlik sekmesini gözden geçir", priority: "dusuk", status: "tamamlandi" },
        ];

        const priorityLabels = { dusuk: "Düşük", orta: "Orta", yuksek: "Yüksek" };
        const statusLabels = {
          bekliyor: "Bekliyor",
          onay_bekliyor: "Onay bekliyor",
          tamamlandi: "Tamamlandı",
        };
        const statusBadgeClass = {
          bekliyor: "task-status-badge--waiting",
          onay_bekliyor: "task-status-badge--approval",
          tamamlandi: "task-status-badge--done",
        };
        const priorityBadgeClass = {
          dusuk: "task-priority-badge--dusuk",
          orta: "task-priority-badge--orta",
          yuksek: "task-priority-badge--yuksek",
        };

        function render() {
          listEl.replaceChildren();
          for (const t of tasks) {
            const li = document.createElement("li");
            li.className = "gorevler-task-card";

            const titleSpan = document.createElement("span");
            titleSpan.className = "gorevler-task-title";
            titleSpan.textContent = t.title;

            const badges = document.createElement("div");
            badges.className = "gorevler-task-badges";

            const st = document.createElement("span");
            st.className = "task-status-badge " + statusBadgeClass[t.status];
            st.textContent = statusLabels[t.status];

            const pr = document.createElement("span");
            pr.className = "task-priority-badge " + priorityBadgeClass[t.priority];
            pr.textContent = priorityLabels[t.priority];

            badges.appendChild(st);
            badges.appendChild(pr);
            li.appendChild(titleSpan);
            li.appendChild(badges);
            listEl.appendChild(li);
          }
        }

        function showHint(msg) {
          hintEl.textContent = msg;
          hintEl.hidden = false;
        }

        function hideHint() {
          hintEl.hidden = true;
          hintEl.textContent = "";
        }

        function addTask() {
          const title = titleInput.value.trim();
          if (!title) {
            showHint("Görev adı boş olamaz.");
            titleInput.focus();
            return;
          }
          hideHint();
          tasks.push({
            title,
            priority: prioritySel.value,
            status: statusSel.value,
          });
          titleInput.value = "";
          render();
        }

        addBtn.addEventListener("click", addTask);
        titleInput.addEventListener("keydown", (e) => {
          if (e.key !== "Enter") return;
          e.preventDefault();
          addTask();
        });

        render();
      }

      wirePanel();
      wireGorevlerPrototype();

      void (async function checkChatApiHealth() {
        const apiEl = document.getElementById("chat-sys-api");
        const timeEl = document.getElementById("chat-sys-time");
        if (!apiEl || !timeEl) return;

        function stampTime() {
          timeEl.textContent = new Date().toLocaleTimeString("tr-TR", {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
          });
        }

        function setApi(ok) {
          apiEl.textContent = ok ? "Bağlı" : "Ulaşılamıyor";
          apiEl.setAttribute("data-state", ok ? "ok" : "bad");
        }

        try {
          const r = await fetch(CHAT_URL, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-Kando-Token": kandoToken,
            },
            body: JSON.stringify({ message: "ping", history: [] }),
          });
          const text = await r.text();
          let ok = false;
          if (r.ok && text && text.trim()) {
            try {
              const data = JSON.parse(text);
              const isPlainObject =
                data !== null && typeof data === "object" && !Array.isArray(data);
              const hasChatBodyKey =
                isPlainObject &&
                ("reply" in data || "content" in data || "message" in data);
              if (hasChatBodyKey) {
                const raw = data.reply ?? data.content ?? data.message;
                ok = raw != null && String(raw).trim() !== "";
              }
            } catch {
              ok = false;
            }
          }
          setApi(ok);
          stampTime();
        } catch {
          setApi(false);
          stampTime();
        }
      })();
    </script>
  </body>
</html>
