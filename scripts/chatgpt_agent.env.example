# OpenAI (zorunlu)
OPENAI_API_KEY=sk-...

# OpenAI model (isteğe bağlı)
OPENAI_MODEL=gpt-4.1-mini

# Relay (chatgpt_agent → JSON POST). Tam URL veya sadece port:
# RELAY_URL=http://127.0.0.1:8766
RELAY_PORT=8766

# Bridge (relay_agent → düz metin POST; kando_bridge_server)
BRIDGE_URL=http://localhost:8765

# Outbox güncellenmesi için bekleme saniyesi (isteğe bağlı)
KANDO_WAIT_TIMEOUT_SEC=600

# Streaming (varsayılan: açık). Kapatmak: 0
LUMOS_AGENT_STREAM=1

# execution = kısa durum satırları + görev metni canlı; verbose = reasoning stderr + metin canlı (öneri/analiz)
LUMOS_AGENT_STREAM_STYLE=execution

# 1 ise relay/Kando atlanır (yalnızca LLM akışı)
LUMOS_AGENT_SKIP_BRIDGE=0
