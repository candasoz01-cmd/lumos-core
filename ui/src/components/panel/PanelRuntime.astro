          } catch (err) {
            voiceStartPending = false;
            applyVoiceSupportUi();
            const name = err && typeof err === "object" && "name" in err ? String(err.name) : "";
            setVoiceHintKey(
              name === "NotAllowedError" || name === "PermissionDeniedError"
                ? "panel.modules.chat.compose.voiceHints.micDenied"
                : "panel.modules.chat.compose.voiceHints.micUnavailable",
            );
            return;
          }

          voiceStream = stream;
          const mimeType = pickAudioRecordMimeType();
          const options = mimeType ? { mimeType } : undefined;
          let recorder;
          try {
            recorder = options
              ? new MediaRecorder(stream, options)
              : new MediaRecorder(stream);
          } catch {
            resetVoiceCaptureState();
            setVoiceHintKey("panel.modules.chat.compose.voiceHints.startFailed");
            return;
