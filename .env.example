# Depo kökü — sunucu / köprü / backend shell ortam değişkenleri (secret'lar burada).
# Gerçek değerleri repoya commit etmeyin.
#
# Astro panel istemci değişkenleri (PUBLIC_*) burada değildir:
#   ui/.env.example → kopyalayıp ui/.env.local olarak kullanın (npm run dev).
# Yerel smoke: docs/local-kando-dev-runbook.md

# Kando köprü (varsayılan port 8765 — bridge_start.sh)
KANDO_BRIDGE_PORT=8765
# Zorunlu: korumalı uç noktalar için paylaşımlı token (köprü süreci / shell)
KANDO_BRIDGE_SECRET=your_local_dev_secret_here

# Köprü POST /chat için OpenAI (sunucu tarafı; PUBLIC_* ile tarayıcıya gömülmez)
OPENAI_API_KEY=your_server_side_key_here

# Lumos state dizini (varsayılan .lumos)
LUMOS_BASE_DIR=.lumos

# vercel dev / Vercel serverless — panel /api/bridge/* proxy upstream (sunucu tarafı)
BRIDGE_UPSTREAM_URL=http://127.0.0.1:8765
# Zorunlu: public /api/bridge/* operatör/smoke caller auth header'ı; KANDO_BRIDGE_SECRET değildir
LUMOS_BRIDGE_PROXY_AUTH_TOKEN=your_proxy_auth_token_here
# Google oturumuyla köprü kullanmasına izin verilen Lumos ID'leri (virgülle ayrılır)
LUMOS_BRIDGE_ALLOWED_LUMOS_IDS=

# İletişim bağlantıları (yalnızca sunucu tarafında; PUBLIC_* kullanmayın)
LUMOS_WHATSAPP_ACCESS_TOKEN=
LUMOS_WHATSAPP_PHONE_NUMBER_ID=
LUMOS_META_GRAPH_VERSION=
LUMOS_TELEGRAM_BOT_TOKEN=

# Meta communications OAuth (WhatsApp / Instagram / Facebook — read-only ilk dilim)
# Meta App Dashboard callback URI ile birebir aynı olmalı.
LUMOS_META_OAUTH_REDIRECT_URI=https://welockai.com/auth/meta/callback
LUMOS_META_APP_ID=
LUMOS_META_APP_SECRET=
LUMOS_INSTAGRAM_APP_ID=
LUMOS_INSTAGRAM_APP_SECRET=
LUMOS_WHATSAPP_LOGIN_CONFIG_ID=
LUMOS_WHATSAPP_APP_ID=
LUMOS_WHATSAPP_APP_SECRET=

# Private credential vault köprüsü — HTTPS zorunlu; raw token public/client ortama çıkmaz.
LUMOS_CREDENTIAL_VAULT_WRITE_URL=
LUMOS_CREDENTIAL_VAULT_WRITE_TOKEN=

# Meta webhook challenge, imza ve private durable sink
LUMOS_META_WEBHOOK_VERIFY_TOKEN=
LUMOS_META_WEBHOOK_SINK_URL=
LUMOS_META_WEBHOOK_SINK_TOKEN=
# Boşsa 262144 byte; izin verilen aralık 1024..2097152.
LUMOS_META_WEBHOOK_MAX_BYTES=

# --- Google Web OAuth (welockai.com / Vercel) — secret commit etme ---
# Client ID öneki (canlı): 48833665…
LUMOS_GOOGLE_WEB_CLIENT_ID=
LUMOS_GOOGLE_WEB_CLIENT_SECRET=
# Console URI ile birebir aynı (canlı yol):
LUMOS_GOOGLE_WEB_REDIRECT_URI=https://welockai.com/auth/google/callback
LUMOS_GOOGLE_WEB_JS_ORIGIN=https://welockai.com
LUMOS_GOOGLE_GEMINI_API_KEY=
LUMOS_AUTH_STATE_SECRET=
# Kararlı, sağlayıcıdan bağımsız Lumos ID türetme anahtarı (>=32; state secret'tan ayrı tutun)
LUMOS_ID_SECRET=

# İzinli kişisel hafıza servisi (ikisi de yoksa chat açıkça "hafıza yüklenmedi" der)
LUMOS_MEMORY_LOOKUP_URL=
LUMOS_MEMORY_SERVICE_TOKEN=

# Mevcut YouTube sağlayıcı sözleşmesiyle uyumluluk
LUMOS_GOOGLE_OAUTH_CLIENT_ID=
LUMOS_GOOGLE_OAUTH_CLIENT_SECRET=
LUMOS_GOOGLE_OAUTH_REDIRECT_URI=https://welockai.com/auth/google/callback

# Panel dosya yükleme (PANEL-UPLOAD-HANDLER-01) — canonical uç YALNIZ /panel/upload
# UI varsayılanı chat tabanından türetir; ayrı host gerekiyorsa açıkça verilir.
PUBLIC_LUMOS_PANEL_UPLOAD_URL=http://127.0.0.1:8765/panel/upload
# Yükleme boyut sınırı (byte); boş bırakılırsa 10 MB
LUMOS_PANEL_UPLOAD_MAX_BYTES=
# Yüklemeyi tamamen kapatmak için 0
LUMOS_PANEL_UPLOAD_ENABLED=1
