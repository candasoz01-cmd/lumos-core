      const PANEL_PROD_ERROR_KINDS = [
        "write_failed",
        "path_outside_sandbox",
        "read_failed",
        "file_not_found",
        "create_failed",
        "complete_failed",
        "delete_failed",
        "restore_failed",
        "confirmation_required",
        "confirmation_expired",
        "scope_mismatch",
        "command_not_allowed",
        "unauthorized",
        "network_error",
        "server_error",
        "unknown_error",
      ];

      function classifyPanelProdError(ctx) {
        const status =
          typeof ctx.httpStatus === "number" && Number.isFinite(ctx.httpStatus)
            ? ctx.httpStatus
            : null;
        const raw = String(ctx.rawError || ctx.errMessage || ctx.upstreamText || "")
          .trim()
          .toLowerCase();
        const code = raw.replace(/^error:\s*/i, "").split(/\s/)[0];
        if (code === "write_failed" || /write_file\s*başarısız|write_file\s*failed/i.test(raw)) {
          return "write_failed";
        }
        if (code === "path_outside_sandbox") return "path_outside_sandbox";
        if (code === "read_failed" || /read_file\s*başarısız|read_file\s*failed/i.test(raw)) {
          return "read_failed";
        }
        if (code === "file_not_found") return "file_not_found";
        if (code === "create_failed" || code === "empty_title") return "create_failed";
        if (code === "complete_failed" || code === "not_found" || code === "already_done") {
          return code === "complete_failed" ? "complete_failed" : "unknown_error";
        }
        if (code === "delete_failed" || code === "missing_trash_file") return "delete_failed";
        if (code === "restore_failed" || code === "invalid_trash_file") return "restore_failed";
        if (
          code === "confirmation_required"
          || code === "confirmation_expired"
          || code === "scope_mismatch"
        ) {
          return code;
        }
        const reason = String(ctx.reason || ctx.dataReason || "").trim().toLowerCase();
        if (reason === "confirmation_required") return "confirmation_required";
        if (reason === "confirmation_expired") return "confirmation_expired";
        if (reason === "scope_mismatch") return "scope_mismatch";
        if (code === "command_not_allowed" || code === "action_disabled") {
          return "command_not_allowed";
        }
        if (status === 401 || status === 403 || /unauthorized|forbidden|invalid.*token/i.test(raw)) {
          return "unauthorized";
        }
        if (status != null && status >= 500) return "server_error";
        if (
          /failed to fetch|networkerror|network\s*error|econnrefused|enotfound|fetch failed|ulaşılamadı|cors/i.test(
            raw,
          )
          || (status == null && ctx.apiUnreachable)
        ) {
          return "network_error";
        }
        if (/oserror|permission denied|errno/i.test(raw)) return "write_failed";
        return "unknown_error";
      }

      function userMessageForPanelProdErrorKind(kind) {
        const k = PANEL_PROD_ERROR_KINDS.includes(kind) ? kind : "unknown_error";
        return panelT("panel.shell.infra.prodErrors." + k);
      }

      function panelProdErrorUserMessage(ctx) {
        const kind = classifyPanelProdError(ctx || {});
        const userMsg = userMessageForPanelProdErrorKind(kind);
        if (PANEL_DEBUG) {
          const raw = String(ctx.rawError || ctx.errMessage || ctx.upstreamText || "").trim();
          const status =
            ctx.httpStatus != null && Number.isFinite(ctx.httpStatus)
              ? " HTTP " + ctx.httpStatus
              : "";
          return raw ? userMsg + " [" + raw + status + "]" : userMsg + status;
        }
        return userMsg;
      }

      function panelOutboxFailureUserMessage(ctx) {
        const status =
          typeof ctx.httpStatus === "number" && Number.isFinite(ctx.httpStatus)
            ? ctx.httpStatus
            : null;
        const text = String(ctx.upstreamText || "").trim();
        if (status === 401 || status === 403) {
          return panelT("panel.modules.media.outboxResultUnauthorized");
        }
        if (!text) {
          return panelT("panel.modules.media.outboxResultNotFound");
        }
        let rawError = "";
        try {
          const j = JSON.parse(text);
          if (j && j.error != null) rawError = String(j.error);
          else if (j && j.message != null) rawError = String(j.message);
        } catch {
          rawError = text.slice(0, 120);
        }
        const userMsg = panelProdErrorUserMessage({
          rawError,
          httpStatus: status,
          upstreamText: text,
        });
        if (PANEL_DEBUG) {
          const snippet = text.slice(0, 280);
          return panelDebugText(
            "Köprü yanıtı " +
              (status != null ? status : "?") +
              (snippet ? ": " + snippet : " (last-result yok veya token hatalı)."),
            userMsg,
          );
        }
        return userMsg;
      }

      function panelDebugText(debugMsg, userMsg) {
