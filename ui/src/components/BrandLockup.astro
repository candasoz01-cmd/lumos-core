---
interface Props {
  id: string;
  name: string;
  compact?: boolean;
  chip?: boolean;
  monochrome?: boolean;
  linked?: boolean;
}

const { id, name, compact = false, chip = false, monochrome = false, linked = true } = Astro.props;

const brands: Record<string, { logo: string; href: string }> = {
  github: { logo: "https://api.iconify.design/logos/github-icon.svg", href: "https://github.com/" },
  gmail: { logo: "https://api.iconify.design/logos/google-gmail.svg", href: "https://workspace.google.com/products/gmail/" },
  googleCalendar: { logo: "https://api.iconify.design/logos/google-calendar.svg", href: "https://workspace.google.com/products/calendar/" },
  googleDrive: { logo: "https://api.iconify.design/logos/google-drive.svg", href: "https://workspace.google.com/products/drive/" },
  google: { logo: "https://api.iconify.design/logos/google-icon.svg", href: "https://about.google/" },
  slack: { logo: "https://api.iconify.design/logos/slack-icon.svg", href: "https://slack.com/" },
  zoom: { logo: "https://api.iconify.design/logos/zoom-icon.svg", href: "https://www.zoom.com/" },
  whatsapp: { logo: "https://api.iconify.design/logos/whatsapp-icon.svg", href: "https://www.whatsapp.com/" },
  telegram: { logo: "https://api.iconify.design/logos/telegram.svg", href: "https://telegram.org/" },
  line: { logo: "https://cdn.simpleicons.org/line", href: "https://line.me/" },
  kakaoTalk: { logo: "https://cdn.simpleicons.org/kakaotalk", href: "https://www.kakaocorp.com/page/service/service/KakaoTalk" },
  microsoftTeams: { logo: "https://api.iconify.design/logos/microsoft-teams.svg", href: "https://www.microsoft.com/microsoft-teams/" },
  notion: { logo: "https://api.iconify.design/logos/notion-icon.svg", href: "https://www.notion.com/" },
  jira: { logo: "https://api.iconify.design/logos/jira.svg", href: "https://www.atlassian.com/software/jira" },
  linear: { logo: "https://api.iconify.design/logos/linear-icon.svg", href: "https://linear.app/" },
  chrome: { logo: "https://api.iconify.design/logos/chrome.svg", href: "https://www.google.com/chrome/" },
  safari: { logo: "https://api.iconify.design/logos/safari.svg", href: "https://www.apple.com/safari/" },
  apple: { logo: "https://cdn.simpleicons.org/apple/FFFFFF", href: "https://www.apple.com/" },
  openai: { logo: "https://api.iconify.design/logos/openai-icon.svg", href: "https://openai.com/" },
  gemini: { logo: "https://api.iconify.design/simple-icons/googlegemini.svg", href: "https://gemini.google.com/" },
  deepseek: { logo: "https://api.iconify.design/simple-icons/deepseek.svg", href: "https://www.deepseek.com/" },
  bluetoothAudio: { logo: "https://api.iconify.design/logos/bluetooth.svg", href: "https://www.bluetooth.com/" },
  matter: { logo: "https://api.iconify.design/logos/matter.svg", href: "https://csa-iot.org/all-solutions/matter/" },
  homeAssistant: { logo: "https://cdn.simpleicons.org/homeassistant", href: "https://www.home-assistant.io/" },
  smartThings: { logo: "https://cdn.simpleicons.org/smartthings", href: "https://www.samsung.com/us/smartthings/" },
  sonos: { logo: "https://cdn.simpleicons.org/sonos/FFFFFF", href: "https://www.sonos.com/" },
  facebook: { logo: "https://api.iconify.design/logos/facebook.svg", href: "https://www.facebook.com/" },
  instagram: { logo: "https://api.iconify.design/logos/instagram-icon.svg", href: "https://www.instagram.com/" },
  x: { logo: "https://api.iconify.design/logos/x.svg", href: "https://x.com/" },
  tiktok: { logo: "https://api.iconify.design/logos/tiktok-icon.svg", href: "https://www.tiktok.com/" },
  linkedin: { logo: "https://api.iconify.design/logos/linkedin-icon.svg", href: "https://www.linkedin.com/" },
  youtube: { logo: "https://api.iconify.design/logos/youtube-icon.svg", href: "https://www.youtube.com/" },
  wechat: { logo: "https://cdn.simpleicons.org/wechat", href: "https://www.wechat.com/" },
  vk: { logo: "https://cdn.simpleicons.org/vk", href: "https://vk.com/" },
  bilibili: { logo: "https://cdn.simpleicons.org/bilibili", href: "https://www.bilibili.com/" },
  xiaohongshu: { logo: "https://cdn.simpleicons.org/xiaohongshu", href: "https://www.xiaohongshu.com/" },
  weibo: { logo: "https://cdn.simpleicons.org/sinaweibo", href: "https://weibo.com/" },
  okru: { logo: "https://cdn.simpleicons.org/odnoklassniki", href: "https://ok.ru/" },
};

const brand = brands[id];
---

{
  brand && linked ? (
    <a
      class:list={["brand-lockup", compact && "brand-lockup--compact", chip && "brand-lockup--chip", monochrome && "brand-lockup--mono"]}
      href={brand.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={name}
    >
      <span class="brand-lockup__mark" aria-hidden="true">
        <span class="brand-lockup__fallback">{name.slice(0, 1)}</span>
        <img src={brand.logo} alt="" decoding="async" />
      </span>
      <span class="brand-lockup__name">{name}</span>
    </a>
  ) : brand ? (
    <span class:list={["brand-lockup", compact && "brand-lockup--compact", chip && "brand-lockup--chip", monochrome && "brand-lockup--mono"]}>
      <span class="brand-lockup__mark" aria-hidden="true">
        <span class="brand-lockup__fallback">{name.slice(0, 1)}</span>
        <img src={brand.logo} alt="" decoding="async" />
      </span>
      <span class="brand-lockup__name">{name}</span>
    </span>
  ) : (
    <span class:list={["brand-lockup", compact && "brand-lockup--compact", chip && "brand-lockup--chip"]}>
      <span class="brand-lockup__mark brand-lockup__mark--fallback" aria-hidden="true">{name.slice(0, 1)}</span>
      <span class="brand-lockup__name">{name}</span>
    </span>
  )
}

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    max-width: 100%;
    color: var(--lumos-land-title);
    text-decoration: none;
  }

  a.brand-lockup:hover .brand-lockup__name,
  a.brand-lockup:focus-visible .brand-lockup__name {
    color: var(--lumos-accent-blue-bright);
  }

  a.brand-lockup:focus-visible {
    outline: 2px solid rgb(var(--lumos-land-warm) / 0.5);
    outline-offset: 4px;
    border-radius: var(--lumos-radius-sm);
  }

  .brand-lockup__mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.36rem;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid rgb(var(--lumos-land-warm) / 0.28);
    border-radius: 0.7rem;
    background: #f8fafc;
  }

  .brand-lockup__mark img {
    position: absolute;
    inset: 0.36rem;
    width: calc(100% - 0.72rem);
    height: calc(100% - 0.72rem);
    object-fit: contain;
  }

  .brand-lockup__fallback {
    color: #172033;
    font-weight: 800;
  }

  .brand-lockup__name {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .brand-lockup--compact { gap: 0.5rem; }
  .brand-lockup--compact .brand-lockup__mark { flex-basis: 2rem; width: 2rem; height: 2rem; padding: 0.3rem; border-radius: 0.55rem; }
  .brand-lockup--compact .brand-lockup__mark img { inset: 0.3rem; width: calc(100% - 0.6rem); height: calc(100% - 0.6rem); }
  .brand-lockup--compact .brand-lockup__name { font-size: 0.92rem; }
  .brand-lockup--chip { gap: 0.4rem; }
  .brand-lockup--chip .brand-lockup__mark { flex-basis: 1.15rem; width: 1.15rem; height: 1.15rem; padding: 0.14rem; border-radius: 0.4rem; border-width: 1px; }
  .brand-lockup--chip .brand-lockup__mark img { inset: 0.14rem; width: calc(100% - 0.28rem); height: calc(100% - 0.28rem); }
  .brand-lockup--chip .brand-lockup__fallback { font-size: 0.68rem; }
  .brand-lockup--chip .brand-lockup__name { font-size: inherit; font-weight: 600; }
  .brand-lockup--mono .brand-lockup__mark img { filter: grayscale(1) opacity(0.7); transition: filter 0.2s ease; }
  .brand-lockup--mono .brand-lockup__name { color: var(--lumos-text-muted); transition: color 0.2s ease; }
  a.brand-lockup--mono:hover .brand-lockup__mark img,
  a.brand-lockup--mono:focus-visible .brand-lockup__mark img,
  .brand-lockup--mono:hover .brand-lockup__mark img,
  .brand-lockup--mono:focus-within .brand-lockup__mark img { filter: grayscale(0) opacity(1); }
  a.brand-lockup--mono:hover .brand-lockup__name,
  a.brand-lockup--mono:focus-visible .brand-lockup__name,
  .brand-lockup--mono:hover .brand-lockup__name,
  .brand-lockup--mono:focus-within .brand-lockup__name { color: var(--lumos-land-title); }
</style>
