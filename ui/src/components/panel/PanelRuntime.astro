      function formatQuantumCryptoInventory(inv) {
        if (!inv || typeof inv !== "object") return panelT("panel.modules.quantum.mock.cryptoValue");
        const parts = []
          .concat(inv.encryption_types || [])
          .concat(inv.signature_types || [])
          .concat(inv.key_types || []);
        const note = String(inv.quantum_exposure_note || "").trim();
        if (!parts.length) return note || panelT("panel.modules.quantum.mock.cryptoValue");
        return note ? `${parts.join(", ")} — ${note}` : parts.join(", ");
      }

      function formatQuantumAgilityLevel(level) {
        const key = String(level || "").trim().toLowerCase();
        const label = panelT(`panel.modules.quantum.live.agility.${key}`);
        if (label && !label.startsWith("panel.modules.quantum")) return label;
        return String(level || panelT("panel.modules.quantum.mock.agilityValue"));
      }

      function formatQuantumPqcReadiness(pqc) {
        if (!pqc || typeof pqc !== "object") return panelT("panel.modules.quantum.mock.pqcValue");
        const status = String(pqc.pqc_status || "").trim();
        const aware = pqc.nist_pqc_awareness === true;
        const statusLabel = panelT(`panel.modules.quantum.live.pqcStatus.${status}`);
        const statusText =
          statusLabel && !statusLabel.startsWith("panel.modules.quantum") ? statusLabel : status;
        const awareText = aware
          ? panelT("panel.modules.quantum.live.pqcAwareYes")
          : panelT("panel.modules.quantum.live.pqcAwareNo");
        return `${statusText} — ${awareText}`;
      }

      function formatQuantumGeneratedAt(iso) {
        const raw = String(iso || "").trim();
        if (!raw) return "";
        const parsed = Date.parse(raw);
        if (Number.isNaN(parsed)) return raw;
        try {
          return new Date(parsed).toLocaleString(undefined, { timeZoneName: "short" });
        } catch {
          return raw;
        }
      }

      function formatQuantumFindingSeverity(severity) {
        const key = String(severity || "").trim().toLowerCase();
        const label = panelT(`panel.modules.quantum.live.severity.${key}`);
        if (label && !label.startsWith("panel.modules.quantum")) return label;
        return String(severity || "").trim();
      }

      function formatQuantumChangeCost(cost) {
        const key = String(cost || "").trim().toLowerCase();
        const label = panelT(`panel.modules.quantum.live.changeCost.${key}`);
        if (label && !label.startsWith("panel.modules.quantum")) return label;
        return String(cost || "").trim();
