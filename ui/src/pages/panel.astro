          display: none;
          width: 0;
          height: 0;
        }
        @media (max-width: 399.98px) {
          #panel-sohbet .chat-compose-bar {
            padding: 0.18rem 0.22rem 0.18rem 0.2rem;
          }
          #panel-sohbet .chat-compose.chat-compose--gpt {
            gap: 0.1rem;
          }
          #panel-sohbet .chat-compose--gpt textarea {
            padding: 0.35rem 0.22rem;
            line-height: 1.45;
            min-height: 2.375rem;
            max-height: 9rem;
          }
          @supports (-webkit-touch-callout: none) {
            #panel-sohbet .chat-compose--gpt textarea {
              padding: 0.35rem 0.22rem;
              line-height: 1.45;
            }
          }
          #panel-sohbet .chat-compose--gpt textarea::placeholder {
            font-size: 0.68rem;
            letter-spacing: -0.01em;
          }
          #panel-sohbet .chat-compose-send {
            min-width: 1.65rem;
            min-height: 1.72rem;
            padding: 0.2rem 0.3rem;
            font-size: 0.62rem;
            letter-spacing: -0.02em;
          }
          #panel-sohbet .chat-compose-camera-btn,
          #panel-sohbet .chat-compose-voice-btn,
          #panel-sohbet .chat-compose-attach-btn {
            width: 1.72rem;
            height: 1.72rem;
            min-width: 1.72rem;
            min-height: 1.72rem;
          }
          #panel-sohbet .chat-compose-camera-btn svg,
          #panel-sohbet .chat-compose-voice-btn svg,
          #panel-sohbet .chat-compose-attach-btn svg {
            width: 0.85rem;
            height: 0.85rem;
          }
        }
        @media (max-width: 540px) {
          #gorevler-detail.gorevler-detail {
            width: 100%;
            max-width: 100%;
          }
        }
      }
      /** Mobil yatay: üst bar + sekmeler + hazır ipucu + compose sonrası kartın ezilmesini önle. */
      @media (max-height: 520px) and (orientation: landscape) {
        #panel-sohbet[data-active="true"] {
          min-height: 0;
        }
        #panel-sohbet .chat-workspace {
          gap: 0.12rem;
          min-height: 0;
        }
        #panel-sohbet .chat-history-shell {
          flex: 1 1 0;
          min-height: 0;
          max-height: 100%;
        }
        #panel-sohbet .chat-thread {
          flex: 1 1 auto;
          min-height: 0;
          gap: 0.28rem;
          padding: 0.28rem 0 0.32rem;
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
        }
        #panel-sohbet .chat-thread:not(:has(> .chat-turn)) {
          justify-content: flex-start;
          padding-top: 0.22rem;
        }
        #panel-sohbet .chat-empty-hint {
          flex-shrink: 0;
          padding: 0.22rem 0.45rem;
        }
        #panel-sohbet .chat-empty-hint__text {
          font-size: 0.6rem;
          line-height: 1.18;
          letter-spacing: -0.02em;
        }
        #panel-sohbet .chat-empty-hint + .chat-capability-card {
          margin-top: 0.14rem;
        }
        #panel-sohbet .chat-capability-card {
          flex: 1 1 auto;
          min-height: 0;
          max-height: min(100%, calc(100dvh - 9.5rem));
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
          padding: 0.38rem 0.52rem 0.42rem;
        }
        #panel-sohbet .chat-capability-card__title {
          margin-bottom: 0.32rem;
          font-size: 0.62rem;
          line-height: 1.24;
        }
        #panel-sohbet .chat-capability-card__sections {
          gap: 0.32rem;
        }
        #panel-sohbet .chat-capability-card__heading {
          margin-bottom: 0.16rem;
          font-size: 0.54rem;
          line-height: 1.28;
        }
        #panel-sohbet .chat-capability-card__list {
          font-size: 0.52rem;
          line-height: 1.3;
          padding-left: 0.82rem;
        }
        #panel-sohbet .chat-capability-card__list li {
          margin-top: 0.08rem;
        }
        #panel-sohbet .lumos-security-note {
          flex-shrink: 0;
          margin-top: 0.12rem;
          padding: 0.08rem 0.32rem 0.1rem;
          font-size: 0.5rem;
          line-height: 1.26;
        }
        #panel-sohbet .chat-compose-stack {
          flex: 0 0 auto;
          flex-shrink: 0;
          padding-top: 0.08rem;
          padding-bottom: calc(
            0.18rem + max(0.28rem, env(safe-area-inset-bottom, 0px))
          );
          box-shadow: 0 -4px 14px rgba(0, 0, 0, 0.38);
        }
        #panel-sohbet .chat-compose--gpt textarea:placeholder-shown,
        #panel-sohbet .chat-compose--gpt textarea:not(:placeholder-shown) {
          height: 2.375rem;
          min-height: 2.375rem;
          max-height: 2.375rem;
          overflow-y: hidden;
          white-space: nowrap;
        }
        #panel-sohbet .chat-compose-send {
          min-height: 1.82rem;
          padding: 0.24rem 0.48rem;
        }
        #panel-sohbet .chat-compose-camera-btn,
        #panel-sohbet .chat-compose-voice-btn,
        #panel-sohbet .chat-compose-attach-btn {
          width: 1.78rem;
          height: 1.78rem;
          min-width: 1.78rem;
          min-height: 1.78rem;
        }
      }
    </style>
  </head>
  <body class="panel-page" data-panel-debug={PANEL_DEBUG ? "true" : "false"}>
    <div class="panel-shell">
      <header class="panel-header">
        <div class="panel-header-title-row">
          <div class="panel-header-brand">
            <span class="lumos-mark" aria-hidden="true"></span>
            <h1>Lumos Panel</h1>
          </div>
          <div class="panel-health-row">
            <span
              id="panel-conn-badge"
              class="panel-conn-badge"
              data-state="pending"
              role="status"
              aria-live="polite"
            >Bağlanıyor</span>
            <GlobalMay19Corner />
          </div>
        </div>
      </header>
      <div class="panel-body">
        <nav class="panel-nav__primary" aria-label="Çalışma modülleri">
          <p class="panel-nav-sig">Lumos <span>panel</span></p>
          <div class="panel-nav-collapsible" data-nav-group="calisma">
            <button
              type="button"
              class="panel-nav-group-toggle"
              id="panel-nav-toggle-calisma"
              aria-expanded="true"
              aria-controls="panel-nav-items-calisma"
            >
              <span class="panel-nav-group-toggle-label">Çalışma</span>
            </button>
            <div class="panel-nav-group-items" id="panel-nav-items-calisma">
              <button type="button" data-module="sohbet" aria-current="true">
                <span class="panel-nav-label">Sohbet</span>
              </button>
              <button type="button" data-module="gorevler">
                <span class="panel-nav-label">Görevler</span>
              </button>
              <button type="button" data-module="ses">
                <span class="panel-nav-label">Ses</span>
              </button>
              <button type="button" data-module="medya">
                <span class="panel-nav-label">Medya</span>
              </button>
              <button type="button" data-module="sosyal">
                <span class="panel-nav-label">Sosyal</span>
              </button>
              <button type="button" data-module="posta">
                <span class="panel-nav-label">Posta</span>
              </button>
              <button type="button" data-module="dosyalar">
                <span class="panel-nav-label">Dosyalar</span>
              </button>
              <button type="button" class="panel-nav-research-chip" data-module="kuantum" title="Kuantum — araştırma alanı (aktif üretim özelliği değil)">
                <span class="panel-nav-label">Kuantum</span>
              </button>
            </div>
          </div>
        </nav>
        <main class="panel-main">
          <section
            id="panel-sohbet"
            class="module-panel"
            data-module-panel="sohbet"
            data-active="true"
            aria-label="Sohbet"
          >
            <div class="chat-workspace">
              <div class="chat-history-shell" aria-label="Mesaj geçmişi">
                <div
                  id="chat-thread"
                  class="chat-thread"
                  role="log"
                  aria-live="polite"
                  aria-relevant="additions"
                >
                  <div class="chat-empty-hint" aria-hidden="true">
                    <span class="chat-empty-hint__text">Lumos hazır · Dinliyor</span>
                    <span id="chat-empty-limited-sub" class="chat-empty-hint__sub" hidden></span>
                  </div>
                  <div
                    class="chat-capability-card"
                    role="region"
                    aria-labelledby="chat-capability-card-title"
                  >
                    <h3 id="chat-capability-card-title" class="chat-capability-card__title">
                      Şu an ne yapabilirim?
                    </h3>
                    <div class="chat-capability-card__sections">
                      <section class="chat-capability-card__section" aria-label="Yapabilirim">
                        <h4 class="chat-capability-card__heading">Yapabilirim</h4>
                        <ul class="chat-capability-card__list">
                          <li>Görev kaydeder, listeler ve kısa plan önerir.</li>
                          <li>Cihaz içi ayarlardan okur; pratik notlar verir.</li>
                        </ul>
                      </section>
                      <section class="chat-capability-card__section" aria-label="Şu an yapmam">
                        <h4 class="chat-capability-card__heading">Şu an yapmam</h4>
                        <ul class="chat-capability-card__list">
                          <li>Komut çalıştırmaz, kod değiştirmez.</li>
                          <li>Onaysız kalıcı işlem yapmaz.</li>
                        </ul>
                      </section>
                    </div>
                  </div>
                  <p class="lumos-security-note">Kalıcı işlemler için onay ister.</p>
                  <p id="panel-empty-secret-note" class="lumos-security-note">Cihaz içinde çalışır; gizli bilgileri sohbete yazma.</p>
                  {PANEL_DEBUG && (
                    <p class="lumos-security-note panel-debug-only">
                      Yerel geliştirmede bağlantı anahtarı tarayıcıda görünebilir; gerçek gizli değeri sohbete yapıştırma.
                    </p>
                  )}
                  <p class="lumos-security-note">Kamera ve mikrofon cihaz iznine bağlıdır.</p>
                </div>
              </div>
              <div class="chat-compose-stack">
                <div id="panel-camera-preview-wrap" class="chat-camera-preview-wrap" hidden>
                  <input
                    type="file"
                    id="panel-camera-photo-input"
                    class="chat-camera-photo-input"
                    accept="image/*"
                    tabindex="-1"
                    aria-label="Galeriden görsel seç"
                  />
                  <input
                    type="file"
                    id="panel-attach-audio-input"
                    class="chat-camera-photo-input"
                    accept="audio/*"
                    tabindex="-1"
                    aria-label="Ses dosyası seç"
                  />
                  <video
                    id="panel-camera-video"
                    class="chat-camera-video"
                    playsinline
                    muted
                    autoplay
                    hidden
                  ></video>
                  <div class="chat-camera-photo-row">
                    <img
                      id="panel-camera-photo-preview"
                      class="chat-camera-photo-preview-img"
                      alt=""
                      width="56"
                      height="56"
                      hidden
                      decoding="async"
                    />
                    <span
                      id="panel-camera-photo-status"
                      class="chat-camera-photo-status"
                      aria-live="polite"
                      hidden
                    ></span>
                  </div>
                </div>
                <div id="panel-audio-record-preview-wrap" class="chat-audio-record-preview-wrap" hidden>
                  <div class="chat-audio-record-row">
                    <span
                      id="panel-audio-record-status"
                      class="chat-audio-record-status"
                      aria-live="polite"
                    >Ses kaydı önizlemesi (henüz gönderilemez)</span>
                    <audio
                      id="panel-audio-record-player"
                      class="chat-audio-record-player"
                      controls
                      hidden
                      aria-label="Ses kaydı önizlemesi"
                    ></audio>
                    <div class="chat-audio-record-actions">
                      <button
                        type="button"
                        id="panel-audio-record-stop"
                        class="chat-audio-record-btn"
                        hidden
                      >
                        Durdur
                      </button>
                      <button type="button" id="panel-audio-record-cancel" class="chat-audio-record-btn" hidden>
                        İptal
                      </button>
                      <button
                        type="button"
                        id="panel-audio-record-rerecord"
                        class="chat-audio-record-btn"
                        hidden
                      >
                        Yeniden kaydet
                      </button>
                    </div>
                  </div>
                  <p
                    id="panel-audio-record-hint"
                    class="chat-audio-record-hint"
                    role="status"
                    aria-live="polite"
                    hidden
                  ></p>
                </div>
                <div class="chat-compose-bar">
                  <div class="chat-compose chat-compose--gpt">
                    <div class="chat-compose-attach-wrap">
                      <button
                        type="button"
                        id="panel-attach-toggle"
                        class="chat-compose-attach-btn"
                        title="Ekle"
                        aria-label="Dosya veya medya ekle"
                        aria-haspopup="menu"
                        aria-expanded="false"
                        aria-controls="panel-attach-menu"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
                        </svg>
                      </button>
                      <div id="panel-attach-menu" class="chat-compose-attach-menu" role="menu" hidden>
                        <button type="button" class="chat-compose-attach-menu__item" role="menuitem" data-attach-action="file">
                          Dosya yükle
                        </button>
                        <button type="button" class="chat-compose-attach-menu__item" role="menuitem" data-attach-action="photo">
                          Fotoğraf seç
                        </button>
                        <button type="button" class="chat-compose-attach-menu__item" role="menuitem" data-attach-action="camera">
                          Kamera aç
                        </button>
                        <button type="button" class="chat-compose-attach-menu__item" role="menuitem" data-attach-action="clipboard">
                          Panodaki metni ilet
                        </button>
                        <button type="button" class="chat-compose-attach-menu__item" role="menuitem" data-attach-action="audio">
                          Ses dosyası yükle
                          <span class="chat-compose-attach-menu__badge">yakında</span>
                        </button>
                        <button type="button" class="chat-compose-attach-menu__item" role="menuitem" data-attach-action="record">
                          Ses kaydı
                        </button>
                      </div>
                      <button
                        type="button"
                        id="panel-clipboard-to-kando"
                        class="chat-compose-clipboard-btn"
                        title="Panodaki metni ilet"
                        aria-label="Panodaki metni ilet"
                        hidden
                      >
                        Panodaki metni ilet
                      </button>
                    </div>
                    <button
                      type="button"
                      id="panel-camera-input"
                      class="chat-compose-camera-btn"
                      title="Kamera / görsel giriş"
                      aria-label="Kamera / görsel giriş"
                      aria-pressed="false"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path
                          d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        ></path>
                        <circle cx="12" cy="13" r="4"></circle>
                      </svg>
                    </button>
                    <button
                      type="button"
                      id="panel-voice-input"
                      class="chat-compose-voice-btn"
                      title="Sesle yazma (deneysel — tarayıcı/ağ servisine bağlı)"
                      aria-label="Sesle yazma, deneysel; tarayıcı ve ağ servisine bağlı"
                      aria-pressed="false"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v5a3 3 0 0 0 3 3z"></path>
                        <path d="M19 11a7 7 0 0 1-14 0"></path>
                        <path d="M12 18v3"></path>
                      </svg>
                    </button>
                    <textarea
                      id="panel-msg"
                      rows="1"
                      placeholder="Mesajını yaz"
                      aria-label="Mesajını yaz"
                      autocomplete="off"
                    ></textarea>
                    <button type="button" id="panel-send" class="chat-compose-send" title="Gönder" aria-label="Gönder">
                      <span class="chat-compose-send__label">Gönder</span>
                    </button>
                  </div>
                </div>
                <p id="panel-voice-hint" class="chat-voice-hint" role="status" aria-live="polite" hidden></p>
                <p id="panel-camera-hint" class="chat-camera-hint" role="status" aria-live="polite" hidden></p>
                <p id="panel-send-limited-hint" class="panel-limited-note" role="note" hidden></p>
                <p id="panel-send-hint" class="chat-camera-hint" role="status" aria-live="polite" hidden></p>
              </div>
            </div>
          </section>

          <section
            id="panel-gorevler"
            class="module-panel"
            data-module-panel="gorevler"
            data-active="false"
            aria-labelledby="panel-gorevler-title"
          >
            <p class="gorevler-eyebrow">Operasyon</p>
            <h2 id="panel-gorevler-title">Görevler</h2>
            <p class="gorevler-intro">
              <span class="panel-data-flow-badge">[Yerel]</span>
              Görevler cihazınızdaki görev kaydına yazılır; görev eklerken iletim gerekmez. Sunucu kapalıysa liste
              tarayıcı önbelleğinden gösterilir.
              {PANEL_DEBUG && (
                <span class="panel-debug-only">
                  {" "}
                  (<code>panel_tasks_server</code> · <code>{TASKS_API_URL}</code>)
                </span>
              )}
            </p>
            <div class="gorevler-proto">
              <div class="gorevler-form-panel">
                <div class="gorevler-field">
                  <label for="gorevler-title-input">Görev adı</label>
                  <input
                    id="gorevler-title-input"
                    type="text"
                    name="gorevler-title"
                    maxlength="200"
                    autocomplete="off"
                    placeholder="Kısa bir başlık yazın…"
                  />
                </div>
                <div class="gorevler-field">
                  <label for="gorevler-priority">Öncelik</label>
                  <select id="gorevler-priority" name="gorevler-priority">
                    <option value="dusuk">Düşük</option>
                    <option value="orta" selected>Orta</option>
                    <option value="yuksek">Yüksek</option>
                  </select>
                </div>
                <div class="gorevler-field">
                  <label for="gorevler-status">Durum</label>
                  <select id="gorevler-status" name="gorevler-status">
                    <option value="bekliyor" selected>Bekliyor</option>
                    <option value="onay_bekliyor">Onay bekliyor</option>
                    <option value="tamamlandi">Tamamlandı</option>
                  </select>
                </div>
                <button type="button" id="gorevler-add" class="gorevler-add-btn">Görev ekle</button>
                <p id="gorevler-hint" class="gorevler-hint" role="status" aria-live="polite" hidden></p>
                <aside
                  id="gorevler-plan-inline"
                  class="gorevler-plan-card"
                  hidden
                  aria-labelledby="gorevler-plan-inline-title"
                >
                  <h4 id="gorevler-plan-inline-title" class="gorevler-plan-card__title">Görev planı</h4>
                  <p id="gorevler-plan-inline-status" class="gorevler-plan-card__status" hidden></p>
                  <dl id="gorevler-plan-inline-dl" class="gorevler-detail-dl"></dl>
                  <p id="gorevler-plan-inline-low-risk-note" class="gorevler-plan-card__low-risk-note" hidden>
                    Düşük risk. Otomatik plan; hiçbir şey çalıştırılmadı.
                  </p>
                  <div class="gorevler-plan-actions">
                    <button type="button" id="gorevler-plan-inline-confirm" class="gorevler-add-btn">
                      Planı onayla
                    </button>
                    <button type="button" id="gorevler-plan-inline-dismiss" class="gorevler-clear-test-btn">
                      Sadece kaydet
                    </button>
                  </div>
                  <section
                    id="gorevler-plan-inline-teshis"
                    class="gorevler-plan-teshis-compact"
                    hidden
                    aria-live="polite"
                  ></section>
                </aside>
              </div>
              <div class="gorevler-list-heading-row">
                <h3 class="gorevler-list-heading">Görev listesi</h3>
                <div class="gorevler-list-filter" role="group" aria-label="Görev durumu filtresi">
                  <button
                    type="button"
                    class="gorevler-list-filter-btn is-active"
                    data-gorevler-filter="all"
                    aria-pressed="true"
                  >
                    Tümü
                  </button>
                  <button
                    type="button"
                    class="gorevler-list-filter-btn"
                    data-gorevler-filter="pending"
                    aria-pressed="false"
                  >
                    Bekleyen
                  </button>
                  <button
                    type="button"
                    class="gorevler-list-filter-btn"
                    data-gorevler-filter="done"
                    aria-pressed="false"
                  >
                    Tamamlanan
                  </button>
                </div>
                <button type="button" id="gorevler-restore-last" class="gorevler-clear-test-btn" hidden>
                  Geri al
                </button>
                <button type="button" id="gorevler-clear-test" class="gorevler-clear-test-btn">
                  Yerel listeyi temizle
                </button>
              </div>
              <ul id="gorevler-list" class="gorevler-task-list" aria-label="Görev listesi"></ul>
              <dialog id="gorevler-detail" class="gorevler-detail" aria-labelledby="gorevler-detail-title" tabindex="-1">
                <div class="gorevler-detail-shell">
                  <header class="gorevler-detail-header">
                    <h3 id="gorevler-detail-title" class="gorevler-detail-heading">Görev</h3>
                    <div class="gorevler-detail-header-actions">
                      <p id="gorevler-detail-bridge-note" class="gorevler-detail-bridge-note" role="note" hidden>
                        Görev iletimi köprü bağlantısı bekliyor.
                      </p>
                      <button type="button" id="gorevler-detail-bridge" class="gorevler-add-btn" hidden>
                        Görevi ilet
                      </button>
                      <button type="button" id="gorevler-detail-complete" class="gorevler-clear-test-btn" hidden>
                        Tamamla
                      </button>
                      <button type="button" id="gorevler-detail-delete" class="gorevler-clear-test-btn" hidden>
                        Sil
                      </button>
                      <button type="button" id="gorevler-detail-close" class="gorevler-detail-close">Kapat</button>
                    </div>
                  </header>
                  <div class="gorevler-detail-body">
                    <section class="gorevler-detail-section" aria-labelledby="gorevler-detail-sec-task">
                      <h4 id="gorevler-detail-sec-task" class="gorevler-detail-section-title">Görev</h4>
                      <dl id="gorevler-detail-task-dl" class="gorevler-detail-dl"></dl>
                    </section>
                    <section
                      id="gorevler-detail-plan-section"
                      class="gorevler-detail-section"
                      hidden
                      aria-labelledby="gorevler-detail-sec-plan"
                    >
