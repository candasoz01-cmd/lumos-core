        async function startVoiceCapture() {
          const transcribeUserBlock = remoteTranscriptionBlocked();
          if (transcribeUserBlock.blocked) {
            setVoiceHintKey(
              isOfflineUserMode()
                ? "panel.modules.chat.transcript.offlineMsg"
                : "panel.modules.chat.transcript.limitedUserMsg",
