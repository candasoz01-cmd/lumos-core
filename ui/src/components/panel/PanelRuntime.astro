---
interface Props {
  CHAT_URL: string;
  kandoToken: string;
  UPLOAD_URL: string;
  HEALTH_URL: string;
  BRIDGE_BASE_URL: string;
  STATUS_URL: string;
  TASKS_API_URL: string;
  PANEL_DEBUG: boolean;
}

const {
  CHAT_URL,
  kandoToken,
  UPLOAD_URL,
  HEALTH_URL,
  BRIDGE_BASE_URL,
  STATUS_URL,
  TASKS_API_URL,
  PANEL_DEBUG,
} = Astro.props;
---

<script define:vars={{ CHAT_URL, kandoToken, UPLOAD_URL, HEALTH_URL, BRIDGE_BASE_URL, STATUS_URL, TASKS_API_URL, PANEL_DEBUG }}>
      /** Görevler: panel_tasks_server → .lumos/tasks.json; localStorage önbellek (görev eklerken köprü yok). */
      const PANEL_GOREVLER_LS_KEY = "lumos_panel_gorevler_list_v1";
      /** Dosyalar: son 5 yükleme özeti — yalnız bu cihaz/tarayıcı. */
      const PANEL_DOSYALAR_HISTORY_LS_KEY = "lumos_panel_dosyalar_history_v1";
      /** EC2-02: offline görev mutasyonları — flush mevcut REST ile (journal istemciden yazılmaz). */
      const PANEL_EVIDENCE_PENDING_OPS_LS_KEY = "lumos_panel_evidence_pending_ops_v1";
      const PANEL_EVIDENCE_QUEUE_MAX = 64;
      const PANEL_EVIDENCE_FLUSH_MAX_ATTEMPTS = 5;
      const PANEL_EVIDENCE_FLUSH_INTERVAL_MS = 45000;
      /** PR-1: kullanıcı modu — altyapı durumundan bağımsız tercih. */
      const PANEL_USER_MODE_LS_KEY = "lumos_panel_user_mode_v1";
      const PANEL_USER_MODES = ["offline", "limited", "full"];
      let panelSessionLumosId = "";
      const panelConversationId =
        globalThis.crypto && typeof globalThis.crypto.randomUUID === "function"
          ? globalThis.crypto.randomUUID()
          : `conversation_${Date.now()}_${Math.random().toString(36).slice(2)}`;

      function panelUserModeBadgeLabel(mode) {
        const m = normalizePanelUserMode(mode);
        if (m === "offline") return panelT("panel.shell.userMode.badgeOffline");
        if (m === "full") return panelT("panel.shell.userMode.badgeFull");
        return panelT("panel.shell.userMode.badgeLimited");
      }

      function panelUserModeMenuLabel(mode) {
        const m = normalizePanelUserMode(mode);
        if (m === "offline") return panelT("panel.shell.userMode.menuOffline");
        if (m === "full") return panelT("panel.shell.userMode.menuFull");
        return panelT("panel.shell.userMode.menuLimited");
      }

      function panelConnBadgeLabel(state) {
        if (state === "ok") return panelT("panel.shell.conn.ok");
        if (state === "limited") return panelT("panel.shell.conn.limited");
        if (state === "bad") return panelT("panel.shell.conn.bad");
        return panelT("panel.shell.conn.pending");
      }

      function normalizePanelUserMode(mode) {
        const m = String(mode || "")
          .trim()
          .toLowerCase();
        return PANEL_USER_MODES.includes(m) ? m : "limited";
      }

      function isLumosDesktopEntry() {
        return document.documentElement.dataset.lumosApp === "true";
      }

      function getPanelUserMode() {
        try {
          const defaultMode = isLumosDesktopEntry() ? "full" : "limited";
          if (isLumosDesktopEntry()) return defaultMode;
          if (typeof localStorage === "undefined") return defaultMode;
          const raw = localStorage.getItem(PANEL_USER_MODE_LS_KEY);
          if (!raw) return defaultMode;
          return normalizePanelUserMode(raw);
        } catch {
          return isLumosDesktopEntry() ? "full" : "limited";
        }
      }

      function setPanelUserMode(mode) {
        const next = normalizePanelUserMode(mode);
        try {
          if (typeof localStorage !== "undefined") {
            localStorage.setItem(PANEL_USER_MODE_LS_KEY, next);
          }
        } catch {
          /* localStorage kapalı olabilir */
        }
        return next;
      }

      const GOREVLER_FIELD_MAX_LEN = 2048;
      const bridgeUsesSameOriginProxy = String(CHAT_URL || "").startsWith("/api/bridge/");
      const bridgeTokenMissing =
        !PANEL_DEBUG &&
        !String(kandoToken || "").trim() &&
        !bridgeUsesSameOriginProxy;
      /** Phase 1: görev köprüsü same-origin proxy; tarayıcı token taşımaz. */
      const TASK_BRIDGE_URL = "/api/bridge/task";
      /** Phase 2: medya outbox (last-result) same-origin proxy; tarayıcı token taşımaz. */
      const LAST_RESULT_BRIDGE_URL = "/api/bridge/last-result";
      /** Phase 2: kontrollü dosya köprüsü same-origin proxy; tarayıcı token taşımaz. */
      const CONTROLLED_BRIDGE_URL = "/api/bridge/controlled";
      /** Phase 2: ses→metin köprüsü same-origin proxy; multipart audio alanı. */
      const TRANSCRIBE_BRIDGE_URL = "/api/bridge/transcribe";

      function bridgeOpsBlocked() {
        return bridgeTokenMissing;
      }

      function isOfflineUserMode() {
        return getPanelUserMode() === "offline";
      }

      function isLocalOnlyUserMode() {
        const mode = getPanelUserMode();
        return mode === "offline" || mode === "limited";
      }

      function shouldAttemptRemoteChat() {
        return getPanelUserMode() === "full";
      }

      function remoteTranscriptionBlocked() {
        if (isOfflineUserMode()) {
          return { blocked: true, message: panelT("panel.modules.chat.transcript.offlineMsg") };
        }
        if (getPanelUserMode() === "limited") {
          return {
            blocked: true,
            message: panelT("panel.modules.chat.transcript.limitedUserMsg"),
          };
        }
        return { blocked: false, message: "" };
      }

      const BRIDGE_BADGE_LIMITED_LABEL = () => panelConnBadgeLabel("limited");

      function chatBubbleRoleLabel(kind) {
        if (kind === "user") return panelT("panel.modules.chat.bubbles.user");
        if (kind === "error") return panelT("panel.modules.chat.bubbles.warning");
        return panelT("panel.modules.chat.bubbles.lumos");
      }

      function refreshChatBubbleRoles() {
        document.querySelectorAll(".chat-msg-role").forEach((roleEl) => {
          const wrap = roleEl.closest(".chat-msg");
          if (!wrap) return;
          if (wrap.classList.contains("chat-msg--user")) {
            roleEl.textContent = panelT("panel.modules.chat.bubbles.user");
          } else if (wrap.classList.contains("chat-msg--error")) {
            roleEl.textContent = panelT("panel.modules.chat.bubbles.warning");
          } else if (wrap.classList.contains("chat-msg--lumos")) {
            roleEl.textContent = panelT("panel.modules.chat.bubbles.lumos");
          }
        });
      }

      function refreshPanelShellI18n() {
        const connBadge = document.getElementById("panel-conn-badge");
        if (connBadge) {
          const state = connBadge.getAttribute("data-state") || "pending";
          connBadge.textContent = panelConnBadgeLabel(state);
        }
        setPanelUserModeBadge(getPanelUserMode());
        syncBridgeHealthLine();
        paintPanelInfraStatusSkeleton();
        document.querySelectorAll("#panel-user-mode-menu [data-mode]").forEach((item) => {
          if (!(item instanceof HTMLElement)) return;
          const mode = item.getAttribute("data-mode");
          const label = item.querySelector(".panel-user-mode-menu__label");
          if (label && mode) label.textContent = panelUserModeMenuLabel(mode);
        });
        document.querySelectorAll('input[name="panel-user-mode"]').forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          const span = input.parentElement && input.parentElement.querySelector("span");
          if (!span) return;
          if (input.value === "offline") span.textContent = panelT("panel.shell.userMode.segOffline");
          else if (input.value === "full") span.textContent = panelT("panel.shell.userMode.segFull");
          else span.textContent = panelT("panel.shell.userMode.segLimited");
        });
      }

      function refreshPanelChatI18n() {
        applyUserModeUi();
        refreshChatBubbleRoles();
        if (typeof refreshChatBubbleBodies === "function") refreshChatBubbleBodies();
        if (typeof refreshPanelCameraHintsI18n === "function") refreshPanelCameraHintsI18n();
        if (typeof refreshPanelAudioRecordI18n === "function") refreshPanelAudioRecordI18n();
        if (typeof refreshPanelVoiceHintsI18n === "function") refreshPanelVoiceHintsI18n();
        if (typeof refreshPanelTtsI18n === "function") refreshPanelTtsI18n();
        if (typeof refreshSendHintI18n === "function") refreshSendHintI18n();
        refreshPanelHeroPrefillBannerI18n();
        if (typeof refreshPanelSendButtonI18n === "function") refreshPanelSendButtonI18n();
        refreshTranscriptVisibleI18n();
      }

      const transcriptVisibleI18nRefreshers = new Set();

      function refreshTranscriptVisibleI18n() {
        transcriptVisibleI18nRefreshers.forEach((fn) => {
          try {
            fn();
          } catch {
            /* ignore */
          }
        });
      }

      let refreshDosyalarPanelI18n = null;
      let refreshPanelCameraHintsI18n = null;
      let refreshPanelAudioRecordI18n = null;
      let refreshPanelVoiceHintsI18n = null;
      let refreshPanelTtsI18n = null;
      let refreshSendHintI18n = null;
      let refreshPanelSendButtonI18n = null;
      let refreshChatBubbleBodies = null;

      function refreshPanelFilesI18n() {
        if (typeof refreshDosyalarPanelI18n === "function") refreshDosyalarPanelI18n();
      }

      function refreshPanelGorevlerI18n() {
        if (typeof panelEvidenceRefreshStrip === "function") {
          void panelEvidenceRefreshStrip();
        }
        if (typeof panelGorevlerRefreshI18n === "function") {
          panelGorevlerRefreshI18n();
        }
      }
      function transcribeFailureUserMessage(result, filename, mime) {
        const isMusic = isLikelyMusicAudio(filename, mime);
        const failedMusic = panelT("panel.modules.chat.transcript.failedMusic");
        const failedSpeech = panelT("panel.modules.chat.transcript.failedSpeech");
        const userMsg = isMusic ? failedMusic : failedSpeech;
        if (!PANEL_DEBUG) return userMsg;
        const bits = [userMsg];
        if (result && typeof result === "object") {
          if (result.error != null && String(result.error).trim()) {
            bits.push("[" + String(result.error).trim() + "]");
          }
          const backendMsg =
            result.message != null ? String(result.message).trim() : "";
          if (
            backendMsg &&
            backendMsg !== userMsg &&
            backendMsg !== failedMusic &&
            backendMsg !== failedSpeech
          ) {
            bits.push(backendMsg);
          }
        }
        return bits.join(" ");
      }

      function transcriptBlockedUserMessage(result) {
        const err = result && result.error != null ? String(result.error).trim() : "";
        let userMsg = panelT("panel.modules.chat.transcript.limitedMsg");
        if (err === "offline_mode") {
          userMsg = panelT("panel.modules.chat.transcript.offlineMsg");
        } else if (err === "user_limited_mode" || err === "bridge_limited") {
          userMsg = panelT("panel.modules.chat.transcript.limitedUserMsg");
        }
        if (!PANEL_DEBUG) return userMsg;
        const bits = [userMsg];
        if (result && result.message != null) {
          const backendMsg = String(result.message).trim();
          if (backendMsg && backendMsg !== userMsg) bits.push("[" + backendMsg + "]");
        }
        if (err) bits.push("[" + err + "]");
        return bits.join(" ");
      }

      function transcriptEngineUserMessage(result) {
        const userMsg = panelT("panel.modules.chat.transcript.engineMsg");
        if (!PANEL_DEBUG) return userMsg;
        const bits = [userMsg];
        if (result && typeof result === "object") {
          if (result.error != null && String(result.error).trim()) {
            bits.push("[" + String(result.error).trim() + "]");
          }
          if (result.message != null) {
            const backendMsg = String(result.message).trim();
            if (backendMsg && backendMsg !== userMsg) bits.push("[" + backendMsg + "]");
          }
        }
        return bits.join(" ");
      }

      function extractTranscriptText(data) {
        if (!data || typeof data !== "object") return "";
        const keys = ["text", "transcript"];
        for (let i = 0; i < keys.length; i++) {
          const v = data[keys[i]];
          if (v != null && String(v).trim()) return String(v).trim();
        }
        return "";
      }

      function isLikelyMusicAudio(filename, mime) {
        const name = filename != null ? String(filename).trim().toLowerCase() : "";
        const type = mime != null ? String(mime).trim().toLowerCase() : "";
        if (!name && !type) return false;
        if (/\.mp3\b/i.test(name)) return true;
        if (/music|song|şarkı|müzik|sarki|muzik/i.test(name)) return true;
        if (/\.(flac|aac|m4a)\b/i.test(name)) return true;
        if (type.startsWith("audio/")) {
          // In-browser speech recordings default to webm; uploaded audio/* otherwise.
          if (type === "audio/webm") return false;
          return true;
        }
        return false;
      }

      function isLowQualityTranscript(text) {
        const trimmed = text != null ? String(text).trim() : "";
        if (!trimmed) return false;
        if (trimmed.length < 3) return true;
        const tokens = trimmed.split(/\s+/).filter((t) => t.length > 0);
        if (!tokens.length) return true;
        function tokenCore(t) {
          return t.toLowerCase().replace(/[^a-z0-9çğıöşüâîû]/gi, "");
        }
        const cores = tokens.map(tokenCore).filter((c) => c.length > 0);
        const basis = cores.length || tokens.length;
        if (cores.length) {
          const counts = {};
          for (const c of cores) counts[c] = (counts[c] || 0) + 1;
          const max = Math.max(...Object.values(counts));
          if (max / basis > 0.4) return true;
        }
        const singleChar = tokens.filter((t) => tokenCore(t).length <= 1);
        if (singleChar.length / tokens.length > 0.35) return true;
        const punctHeavy = tokens.filter((t) => {
          const letters = (t.match(/[a-zA-Z0-9çğıöşüâîû]/gi) || []).length;
          return letters === 0 || (letters <= 1 && t.length > 2);
        });
        if (punctHeavy.length / tokens.length > 0.3) return true;
        const words = cores.length ? cores : tokens.map((t) => t.toLowerCase());
        if (words.length >= 6) {
          for (let len = 2; len <= 3; len++) {
            const phraseCounts = {};
            for (let i = 0; i <= words.length - len; i++) {
              const phrase = words.slice(i, i + len).join(" ");
              phraseCounts[phrase] = (phraseCounts[phrase] || 0) + 1;
              if (phraseCounts[phrase] >= 3) return true;
            }
          }
        }
        return false;
      }

      async function requestLocalTranscription(blob, source, filename, mime) {
        if (!blob || typeof blob.size !== "number" || blob.size < 512) {
          return {
            ok: false,
            error: "transcribe_missing_audio",
            message: panelT("panel.modules.chat.transcript.missingAudio"),
          };
        }
        const transcribeUserBlock = remoteTranscriptionBlocked();
        if (transcribeUserBlock.blocked) {
          return {
            ok: false,
            blocked: true,
            error: isOfflineUserMode() ? "offline_mode" : "user_limited_mode",
            message: transcribeUserBlock.message,
          };
        }
        const safeName =
          filename != null && String(filename).trim()
            ? String(filename).trim()
            : "recording.webm";
        const safeMime =
          mime != null && String(mime).trim()
            ? String(mime).trim()
            : blob.type || "application/octet-stream";
        const fd = new FormData();
        try {
          fd.append("audio", blob, safeName);
        } catch {
          fd.append("audio", blob);
        }
        let r;
        try {
          r = await fetch(TRANSCRIBE_BRIDGE_URL, {
            method: "POST",
            body: fd,
          });
        } catch {
          return {
            ok: false,
            error: "network_error",
            message: panelT("panel.modules.chat.transcript.networkFailed"),
          };
        }
        let data = null;
        const raw = await r.text();
        if (raw && raw.trim()) {
          try {
            data = JSON.parse(raw);
          } catch {
            data = null;
          }
        }
        if (taskBridgeBlockedResponse(r.status)) {
          const engineUnavailable =
            data &&
            (data.error === "transcribe_engine_unavailable" ||
              data.error === "engine_unavailable");
          if (engineUnavailable || (data && data.ok === false && !data.error)) {
            return {
              ok: false,
              engineUnavailable: true,
              status: r.status,
              error: data && data.error ? String(data.error) : "transcribe_engine_unavailable",
              message:
                data && data.message != null && String(data.message).trim()
                  ? String(data.message).trim()
                  : panelT("panel.modules.chat.transcript.engineMsg"),
            };
          }
          if (data && data.error === "bridge_proxy_unconfigured") {
            if (isLocalOnlyUserMode()) {
              const block = remoteTranscriptionBlocked();
              return {
                ok: false,
                blocked: true,
                status: r.status,
                error: "bridge_proxy_unconfigured",
                message: block.message,
              };
            }
            return {
              ok: false,
              transcribeFailure: true,
              status: r.status,
              error: "bridge_proxy_unconfigured",
              message: panelT("panel.shell.infra.unavailableMsg"),
            };
          }
          if (isLocalOnlyUserMode()) {
            const block = remoteTranscriptionBlocked();
            return {
              ok: false,
              blocked: true,
              status: r.status,
              error: data && data.error ? String(data.error) : "bridge_limited",
              message: block.message,
            };
          }
          return {
            ok: false,
            engineUnavailable: true,
            status: r.status,
            error: data && data.error ? String(data.error) : "transcribe_engine_unavailable",
            message:
              data && data.message != null && String(data.message).trim()
                ? String(data.message).trim()
                : panelT("panel.modules.chat.transcript.engineMsg"),
          };
        }
        if (!r.ok) {
          const backendMsg =
            data && data.message != null && String(data.message).trim()
              ? String(data.message).trim()
              : "";
          return {
            ok: false,
            transcribeFailure: true,
            status: r.status,
            error: data && data.error != null ? String(data.error) : "transcribe_failed",
            message: backendMsg || panelT("panel.modules.chat.transcript.failedMusic"),
          };
        }
        const text = extractTranscriptText(data);
        if (data && data.ok === true && text) {
          return { ok: true, text, data, source: source || "panel" };
        }
        const backendMsg =
          data && data.message != null && String(data.message).trim()
            ? String(data.message).trim()
            : "";
        return {
          ok: false,
          transcribeFailure: true,
          status: r.status,
          error: data && data.error != null ? String(data.error) : "transcribe_empty",
          message: backendMsg || panelT("panel.modules.chat.transcript.failedMusic"),
        };
      }

      function fillPanelChatInputWithTranscript(text) {
        const chatInput = document.getElementById("panel-msg");
        if (!(chatInput instanceof HTMLTextAreaElement)) return false;
        const transcript = text != null ? String(text).trim() : "";
        if (!transcript) return false;
        const existing = chatInput.value.trim();
        chatInput.value = existing ? existing + "\n" + transcript : transcript;
        chatInput.dispatchEvent(new Event("input", { bubbles: true }));
        try {
          chatInput.focus({ preventScroll: true });
        } catch {
          chatInput.focus();
        }
        return true;
      }

      /** Yerel ses balonu: Metne çevir → önizleme; Sohbete ekle yalnızca tıklamada. */
      function attachAudioTranscriptPlaceholder(parentEl, audioBlob, options) {
        if (!parentEl) return null;
        const opts = options && typeof options === "object" ? options : {};
        const filename = opts.filename || "recording.webm";
        const mime = opts.mime || (audioBlob && audioBlob.type) || "audio/webm";
        const source = opts.source || "bubble";

        const wrap = document.createElement("div");
        wrap.className = "chat-audio-transcript-placeholder";

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "chat-audio-transcript-btn";
        btn.textContent = panelT("panel.modules.chat.compose.transcribe");

        const msg = document.createElement("p");
        msg.className = "chat-audio-transcript-msg";
        msg.hidden = true;
        msg.setAttribute("role", "status");
        msg.setAttribute("aria-live", "polite");

        const preview = document.createElement("div");
        preview.className = "chat-audio-transcript-preview";
        preview.hidden = true;
        preview.setAttribute("role", "region");
        preview.setAttribute("aria-label", panelT("panel.modules.chat.transcript.previewAria"));

        const musicWarn = document.createElement("p");
        musicWarn.className = "chat-audio-transcript-warn";
        musicWarn.hidden = true;
        musicWarn.setAttribute("role", "note");

        const qualityWarn = document.createElement("p");
        qualityWarn.className = "chat-audio-transcript-warn";
        qualityWarn.hidden = true;
        qualityWarn.setAttribute("role", "note");

        const privacy = document.createElement("p");
        privacy.className = "chat-audio-transcript-privacy";
        privacy.hidden = true;
        privacy.textContent = panelT("panel.modules.chat.transcript.privacyMsg");

        const addBtn = document.createElement("button");
        addBtn.type = "button";
        addBtn.className = "chat-audio-transcript-btn chat-audio-transcript-add-btn";
        addBtn.textContent = panelT("panel.modules.chat.transcript.addToChat");
        addBtn.hidden = true;

        let lastTranscript = "";
        let busy = false;
        let transcriptStatusRefresh = null;
        let transcriptStatusOptions = {};

        function setBusy(on) {
          busy = on;
          btn.disabled = on;
          if (on) {
            btn.setAttribute("aria-busy", "true");
            btn.textContent = panelT("panel.modules.chat.transcript.transcribing");
          } else {
            btn.removeAttribute("aria-busy");
            btn.textContent = panelT("panel.modules.chat.compose.transcribe");
          }
        }

        function updateMusicWarnVisibility(show) {
          const showMusic = !!show && isLikelyMusicAudio(filename, mime);
          musicWarn.textContent = panelT("panel.modules.chat.transcript.musicWarnMsg");
          musicWarn.hidden = !showMusic;
        }

        function paintTranscriptStatusFromResolver() {
          if (!transcriptStatusRefresh) return;
          const s = panelUserVisibleText(transcriptStatusRefresh());
          msg.textContent = s;
          msg.hidden = !s;
          updateMusicWarnVisibility(transcriptStatusOptions.showMusicWarn === true);
        }

        function showStatus(textOrResolver, options) {
          transcriptStatusOptions = options && typeof options === "object" ? options : {};
          preview.hidden = true;
          qualityWarn.hidden = true;
          privacy.hidden = true;
          addBtn.hidden = true;
          if (textOrResolver == null || textOrResolver === "") {
            transcriptStatusRefresh = null;
            msg.textContent = "";
            msg.hidden = true;
            updateMusicWarnVisibility(transcriptStatusOptions.showMusicWarn === true);
            return;
          }
          transcriptStatusRefresh =
            typeof textOrResolver === "function" ? textOrResolver : () => String(textOrResolver);
          msg.hidden = false;
          paintTranscriptStatusFromResolver();
        }

        function showPreview(text) {
          transcriptStatusRefresh = null;
          lastTranscript = text != null ? String(text) : "";
          msg.hidden = true;
          preview.textContent = lastTranscript;
          preview.hidden = !lastTranscript;
          updateMusicWarnVisibility(isLikelyMusicAudio(filename, mime));
          const showQuality = !!lastTranscript && isLowQualityTranscript(lastTranscript);
          qualityWarn.textContent = panelT("panel.modules.chat.transcript.lowQualityWarnMsg");
          qualityWarn.hidden = !showQuality;
          privacy.hidden = !lastTranscript;
          addBtn.hidden = !lastTranscript;
        }

        function refreshTranscriptWidgetVisibleI18n() {
          if (busy) {
            btn.textContent = panelT("panel.modules.chat.transcript.transcribing");
          } else {
            btn.textContent = panelT("panel.modules.chat.compose.transcribe");
          }
          privacy.textContent = panelT("panel.modules.chat.transcript.privacyMsg");
          if (!addBtn.hidden) addBtn.textContent = panelT("panel.modules.chat.transcript.addToChat");
          if (!musicWarn.hidden) {
            musicWarn.textContent = panelT("panel.modules.chat.transcript.musicWarnMsg");
          }
          if (!qualityWarn.hidden) {
            qualityWarn.textContent = panelT("panel.modules.chat.transcript.lowQualityWarnMsg");
          }
          if (!preview.hidden) {
            preview.setAttribute("aria-label", panelT("panel.modules.chat.transcript.previewAria"));
          }
          paintTranscriptStatusFromResolver();
        }

        transcriptVisibleI18nRefreshers.add(refreshTranscriptWidgetVisibleI18n);

        addBtn.addEventListener("click", () => {
          if (!lastTranscript) return;
          fillPanelChatInputWithTranscript(lastTranscript);
        });

        btn.addEventListener("click", async () => {
          if (busy) return;
          if (!audioBlob || audioBlob.size < 512) {
            showStatus(() => panelT("panel.modules.chat.transcript.missingAudio"));
            return;
          }
          const transcribeUserBlock = remoteTranscriptionBlocked();
          if (transcribeUserBlock.blocked) {
            showStatus(() => remoteTranscriptionBlocked().message);
            return;
          }
          setBusy(true);
          showStatus(() => panelT("panel.modules.chat.transcript.busyMsg"), { showMusicWarn: false });
          try {
            const result = await requestLocalTranscription(
              audioBlob,
              source,
              filename,
              mime,
            );
            if (result.ok && result.text) {
              showPreview(result.text);
            } else if (result.blocked) {
              showStatus(() => transcriptBlockedUserMessage(result));
            } else if (result.engineUnavailable) {
              showStatus(() => transcriptEngineUserMessage(result));
            } else if (result.transcribeFailure) {
              showStatus(() => transcribeFailureUserMessage(result, filename, mime), {
                showMusicWarn: true,
              });
            } else {
              showStatus(
                () => {
                  const fallback = isLikelyMusicAudio(filename, mime)
                    ? panelT("panel.modules.chat.transcript.failedMusic")
                    : panelT("panel.modules.chat.transcript.failedSpeech");
                  let text = result.message || fallback;
                  if (!PANEL_DEBUG && text) {
                    text =
                      String(text)
                        .replace(/\s*\[[^\]]+\]\s*/g, " ")
                        .replace(/\s{2,}/g, " ")
                        .trim() || fallback;
                  }
                  return text;
                },
                { showMusicWarn: isLikelyMusicAudio(filename, mime) },
              );
            }
          } catch {
            showStatus(() => transcribeFailureUserMessage(null, filename, mime), {
              showMusicWarn: true,
            });
          } finally {
            setBusy(false);
          }
        });

        wrap.appendChild(btn);
        wrap.appendChild(musicWarn);
        wrap.appendChild(qualityWarn);
        wrap.appendChild(msg);
        wrap.appendChild(preview);
        wrap.appendChild(privacy);
        wrap.appendChild(addBtn);
        parentEl.appendChild(wrap);
        return wrap;
      }

