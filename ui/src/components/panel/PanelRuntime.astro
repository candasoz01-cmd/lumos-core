      /** Display-only hazırlık_raporu badge — derived from existing scan fields (ADR-013). */
      function deriveQuantumReadinessReportBadge(report) {
        const agility = String(report?.crypto_agility_level || "").trim().toLowerCase();
        if (agility === "dogrulanamadi") return "dogrulanamadi";
        const findings = Array.isArray(report?.evidenced_findings) ? report.evidenced_findings : [];
        if (findings.some((f) => f && f.verified === false)) return "kismi";
        const inv = report?.crypto_inventory;
        const hasTypes =
          inv &&
          typeof inv === "object" &&
          []
            .concat(inv.encryption_types || [])
            .concat(inv.signature_types || [])
            .concat(inv.key_types || []).length > 0;
        if (!hasTypes) return "kismi";
        return "tamamlandi";
      }

