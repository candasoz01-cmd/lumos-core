            const blob = new Blob(recorderChunks, { type });
            resetVoiceCaptureState(recorder);
            if (recorderFailed) return;
            if (blob.size < 512) {
              setVoiceHintKey("panel.modules.chat.compose.voiceHints.noSpeech");
              return;
            }
            void transcribeVoiceCapture(blob, type);
          };

          try {
            voiceRecorder.start();
          } catch {
            resetVoiceCaptureState(recorder);
            setVoiceHintKey("panel.modules.chat.compose.voiceHints.startFailed");
            return;
          }
          voiceStartPending = false;
          setVoiceListeningUi(true);
          setVoiceHintKey("panel.modules.chat.compose.voiceHints.recording");
          voiceStopTimer = window.setTimeout(stopVoiceCapture, VOICE_CAPTURE_MAX_MS);
