          scrollActivePanelNavChipIntoView(btn);
          focusPanelModuleContent(moduleId);
          return true;
        }

        function tryPanelLimitedNavigationIntent(trimmed, offlineNav) {
          const k = normalizePanelLimitedIntentKey(trimmed)
            .replace(/[.?!…]+$/g, "")
            .trim();
          if (!k) return null;
          if (/^(görevler|gorevler)$/.test(k)) {
            panelNavigateToModule("gorevler");
            return panelT("panel.modules.chat.localReply.navGorevler");
          }
          if (/^(durum|sistem|sistem durumu|system)$/.test(k)) {
            panelNavigateToModule("ayarlar");
            return offlineNav
              ? panelT("panel.modules.chat.localReply.navAyarlarOffline")
              : panelT("panel.modules.chat.localReply.navAyarlar");
          }
          if (/^(anahtar\s+kasası|anahtar\s+kasasi|keystore|kimlik)$/.test(k)) {
            panelNavigateToModule("kimlik");
            return panelT("panel.modules.chat.localReply.navKimlik");
