        const PANEL_TIME_QUERY_KEYS = [
          "saat kaç",
          "saat kac",
          "saat",
          "time",
          "tarih",
          "bugün kaç",
          "bugun kac",
          "bugün günlerden ne",
          "bugun gunlerden ne",
          "hangi gün",
          "hangi gun",
          "günlerden",
          "gunlerden",
        ];

        function isPanelTimeQuery(text) {
          const lower = String(text || "").trim().toLowerCase();
          if (!lower) return false;
          return PANEL_TIME_QUERY_KEYS.some((k) => lower.indexOf(k) !== -1);
        }

        function isPanelWeekdayTimeQuery(text) {
          const lower = String(text || "").trim().toLowerCase();
          return (
            lower.indexOf("günlerden") !== -1 ||
            lower.indexOf("gunlerden") !== -1 ||
            lower.indexOf("hangi gün") !== -1 ||
            lower.indexOf("hangi gun") !== -1
          );
