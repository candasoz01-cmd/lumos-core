#!/bin/sh
# Compatibility entry for core.hooksPath=ops/claim_guard/hooks.
# The canonical hook set is .githooks (claim gate + ruff/pytest + publication
# gate). Delegate there so pointing hooksPath here never drops an older guard.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(git rev-parse --show-toplevel)
if [ -f "$root/.githooks/commit-msg" ]; then
  exec "$root/.githooks/commit-msg" "$@"
fi
exec "$here/../claim-commit-msg" "$@"
