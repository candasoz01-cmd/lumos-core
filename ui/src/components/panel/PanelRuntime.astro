        function positionPanelAttachMenu() {
          if (!attachMenu || !attachToggle || attachMenu.hidden) return;
          const btn = attachToggle.getBoundingClientRect();
          const menu = attachMenu.getBoundingClientRect();
          const gap = panelAttachMenuGapPx();
          const margin = Math.max(8, gap);
          const menuW = menu.width;
          const menuH = menu.height;

          let left = btn.left;
          let top = btn.top - menuH - gap;

          if (top < margin) {
            const below = btn.bottom + gap;
            if (below + menuH + margin <= window.innerHeight) {
              top = below;
            } else {
              top = Math.max(margin, top);
            }
          }

          left = Math.max(margin, Math.min(left, window.innerWidth - menuW - margin));
          top = Math.max(margin, Math.min(top, window.innerHeight - menuH - margin));

          attachMenu.style.top = `${Math.round(top)}px`;
          attachMenu.style.left = `${Math.round(left)}px`;
