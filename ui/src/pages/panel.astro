        function tryPanelLocalTimeReply(userText) {
          const trimmed = String(userText || "").trim();
          if (!trimmed || !isPanelTimeQuery(trimmed)) return null;
          const now = new Date();
          const hh = String(now.getHours()).padStart(2, "0");
          const mm = String(now.getMinutes()).padStart(2, "0");
          const dd = String(now.getDate()).padStart(2, "0");
          const mo = String(now.getMonth() + 1).padStart(2, "0");
          const yyyy = now.getFullYear();
          let reply = panelT("panel.modules.chat.localReply.timeBase")
            .replace("{hh}", hh)
            .replace("{mm}", mm)
            .replace("{date}", dd + "." + mo + "." + yyyy);
          if (isPanelWeekdayTimeQuery(trimmed)) {
            reply += panelT("panel.modules.chat.localReply.timeWeekdaySuffix").replace(
              "{weekday}",
              panelLocalWeekdayName(now.getDay()),
            );
          }
          return reply;
        }

        function buildPanelLimitedReply(userText) {
          const trimmed = String(userText || "").trim();
          if (!trimmed) return panelT("panel.modules.chat.localReply.emptyMessage");
          const timeReply = tryPanelLocalTimeReply(trimmed);
          if (timeReply) return timeReply;
          const navReply = tryPanelLimitedNavigationIntent(trimmed, false);
          if (navReply) return navReply;
          const keyTr = normalizePanelLimitedIntentKey(trimmed);
          const keyAscii = keyTr
            .replace(/ğ/g, "g")
            .replace(/ü/g, "u")
            .replace(/ş/g, "s")
            .replace(/ı/g, "i")
            .replace(/ö/g, "o")
            .replace(/ç/g, "c");
          if (keyTr.indexOf("görev") !== -1 || keyAscii.indexOf("gorev") !== -1) {
            return panelT("panel.modules.chat.localReply.keywordGorev");
          }
          if (keyTr.indexOf("kayıt") !== -1 || keyAscii.indexOf("kayit") !== -1) {
            return panelT("panel.modules.chat.localReply.keywordKayit");
          }
          if (keyTr.indexOf("akış") !== -1 || keyAscii.indexOf("akis") !== -1) {
            return panelT("panel.modules.chat.localReply.keywordAkis");
          }
          return panelT("panel.modules.chat.localReply.limitedDefault");
        }

        function buildPanelOfflineReply(userText) {
          const trimmed = String(userText || "").trim();
          if (!trimmed) return panelT("panel.modules.chat.localReply.emptyMessage");
          const timeReply = tryPanelLocalTimeReply(trimmed);
          if (timeReply) return timeReply;
          const navReply = tryPanelLimitedNavigationIntent(trimmed, true);
          if (navReply) return navReply;
          const limited = buildPanelLimitedReply(trimmed);
          const limitedDefault = panelT("panel.modules.chat.localReply.limitedDefault");
          if (limited === limitedDefault) {
            return panelT("panel.modules.chat.localReply.offlineDefault");
          }
          return limited;
