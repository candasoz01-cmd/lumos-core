      function maskBridgeSensitive(text) {
        if (text == null) return "";
        let s = String(text);
        s = s.replace(
          /("(?:token|api[_-]?key|secret|password|bearer|cookie|session|authorization|x-kando-token)"\s*:\s*")([^"]+)(")/gi,
          "$1***$3",
        );
        s = s.replace(
          /\b(Bearer|Token|ApiKey|API-Key|Password|Secret|Cookie|Session|Authorization)\s*[:=]\s*\S+/gi,
          "$1: ***",
        );
        s = s.replace(/\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b/g, "***");
        s = s.replace(/\b[a-f0-9]{32,}\b/gi, "***");
        s = s.replace(
          /\bX-Kando-Token\s*[:=]\s*\S+/gi,
          panelT("panel.shell.infra.leakConnectionMasked"),
        );
        return s;
      }

      function stripPanelTechnicalLeak(text) {
        if (PANEL_DEBUG || text == null) return text == null ? "" : String(text);
        let s = String(text);
        s = s.replace(/\bX-Kando-Token\b/gi, panelT("panel.shell.infra.leakConnectionKey"));
        s = s.replace(/\b(?:Kando|Cando)\b/gi, "Lumos");
        s = s.replace(/\bajan\b/gi, panelT("panel.shell.infra.leakDevice"));
        s = s.replace(/\bagent\b/gi, panelT("panel.shell.infra.leakDevice"));
        s = s.replace(/\b(?:PUBLIC\s+)?token\b/gi, panelT("panel.shell.infra.leakConnectionInfo"));
        s = s.replace(/\bendpoint\b/gi, panelT("panel.shell.infra.leakConnection"));
        s = s.replace(/\broute\b/gi, panelT("panel.shell.infra.leakRoute"));
        s = s.replace(/\bbridge\b/gi, panelT("panel.shell.infra.leakConnection"));
        s = s.replace(/\bk[öo]pr[üu]\b/gi, panelT("panel.shell.infra.leakTransmission"));
        s = s.replace(/127\.0\.0\.1(?::\d+)?/gi, panelT("panel.shell.infra.leakLocalServer"));
        s = s.replace(/https?:\/\/[^\s)]+/gi, panelT("panel.shell.infra.leakConnection"));
        s = s.replace(/\/last-result/gi, panelT("panel.shell.infra.leakLastResult"));
        s = s.replace(/\.lumos\/tasks\.json/gi, panelT("panel.shell.infra.leakTaskRecord"));
        s = s.replace(/\/tasks\b/gi, panelT("panel.shell.infra.leakTask"));
        s = s.replace(/\/controlled\b/gi, panelT("panel.shell.infra.leakControlledFile"));
        s = s.replace(/\/task\b/gi, panelT("panel.shell.infra.leakTask"));
        s = s.replace(/\/status\b/gi, panelT("panel.shell.infra.leakStatus"));
        s = s.replace(/\/health\b/gi, panelT("panel.shell.infra.leakHealth"));
        s = s.replace(/\/chat\b/gi, panelT("panel.shell.infra.leakChat"));
        s = s.replace(/\b(GET|POST|PUT|DELETE|OPTIONS)\b/gi, "");
        s = s.replace(/\bHTTP\s+\d+\b/gi, panelT("panel.shell.infra.leakRequestError"));
        s = s.replace(/panel_tasks_server/gi, panelT("panel.shell.infra.leakTaskService"));
        s = s.replace(/bridge_start\.sh/gi, panelT("panel.shell.infra.leakConnectionStart"));
        s = s.replace(/\bcomplete_failed\b/gi, panelT("panel.modules.tasks.hints.leakCompleteFailed"));
        s = s.replace(/\bcreate_failed\b/gi, panelT("panel.modules.tasks.hints.createFailed"));
        s = s.replace(/\bdelete_failed\b/gi, panelT("panel.modules.tasks.hints.leakDeleteFailed"));
        s = s.replace(/\brestore_failed\b/gi, panelT("panel.modules.tasks.hints.leakRestoreFailed"));
        s = s.replace(/\bwrite_failed\b/gi, panelT("panel.shell.infra.prodErrors.write_failed"));
        s = s.replace(/\bpath_outside_sandbox\b/gi, panelT("panel.shell.infra.prodErrors.path_outside_sandbox"));
