        stripEl.hidden = false;
        summaryEl.textContent =
          panelT("panel.modules.tasks.detail.evidenceSummaryPrefix") + latest.label;
        continueBtn.hidden = !latest.canContinue;
      }

      panelEvidenceRefreshStrip = refreshGorevlerEvidenceStrip;

      let panelConfirmationEnabled = false;

      function syncPanelConfirmationEnabledFromDoc(doc) {
        if (!doc || typeof doc !== "object") return;
        if (typeof doc.confirmation_enabled === "boolean") {
          panelConfirmationEnabled = doc.confirmation_enabled;
        }
      }

      function isPanelConfirmationEnabled() {
        return panelConfirmationEnabled === true;
      }

      function isPanelConfirmationGateError(data) {
        if (!data || typeof data !== "object") return false;
        const err = String(data.error || "").trim();
        const reason = String(data.reason || "").trim();
        return (
          err === "confirmation_required"
          || reason === "confirmation_required"
          || reason === "confirmation_expired"
          || reason === "scope_mismatch"
        );
      }

      function panelConfirmationPreviewLabel(kind, value) {
        const v = String(value || "").trim();
        if (!v) return "—";
        const actionKey = panelT("panel.shell.infra.confirmation.actions." + v);
        if (actionKey !== "panel.shell.infra.confirmation.actions." + v) return actionKey;
        const effectKey = panelT("panel.shell.infra.confirmation.effects." + v);
        if (effectKey !== "panel.shell.infra.confirmation.effects." + v) return effectKey;
        return v;
      }

      function showPanelConfirmationModal(preview) {
        return new Promise((resolve) => {
          const dlg = document.getElementById("lumos-confirm-dialog");
          const whatEl = document.getElementById("lumos-confirm-preview-what");
          const whereEl = document.getElementById("lumos-confirm-preview-where");
          const effectEl = document.getElementById("lumos-confirm-preview-effect");
          const approveBtn = document.getElementById("lumos-confirm-approve");
          const cancelBtn = document.getElementById("lumos-confirm-cancel");
          if (!dlg || !whatEl || !whereEl || !effectEl || !approveBtn || !cancelBtn) {
            resolve(false);
            return;
          }
          const p = preview && typeof preview === "object" ? preview : {};
          whatEl.textContent = panelConfirmationPreviewLabel("what", p.what);
          whereEl.textContent = String(p.where || "—");
          effectEl.textContent = panelConfirmationPreviewLabel("effect", p.effect);

          let settled = false;
          function finish(ok) {
            if (settled) return;
            settled = true;
            approveBtn.removeEventListener("click", onApprove);
            cancelBtn.removeEventListener("click", onCancel);
            dlg.removeEventListener("cancel", onCancel);
            dlg.removeEventListener("close", onClose);
            try {
              if (typeof dlg.close === "function") dlg.close();
            } catch (_) {
              /* ignore */
            }
            resolve(ok);
          }
          function onApprove() {
            finish(true);
          }
          function onCancel() {
            finish(false);
          }
          function onClose() {
            finish(false);
          }
          approveBtn.addEventListener("click", onApprove);
          cancelBtn.addEventListener("click", onCancel);
          dlg.addEventListener("cancel", onCancel);
          dlg.addEventListener("close", onClose);
          try {
            if (typeof dlg.showModal === "function") dlg.showModal();
            else dlg.setAttribute("open", "open");
          } catch (_) {
            finish(false);
          }
        });
      }

      async function requestPanelConfirmation(mutationPath, mutationBody) {
        const base = resolveGorevlerTasksApiBase();
        if (!base) return null;
        const r = await fetch(`${base}/lumos-confirm/request`, {
          method: "POST",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          body: JSON.stringify({
            mutation_path: mutationPath,
            mutation_body: mutationBody != null ? mutationBody : {},
          }),
        });
        let data = null;
        try {
          data = await r.json();
        } catch {
          data = null;
        }
        if (!r.ok || !data || !data.ok || !data.confirmation_id) return null;
        return data;
      }

      async function panelEnsureMutationConfirmation(mutationPath, mutationBody) {
        const pending = await requestPanelConfirmation(mutationPath, mutationBody);
        if (!pending) return null;
        const approved = await showPanelConfirmationModal(pending.preview || {});
        if (!approved) return null;
        return String(pending.confirmation_id || "").trim() || null;
      }

      async function tasksApiPost(path, body) {
        const base = resolveGorevlerTasksApiBase();
        if (!base) throw new Error("tasks_api_disabled");
        const p = path.charAt(0) === "/" ? path : "/" + path;
        const payload =
          body != null && typeof body === "object" ? { ...body } : body != null ? body : {};

        async function doPost(postBody) {
          const r = await fetch(`${base}${p}`, {
            method: "POST",
            headers: { Accept: "application/json", "Content-Type": "application/json" },
            body: JSON.stringify(postBody != null ? postBody : {}),
          });
          let data = null;
          try {
            data = await r.json();
          } catch {
            data = null;
          }
          return { ok: r.ok, status: r.status, data };
        }

        if (isPanelConfirmationEnabled() && !(payload && payload.confirmation_id)) {
          const confirmationId = await panelEnsureMutationConfirmation(p, payload);
          if (!confirmationId) {
            return {
              ok: false,
              status: 0,
              data: { ok: false, error: "confirmation_cancelled" },
            };
          }
          payload.confirmation_id = confirmationId;
        }

        let res = await doPost(payload);

        if (!res.ok && res.status === 409 && isPanelConfirmationGateError(res.data)) {
          const retryPayload =
            payload && typeof payload === "object" ? { ...payload } : payload;
          if (retryPayload && typeof retryPayload === "object") {
            delete retryPayload.confirmation_id;
          }
          const confirmationId = await panelEnsureMutationConfirmation(p, retryPayload);
          if (!confirmationId) return res;
          if (retryPayload && typeof retryPayload === "object") {
            retryPayload.confirmation_id = confirmationId;
          }
          res = await doPost(retryPayload);
        }

        return res;
      }

      let panelEvidenceFlushInFlight = false;
      let panelEvidenceFlushSkipNested = false;
      let panelEvidenceFlushTimer = null;

      function generateEvidenceOpId() {
        try {
          if (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") {
            return crypto.randomUUID();
          }
        } catch (_) {
          /* ignore */
        }
        return (
          "evop_" + Date.now().toString(36) + "_" + Math.random().toString(36).slice(2, 10)
        );
      }

      function sanitizeEvidenceQueueRef(ref) {
        const s = String(ref || "").trim();
        if (!s) return "";
        return s.length > 200 ? s.slice(0, 200) : s;
      }

      function loadEvidencePendingOps() {
        try {
          if (typeof localStorage === "undefined") return [];
          const raw = localStorage.getItem(PANEL_EVIDENCE_PENDING_OPS_LS_KEY);
          if (!raw) return [];
          const a = JSON.parse(raw);
          if (!Array.isArray(a)) return [];
          const out = [];
          for (let i = 0; i < a.length; i++) {
            const x = a[i];
            if (!x || typeof x !== "object") continue;
            const op = String(x.op || "").trim();
            if (!["create", "complete", "delete", "restore"].includes(op)) continue;
            const ref = sanitizeEvidenceQueueRef(x.ref);
            if (!ref) continue;
            out.push({
              v: 1,
              op_id: String(x.op_id || generateEvidenceOpId()),
              op,
              ref,
              ref_kind: x.ref_kind === "title" ? "title" : "id",
              enqueued_at: String(x.enqueued_at || new Date().toISOString()),
              attempts: Number(x.attempts) >= 0 ? Number(x.attempts) : 0,
              last_attempt_at: x.last_attempt_at != null ? String(x.last_attempt_at) : null,
            });
          }
          return out;
        } catch {
          return [];
        }
      }

      function persistEvidencePendingOps(queue) {
        try {
          if (typeof localStorage === "undefined") return;
          localStorage.setItem(PANEL_EVIDENCE_PENDING_OPS_LS_KEY, JSON.stringify(queue));
        } catch (_) {
          /* kota / gizli mod */
        }
      }

      function trimEvidenceQueue(queue) {
        if (queue.length <= PANEL_EVIDENCE_QUEUE_MAX) return queue;
        const dropped = queue.length - PANEL_EVIDENCE_QUEUE_MAX;
        console.warn(
          "[Lumos panel evidence] pending-op kuyruğu limit aşıldı; " +
            dropped +
            " eski öğe düşürüldü.",
        );
        return queue.slice(-PANEL_EVIDENCE_QUEUE_MAX);
      }

      function evidenceOpPairKey(op, ref) {
        return String(op || "") + "\0" + sanitizeEvidenceQueueRef(ref);
      }

      function enqueueEvidencePendingOp(op, ref, refKind) {
        const r = sanitizeEvidenceQueueRef(ref);
        if (!r || !["create", "complete", "delete", "restore"].includes(String(op))) return null;
        const rk = refKind === "title" ? "title" : "id";
        let queue = loadEvidencePendingOps();
        const pair = evidenceOpPairKey(op, r);
        queue = queue.filter((x) => evidenceOpPairKey(x.op, x.ref) !== pair);
        const item = {
          v: 1,
          op_id: generateEvidenceOpId(),
          op: String(op),
          ref: r,
          ref_kind: rk,
          enqueued_at: new Date().toISOString(),
          attempts: 0,
          last_attempt_at: null,
        };
        queue.push(item);
        queue = trimEvidenceQueue(queue);
        persistEvidencePendingOps(queue);
        return item;
      }

      function evidenceRefFromGorevlerRow(t) {
        if (!t) return { ref: "", refKind: "title" };
        const id = t.id ? String(t.id).trim() : "";
        if (id) return { ref: id, refKind: "id" };
        const title = t.title ? String(t.title).trim() : "";
        return { ref: title, refKind: "title" };
      }

      function evidenceFlushBackoffMs(attempts) {
        const n = Math.max(0, Number(attempts) || 0);
        return Math.min(30000, 1000 * Math.pow(2, n));
      }

      function evidenceOpReadyForRetry(item) {
        if (!item || !item.last_attempt_at) return true;
        const last = Date.parse(String(item.last_attempt_at));
        if (Number.isNaN(last)) return true;
        return Date.now() - last >= evidenceFlushBackoffMs(item.attempts);
      }

      function isEvidenceFlushNetworkError(res, errThrown) {
        if (errThrown) return true;
        if (!res) return true;
        return false;
      }

      function isEvidenceFlushIdempotentSuccess(res, op) {
        if (!res) return false;
        if (res.ok && res.data && res.data.ok) return true;
        const err = res.data && res.data.error != null ? String(res.data.error) : "";
        if (res.status === 404 && err === "not_found") return true;
        if (op === "complete" && res.status === 409 && err === "already_done") return true;
        return false;
      }

      async function fetchTasksApiDoc() {
        const base = resolveGorevlerTasksApiBase();
        if (!base) return null;
        try {
          const r = await fetch(`${base}/tasks`, { headers: { Accept: "application/json" } });
          if (!r.ok) return null;
          const doc = await r.json();
          if (!doc || !Array.isArray(doc.tasks)) return null;
          syncPanelConfirmationEnabledFromDoc(doc);
          return doc;
        } catch {
          return null;
        }
      }

      function findTaskByTitleInDoc(doc, title) {
        const tt = String(title || "")
          .trim()
          .toLocaleLowerCase("tr-TR");
        if (!tt || !doc || !Array.isArray(doc.tasks)) return null;
        for (let i = 0; i < doc.tasks.length; i++) {
          const t = doc.tasks[i];
          if (!t || typeof t !== "object") continue;
          if (String(t.status || "") === "deleted") continue;
          const tTitle = String(t.title || "")
            .trim()
            .toLocaleLowerCase("tr-TR");
          if (tTitle === tt) return t;
        }
        return null;
      }

      async function replayEvidencePendingOp(item, tasksDoc) {
        const op = String(item.op || "");
        const ref = sanitizeEvidenceQueueRef(item.ref);
        if (!ref) return { outcome: "skip" };

        if (op === "create") {
          let doc = tasksDoc;
          if (!doc) doc = await fetchTasksApiDoc();
          if (doc && findTaskByTitleInDoc(doc, ref)) {
            return { outcome: "success", deduped: true };
          }
          try {
            const res = await tasksApiPost("/tasks", { title: ref });
            if (isEvidenceFlushIdempotentSuccess(res, op)) return { outcome: "success", res };
            return { outcome: "fail", res, network: false };
          } catch {
            return { outcome: "fail", network: true };
          }
        }

        if (op === "complete") {
          try {
            const res = await tasksApiPost("/tasks/complete", { ref });
            if (isEvidenceFlushIdempotentSuccess(res, op)) return { outcome: "success", res };
            return { outcome: "fail", res, network: false };
          } catch {
            return { outcome: "fail", network: true };
          }
        }

        if (op === "delete") {
          try {
            const res = await tasksApiPost("/tasks/delete", { ref });
            if (isEvidenceFlushIdempotentSuccess(res, op)) return { outcome: "success", res };
            return { outcome: "fail", res, network: false };
          } catch {
            return { outcome: "fail", network: true };
          }
        }

        if (op === "restore") {
          try {
            const res = await tasksApiPost("/tasks/restore", { id: ref });
            if (isEvidenceFlushIdempotentSuccess(res, op)) return { outcome: "success", res };
            return { outcome: "fail", res, network: false };
          } catch {
            return { outcome: "fail", network: true };
          }
        }

        return { outcome: "skip" };
      }

      async function flushPendingEvidenceOps() {
        if (shouldSkipGorevlerTasksApi()) return false;
        if (panelEvidenceFlushInFlight) return false;
        let queue = loadEvidencePendingOps();
        if (!queue.length) return true;

        panelEvidenceFlushInFlight = true;
        let tasksDoc = null;
        let changed = false;
        let anySuccess = false;
        let stoppedOnNetwork = false;

        try {
          for (let i = 0; i < queue.length; i++) {
            if (stoppedOnNetwork) break;
            const item = queue[i];
            if (!item) continue;
            if (item.attempts >= PANEL_EVIDENCE_FLUSH_MAX_ATTEMPTS) continue;
            if (!evidenceOpReadyForRetry(item)) continue;

            const result = await replayEvidencePendingOp(item, tasksDoc);
            if (result.outcome === "success") {
              queue.splice(i, 1);
              i -= 1;
              changed = true;
              anySuccess = true;
              if (item.op === "create") {
                tasksDoc = await fetchTasksApiDoc();
              }
              continue;
            }
            if (result.outcome === "fail") {
              item.attempts = (Number(item.attempts) || 0) + 1;
              item.last_attempt_at = new Date().toISOString();
              changed = true;
              if (result.network || isEvidenceFlushNetworkError(result.res, false)) {
                stoppedOnNetwork = true;
              }
            }
          }
          if (changed) persistEvidencePendingOps(queue);
          if (anySuccess) {
            panelEvidenceFlushSkipNested = true;
            try {
              await refreshPanelGorevlerFromTasksApi();
            } finally {
              panelEvidenceFlushSkipNested = false;
            }
          }
          return !stoppedOnNetwork;
        } finally {
          panelEvidenceFlushInFlight = false;
        }
      }

      function scheduleEvidenceQueueFlush() {
        if (shouldSkipGorevlerTasksApi()) return;
        flushPendingEvidenceOps().catch(() => {});
      }

      function wireEvidenceQueueFlushTriggers() {
        if (typeof window === "undefined") return;
        window.addEventListener("online", () => scheduleEvidenceQueueFlush());
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") scheduleEvidenceQueueFlush();
        });
        if (panelEvidenceFlushTimer) clearInterval(panelEvidenceFlushTimer);
        panelEvidenceFlushTimer = setInterval(
          () => scheduleEvidenceQueueFlush(),
          PANEL_EVIDENCE_FLUSH_INTERVAL_MS,
        );
      }

      async function refreshPanelGorevlerFromTasksApi() {
        const base = resolveGorevlerTasksApiBase();
        if (!base) return false;
        try {
          const r = await fetch(`${base}/tasks`, {
            headers: { Accept: "application/json" },
          });
          if (!r.ok) return false;
          const doc = await r.json();
          if (!doc || !Array.isArray(doc.tasks)) return false;
          syncPanelConfirmationEnabledFromDoc(doc);
          const next = [];
          for (let i = 0; i < doc.tasks.length; i++) {
            const t = doc.tasks[i];
            if (!t || typeof t !== "object") continue;
            if (String(t.status || "") === "deleted") continue;
            const row = engineTaskToPanelRow(t);
            if (row) next.push(row);
          }
          mergePanelGorevlerMetaFromPrevious(next);
          panelGorevlerTasks.length = 0;
          panelGorevlerTasks.push(...next);
          persistPanelGorevlerTasks();
          if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
          if (!panelEvidenceFlushSkipNested) scheduleEvidenceQueueFlush();
          return true;
        } catch {
          return false;
        }
      }

      function loadPanelGorevlerTasksFromStorage() {
        try {
          if (typeof localStorage === "undefined") return undefined;
          const raw = localStorage.getItem(PANEL_GOREVLER_LS_KEY);
          if (raw == null || raw === "") return undefined;
          const a = JSON.parse(raw);
          if (!Array.isArray(a)) return [];
          const out = [];
          for (let i = 0; i < a.length; i++) {
            const r = sanitizeGorevlerRow(a[i]);
            if (r) out.push(r);
          }
          return out;
        } catch {
          return [];
        }
      }

      function persistPanelGorevlerTasks() {
        try {
          if (typeof localStorage === "undefined") return;
          localStorage.setItem(PANEL_GOREVLER_LS_KEY, JSON.stringify(panelGorevlerTasks));
        } catch (_) {
          /* kota / gizli mod */
        }
      }

      let panelGorevlerTasks = [];

      let panelGorevlerTasksRender = null;
      let panelGorevlerRefreshI18n = null;

      /** @type {null | ((ref: string) => Promise<string>)} */
      let panelGorevlerDeleteFromChat = null;
      let panelGorevlerRestoreFromChat = null;
      function panelGorevDeleteRestoreHint() {
        return panelT("panel.modules.chat.gorev.deleteRestoreHint");
      }

      /** @typedef {{ title: string, whenSummary: string | null, replyKind?: string }} PanelGorevCreateKomut */
      /** @typedef {{ verb: "sil", ref: string }} PanelGorevSilKomut */
      /** @typedef {PanelGorevCreateKomut | PanelGorevSilKomut} PanelGorevKomut */

      function pad2(n) {
        const x = String(Number(n));
        return x.length >= 2 ? x : "0" + x;
      }

      /** Kullanıcı yazımı: gorev/yarain/saar vb. — ayrıştırmadan önce tek satırda düzeltir. */
      function normalizeUserTaskMessage(s) {
        return String(s || "")
          .replace(/\bgorev\b/gi, "görev")
          .replace(/\bolustur\b/gi, "oluştur")
          .replace(/\byarain\b/gi, "yarın")
          .replace(/\byarin\b/gi, "yarın")
          .replace(/\bsaar\b/gi, "saat")
          .replace(/\bbugun\b/gi, "bugün");
      }

      /** Lumos metninden Görev:/Tarih:/Saat: satırları (ekleyemiyorum densene çalışır). */
      function parsePanelGorevFromAssistantReply(raw) {
        const t = String(raw || "")
          .replace(/\*\*/g, "")
          .replace(/\r\n/g, "\n")
          .trim();
        if (!t) return null;
        const g = /(?:^|\n)\s*Görev\s*:\s*([^\n]+)/i.exec(t);
        if (!g) return null;
        const title = g[1].trim().replace(/^>\s*/, "");
        if (!title) return null;
        const parts = [];
        const d = /(?:^|\n)\s*Tarih\s*:\s*([^\n]+)/i.exec(t);
        if (d) {
          const dl = d[1].trim().toLocaleLowerCase("tr-TR");
          if (/\byarın\b|\byarin\b|\byarain\b/.test(dl)) {
            parts.push(panelT("panel.modules.tasks.when.tomorrow"));
          } else if (/\bbugün\b|\bbugun\b/.test(dl)) {
            parts.push(panelT("panel.modules.tasks.when.today"));
          } else if (d[1].trim()) parts.push(d[1].trim());
        }
        const st = /(?:^|\n)\s*Saat\s*:\s*([^\n]+)/i.exec(t);
        if (st) {
          const sx = st[1].trim();
          const tm = /^(\d{1,2})(?:\s*[:.]\s*(\d{2}))?$/.exec(sx);
          if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
          else parts.push(sx);
        }
        const whenSummary = parts.length ? parts.join(" ") : null;
        return { title, whenSummary };
      }

      function panelGorevRowExists(title, whenSummary) {
        const w = whenSummary || null;
        return panelGorevlerTasks.some((x) => x.title === title && (x.when || null) === w);
      }

      /**
       * Onay sorusu / dış uygulama uyarısı içeren Lumos metninden mini görev başlığı.
       * Örn: Mini görev olarak 'tiss' eklemek istiyorsun, doğru mu?
       */
      function parsePanelGorevLooseFromAssistant(raw) {
        const t = String(raw || "").replace(/\*\*/g, "").replace(/\r\n/g, "\n");
        const m =
          /mini\s+görev\s+olarak\s+['"'‘’«\u201c](.+?)['"'‘’»\u201d]/i.exec(t);
        if (!m) return null;
        const title = m[1].trim();
        return title ? { title, whenSummary: null, replyKind: "mini" } : null;
      }

      /** Asistan cevabından listeye aktarır (POST /tasks veya yerel); mini onay cümlelerinde sohbet metnini kısaltır. */
      async function ingestAssistantPanelGorev(replyBody) {
        let cmd = parsePanelGorevFromAssistantReply(replyBody);
        if (cmd) {
          const w = cmd.whenSummary || null;
          if (!panelGorevRowExists(cmd.title, w)) await applyPanelGorevKomutu(cmd);
          return { lumosText: String(replyBody || "").trim() };
        }
        const loose = parsePanelGorevLooseFromAssistant(replyBody);
        if (loose) {
          const w = loose.whenSummary || null;
          if (!panelGorevRowExists(loose.title, w)) {
            await applyPanelGorevKomutu({ title: loose.title, whenSummary: loose.whenSummary || null });
          }
          if (loose.replyKind === "mini") {
            return {
              lumosText: panelT("panel.modules.chat.gorev.confirmMini").replace(
                "{title}",
                loose.title,
              ),
            };
          }
        }
        return { lumosText: String(replyBody || "").trim() };
      }

      /**
       * "görev oluştur …" kuyruğundan başlık + Yarın 14:00 benzeri özet (yarain/saar toleranslı).
       */
      function parseOlusturRest(restRaw) {
        const rest = normalizeUserTaskMessage(String(restRaw || "").trim());
        if (!rest) return { title: "", whenSummary: null };
        const parts = [];
        if (/\byarın\b/i.test(rest)) parts.push(panelT("panel.modules.tasks.when.tomorrow"));
        else if (/\bbugün\b/i.test(rest)) parts.push(panelT("panel.modules.tasks.when.today"));
        const tm = /\bsaat\s*(\d{1,2})(?:\s*[:.]\s*(\d{2}))?\b/i.exec(rest);
        if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
        let titleWork = rest
          .replace(/\byarın\b/gi, " ")
          .replace(/\bbugün\b/gi, " ")
          .replace(/\bsaat\s*\d{1,2}(?:\s*[:.]\s*\d{2})?\b/gi, " ")
          .replace(/\s+/g, " ")
          .trim();
        if (!titleWork) titleWork = normalizeUserTaskMessage(String(restRaw || "").trim());
        const whenSummary = parts.length ? parts.join(" ") : null;
        return { title: titleWork, whenSummary };
      }

      /**
       * "yarın saat 14:00" / "bugün 09:30" vb. önekten görünen özet üretir (chat + liste).
       */
      function parseSchedulePrefix(prefixRaw) {
        const prefix = normalizeUserTaskMessage(String(prefixRaw || "").trim());
        if (!prefix) return { whenSummary: null };
        const pl = prefix.toLocaleLowerCase("tr-TR");
        const parts = [];
        if (/\byarın\b|\byarain\b|\byarin\b/i.test(prefix)) {
          parts.push(panelT("panel.modules.tasks.when.tomorrow"));
        } else if (/\bbugün\b|\bbugun\b/i.test(prefix)) {
          parts.push(panelT("panel.modules.tasks.when.today"));
        }
        const tm = /(?:saat\s*)?(\d{1,2})(?:\s*[:.]\s*(\d{2}))?\b/.exec(pl);
        if (tm) parts.push(tm[2] !== undefined ? `${pad2(tm[1])}:${tm[2]}` : `${pad2(tm[1])}:00`);
        const whenSummary = parts.length ? parts.join(" ") : prefix;
        return { whenSummary };
      }

      /** NBSP / büyük-küçük harf / birleşik Unicode — komut satırını tek forma çeker. */
      function canonicalizeTaskInput(raw) {
        let s = String(raw || "")
          .replace(/\u00a0/g, " ")
          .normalize("NFKC")
          .trim();
        s = normalizeUserTaskMessage(s);
        s = s.toLocaleLowerCase("tr-TR").replace(/\s+/g, " ").trim();
        return s;
      }

      /**
       * mini görev ekle … | görev oluştur … | … görev ekle … (isteğe bağlı tarih/saat öneki).
       * accepted / onay beklemez; POST /tasks veya yerel fallback ile bağlar.
       */
      function parsePanelGorevKomutu(raw) {
        const s0 = String(raw || "").trim();
        if (!s0) return null;
        const s = canonicalizeTaskInput(s0);

        let m = /^(?:görev|gorev)\s+sil(?=\s|:|$)/i.exec(s);
        if (m) {
          const ref = s.slice(m[0].length).replace(/^\s*:+\s*/, "").trim();
          return { verb: "sil", ref };
        }

        m = /^(?:görev|gorev)\s+geri\s+al(?=\s|:|$)/i.exec(s);
        if (m) {
          const ref = s.slice(m[0].length).replace(/^\s*:+\s*/, "").trim();
          return { verb: "geri_al", ref };
        }

        m = /^\s*mini\s+görev\s+ekle\s+(.+)$/i.exec(s);
        if (m) {
          const title = m[1].trim();
          return title ? { title, whenSummary: null, replyKind: "mini" } : null;
        }

        m = /^\s*görev\s+oluştur\s+(.+)$/i.exec(s);
        if (m) {
          const { title, whenSummary } = parseOlusturRest(m[1]);
          return title ? { title, whenSummary } : null;
        }

        m = /^\s*(?:([\s\S]*?)\s+)?görev\s+ekle\s+(.+)$/i.exec(s);
        if (!m) return null;
        const pre = (m[1] || "").trim();
        const title = (m[2] || "").trim();
        if (!title) return null;
        const { whenSummary } = parseSchedulePrefix(pre);
        return { title, whenSummary };
      }

      function buildPanelGorevConfirmation(cmd) {
        if (cmd.replyKind === "mini") {
          return panelT("panel.modules.chat.gorev.confirmMini").replace("{title}", cmd.title);
        }
        if (cmd.whenSummary) {
          return panelT("panel.modules.chat.gorev.confirmWithWhen")
            .replace("{title}", cmd.title)
            .replace("{when}", cmd.whenSummary);
        }
        return panelT("panel.modules.chat.gorev.confirm").replace("{title}", cmd.title);
      }

      function buildPanelGorevConfirmationMeta(cmd) {
        if (cmd.replyKind === "mini") {
          return {
            i18nKey: "panel.modules.chat.gorev.confirmMini",
            i18nVars: { title: cmd.title },
          };
        }
        if (cmd.whenSummary) {
          return {
            i18nKey: "panel.modules.chat.gorev.confirmWithWhen",
            i18nVars: { title: cmd.title, when: cmd.whenSummary },
          };
        }
        return {
          i18nKey: "panel.modules.chat.gorev.confirm",
          i18nVars: { title: cmd.title },
        };
      }

      function normalizePanelLimitedIntentKey(text) {
        return String(text || "")
          .trim()
          .toLocaleLowerCase("tr-TR")
          .replace(/\s+/g, " ");
      }

      function findPanelGorevlerRow(taskId, title) {
        const tid = taskId != null ? String(taskId).trim() : "";
        const tt = title != null ? String(title).trim() : "";
        for (let i = 0; i < panelGorevlerTasks.length; i++) {
          const x = panelGorevlerTasks[i];
          if (tid && x.id === tid) return x;
          if (tt && x.title === tt) return x;
        }
        return null;
      }

      /**
       * Chat/asistan görev oluşturma: POST /tasks → tasks.json; API yoksa yerel push.
       * addTask ile aynı sunucu yolu; whenSummary yalnızca panel satırında tutulur.
       */
      async function persistPanelGorevCreateViaApi(opts) {
        const title = String(opts && opts.title != null ? opts.title : "").trim();
        if (!title) return null;
        const whenSummary = opts && opts.whenSummary != null ? opts.whenSummary : null;
        const priority =
          opts &&
          opts.priority &&
          ["dusuk", "orta", "yuksek"].includes(String(opts.priority))
            ? String(opts.priority)
            : "orta";
        let status = "bekliyor";
        if (opts && opts.status === "onay_bekliyor") status = "onay_bekliyor";
        else if (opts && opts.status === "tamamlandi") status = "tamamlandi";

        function finishLocal() {
          const row = { title, priority, status };
          if (whenSummary) row.when = whenSummary;
          panelGorevlerTasks.push(row);
          persistPanelGorevlerTasks();
          attachGorevlerTaskPlan(row, title);
          enqueueEvidencePendingOp("create", title, "title");
          if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
          return row;
        }

        if (shouldSkipGorevlerTasksApi()) {
          return finishLocal();
        }

        let createRes;
        let apiUnreachable = false;
        try {
          createRes = await tasksApiPost("/tasks", { title });
        } catch {
          apiUnreachable = true;
        }
        if (
          apiUnreachable ||
          !createRes ||
          !createRes.ok ||
          !createRes.data ||
          !createRes.data.ok
        ) {
          if (shouldFallbackGorevlerTasksLocal(apiUnreachable)) {
            return finishLocal();
          }
          return null;
        }

        const taskId =
          createRes.data.task && createRes.data.task.id != null
            ? String(createRes.data.task.id).trim()
            : "";
        if (status === "tamamlandi" && taskId) {
          await tasksApiPost("/tasks/complete", { ref: taskId });
        }

        const refreshed = await refreshPanelGorevlerFromTasksApi();
        if (!refreshed && createRes.data.task) {
          const row = engineTaskToPanelRow(createRes.data.task);
          if (row) {
            row.priority = priority;
            if (status === "onay_bekliyor") row.status = "onay_bekliyor";
            else if (status === "tamamlandi") row.status = "tamamlandi";
            if (whenSummary) row.when = whenSummary;
            panelGorevlerTasks.push(row);
            persistPanelGorevlerTasks();
            if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
          }
        }

        const taskRef = findPanelGorevlerRow(taskId, title);
        if (taskRef) {
          taskRef.priority = priority;
          if (status === "onay_bekliyor") taskRef.status = "onay_bekliyor";
          else if (status === "tamamlandi") taskRef.status = "tamamlandi";
          if (whenSummary) taskRef.when = whenSummary;
          persistPanelGorevlerTasks();
          attachGorevlerTaskPlan(taskRef, title);
          if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
          return taskRef;
        }

        if (createRes.data.task) {
          const row = engineTaskToPanelRow(createRes.data.task);
          if (row) {
            row.priority = priority;
            if (whenSummary) row.when = whenSummary;
            attachGorevlerTaskPlan(row, title);
            if (typeof panelGorevlerTasksRender === "function") panelGorevlerTasksRender();
            return row;
          }
        }
        return null;
      }

      async function applyPanelGorevKomutu(cmd) {
        await persistPanelGorevCreateViaApi({
          title: cmd.title,
          whenSummary: cmd.whenSummary || null,
          priority: "orta",
          status: "bekliyor",
