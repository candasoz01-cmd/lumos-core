---
import "../styles/lumos-tokens.css";
import "../styles/umbrella-chrome.css";
import WeLockSiteNav from "../components/WeLockSiteNav.astro";
import WeLockSiteFooter from "../components/WeLockSiteFooter.astro";
import I18nInit from "../components/I18nInit.astro";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Lumos Lab — Kurumsal Araştırma ve Doğrulama</title>
    <meta name="description" content="Lumos Lab hizmet alanları, çıktıları ve Public, Private/Diamond ve Cyber katmanlarının farkları." />
    <link rel="canonical" href="https://welockai.com/lab" />
    <link rel="icon" href="/chat-lumos-mark.svg" type="image/svg+xml" sizes="any" />
  </head>
  <body class="umbrella-page">
    <WeLockSiteNav active="lab" />
    <main class="umbrella-main">
      <p class="umbrella-eyebrow" data-i18n="umbrella.lab.eyebrow">WE LOCK AI · LUMOS LAB</p>
      <h1 data-i18n="umbrella.lab.title">Kurumsal araştırma ve doğrulama alanı</h1>
      <p class="umbrella-lead" data-i18n="umbrella.lab.lead">Lumos Lab; yapay zekâ, kuantum hazırlığı, erişilebilirlik ve güvenli etkileşim yaklaşımlarını ölçülebilir raporlara dönüştüren araştırma katmanıdır.</p>
      <div class="umbrella-visual umbrella-visual--cinematic"><img src="/lumos-together-future.webp" alt="Araştırma, eğitim ve erişilebilir teknoloji üzerinde çalışan uluslararası ekip" decoding="async" /><p class="umbrella-visual__caption" data-i18n="umbrella.lab.visual">Her çalışma kapsam, yöntem, kanıt, sınırlama ve önerilen sonraki adımla sunulur.</p></div>
      <h2 data-i18n="umbrella.lab.servicesTitle">Lab hizmet alanları</h2>
      <div class="umbrella-feature-grid">
        <article class="umbrella-feature-card"><h2 data-i18n="umbrella.lab.aiTitle">AI Model ve Yönlendirme Lab</h2><p data-i18n="umbrella.lab.aiBody">Göreve, bölgeye, maliyete, gecikmeye ve mahremiyete göre model/paket karşılaştırması ve açıklanabilir öneri.</p></article>
        <article class="umbrella-feature-card"><h2 data-i18n="umbrella.lab.quantumTitle">Kuantum Hazırlık</h2><p data-i18n="umbrella.lab.quantumBody">Kripto envanteri, geçiş riski ve hazırlık değerlendirmesi.</p></article>
        <article class="umbrella-feature-card"><h2 data-i18n="umbrella.lab.accessibilityTitle">Erişilebilirlik Lab</h2><p data-i18n="umbrella.lab.accessibilityBody">Klavye, ekran okuyucu, kontrast, bilişsel yük ve düşük bant senaryolarında deneyim değerlendirmesi.</p></article>
        <article class="umbrella-feature-card"><h2 data-i18n="umbrella.lab.securityTitle">Güvenli Etkileşim</h2><p data-i18n="umbrella.lab.securityBody">Onay kapıları, risk dili ve insan denetimi doğrulaması.</p></article>
      </div>
      <h2 data-i18n="umbrella.lab.differenceTitle">Katmanların farkı</h2>
      <div class="umbrella-feature-grid">
        <article class="umbrella-feature-card"><h3 data-i18n="umbrella.lab.publicTitle">Lumos Lab · kamusal yüzey</h3><p data-i18n="umbrella.lab.publicBody">Demo-safe değerlendirme ve genel hazırlık raporları.</p></article>
        <article class="umbrella-feature-card umbrella-feature-card--diamond"><h3 data-i18n="umbrella.lab.privateTitle">Private / Diamond · kontrollü erişim</h3><p data-i18n="umbrella.lab.privateBody">Kuruluşa özel politika, veri, kimlik ve uzman incelemesi.</p></article>
        <article class="umbrella-feature-card umbrella-feature-card--cyber"><h3 data-i18n="umbrella.lab.cyberTitle">Lumos Cyber · bağımsız güvenlik katmanı</h3><p data-i18n="umbrella.lab.cyberBody">Savunma, risk görünürlüğü ve güvenlik operasyonları.</p></article>
      </div>
      <div class="umbrella-callout"><p><strong data-i18n="umbrella.lab.outputsTitle">Sunulan ve planlanan çıktılar</strong><br /><span data-i18n="umbrella.lab.outputsBody">Karşılaştırma özeti, hazırlık puanı, risk ve fark raporu, erişilebilirlik bulguları ve önerilen sonraki adımlar.</span></p></div>
      <div class="umbrella-actions"><a class="umbrella-btn umbrella-btn--primary" href="/panel" data-i18n="umbrella.lab.panelCta">Lumos paneli</a><a class="umbrella-btn" href="/cyber" data-i18n="umbrella.lab.cyberCta">Cyber katmanı</a><a class="umbrella-btn" href="/education" data-i18n="umbrella.lab.educationCta">Eğitim alanı</a></div>
    </main>
    <WeLockSiteFooter />
    <I18nInit />
  </body>
</html>
