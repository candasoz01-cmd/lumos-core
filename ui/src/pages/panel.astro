---
import "../styles/lumos-tokens.css";
import "../styles/umbrella-chrome.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import I18nInit from "../components/I18nInit.astro";

/**
 * POST /chat tam URL (örn. `https://host/chat`).
 * GET /status: aynı origin’de `.../status` — `PUBLIC_LUMOS_PANEL_STATUS_URL` ile ayrı host verilmezse CHAT_URL’den türetilir.
 */
const CHAT_URL = import.meta.env.PUBLIC_LUMOS_CHAT_URL || "/api/bridge/chat";
/** PUBLIC token visible in browser — local/dev only; prod build omits test123 fallback */
const kandoToken = import.meta.env.DEV
  ? import.meta.env.PUBLIC_KANDO_TOKEN || "test123"
  : import.meta.env.PUBLIC_KANDO_TOKEN || "";
const UPLOAD_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_UPLOAD_URL ||
  String(CHAT_URL).replace(/\/chat\/?$/i, "") + "/panel/upload";
/** Köprü tabanı: upload ile aynı origin (CHAT farklı host olsa bile rozet yerel bridge’e baksın). */
const BRIDGE_BASE_URL = String(UPLOAD_URL).replace(/\/panel\/upload\/?$/i, "");
/** Rozet: önce açık health URL; yoksa BRIDGE_BASE + /health (PUBLIC_LUMOS_PANEL_HEALTH_URL ve BRIDGE_HEALTH_URL birlikte desteklenir). */
const HEALTH_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_HEALTH_URL ||
  import.meta.env.PUBLIC_LUMOS_BRIDGE_HEALTH_URL ||
  BRIDGE_BASE_URL + "/health";
/** Backend "Sistem Durumu" (GET): varsayılan olarak CHAT_URL’deki `/chat` → `/status` ile aynı host. */
const STATUS_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_STATUS_URL ||
  String(CHAT_URL).replace(/\/chat\/?$/i, "") + "/status";
/** Görev motoru: GET/POST /tasks → `.lumos/tasks.json` (`panel/scripts/panel_tasks_server.py`, varsayılan :8766). */
const TASKS_API_URL =
  import.meta.env.PUBLIC_LUMOS_PANEL_TASKS_URL || "http://127.0.0.1:8766";
// Prod builds ignore PUBLIC_LUMOS_PANEL_DEV; bundle token risk is separate.
const PANEL_DEBUG = import.meta.env.DEV;
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover, user-scalable=no"
    />
    <title data-i18n="panel.meta.title">ChatLumos — Lumos çalışma alanı</title>
    <link rel="icon" href="/chat-lumos-mark.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/chat-lumos-mark.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0e14" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Lumos" />
    <script is:inline>
      (() => {
        const params = new URLSearchParams(window.location.search);
        const standalone = window.matchMedia?.("(display-mode: standalone)")?.matches === true;
        const desktopSource = params.get("source") === "desktop";
        if (desktopSource || standalone) {
          document.documentElement.dataset.lumosApp = "true";
        }
      })();
    </script>
    <style>
      * {
        box-sizing: border-box;
      }
      html {
        height: 100%;
      }
      body {
        margin: 0;
        height: 100vh;
        height: 100dvh;
        max-height: 100vh;
        max-height: 100dvh;
        overflow: hidden;
        overflow-x: hidden;
        background-color: var(--lumos-bg);
        background-image: var(--panel-body-wash);
        background-attachment: fixed;
        color: var(--lumos-text);
        font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, sans-serif;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      .panel-shell {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        max-height: 100%;
        width: 100%;
        max-width: 100%;
        min-width: 0;
      }
      .panel-header {
        flex-shrink: 0;
        padding: clamp(0.85rem, 2vw, 1.15rem) clamp(1rem, 3vw, 1.5rem);
        border-bottom: 1px solid var(--lumos-teal-38);
        box-shadow: 0 1px 0 rgb(var(--lumos-land-warm-deep) / 0.14);
        background: var(--panel-strip-bg);
      }
      .panel-header-title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        column-gap: 0.65rem;
        row-gap: 0.45rem;
      }
      .panel-umbrella-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.65rem;
        width: 100%;
        margin-top: 0.35rem;
        padding-top: 0.45rem;
        border-top: 1px solid rgb(var(--lumos-land-teal) / 0.18);
      }
      .panel-umbrella-links a {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgb(var(--lumos-land-teal) / 0.78);
        text-decoration: none;
      }
      .panel-umbrella-links a:hover,
      .panel-umbrella-links a:focus-visible {
        color: var(--lumos-accent-blue-bright);
      }
      .panel-header-brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        min-width: 0;
        flex: 1 1 12rem;
        overflow: visible;
      }
      .panel-conn-badge {
        flex: 0 0 auto;
        margin-left: auto;
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        padding: 0.2rem 0.48rem;
        border-radius: 999px;
        line-height: 1.25;
        border: 1px solid rgba(255, 255, 255, 0.12);
        white-space: nowrap;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
        /** Label uzunluğu (Bağlanıyor → Bağlı) header titremesin */
        min-width: 5.4rem;
        text-align: center;
        box-sizing: border-box;
      }
      .panel-conn-badge[data-state="pending"] {
        color: rgba(200, 188, 160, 0.95);
        background: rgba(90, 72, 44, 0.28);
        border-color: rgba(184, 148, 96, 0.35);
      }
      .panel-conn-badge[data-state="ok"] {
        color: rgb(196 234 255 / 0.96);
        background: linear-gradient(180deg, rgb(6 16 36 / 0.96) 0%, rgb(2 6 18 / 0.98) 100%);
        border-color: var(--lumos-teal-38);
        box-shadow:
          inset 0 1px 0 var(--lumos-tq-badge-inset),
          0 0 14px rgb(var(--lumos-land-teal) / 0.14),
          0 0 0 1px rgb(var(--lumos-land-warm) / 0.18);
      }
      .panel-conn-badge[data-state="bad"] {
        color: rgba(240, 195, 195, 0.96);
        background: rgba(92, 42, 42, 0.32);
        border-color: rgba(200, 120, 110, 0.38);
      }
      .panel-conn-badge[data-state="limited"] {
        color: rgba(210, 198, 168, 0.92);
        background: rgba(72, 62, 48, 0.28);
        border-color: rgba(160, 140, 108, 0.32);
      }
      .panel-conn-badge[data-setup-link="1"] {
        cursor: pointer;
      }
      .panel-conn-badge[data-setup-link="1"]:hover,
      .panel-conn-badge[data-setup-link="1"]:focus-visible {
        filter: brightness(1.08);
        outline: 2px solid rgba(120, 200, 255, 0.35);
        outline-offset: 2px;
      }
      .panel-user-mode-badge {
        flex: 0 0 auto;
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        padding: 0.22rem 0.5rem;
        border-radius: 999px;
        line-height: 1.25;
        border: 1px solid var(--lumos-border);
        white-space: nowrap;
        box-shadow: var(--panel-edge-inset);
      }
      .panel-user-mode-badge[data-mode="offline"] {
        color: var(--lumos-text-soft);
        background: rgb(var(--lumos-land-warm) / 0.06);
        border-color: var(--lumos-gold-line);
      }
      .panel-user-mode-badge[data-mode="limited"] {
        color: var(--lumos-accent-gold);
        background: rgb(var(--lumos-land-warm) / 0.08);
        border-color: var(--lumos-gold-line);
        box-shadow: var(--panel-edge-inset);
      }
      .panel-user-mode-badge[data-mode="full"] {
        color: var(--lumos-accent-primary);
        background: rgb(var(--lumos-land-teal) / 0.08);
        border-color: var(--lumos-teal-28);
        box-shadow:
          var(--panel-edge-inset),
          0 0 8px rgb(var(--lumos-land-teal) / 0.06);
      }
      .panel-user-mode-wrap {
        position: relative;
        flex: 0 0 auto;
      }
      button.panel-user-mode-badge {
        appearance: none;
        -webkit-appearance: none;
        margin: 0;
        cursor: pointer;
        font-family: inherit;
        transition:
          filter 0.15s ease,
          border-color 0.15s ease,
          box-shadow 0.15s ease;
      }
      button.panel-user-mode-badge:hover {
        filter: brightness(1.08);
      }
      button.panel-user-mode-badge:focus-visible {
        outline: 2px solid var(--lumos-teal-38);
        outline-offset: 2px;
      }
      button.panel-user-mode-badge.panel-user-mode-badge--open {
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.08),
          0 0 0 1px var(--lumos-teal-18);
      }
      .panel-user-mode-menu {
        position: absolute;
        top: calc(100% + 0.35rem);
        right: 0;
        z-index: 60;
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
        min-width: 9.5rem;
        padding: 0.35rem;
        border-radius: 0.7rem;
        border: 1px solid var(--lumos-border);
        background: rgba(5, 10, 22, 0.98);
        box-shadow:
          0 10px 28px rgb(0 0 0 / 0.42),
          var(--panel-edge-inset);
      }
      .panel-user-mode-menu[hidden] {
        display: none !important;
      }
      .panel-user-mode-menu__item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        width: 100%;
        margin: 0;
        padding: 0.42rem 0.5rem;
        border: none;
        border-radius: 0.45rem;
        background: transparent;
        color: rgb(214 232 248 / 0.96);
        font: inherit;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        line-height: 1.35;
        text-align: start;
        cursor: pointer;
      }
      .panel-user-mode-menu__item:hover,
      .panel-user-mode-menu__item:focus-visible {
        background: rgb(var(--lumos-land-teal) / 0.1);
        outline: none;
      }
      .panel-user-mode-menu__item[aria-checked="true"] {
        color: rgb(196 234 255 / 0.96);
        background: linear-gradient(180deg, rgb(6 16 36 / 0.96) 0%, rgb(2 6 18 / 0.98) 100%);
        box-shadow: inset 0 1px 0 var(--lumos-tq-badge-inset);
      }
      .panel-user-mode-menu__check {
        flex: 0 0 auto;
        font-size: 0.68rem;
        opacity: 0;
        color: rgb(130 206 255 / 0.92);
      }
      .panel-user-mode-menu__item[aria-checked="true"] .panel-user-mode-menu__check {
        opacity: 1;
      }
      .panel-user-mode-fieldset {
        margin: 0;
        padding: 0;
        border: 0;
        min-width: 0;
      }
      .panel-user-mode-legend {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--lumos-muted);
        margin-bottom: 0.55rem;
      }
      .panel-user-mode-seg {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }
      .panel-user-mode-seg-option {
        position: relative;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
      }
      .panel-user-mode-seg-option input {
        position: absolute;
        opacity: 0;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
      }
      .panel-user-mode-seg-option span {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        padding: 0.32rem 0.62rem;
        border-radius: 999px;
        border: 1px solid var(--lumos-teal-18);
        background: var(--lumos-main-bg);
        color: var(--lumos-muted);
        transition:
          border-color 0.15s ease,
          background 0.15s ease,
          color 0.15s ease;
      }
      .panel-user-mode-seg-option input:focus-visible + span {
        outline: 2px solid var(--lumos-teal-38);
        outline-offset: 2px;
      }
      .panel-user-mode-seg-option input:checked + span {
        color: rgb(196 234 255 / 0.96);
        border-color: var(--lumos-teal-38);
        background: linear-gradient(180deg, rgb(6 16 36 / 0.96) 0%, rgb(2 6 18 / 0.98) 100%);
        box-shadow: inset 0 1px 0 var(--lumos-tq-badge-inset);
      }
      .panel-infra-status-dl {
        margin: 0.35rem 0 0;
        display: grid;
        gap: 0.35rem 0.75rem;
        grid-template-columns: minmax(5.5rem, auto) 1fr;
        font-size: 0.74rem;
        line-height: 1.4;
      }
      .panel-infra-status-dl dt {
        margin: 0;
        font-weight: 600;
        color: var(--lumos-muted);
      }
      .panel-infra-status-dl dd {
        margin: 0;
        color: var(--lumos-text);
        word-break: break-word;
      }
      .panel-health-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 0.35rem 0.6rem;
        margin-top: 0;
        margin-left: auto;
        flex: 0 1 auto;
        max-width: 100%;
      }
      .gorevler-task-bridge {
        margin: 0;
        margin-top: 0.12rem;
        font-size: 0.72rem;
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: 0.01em;
        color: rgba(198, 194, 186, 0.78);
      }
      .gorevler-task-plan {
        margin: 0;
        margin-top: 0.1rem;
        font-size: 0.72rem;
        font-weight: 500;
        line-height: 1.45;
        color: rgba(212, 188, 150, 0.88);
      }
      .gorevler-plan-card {
        max-width: 36rem;
        margin-top: 0.65rem;
        padding: 0.85rem 1rem;
        border-radius: var(--panel-radius-lg);
        border: 1px solid rgba(184, 148, 96, 0.35);
        background: rgba(14, 13, 11, 0.96);
        box-shadow: var(--panel-edge-inset);
      }
      .gorevler-plan-card__title {
        margin: 0 0 0.55rem;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: rgba(212, 188, 150, 0.92);
      }
      .gorevler-plan-card__status {
        margin: 0 0 0.45rem;
        font-size: 0.74rem;
        color: rgba(168, 206, 182, 0.9);
      }
      .gorevler-plan-card__low-risk-note {
        margin: 0.5rem 0 0;
        font-size: 0.74rem;
        line-height: 1.45;
        color: rgba(184, 200, 220, 0.9);
      }
      .gorevler-plan-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 0.65rem;
      }
      /** display:flex [hidden]'ı ezer; düşük riskte butonlar görünmesin */
      .gorevler-plan-actions[hidden] {
        display: none !important;
      }
      .gorevler-plan-actions .gorevler-add-btn {
        flex: 1 1 auto;
        min-width: 10rem;
      }
      .gorevler-plan-teshis-compact {
        margin-top: 0.55rem;
        padding-top: 0.5rem;
        border-top: 1px dashed rgba(184, 148, 96, 0.28);
      }
      .gorevler-plan-teshis-compact[hidden] {
        display: none !important;
      }
      .gorevler-plan-teshis-compact__line {
        margin: 0.22rem 0 0;
        font-size: 0.71rem;
        line-height: 1.42;
        color: rgba(198, 194, 186, 0.86);
      }
      .gorevler-plan-teshis-compact__line strong {
        font-weight: 600;
        color: rgba(212, 188, 150, 0.9);
      }
      .medya-outbox-wrap {
        margin: 0.75rem 0 1.25rem;
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--lumos-card-border);
        border-radius: var(--panel-radius-lg);
        background: var(--lumos-surface);
        box-shadow: var(--panel-edge-inset);
      }
      .medya-outbox-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.45rem;
      }
      .medya-outbox-refresh {
        font: inherit;
        font-size: 0.78rem;
        padding: 0.35rem 0.65rem;
        border-radius: 8px;
        border: 1px solid var(--lumos-teal-35);
        background: var(--lumos-btn-a);
        color: var(--lumos-text);
        cursor: pointer;
      }
      .medya-outbox-refresh:hover {
        border-color: rgb(var(--lumos-land-teal) / 0.4);
      }
      .medya-outbox-refresh:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }
      .medya-outbox-pre {
        margin: 0.5rem 0 0;
        padding: 0.5rem 0.55rem;
        max-height: 12rem;
        overflow: auto;
        font-size: 0.68rem;
        line-height: 1.45;
        white-space: pre-wrap;
        word-break: break-word;
        background: var(--lumos-main-bg);
        border: 1px solid var(--lumos-teal-18);
        border-radius: 8px;
        color: var(--lumos-muted);
      }
      @media (max-width: 520px) {
        .panel-conn-badge {
          margin-left: 0;
          flex-basis: auto;
          width: auto;
          max-width: 100%;
          align-self: flex-start;
        }
        .panel-header-title-row {
          align-items: flex-start;
        }
        /* Rozet, işaret + başlık satırının altında hizalı */
        .panel-header-brand {
          flex: 1 1 100%;
        }
        .panel-conn-badge {
          margin-left: calc(1.42rem + 0.42rem);
        }
        .panel-health-row {
          justify-content: flex-start;
          margin-left: 0;
          width: 100%;
          flex-basis: 100%;
        }
      }
      .lumos-mark {
        width: clamp(1.75rem, 4.2vw, 2.125rem);
        height: clamp(1.75rem, 4.2vw, 2.125rem);
        flex-shrink: 0;
        object-fit: contain;
        padding: 0.18rem;
        border: 1px solid rgb(var(--lumos-land-warm) / 0.55);
        border-radius: 0.55rem;
        background: #03060d;
        filter: drop-shadow(0 0 8px rgb(var(--lumos-land-warm) / 0.14));
      }

      html[data-lumos-app="true"] .panel-umbrella-links,
      html[data-lumos-app="true"] .panel-user-mode-wrap,
      html[data-lumos-app="true"] .panel-nav__lumos,
      html[data-lumos-app="true"] .panel-nav-group-toggle,
      html[data-lumos-app="true"] .panel-nav__primary button[data-module-availability="inactive"],
      html[data-lumos-app="true"] .panel-nav-status-subline,
      html[data-lumos-app="true"] .chat-capability-card,
      html[data-lumos-app="true"] #panel-empty-secret-note,
      html[data-lumos-app="true"] #panel-sohbet .lumos-security-note:not(:first-of-type) {
        display: none !important;
      }

      html[data-lumos-app="true"] .panel-body {
        grid-template-rows: minmax(0, 1fr);
        grid-template-areas: "nav-primary main";
      }

      html[data-lumos-app="true"] .panel-nav__primary {
        padding-top: 1rem;
        border-bottom: none;
      }

      html[data-lumos-app="true"] .panel-nav-collapsible {
        margin-bottom: 0;
      }

      html[data-lumos-app="true"] .panel-header {
        padding-block: 0.65rem;
      }
      .panel-header-brand-text {
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
        min-width: 0;
      }
      .panel-header-brand h1 {
        margin: 0;
        font-size: var(--panel-font-display);
        font-weight: 600;
        letter-spacing: -0.018em;
        color: #e9eef5;
        line-height: 1.2;
      }
      .panel-header-tagline {
        margin: 0;
        font-size: var(--panel-font-caption);
        font-weight: 500;
        letter-spacing: 0.02em;
        color: rgba(168, 188, 210, 0.72);
        line-height: 1.35;
      }
      .panel-engine-badge {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        width: fit-content;
        margin-top: 0.08rem;
        padding: 0.12rem 0.38rem;
        border: 1px solid rgb(var(--lumos-land-warm) / 0.28);
        border-radius: 999px;
        color: rgba(214, 220, 228, 0.72);
        background: rgba(3, 6, 13, 0.46);
        font-size: 0.54rem;
        font-weight: 600;
        letter-spacing: 0.055em;
        line-height: 1.25;
        white-space: nowrap;
      }
      /**
       * Masaüstü: sol sütunda üstte Çalışma, altta Lumos çekirdeği; sağda `main` iki satırı kaplar.
       * Mobil: aynı üç çocuk `grid-template-areas` ile Çalışma → içerik → Lumos (Safari’de `display: contents` gerekmez).
       */
      .panel-body {
        display: grid;
        flex: 1;
        min-height: 0;
        min-width: 0;
        overflow: hidden;
        grid-template-columns: clamp(10rem, 22vw, 12.75rem) minmax(0, 1fr);
        grid-template-rows: auto minmax(0, 1fr);
        grid-template-areas:
          "nav-primary main"
          "nav-lumos main";
      }
      .panel-nav__primary {
        grid-area: nav-primary;
        align-self: stretch;
        min-height: 0;
        padding: 0.65rem 0.4rem 0.45rem 0;
        border-right: 1px solid var(--lumos-teal-18);
        border-bottom: 1px solid var(--lumos-teal-12);
        background: var(--lumos-sidebar-bg);
