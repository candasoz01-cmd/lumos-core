          <section
            id="panel-yapayzeka"
            class="module-panel"
            data-module-panel="yapayzeka"
            data-active="false"
            aria-labelledby="panel-yapayzeka-title"
          >
            <h2 id="panel-yapayzeka-title">Yapay Zekâ</h2>
            <p class="medya-intro">
              Yapay Zekâ alanı, Lumos’un kullanıcıyla çalışırken sınırlarını, belirsizlik yönetimini ve karar destek rolünü açık
              tutması için ayrılmıştır.
            </p>
            <ul class="medya-card-list">
              <li class="medya-card">
                <h3>Belirsizlik Sınırı</h3>
                <p>Lumos emin olmadığı yerde kesin konuşmaz; belirsizliği açıkça belirtir.</p>
              </li>
              <li class="medya-card">
                <h3>Karar Desteği</h3>
                <p>Lumos seçenekleri ve riskleri görünür kılar; nihai karar kullanıcıda kalır.</p>
              </li>
              <li class="medya-card">
                <h3>Manipülasyon Yasağı</h3>
                <p>Lumos korku, umut, suçluluk veya bağımlılık üzerinden kullanıcıyı yönlendirmez.</p>
              </li>
              <li class="medya-card">
                <h3>İnsan Onuru</h3>
                <p>Hız, veri, performans veya kâr; insan onurunun ve kullanıcı iradesinin önüne geçemez.</p>
              </li>
            </ul>
          </section>

          <section
            id="panel-kuantum"
            class="module-panel"
            data-module-panel="kuantum"
            data-active="false"
            aria-labelledby="panel-kuantum-title"
          >
            <h2 id="panel-kuantum-title" class="module-title-row">
              Kuantum <span class="lumos-soon-badge">Yakında</span>
            </h2>
            <div class="placeholder-block">
              <p>Kuantum ve ileri hesaplama başlıkları burada araştırma alanı olarak izlenecek.</p>
              <p>Bu bölüm iddia değil, yön ve kapasite alanıdır.</p>
            </div>
          </section>

          <section
            id="panel-entegrasyon"
            class="module-panel"
            data-module-panel="entegrasyon"
            data-active="false"
            aria-labelledby="panel-entegrasyon-title"
          >
            <h2 id="panel-entegrasyon-title">Entegrasyon</h2>
            <p class="medya-intro">
              Entegrasyon alanı, Lumos’un dış servisler ve sistemlerle ilişki kurarken kullanıcı iznini, veri sınırını ve güvenli
              geçiş ilkesini koruması için ayrılmıştır.
            </p>
            <ul class="medya-card-list">
              <li class="medya-card">
                <h3>Bağlantı Sınırı</h3>
                <p>Lumos’un dış sistemlerle kuracağı her ilişki, açık amaç ve sınırlı kapsam içinde değerlendirilir.</p>
              </li>
              <li class="medya-card">
                <h3>Kullanıcı İzni</h3>
                <p>Dış servislerle temas, kullanıcı iradesi ve onayı dışında genişletilmez.</p>
              </li>
              <li class="medya-card">
                <h3>Veri Geçişi</h3>
                <p>Sistemler arasında taşınacak bilgi, yalnızca gerekli bağlam ve güvenli sınırlar içinde ele alınır.</p>
              </li>
              <li class="medya-card">
                <h3>Güvenli Köprü</h3>
                <p>
                  Entegrasyon, Lumos’un kontrolsüz erişim alanı değil; kullanıcıyı ve sistemi koruyan kontrollü geçiş katmanıdır.
                </p>
              </li>
            </ul>
          </section>

          <section
            id="panel-kimlik"
            class="module-panel"
            data-module-panel="kimlik"
            data-active="false"
            aria-labelledby="panel-kimlik-title"
          >
            <h2 id="panel-kimlik-title">Kimlik</h2>
            <p class="medya-intro">
              Kimlik alanı, Lumos’un kullanıcıyla ilişkisinde temsil sınırını, kullanıcı iradesini ve yetki ayrımını açık tutması
              için ayrılmıştır.
            </p>
            <ul class="medya-card-list">
              <li class="medya-card">
                <h3>Kullanıcı İradesi</h3>
                <p>Lumos’un yönü, kullanıcının açık niyeti ve kararı dışında genişletilmez.</p>
              </li>
              <li class="medya-card">
                <h3>Temsil Sınırı</h3>
                <p>
                  Lumos, kullanıcı adına kimlik veya yetki sahibi gibi davranmaz; kullanıcı iradesini koruyan destek alanı
                  olarak konumlanır.
                </p>
              </li>
              <li class="medya-card">
                <h3>İmza Ayrımı</h3>
                <p>Lumos ile hazırlanan çıktıların sahipliği ve imzası Lumos’a değil, kullanıcıya aittir.</p>
              </li>
              <li class="medya-card">
                <h3>Yetki Dengesi</h3>
                <p>Kalıcı, maliyetli veya başkalarını etkileyen işlemler açık kullanıcı onayı gerektirir.</p>
              </li>
            </ul>
          </section>

          <section
            id="panel-guvenlik"
            class="module-panel"
            data-module-panel="guvenlik"
            data-active="false"
            aria-labelledby="panel-guvenlik-title"
          >
            <h2 id="panel-guvenlik-title" class="module-title-row">
              Güvenlik <span class="lumos-soon-badge">Yakında</span>
            </h2>
            <div class="placeholder-block">
              <p>Kalıcı ve yıkıcı işlemler açık onay gerektirir.</p>
              <p>Dış bağlantılar ve izinler kullanıcıdan gizlenmez.</p>
            </div>
          </section>

          <section
            id="panel-dunya"
            class="module-panel"
            data-module-panel="dunya"
            data-active="false"
            aria-labelledby="panel-dunya-title"
          >
            <h2 id="panel-dunya-title" class="module-title-row">
              Dünya <span class="lumos-soon-badge">Yakında</span>
            </h2>
            <div class="placeholder-block">
              <p>Yerel cihazdan küresel bağlantılara uzanan akış burada izlenecek.</p>
              <p>Farklı servisler, zamanlar ve bağlamlar arasında kontrollü geçiş hedeflenecek.</p>
            </div>
          </section>

          <section
            id="panel-ayarlar"
            class="module-panel"
            data-module-panel="ayarlar"
            data-active="false"
            aria-labelledby="panel-ayarlar-title"
          >
            <h2 id="panel-ayarlar-title" class="module-title-row">
              Ayarlar <span class="lumos-soon-badge">Yakında</span>
            </h2>
            <div class="placeholder-block">
              <p>Kullanıcı tercihleri ve Lumos davranış ayarları burada yer alacak.</p>
            </div>
          </section>
        </main>
      </div>
    </div>
    <script define:vars={{ CHAT_URL, kandoToken }}>
      function wirePanel() {
        const nav = document.querySelector(".panel-nav");
        const panels = document.querySelectorAll("[data-module-panel]");
        const sendBtn = document.getElementById("panel-send");
        const input = document.getElementById("panel-msg");
        const thread = document.getElementById("chat-thread");
        if (!nav || !sendBtn || !input || !thread) return;

        function expandNavGroupIfActiveHidden() {
          const active = nav.querySelector('button[data-module][aria-current="true"]');
          if (!active) return;
          const items = active.closest(".panel-nav-group-items");
          if (!items || !items.hasAttribute("hidden")) return;
          items.removeAttribute("hidden");
          const collapsible = items.closest(".panel-nav-collapsible");
          const toggle = collapsible?.querySelector(".panel-nav-group-toggle");
          if (toggle) toggle.setAttribute("aria-expanded", "true");
        }
        expandNavGroupIfActiveHidden();

        nav.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLElement)) return;
          const groupToggle = t.closest(".panel-nav-group-toggle");
          if (groupToggle) {
            const expanded = groupToggle.getAttribute("aria-expanded") === "true";
            const next = !expanded;
            groupToggle.setAttribute("aria-expanded", next ? "true" : "false");
            const cid = groupToggle.getAttribute("aria-controls");
            const panel = cid ? document.getElementById(cid) : null;
            if (panel) {
              if (next) panel.removeAttribute("hidden");
              else panel.setAttribute("hidden", "");
            }
            return;
          }
          const btn = t.closest("button[data-module]");
          if (!btn) return;
          const id = btn.getAttribute("data-module");
          if (!id) return;
          nav.querySelectorAll("button[data-module]").forEach((b) => {
            b.setAttribute("aria-current", b === btn ? "true" : "false");
          });
          panels.forEach((p) => {
            p.setAttribute("data-active", p.getAttribute("data-module-panel") === id ? "true" : "false");
          });
        });

        const sendLabel = "Gönder";
        const loadingLabel = "Gönderiliyor…";
        const CHAT_HISTORY_LIMIT = 12;
        let sending = false;

        function escapeHtml(s) {
          return String(s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        function formatAssistantHtml(raw) {
          let s = escapeHtml(String(raw));
          s = s.replace(/\*\*([\s\S]+?)\*\*/g, "<strong>$1</strong>");
          s = s.replace(/\*\*/g, "");
          s = s.replace(/\n/g, "<br />");
          return s;
        }

        /** Lumos gövdesinden (strong, br) backend geçmişi için düz metin üretir. */
        function lumosBodyToPlainText(root) {
          const out = [];
          function walk(n) {
            if (n.nodeType === Node.TEXT_NODE) out.push(n.textContent);
            else if (n.nodeType === Node.ELEMENT_NODE) {
              const el = /** @type {Element} */ (n);
              if (el.tagName === "BR") out.push("\n");
              else el.childNodes.forEach(walk);
            }
          }
          walk(root);
          return out.join("").trim();
        }

        /** Mevcut iplikten (yeni kullanıcı mesajı eklenmeden önce) son N mesajı role/content olarak döner. */
        function collectThreadHistory(threadEl) {
          const nodes = threadEl.querySelectorAll(".chat-msg");
          const items = [];
          for (const wrap of nodes) {
            let role;
            if (wrap.classList.contains("chat-msg--user")) role = "user";
            else if (wrap.classList.contains("chat-msg--lumos")) role = "assistant";
            else continue;
            const body = wrap.querySelector(".chat-msg-body");
            let text = "";
            if (role === "assistant" && body) {
              text = lumosBodyToPlainText(body);
            } else if (body && body.textContent) {
              text = body.textContent.trim();
            }
            if (!text) continue;
            items.push({ role, content: text });
          }
          if (items.length <= CHAT_HISTORY_LIMIT) return items;
          return items.slice(-CHAT_HISTORY_LIMIT);
        }

        function appendBubble(kind, text) {
          const turn = document.createElement("div");
          turn.className =
            "chat-turn " +
            (kind === "user" ? "chat-turn--user" : kind === "error" ? "chat-turn--error" : "chat-turn--lumos");

          const wrap = document.createElement("div");
          wrap.className =
            "chat-msg " +
            (kind === "user" ? "chat-msg--user" : kind === "error" ? "chat-msg--error" : "chat-msg--lumos");
          const role = document.createElement("span");
          role.className = "chat-msg-role";
          role.textContent = kind === "user" ? "Sen" : kind === "error" ? "Uyarı" : "Lumos";
          const body = document.createElement("div");
          body.className = "chat-msg-body";
          if (kind === "lumos") {
            body.innerHTML = formatAssistantHtml(text);
          } else {
            body.textContent = text;
          }
          wrap.appendChild(role);
          wrap.appendChild(body);
          turn.appendChild(wrap);
          thread.appendChild(turn);
          requestAnimationFrame(() => {
            thread.scrollTop = thread.scrollHeight;
          });
        }

        async function runSend() {
          const message = input.value.trim();
          if (!message || sending) return;

          sending = true;
          sendBtn.disabled = true;
          sendBtn.setAttribute("aria-busy", "true");
          sendBtn.textContent = loadingLabel;
          const history = collectThreadHistory(thread);
          appendBubble("user", message);

          try {
            const r = await fetch(CHAT_URL, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Kando-Token": kandoToken,
              },
              body: JSON.stringify({ message, history }),
            });
            const text = await r.text();
            let data = null;
            try {
              data = text ? JSON.parse(text) : null;
            } catch {
              data = null;
            }
            if (r.ok) {
              let replyBody = "";
              if (data && typeof data === "object" && "reply" in data) {
                const raw = data.reply;
                replyBody = raw == null ? "" : String(raw);
              }
              if (!replyBody.trim() && text && text.trim()) {
                replyBody =
                  data && typeof data === "object" && "reply" in data
                    ? ""
                    : "Bu kez yanıtı okuyamadık. Biraz sonra yeniden denebilirsin.";
              }
              const lumosText = replyBody.trim()
                ? replyBody
                : "Bu sefer boş bir yanıt geldi. Sorunu biraz açıp yeniden deneyebilirsin.";
              appendBubble("lumos", lumosText);
              input.value = "";
            } else {
              let errHuman = "";
              if (data && typeof data === "object" && data.error != null) {
                errHuman = String(data.error);
              } else if (text && text.trim()) {
                errHuman = text.trim();
              } else {
                errHuman = r.statusText || "Beklenmeyen bir durum oluştu.";
              }
              if (errHuman === "OPENAI_API_KEY missing") {
                errHuman = "Şu an yanıt üretilemiyor; kısa süre içinde yeniden denebilirsin.";
              } else if (errHuman === "message required") {
                errHuman = "Önce kısa bir mesaj yazman gerekiyor.";
              }
              appendBubble("error", "Şimdilik yanıt veremedik. " + errHuman);
            }
          } catch {
            appendBubble(
              "error",
              "Bağlantıda kısa bir kesinti oldu. İnternetini kontrol edip biraz sonra yeniden deneyebilirsin."
            );
          } finally {
            sending = false;
            sendBtn.disabled = false;
            sendBtn.removeAttribute("aria-busy");
            sendBtn.textContent = sendLabel;
          }
        }

        sendBtn.addEventListener("click", () => {
          void runSend();
        });
        input.addEventListener("keydown", (e) => {
          if (e.key !== "Enter" || e.shiftKey) return;
          e.preventDefault();
          void runSend();
        });
      }
      wirePanel();
    </script>
  </body>
</html>
