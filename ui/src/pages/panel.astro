      #panel-sohbet {
        gap: 0;
        background: transparent;
      }
      /** Sohbet: kaydırılan geçmiş, altta compose. */
      .chat-workspace {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        gap: 0.75rem;
        background: transparent;
      }
      .chat-history-shell {
        flex: 1;
        min-height: 10rem;
        min-width: 0;
        display: flex;
        flex-direction: column;
        border-radius: 14px;
        border: 1px solid var(--lumos-border);
        background: var(--lumos-chat-history-bg);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.025),
          0 8px 28px rgba(0, 0, 0, 0.72);
